# Core runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
DB=mongodb+srv://USER:PASSWORD@HOST/DATABASE
SECRET=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
SESSION_TTL_SECONDS=604800
APP_BASE_URL=https://www.matths.kr
PUBLIC_BASE_URL=https://www.matths.kr
PAID_CHECKOUT_ENABLED=false

# Dedicated signing/encryption keys. Do not change these after data is created
# without running the corresponding migration first.
API_TOKEN_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
IDENTITY_MATCH_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
ARENA_INTEGRITY_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
PAYBACK_ACCOUNT_ENCRYPTION_KEY=GENERATE_A_SEPARATE_RANDOM_VALUE
DOCUMENT_WATERMARK_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
NICKNAME_CHECK_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
PASSWORD_RESET_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE

# Public/support email identity
ADMIN_EMAIL=admin@lsbproduction.com
PUBLIC_CONTACT_EMAIL=admin@lsbproduction.com
# All automated and administrator-triggered email: Gmail
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=lsbproduction00@gmail.com
GMAIL_APP_PASSWORD=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
SUPPORT_EMAIL_FROM_NAME=Matths

# User-upload storage (Cloudinary) and private administrator originals (R2)
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_PRIVATE_BUCKET_NAME

# PG contract's final VAT-inclusive fee. Example: 3.5% = 350 basis points.
# Taxes are intentionally not included in the withdrawal calculation.
FINANCE_PG_FEE_RESERVE_BPS=350

# Google sign-in (optional until the OAuth client is approved)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.matths.kr/auth/google/callback

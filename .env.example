# Core runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
DB=mongodb+srv://USER:PASSWORD@HOST/DATABASE
SECRET=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_DOMAIN=.matths.kr
PUBLIC_BASE_URL=https://www.matths.kr
APP_BASE_URL=https://app.matths.kr
ACADEMY_BASE_URL=https://academy.matths.kr
ADMIN_BASE_URL=https://admin.matths.kr
PARENTS_BASE_URL=https://parents.matths.kr
PAID_CHECKOUT_ENABLED=false

# Public Google Tag Manager container ID
GOOGLE_TAG_MANAGER_ID=GTM-T9FC8Z4B

# Dedicated signing/encryption keys. Do not change these after data is created
# without running the corresponding migration first.
API_TOKEN_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
IDENTITY_MATCH_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
ARENA_INTEGRITY_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
ATTENDANCE_CODE_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
DOCUMENT_WATERMARK_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
NICKNAME_CHECK_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE
PASSWORD_RESET_SECRET=GENERATE_A_SEPARATE_RANDOM_VALUE

# Internal operations inbox; public support contact is fixed in contactEmail.js
ADMIN_EMAIL=admin@lsbproduction.com
# All automated and administrator-triggered email: Gmail
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=lsbproduction00@gmail.com
GMAIL_APP_PASSWORD=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
SUPPORT_EMAIL_FROM_NAME=Matths

# User-upload storage (Cloudinary) and private administrator originals (R2)
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_PRIVATE_BUCKET_NAME

# PG contract's final VAT-inclusive fee. Example: 3.5% = 350 basis points.
# Taxes are intentionally not included in the withdrawal calculation.
FINANCE_PG_FEE_RESERVE_BPS=350

# KG Inicis production payment credentials. Inject real values through the
# hosting provider's secret/environment-variable store; never commit them.
PAYMENT_PROVIDER=INICIS
INICIS_PAYMENTS_MODE=LIVE
INICIS_LIVE_MID=
INICIS_LIVE_HASH_KEY=
INICIS_LIVE_API_KEY=
INICIS_LIVE_CLIENT_IP=

# Google sign-in (optional until the OAuth client is approved)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.matths.kr/auth/google/callback

# Kakao sign-in (REST API key and enabled Client Secret)
KAKAO_OAUTH_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=https://www.matths.kr/auth/kakao/callback

# Sign in with Apple (web Services ID + native bundle ID)
APPLE_SERVICES_ID=
APPLE_OAUTH_REDIRECT_URI=https://www.matths.kr/auth/apple/callback
APPLE_BUNDLE_ID=kr.matths.app
APPLE_PRO_PRODUCT_ID=
APPLE_ALLOW_SANDBOX=false
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 PKCS#8 key with newlines encoded as \n.
APPLE_PRIVATE_KEY=

# Account plans (server defaults shown; keep configurable per environment)
MATTHS_PRO_PRICE_KRW=5500
MATTHS_PRO_BILLING_PERIOD_DAYS=30

# GOAT Arena general-play hidden matchmaking rating. This never changes the
# public competitive score, tier, or ranking.
ARENA_NORMAL_HIDDEN_MMR_DEFAULT=1000
ARENA_NORMAL_HIDDEN_RD_DEFAULT=350
ARENA_NORMAL_HIDDEN_VOLATILITY_DEFAULT=0.06
# Calibrated operator baseline records use a steadier opponent snapshot. These
# remain staging hypotheses until the handwritten records are approved.
ARENA_NORMAL_BASELINE_RD=156.524758
ARENA_NORMAL_BASELINE_VOLATILITY=0.06

# GOAT Arena Glicko-2 launch hypotheses. Keep these configurable and validate
# them with simulations and staging data before enabling competitive play.
ARENA_GLICKO_DEFAULT_RATING=1500
ARENA_GLICKO_INITIAL_RD=350
ARENA_GLICKO_DEFAULT_VOLATILITY=0.06
ARENA_GLICKO_TAU=0.5
ARENA_GLICKO_EPSILON=0.000001
# Optional override for 1..5 valid placement samples. When omitted, the server
# uses 350/sqrt(sample count).
# ARENA_GLICKO_PLACEMENT_RD_BY_COUNT=350,247.487373,202.072594,175,156.524758
ARENA_ASYNC_NORMAL_CLOSE_SCORE_THRESHOLD=0.1
ARENA_ASYNC_CLOSE_SCORE_THRESHOLD=0.1
ARENA_GLICKO_PLACEMENT_VOLATILITY_BY_COUNT=0.10,0.09,0.08,0.07,0.06
# Prevent a question already shown to a user from appearing in that user's
# next five normal/competitive matches.
# Question exposure cooldown is fixed at 10 started normal/competitive matches.
# Public competitive points are separate from internal Glicko-2 MMR.
ARENA_COMPETITIVE_SCORE_K_FACTOR=32
ARENA_COMPETITIVE_SCORE_RATING_SCALE=400
ARENA_COMPETITIVE_SCORE_MINIMUM=0
ARENA_ONE_SIDED_MMR_DRIFT_WARNING_AVERAGE=2
ARENA_RATING_REVERSAL_MINIMUM_STREAK=2
ARENA_RATING_REVERSAL_DELTA_STEP=0.15
ARENA_RATING_REVERSAL_MINIMUM_MULTIPLIER=0.55

# One-time/idempotent activation of the verified 60-per-tier normal beta batch.
# Set true in production and identify an existing active administrator email.
ARENA_NORMAL_BASELINE_AUTO_ACTIVATE=false
ARENA_NORMAL_BASELINE_OPERATOR_EMAIL=

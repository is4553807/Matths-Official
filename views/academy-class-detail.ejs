<%
  const academyClass = detail.academyClass;
  const academyName = String(detail.academy?.name || "학원");
  const className = String(academyClass?.name || "반");
  const classStudents = detail.students || [];
  const gradeLabelFor = (grade) => ({
    10: "고1",
    11: "고2",
    12: "고3",
    13: "N수생",
    14: "대학생",
    15: "직장인",
  })[Number(grade)] || "학년 미설정";
  const displayStudentName = (student) => String(student?.realName || student?.name || "학생");
  const summaryRows = statistics.summary?.bullets || [];
  const classMathMap = typeof mathMap !== "undefined" && mathMap ? mathMap : {
    graphVersion: "kr-2022-math-graph-v1.0", modelVersion: "v1.0", overallMastery: null,
    analyzedConceptCount: 0, concepts: [], bottlenecks: [], heatmap: [], totalStudents: classStudents.length,
  };
  const classMathMapJson = JSON.stringify({ heatmap: { items: classMathMap.heatmap.slice(0, 18) } }).replace(/</g, "\\u003c");
  const summaryCopyText = [
    `[Matths ${statistics.period.label.replace(/ \(.+\)$/, "")} 반 학습 요약]`,
    `${academyName} · ${className}`,
    ...summaryRows.map((row) => `• ${row.label}: ${row.text}`),
  ].join("\n");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= className %> 반 통계 | <%= academyName %> · Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/academy.css" />
    <link rel="stylesheet" href="/css/contrast.css" />
    <script src="/js/academy.js" defer></script>
  </head>
  <body class="academy-page">
    <header class="academy-topbar">
      <%- include("partials/matths-brand", { href: "/academy", ariaLabel: "Matths 학원 관리 홈", className: "academy-brand", suffix: "학원 관리", compact: true }) %>
      <div class="academy-account"><span><strong><%= user.realName || user.name %></strong> 선생님</span><form action="/logout" method="POST"><button type="submit">로그아웃</button></form></div>
    </header>

    <div class="academy-layout">
      <aside class="academy-sidebar">
        <div class="academy-identity">
          <% if (detail.profileImageSrc) { %><img src="<%= detail.profileImageSrc %>" alt="<%= academyName %> 프로필 사진" /><% } else { %><span aria-hidden="true"><%= academyName.slice(0, 1) %></span><% } %>
          <div><small>ACADEMY</small><strong><%= academyName %></strong></div>
        </div>
        <nav aria-label="학원 관리 메뉴">
          <a href="/academy?tab=dashboard">대시보드</a>
          <a href="/academy?tab=attendance">출결 관리</a>
          <a href="/academy?tab=students">학생 관리</a>
          <a href="/academy?tab=requests">승인 요청 <% if (detail.pendingCount) { %><b><%= detail.pendingCount %></b><% } %></a>
          <a class="active" href="/academy?tab=classes">반 관리</a>
          <a href="/academy?tab=invites">초대 관리</a>
          <a href="/academy?tab=teachers">선생님 관리</a>
          <% if (detail.isOwner) { %><a href="/academy?tab=settings">학원 설정</a><% } %>
        </nav>
        <p>반 통계는 현재 해당 반에 배정된 승인 학생의 기록만 집계합니다.</p>
      </aside>

      <main class="academy-main">
        <section class="academy-student-hero">
          <div><span class="academy-student-avatar" aria-hidden="true"><%= className.slice(0, 1) %></span><div><small>CLASS LEARNING REPORT</small><h1><%= className %></h1><p><%= academyName %> · 배정 학생 <%= classStudents.length %>명</p></div></div>
          <a href="/academy?tab=classes">반 목록 <span>→</span></a>
        </section>

        <section class="academy-report-toolbar" aria-label="반 통계 기간 선택">
          <div><small>CLASS MONTHLY REPORT</small><strong><%= statistics.period.label %> 반 학습 기록</strong><p>현재 이 반에 배정된 승인 학생 전체를 기준으로 평균을 계산합니다.</p></div>
          <form class="academy-period" action="/academy/classes/<%= academyClass._id %>" method="GET">
            <label for="academy-class-period">조회 기간</label>
            <div><select id="academy-class-period" name="period"><% statistics.period.options.forEach((option) => { %><option value="<%= option.key %>" <%= option.key === statistics.period.key ? "selected" : "" %>><%= option.label %></option><% }) %></select><button type="submit">조회</button></div>
          </form>
        </section>

        <div class="academy-integration-notice" role="status"><span aria-hidden="true">i</span><p><strong>반 평균 통계입니다.</strong> 학습하지 않은 반 학생도 0일·0문제로 포함하며, 정답률과 복습률은 해당 기록이 있는 전체 문제를 합산해 계산합니다.</p></div>

        <section class="academy-stat-grid" aria-label="반 주요 통계">
          <% statistics.cards.forEach((card) => { %><article><small><%= card.label %></small><strong><%= card.value %></strong><span><%= card.detail %></span></article><% }) %>
        </section>

        <section class="academy-panel academy-math-map-panel academy-student-section">
          <header><div><p>CLASS MATH MAP</p><h2><%= className %> 규칙 기반 숙달도</h2></div><span class="academy-status-chip"><%= classMathMap.overallMastery === null ? "분석 전" : `평균 ${classMathMap.overallMastery}%` %></span></header>
          <div class="academy-math-map-meta">
            <div><small>반 학생</small><strong><%= classMathMap.totalStudents %>명</strong></div>
            <div><small>분석 개념</small><strong><%= classMathMap.analyzedConceptCount %>개</strong></div>
            <div><small>그래프</small><strong><%= classMathMap.graphVersion %></strong></div>
            <div><small>계산 모델</small><strong><%= classMathMap.modelVersion %></strong></div>
          </div>
          <div class="academy-heatmap-legend" aria-hidden="true"><span>취약</span><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i><i class="level-5"></i><span>안정</span></div>
          <div class="academy-heatmap-chart" data-class-math-map-chart role="img" aria-label="반 학생의 개념별 평균 숙달도 히트맵"></div>
          <p class="academy-chart-note">개념별 평균은 해당 개념 풀이가 5개 이상인 학생만 계산합니다. 각 칸에 분석 인원/반 전체 인원을 표시해 적은 표본의 평균이 과도하게 해석되지 않도록 했습니다.</p>
          <% if (classMathMap.bottlenecks.length) { const bottleneck = classMathMap.bottlenecks[0]; %><div class="academy-math-map-alert"><strong>수업 확인 우선순위</strong><p><%= bottleneck.conceptTitle %>: 분석 <%= bottleneck.analyzedCount %>명 중 <%= bottleneck.weakCount %>명이 보완 필요이며, <%= bottleneck.affectedConceptCount %>개 후속 개념과 연결됩니다.</p></div><% } %>
          <% if (classMathMap.recommendation) { const recommendation = classMathMap.recommendation; %><div class="academy-math-map-recommendation"><div><small>CLASS RECOMMENDATION</small><h3><%= recommendation.conceptTitle %> 복습</h3><p><%= recommendation.reason %></p></div><div><strong>학생별 <%= recommendation.problemMix.total %>문제 구성안</strong><p><% recommendation.problemMix.difficulties.forEach((item, index) => { %><%= index ? " · " : "" %>난이도 <%= item.level %> <%= item.count %>개<% }) %><% if (recommendation.problemMix.retryCount) { %> · 이전 오답 <%= recommendation.problemMix.retryCount %>개<% } %></p><span>선생님 검토용 규칙 제안이며 자동 배정하지 않습니다.</span></div></div><% } %>
          <% if (classMathMap.concepts.length) { %>
            <div class="academy-table-wrap academy-math-map-table"><table><thead><tr><th>개념</th><th>평균 숙달도</th><th>분석 표본</th><th>숙달</th><th>성장 중</th><th>보완 필요</th><th>Unknown</th></tr></thead><tbody>
              <% classMathMap.concepts.forEach((concept) => { %><tr><td><strong><%= concept.title %></strong><small><%= concept.courseTitle %> · <%= concept.unitTitle %></small></td><td><span class="academy-mastery-chip is-<%= concept.status.toLowerCase() %>"><%= concept.mastery === null ? "Unknown" : `${concept.mastery}%` %></span></td><td><%= concept.analyzedCount %>/<%= concept.totalStudents %>명</td><td><%= concept.statusCounts.MASTERED %>명</td><td><%= concept.statusCounts.DEVELOPING %>명</td><td><%= concept.statusCounts.WEAK %>명</td><td><%= concept.statusCounts.UNKNOWN %>명</td></tr><% }) %>
            </tbody></table></div>
          <% } %>
        </section>
        <script type="application/json" data-class-math-map-data><%- classMathMapJson %></script>

        <div class="academy-dashboard-grid">
          <section class="academy-panel academy-summary-panel">
            <header><div><p>CLASS SUMMARY</p><h2><%= className %> Summary</h2></div><span class="academy-status-chip"><%= statistics.period.label %></span></header>
            <ul><% summaryRows.forEach((row) => { %><li><span aria-hidden="true"></span><p><strong><%= row.label %></strong><small><%= row.text %></small></p></li><% }) %></ul>
            <footer><p>반 전체 평균은 수업 운영 방향을 확인하는 용도입니다. 개별 상담에는 아래 학생의 상세 통계를 확인해 주세요.</p><div><button type="button" data-copy-value="<%= summaryCopyText %>" data-copy-success="반 요약을 복사했습니다.">요약 복사</button></div></footer>
          </section>

          <aside class="academy-panel academy-attention-panel">
            <header><div><p>NEEDS ATTENTION</p><h2>확인이 필요한 학생</h2></div><strong><%= statistics.attentionStudents.length %></strong></header>
            <% if (!statistics.attentionStudents.length) { %>
              <div class="academy-empty-state"><span aria-hidden="true">✓</span><strong>현재 확인 항목이 없습니다</strong><p>미학습, 낮은 학습 빈도, 정답률과 오답 복습률을 기준으로 확인합니다.</p></div>
            <% } else { %>
              <div class="academy-attention-list">
                <% statistics.attentionStudents.slice(0, 8).forEach((item) => { const membership = item.membership; const student = membership.studentUserId; %>
                  <a href="/academy/students/<%= membership._id %>"><span><strong><%= displayStudentName(student) %></strong><small><%= item.reasons.join(" · ") %></small></span><b>→</b></a>
                <% }) %>
                <% if (statistics.attentionStudents.length > 8) { %><p>외 <%= statistics.attentionStudents.length - 8 %>명은 아래 반 학생 목록에서 확인할 수 있습니다.</p><% } %>
              </div>
            <% } %>
          </aside>
        </div>

        <section class="academy-panel academy-table-panel academy-student-section">
          <header><div><p>CLASS MEMBERS</p><h2>반 학생 목록</h2></div><strong class="academy-panel-count"><%= classStudents.length %></strong></header>
          <% if (!classStudents.length) { %>
            <div class="academy-empty-state"><span aria-hidden="true">＋</span><strong>이 반에 배정된 학생이 없습니다</strong><p>학생 관리에서 학생을 선택해 이 반에 배정해 주세요.</p></div>
          <% } else { %>
            <div class="academy-table-wrap">
              <table>
                <thead><tr><th>학생</th><th>가입 학년</th><th>학교</th><th>개별 통계</th></tr></thead>
                <tbody>
                  <% classStudents.forEach((membership) => { const student = membership.studentUserId; %>
                    <tr><td><strong><%= displayStudentName(student) %></strong><small><%= student.name !== student.realName && student.realName ? `닉네임 ${student.name}` : "승인 학생" %></small></td><td><span class="academy-grade-chip"><%= gradeLabelFor(student.schoolGrade) %></span></td><td><strong><%= student.school?.name || "학교 미설정" %></strong><small><%= student.school?.region || "" %></small></td><td><a class="academy-detail-link" href="/academy/students/<%= membership._id %>">학생 통계 보기 <span>→</span></a></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
        <div class="academy-copy-toast" data-copy-toast role="status" aria-live="polite" hidden>복사했습니다.</div>
      </main>
    </div>
  </body>
</html>

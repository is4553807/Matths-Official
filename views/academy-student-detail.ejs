<%
  const membership = detail.membership;
  const student = membership.studentUserId;
  const academyName = detail.academy?.name || "학원";
  const studentName = student.realName || student.name || "학생";
  const gradeLabel = ({ 10: "고1", 11: "고2", 12: "고3", 13: "N수생", 14: "대학생", 15: "직장인" })[Number(student.schoolGrade)] || "학년 미설정";
  const statCards = statistics.cards;
  const studentMathMap = typeof mathMap !== "undefined" && mathMap ? mathMap : {
    graphVersion: "kr-2022-math-graph-v1.0", modelVersion: "v1.0", overallMastery: null,
    analyzedConceptCount: 0, unknownConceptCount: 0, concepts: [], bottlenecks: [],
    topStrength: null, topPriority: null, recommendation: null, courses: [],
  };
  const topStrength = studentMathMap.topStrength;
  const topPriority = studentMathMap.topPriority;
  const topBottleneck = studentMathMap.bottlenecks?.[0] || null;
  const detailCards = [
    ["STRENGTH", "강점 개념", topStrength ? `${topStrength.title} · 숙달도 ${topStrength.mastery}% (${topStrength.confidenceLabel} 신뢰도)` : "분석 가능한 개념 표본이 아직 없습니다."],
    ["PRIORITY", "우선 보완 개념", topPriority ? `${topPriority.title} · 숙달도 ${topPriority.mastery}% (${topPriority.evidence.attemptCount}개 풀이)` : "개념별 풀이가 5개 이상 쌓이면 표시됩니다."],
    ["BOTTLENECK", "잠재 병목 개념", topBottleneck ? `${topBottleneck.conceptTitle} · 연결된 ${topBottleneck.affectedConcepts.length}개 후속 개념을 함께 확인하세요.` : "현재 규칙으로 식별된 잠재 병목이 없습니다."],
  ];
  const mathMapJson = JSON.stringify({ concepts: studentMathMap.concepts }).replace(/</g, "\\u003c");
  const formatMapDate = (date) => date ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date(date)) : "—";
  const summaryRows = statistics.summary.bullets;
  const summaryCopyText = [
    `[Matths ${statistics.period.label.replace(/ \(.+\)$/, "")} 학습 요약]`,
    `${studentName} 학생`,
    ...summaryRows.map((row) => `• ${row.label}: ${row.text}`),
  ].join("\n");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= studentName %> 학생 통계 | <%= academyName %> · Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/academy.css" />
    <link rel="stylesheet" href="/css/contrast.css" />
  </head>
  <body class="academy-page">
    <header class="academy-topbar">
      <%- include("partials/matths-brand", { href: "/academy", ariaLabel: "Matths 학원 관리 홈", className: "academy-brand", suffix: "학원 관리", compact: true }) %>
      <div class="academy-account"><span><strong><%= user.realName || user.name %></strong> 선생님</span><form action="/logout" method="POST"><button type="submit">로그아웃</button></form></div>
    </header>
    <div class="academy-layout">
      <aside class="academy-sidebar">
        <div class="academy-identity"><span aria-hidden="true"><%= academyName.slice(0, 1) %></span><div><small>ACADEMY</small><strong><%= academyName %></strong></div></div>
        <nav aria-label="학원 관리 메뉴"><a href="/academy?tab=dashboard">대시보드</a><a href="/academy?tab=attendance">출결 관리</a><a class="active" href="/academy?tab=students">학생 관리</a><a href="/academy?tab=requests">승인 요청 <% if (detail.pendingCount) { %><b><%= detail.pendingCount %></b><% } %></a><a href="/academy?tab=classes">반 관리</a><a href="/academy?tab=invites">초대 관리</a><a href="/academy?tab=teachers">선생님 관리</a></nav>
        <p>학생의 학습 기록은 승인된 소속 관계 안에서만 조회됩니다.</p>
      </aside>
      <main class="academy-main">
        <section class="academy-student-hero">
          <div><span class="academy-student-avatar" aria-hidden="true"><%= studentName.slice(0, 1) %></span><div><small>STUDENT LEARNING REPORT</small><h1><%= studentName %> 학생</h1><p><%= student.school?.name || "학교 미설정" %> · <%= gradeLabel %> · <%= membership.classId?.name || "반 미배정" %></p></div></div>
          <a href="/academy?tab=students">학생 목록 <span>→</span></a>
        </section>
        <section class="academy-report-toolbar" aria-label="보고서 기간 선택">
          <div><small>MONTHLY REPORT</small><strong><%= statistics.period.label %> 학습 기록</strong><p>한국 시간 기준으로 승인된 학생의 학습 기록만 집계합니다.</p></div>
          <form class="academy-period" action="/academy/students/<%= membership._id %>" method="GET">
            <label for="academy-report-period">조회 기간</label>
            <div><select id="academy-report-period" name="period"><% statistics.period.options.forEach((option) => { %><option value="<%= option.key %>" <%= option.key === statistics.period.key ? "selected" : "" %>><%= option.label %></option><% }) %></select><button type="submit">조회</button></div>
          </form>
        </section>
        <div class="academy-integration-notice" role="status"><span aria-hidden="true">i</span><p><strong>통계 기준</strong> 문제 수는 중복을 제외하고, 정답률은 첫 제출만 계산합니다. 오답 복습률은 해당 기간에 발생한 오답이 그 기간 안에 완료됐는지를 기준으로 합니다.</p></div>
        <section class="academy-stat-grid academy-student-stat-grid" aria-label="학생 학습 통계">
          <% statCards.forEach((card) => { %><article><small><%= card.label %></small><strong><%= card.value %></strong><span><%= card.detail %></span></article><% }) %>
        </section>
        <section class="academy-placeholder-detail">
          <% detailCards.forEach((card) => { %><article><small><%= card[0] %></small><h2><%= card[1] %></h2><p><%= card[2] %></p></article><% }) %>
        </section>
        <section class="academy-panel academy-math-map-panel academy-student-section">
          <header><div><p>RULE-BASED MATH MAP</p><h2>학생 수학 능력 지도</h2></div><span class="academy-status-chip"><%= studentMathMap.overallMastery === null ? "분석 전" : `평균 ${studentMathMap.overallMastery}%` %></span></header>
          <div class="academy-math-map-meta">
            <div><small>분석 개념</small><strong><%= studentMathMap.analyzedConceptCount %>개</strong></div>
            <div><small>데이터 부족</small><strong><%= studentMathMap.unknownConceptCount %>개</strong></div>
            <div><small>그래프</small><strong><%= studentMathMap.graphVersion %></strong></div>
            <div><small>계산 모델</small><strong><%= studentMathMap.modelVersion %></strong></div>
          </div>
          <div class="academy-math-map-legend" aria-label="숙달 상태 범례"><span class="is-mastered">숙달 80 이상</span><span class="is-developing">성장 중 50–79</span><span class="is-weak">보완 필요 50 미만</span><span class="is-unknown">Unknown 5문제 미만</span></div>
          <div class="academy-student-map-chart" data-student-math-map-chart role="img" aria-label="공식 교육과정 개념과 검수된 선수 관계를 표시한 학생 수학 능력 지도"></div>
          <p class="academy-chart-note">각 개념의 원은 규칙 기반 숙달 상태를, 선은 검수된 선수 관계를 뜻합니다. 선수 개념 점수가 후속 개념 점수를 직접 변경하지 않으며, 병목 표시는 수업 확인 우선순위를 위한 규칙 기반 신호입니다.</p>
          <% if (studentMathMap.recommendation) { const recommendation = studentMathMap.recommendation; %>
            <div class="academy-math-map-recommendation"><div><small>RULE-BASED RECOMMENDATION</small><h3><%= recommendation.conceptTitle %> 우선 학습</h3><ul><% recommendation.reasons.forEach((reason) => { %><li><%= reason %></li><% }) %></ul></div><div><strong><%= recommendation.problemMix.diagnostic ? "진단" : "복습" %> <%= recommendation.problemMix.total %>문제</strong><p><% recommendation.problemMix.difficulties.forEach((item, index) => { %><%= index ? " · " : "" %>난이도 <%= item.level %> <%= item.count %>개<% }) %><% if (recommendation.problemMix.retryCount) { %> · 이전 오답 <%= recommendation.problemMix.retryCount %>개<% } %></p><span>문제은행 자동 선택·배정은 아직 연결하지 않았습니다.</span></div></div>
          <% } %>
          <% if (studentMathMap.concepts.length) { %>
            <div class="academy-math-map-evidence">
              <% studentMathMap.concepts.forEach((concept) => { %>
                <details class="is-<%= concept.status.toLowerCase() %>">
                  <summary><span><strong><%= concept.title %></strong><small><%= concept.courseTitle %> · <%= concept.unitTitle %></small></span><b><%= concept.mastery === null ? "Unknown" : `${concept.mastery}%` %></b></summary>
                  <dl>
                    <div><dt>상태 / 신뢰도</dt><dd><%= concept.statusLabel %> / <%= concept.confidenceLabel %></dd></div>
                    <div><dt>최근 유효 풀이</dt><dd><%= concept.evidence.attemptCount %>개 (정답 <%= concept.evidence.correctCount %>개)</dd></div>
                    <div><dt>난이도 1–2</dt><dd><%= concept.evidence.lowDifficulty.correct %>/<%= concept.evidence.lowDifficulty.total %> 정답</dd></div>
                    <div><dt>난이도 3–5</dt><dd><%= concept.evidence.highDifficulty.correct %>/<%= concept.evidence.highDifficulty.total %> 정답</dd></div>
                    <div><dt>재도전 회복</dt><dd><%= concept.evidence.retryRecoveredCount %>/<%= concept.evidence.retryAttemptedCount %>개</dd></div>
                    <div><dt>문제 유형</dt><dd><%= concept.evidence.problemTypeCount %>종</dd></div>
                    <div><dt>평균 풀이 시간</dt><dd><%= concept.evidence.averageResponseTimeMs === null ? "—" : `${Math.round(concept.evidence.averageResponseTimeMs / 1000)}초` %></dd></div>
                    <div><dt>마지막 학습일</dt><dd><%= formatMapDate(concept.evidence.lastStudiedAt) %></dd></div>
                  </dl>
                  <% if (concept.prerequisites.length || concept.unlocks.length) { %><p>선수 개념 <%= concept.prerequisites.length %>개 · 연결된 후속 개념 <%= concept.unlocks.length %>개</p><% } %>
                </details>
              <% }) %>
            </div>
          <% } else { %><div class="academy-chart-empty">개념별 문제 풀이 기록이 쌓이면 수학 능력 지도가 표시됩니다.</div><% } %>
        </section>
        <script type="application/json" data-student-math-map-data><%- mathMapJson %></script>
        <section class="academy-panel academy-summary-panel academy-student-section">
          <header><div><p>MONTHLY SUMMARY</p><h2>학부모 공유용 Summary</h2></div><span class="academy-status-chip">자동 생성</span></header>
          <ul><% summaryRows.forEach((row) => { %><li><span aria-hidden="true"></span><p><strong><%= row.label %></strong><small><%= row.text %></small></p></li><% }) %></ul>
          <footer><p>현재 Summary는 위 통계만 사용한 규칙 기반 문구입니다. 선생님이 확인한 뒤 복사해 전달할 수 있으며, 학부모 직접 전송 기능은 아직 연결하지 않았습니다.</p><div><button type="button" data-copy-value="<%= summaryCopyText %>" data-copy-success="요약을 복사했습니다.">요약 복사</button><button type="button" disabled>학부모 미리보기</button></div></footer>
        </section>
        <div class="academy-copy-toast" data-copy-toast role="status" aria-live="polite" hidden>복사했습니다.</div>
      </main>
    </div>
    <script src="/js/academy.js" defer></script>
  </body>
</html>

<%
  const membership = detail.membership;
  const student = membership.studentUserId;
  const academyName = detail.academy?.name || "학원";
  const studentName = student.realName || student.name || "학생";
  const gradeLabel = ({ 10: "고1", 11: "고2", 12: "고3", 13: "N수생", 14: "대학생", 15: "직장인" })[Number(student.schoolGrade)] || "학년 미설정";
  const statCards = statistics.cards;
  const detailCards = [
    ["STRENGTH", "강점 개념", "개념별 표본 기준을 정한 뒤 2차 통계에서 연결합니다."],
    ["REVIEW", "보완 개념", "반복 오답과 개념별 정답률 분석은 2차 통계에서 연결합니다."],
    ["NEXT ACTION", "다음 학습 방향", statistics.summary.nextDirection],
  ];
  const summaryRows = statistics.summary.bullets;
  const summaryCopyText = [
    `[Matths ${statistics.period.label.replace(/ \(.+\)$/, "")} 학습 요약]`,
    `${studentName} 학생`,
    ...summaryRows.map((row) => `• ${row.label}: ${row.text}`),
  ].join("\n");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= studentName %> 학생 통계 | <%= academyName %> · Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/academy.css" />
    <link rel="stylesheet" href="/css/contrast.css" />
  </head>
  <body class="academy-page">
    <header class="academy-topbar">
      <%- include("partials/matths-brand", { href: "/academy", ariaLabel: "Matths 학원 관리 홈", className: "academy-brand", suffix: "학원 관리", compact: true }) %>
      <div class="academy-account"><span><strong><%= user.realName || user.name %></strong> 선생님</span><form action="/logout" method="POST"><button type="submit">로그아웃</button></form></div>
    </header>
    <div class="academy-layout">
      <aside class="academy-sidebar">
        <div class="academy-identity"><span aria-hidden="true"><%= academyName.slice(0, 1) %></span><div><small>ACADEMY</small><strong><%= academyName %></strong></div></div>
        <nav aria-label="학원 관리 메뉴"><a href="/academy?tab=dashboard">대시보드</a><a class="active" href="/academy?tab=students">학생 관리</a><a href="/academy?tab=requests">승인 요청 <% if (detail.pendingCount) { %><b><%= detail.pendingCount %></b><% } %></a><a href="/academy?tab=classes">반 관리</a><a href="/academy?tab=invites">초대 관리</a><a href="/academy?tab=teachers">선생님 관리</a></nav>
        <p>학생의 학습 기록은 승인된 소속 관계 안에서만 조회됩니다.</p>
      </aside>
      <main class="academy-main">
        <section class="academy-student-hero">
          <div><span class="academy-student-avatar" aria-hidden="true"><%= studentName.slice(0, 1) %></span><div><small>STUDENT LEARNING REPORT</small><h1><%= studentName %> 학생</h1><p><%= student.school?.name || "학교 미설정" %> · <%= gradeLabel %> · <%= membership.classId?.name || "반 미배정" %></p></div></div>
          <a href="/academy?tab=students">학생 목록 <span>→</span></a>
        </section>
        <section class="academy-report-toolbar" aria-label="보고서 기간 선택">
          <div><small>MONTHLY REPORT</small><strong><%= statistics.period.label %> 학습 기록</strong><p>한국 시간 기준으로 승인된 학생의 학습 기록만 집계합니다.</p></div>
          <form class="academy-period" action="/academy/students/<%= membership._id %>" method="GET">
            <label for="academy-report-period">조회 기간</label>
            <div><select id="academy-report-period" name="period"><% statistics.period.options.forEach((option) => { %><option value="<%= option.key %>" <%= option.key === statistics.period.key ? "selected" : "" %>><%= option.label %></option><% }) %></select><button type="submit">조회</button></div>
          </form>
        </section>
        <div class="academy-integration-notice" role="status"><span aria-hidden="true">i</span><p><strong>통계 기준</strong> 문제 수는 중복을 제외하고, 정답률은 첫 제출만 계산합니다. 오답 복습률은 해당 기간에 발생한 오답이 그 기간 안에 완료됐는지를 기준으로 합니다.</p></div>
        <section class="academy-stat-grid academy-student-stat-grid" aria-label="학생 학습 통계">
          <% statCards.forEach((card) => { %><article><small><%= card.label %></small><strong><%= card.value %></strong><span><%= card.detail %></span></article><% }) %>
        </section>
        <section class="academy-placeholder-detail">
          <% detailCards.forEach((card) => { %><article><small><%= card[0] %></small><h2><%= card[1] %></h2><p><%= card[2] %></p></article><% }) %>
        </section>
        <section class="academy-panel academy-summary-panel academy-student-section">
          <header><div><p>MONTHLY SUMMARY</p><h2>학부모 공유용 Summary</h2></div><span class="academy-status-chip">자동 생성</span></header>
          <ul><% summaryRows.forEach((row) => { %><li><span aria-hidden="true"></span><p><strong><%= row.label %></strong><small><%= row.text %></small></p></li><% }) %></ul>
          <footer><p>현재 Summary는 위 통계만 사용한 규칙 기반 문구입니다. 선생님이 확인한 뒤 복사해 전달할 수 있으며, 학부모 직접 전송 기능은 아직 연결하지 않았습니다.</p><div><button type="button" data-copy-value="<%= summaryCopyText %>" data-copy-success="요약을 복사했습니다.">요약 복사</button><button type="button" disabled>학부모 미리보기</button></div></footer>
        </section>
        <div class="academy-copy-toast" data-copy-toast role="status" aria-live="polite" hidden>복사했습니다.</div>
      </main>
    </div>
    <script src="/js/academy.js" defer></script>
  </body>
</html>

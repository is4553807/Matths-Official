<%
  const health = {
    HEALTHY: { label: "정상", description: "현재 검사 범위에서 비동기 경기·기록 풀 불일치가 없습니다." },
    REVIEW_RECOMMENDED: { label: "확인 권장", description: "정리 작업이 지연된 데이터가 있습니다." },
    ACTION_REQUIRED: { label: "조치 필요", description: "경기 결과 또는 무결성 정책에 영향을 줄 수 있는 불일치가 있습니다." },
  }[audit.health];
  const formatKst = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "medium", timeStyle: "medium" }).format(new Date(value))
    : "기록 없음";
  const number = (value) => Number(value || 0).toLocaleString("ko-KR");
  const signature = [audit.health, audit.summary.criticalCount, audit.summary.warningCount, ...audit.issues.map((issue) => `${issue.key}:${issue.count}`)].join(":");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena 비동기 경기와 기록 원장 감사" />
    <title>Arena 데이터 감사 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/admin-arena-audit.js" defer></script>
  </head>
  <body class="admin-page" data-arena-audit data-audit-signature="<%= signature %>">
    <%- include("partials/admin-navigation", { activePage: "arena-audit" }) %>
    <main class="admin-main">
      <header class="admin-heading arena-audit-heading">
        <div>
          <p>ARENA DATA AUDIT</p>
          <h1>Arena 데이터 감사</h1>
          <span>과거 기록 매칭, MMR 정산, 배치 상태, 게스트 링크와 모드별 무결성 적용 상태를 읽기 전용으로 검사합니다.</span>
        </div>
        <div class="arena-audit-refresh"><small data-audit-poll-status>30초마다 변경 여부 확인</small><button type="button" data-audit-refresh>지금 다시 검사</button></div>
      </header>

      <section class="arena-audit-health is-<%= audit.health.toLowerCase() %>" aria-live="polite">
        <div><small>현재 상태</small><strong><%= health.label %></strong></div>
        <p><%= health.description %></p>
        <time datetime="<%= new Date(audit.generatedAt).toISOString() %>">최근 검사 <%= formatKst(audit.generatedAt) %> KST</time>
      </section>

      <section class="admin-stat-grid arena-audit-stats" aria-label="Arena 감사 요약">
        <article class="is-critical"><span>즉시 확인</span><strong><%= number(audit.summary.criticalCount) %></strong><small>경기·무결성 불일치</small></article>
        <article class="is-warning"><span>확인 권장</span><strong><%= number(audit.summary.warningCount) %></strong><small>만료 상태 정리 지연</small></article>
        <article><span>진행 중 경기</span><strong><%= number(audit.summary.activeMatches) %></strong><small>모든 모드 합계</small></article>
        <article><span>경쟁전 MMR 정산</span><strong><%= number(audit.summary.ratingSettlements) %></strong><small>경기당 1회 원장</small></article>
      </section>

      <section class="admin-panel arena-audit-scope">
        <div class="admin-panel-heading"><div><p>RECORD INVENTORY</p><h2>운영 데이터 범위</h2></div><a href="/admin/arena-policies">운영 설정 보기 →</a></div>
        <div class="arena-audit-scope-grid">
          <article><small>사용 가능한 일반전 기록</small><strong><%= number(audit.summary.availableNormalRecords) %>건</strong></article>
          <article><small>사용 가능한 경쟁전 기록</small><strong><%= number(audit.summary.availableCompetitiveRecords) %>건</strong></article>
          <article><small>배치 완료 프로필</small><strong><%= number(audit.summary.placedProfiles) %>명</strong></article>
          <article><small>배치 검토 대기</small><strong><%= number(audit.overview.placementReviewQueue.length) %>명</strong></article>
        </div>
      </section>

      <section class="admin-panel arena-audit-issues">
        <div class="admin-panel-heading"><div><p>ISSUES</p><h2>확인할 항목</h2></div><span>자동 수정하지 않음</span></div>
        <% if (!audit.issues.length) { %>
          <div class="arena-audit-empty"><span aria-hidden="true">✓</span><strong>현재 불일치가 없습니다.</strong><p>새 경기와 배치·게스트 링크가 처리된 뒤에도 이 화면에서 계속 확인할 수 있습니다.</p></div>
        <% } else { %>
          <div class="arena-audit-issue-list">
            <% audit.issues.forEach((issue) => { %>
              <article class="is-<%= issue.severity %>">
                <header><div><span><%= issue.severity === "critical" ? "즉시 확인" : "확인 권장" %></span><small><%= issue.key %></small></div><b><%= number(issue.count) %>건</b></header>
                <h3><%= issue.title %></h3><p><%= issue.detail %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>CONTROL BOUNDARIES</p><h2>자동 검사 기준</h2></div></div>
        <div class="admin-table-wrap"><table><thead><tr><th>대상</th><th>정상 기준</th></tr></thead><tbody>
          <tr><td>일반전·경쟁전</td><td>모든 진행 경기에는 예약된 과거 기록이 연결되어야 합니다.</td></tr>
          <tr><td>과거 기록</td><td>예약 만료 시 다시 사용 가능한 상태로 복구되어야 합니다.</td></tr>
          <tr><td>친선전·게스트 친선전</td><td>풀이 업로드는 필수지만 부정행위 검토 대상으로 만들지 않습니다.</td></tr>
          <tr><td>배치고사</td><td>서버 오류 복구와 운영자 초기화는 별도 승인 원장으로 보존합니다.</td></tr>
          <tr><td>경쟁전 정산</td><td>과거 상대는 변경하지 않고 현재 응시자의 MMR만 경기당 한 번 갱신합니다.</td></tr>
        </tbody></table></div>
      </section>
    </main>
  </body>
</html>

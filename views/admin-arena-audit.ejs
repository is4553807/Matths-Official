<%
  const healthCopy = {
    HEALTHY: {
      label: "정상",
      description: "현재 검사 범위에서 잔액·경기·초대 불일치가 발견되지 않았습니다.",
    },
    REVIEW_RECOMMENDED: {
      label: "확인 권장",
      description: "즉시 데이터 손상을 뜻하지는 않지만 운영자가 확인할 항목이 있습니다.",
    },
    ACTION_REQUIRED: {
      label: "조치 필요",
      description: "사용자 권리나 경기 결과에 영향을 줄 수 있는 불일치가 발견되었습니다.",
    },
  }[audit.health];
  const categoryLabels = {
    BALANCE: "학습일수",
    MATCH: "경기 상태",
    STANDING: "Arena 상태",
    INVITATION: "초대",
    OUTBOX: "처리 대기 이벤트",
    SHOP: "Ranked 상점",
    SCOPE: "검사 범위",
  };
  const formatKst = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", {
        timeZone: "Asia/Seoul",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      }).format(new Date(value))
    : "시각 없음";
  const signature = [
    audit.health,
    audit.summary.criticalCount,
    audit.summary.warningCount,
    audit.summary.pendingOutboxCount,
    audit.summary.checkedCycles,
    audit.summary.checkedMatches,
    audit.summary.checkedInvitations,
    audit.summary.checkedLocks,
    audit.scope.truncated,
    ...audit.issues.map((issue) => [
      issue.severity,
      issue.category,
      issue.entityId,
      issue.title,
      issue.observedAt ? new Date(issue.observedAt).toISOString() : "",
    ].join("~")),
  ].join(":");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena 원장과 경기 상태 감사" />
    <title>Arena 감사 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/admin-arena-audit.js" defer></script>
  </head>
  <body
    class="admin-page"
    data-arena-audit
    data-audit-signature="<%= signature %>"
  >
    <%- include("partials/admin-navigation", { activePage: "arena-audit" }) %>

    <main class="admin-main">
      <header class="admin-heading arena-audit-heading">
        <div>
          <p>ARENA RECONCILIATION</p>
          <h1>Arena 감사</h1>
          <span>학습일수 원장, 경기 결과, Arena 상태 교환, 초대 수락과 Ranked 상점 구매·효과를 읽기 전용으로 대사합니다.</span>
        </div>
        <div class="arena-audit-refresh">
          <small data-audit-poll-status>30초마다 변경 여부 확인</small>
          <button type="button" data-audit-refresh>지금 다시 검사</button>
        </div>
      </header>

      <section class="arena-audit-health is-<%= audit.health.toLowerCase() %>" aria-live="polite">
        <div>
          <small>현재 상태</small>
          <strong><%= healthCopy.label %></strong>
        </div>
        <p><%= healthCopy.description %></p>
        <time datetime="<%= new Date(audit.generatedAt).toISOString() %>">최근 검사 <%= formatKst(audit.generatedAt) %> KST</time>
      </section>

      <section class="admin-stat-grid arena-audit-stats" aria-label="감사 결과 요약">
        <article class="is-critical">
          <span>즉시 확인</span>
          <strong><%= audit.summary.criticalCount %></strong>
          <small>잔액·경기 결과에 영향을 줄 수 있는 항목</small>
        </article>
        <article class="is-warning">
          <span>확인 권장</span>
          <strong><%= audit.summary.warningCount %></strong>
          <small>처리 지연 또는 검사 범위 안내</small>
        </article>
        <article>
          <span>검사한 이용 주기</span>
          <strong><%= audit.summary.checkedCycles %></strong>
          <small>활성 전체와 최근 종료 주기</small>
        </article>
        <article>
          <span>검사한 경기</span>
          <strong><%= audit.summary.checkedMatches %></strong>
          <small>미정산 전체와 최근 종료 경기</small>
        </article>
      </section>

      <section class="admin-panel arena-audit-scope">
        <div class="admin-panel-heading">
          <div><p>CHECKED SCOPE</p><h2>검사 범위</h2></div>
          <span><%= audit.scope.truncated ? "최근 데이터 중심" : "전체 범위" %></span>
        </div>
        <div class="arena-audit-scope-grid">
          <article><small>Ranked 초대</small><strong><%= audit.summary.checkedInvitations %>건</strong></article>
          <article><small>경기 참가 잠금</small><strong><%= audit.summary.checkedLocks %>건</strong></article>
          <article><small>처리 대기 이벤트</small><strong><%= audit.summary.pendingOutboxCount %>건</strong></article>
          <article><small>Ranked 상점 구매·효과</small><strong><%= audit.summary.checkedShopPurchases %> / <%= audit.summary.checkedShopEffects %>건</strong></article>
          <article><small>표시 중인 이상 항목</small><strong><%= audit.summary.displayedIssueCount %> / <%= audit.summary.issueCount %>건</strong></article>
        </div>
        <% if (Object.keys(audit.summary.byCategory || {}).length) { %>
          <div class="arena-audit-category-list" aria-label="분류별 이상 항목">
            <% Object.entries(audit.summary.byCategory).forEach(([category, count]) => { %>
              <span><%= categoryLabels[category] || "기타" %> <b><%= count %></b></span>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="admin-panel arena-audit-issues">
        <div class="admin-panel-heading">
          <div><p>ISSUES</p><h2>확인할 항목</h2></div>
          <span>자동 수정하지 않음</span>
        </div>
        <% if (!audit.issues.length) { %>
          <div class="arena-audit-empty">
            <span aria-hidden="true">✓</span>
            <strong>현재 불일치가 없습니다.</strong>
            <p>새 경기·결제·초대 처리 후에도 이 화면에서 계속 확인할 수 있습니다.</p>
          </div>
        <% } else { %>
          <div class="arena-audit-issue-list">
            <% audit.issues.forEach((issue) => { %>
              <article class="is-<%= issue.severity %>">
                <header>
                  <div>
                    <span><%= issue.severity === "critical" ? "즉시 확인" : "확인 권장" %></span>
                    <small><%= issue.categoryLabel %></small>
                  </div>
                  <time datetime="<%= issue.observedAt ? new Date(issue.observedAt).toISOString() : "" %>"><%= formatKst(issue.observedAt) %></time>
                </header>
                <h3><%= issue.title %></h3>
                <p><%= issue.detail %></p>
                <footer>
                  <% if (issue.entityId) { %><small>연결 ID <%= issue.entityId %></small><% } %>
                  <% if (issue.href) { %><a href="<%= issue.href %>">관련 경기 확인 →</a><% } %>
                </footer>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="admin-panel ranking-operations" id="ranking-operations">
        <div class="admin-panel-heading">
          <div><p>RANKING HEALTH</p><h2>랭킹 운영 상태</h2></div>
          <span class="ranking-health-badge is-<%= rankingOperations.health.status.toLowerCase() %>"><%= rankingOperations.health.status === "HEALTHY" ? "정상" : "확인 필요" %></span>
        </div>
        <% if (operationFeedback) { %><p class="admin-operation-feedback"><%= operationFeedback %></p><% } %>
        <div class="admin-stat-grid arena-audit-stats">
          <article><span>활성 최종 종합 랭킹</span><strong><%= rankingOperations.health.activeProfileCount %></strong><small>현재 공개 대상</small></article>
          <article><span>중복 순위</span><strong><%= rankingOperations.health.duplicateRanks.length %></strong><small>동일 순위가 두 번 이상 존재</small></article>
          <article><span>누락 순위</span><strong><%= rankingOperations.health.missingRanks.length %></strong><small>1위부터 활성 인원 사이 빈 번호</small></article>
          <article><span>15분 이상 계산 지연</span><strong><%= rankingOperations.health.staleCount %></strong><small>최근 계산 시각 기준</small></article>
        </div>
        <% if (rankingOperations.health.alerts.length) { %>
          <div class="ranking-operations-alerts"><% rankingOperations.health.alerts.forEach((alert) => { %><p><span>!</span><%= alert %></p><% }) %></div>
        <% } %>
        <div class="ranking-operation-actions">
          <a href="/admin/arena-audit?preview=1#ranking-preview">재계산 결과 미리보기</a>
          <a href="/admin/arena-audit/ranking.csv">CSV 내보내기</a>
          <form action="/admin/arena-audit/ranking/rebuild" method="POST" onsubmit="return confirm('현재 데이터를 기준으로 최종 종합 랭킹을 다시 계산할까요?');"><button type="submit">랭킹 다시 계산</button></form>
        </div>
      </section>

      <% if (rankingOperations.recalculationPreview) { %>
        <section class="admin-panel ranking-preview" id="ranking-preview">
          <div class="admin-panel-heading"><div><p>DRY RUN</p><h2>재계산 미리보기</h2></div><span>DB 변경 없음 · <%= rankingOperations.recalculationPreview.changedCount %>명 변동</span></div>
          <% if (!rankingOperations.recalculationPreview.changes.length) { %><div class="arena-audit-empty"><strong>현재 랭킹과 계산 결과가 같습니다.</strong></div><% } else { %>
            <div class="ranking-history-table"><div class="ranking-history-row is-head"><span>사용자</span><span>기존 순위</span><span>예상 순위</span><span>점수 변화</span></div>
              <% rankingOperations.recalculationPreview.changes.forEach((change) => { %><div class="ranking-history-row"><strong><%= change.user?.realName || change.user?.name || change.userId %></strong><span><%= change.beforeRank || "신규" %>위</span><span><%= change.afterRank %>위</span><span><%= change.beforeRating ?? "-" %> → <%= change.afterRating %></span></div><% }) %>
            </div>
          <% } %>
        </section>
      <% } %>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>RANKING HISTORY</p><h2>최근 순위 변경 원장</h2></div><span>경기별 이전·이후 값</span></div>
        <div class="ranking-history-table"><div class="ranking-history-row is-head"><span>사용자</span><span>변경 전</span><span>변경 후</span><span>발생 시각</span></div>
          <% rankingOperations.history.forEach((entry) => { %><div class="ranking-history-row"><strong><%= entry.user?.realName || entry.user?.name || "사용자" %><small>경기 <%= entry.matchId %></small></strong><span><%= entry.before.arenaRank %> · <%= entry.before.arenaPosition %>위 · <%= entry.before.arenaGp %> GP</span><span><%= entry.after.arenaRank %> · <%= entry.after.arenaPosition %>위 · <%= entry.after.arenaGp %> GP</span><time><%= formatKst(entry.occurredAt) %></time></div><% }) %>
        </div>
      </section>

      <section class="admin-panel operations-status" id="operations-status">
        <div class="admin-panel-heading"><div><p>OPERATIONS</p><h2>외부 연결·재처리</h2></div><span>기존 로직 수동 재실행</span></div>
        <div class="operations-status-grid">
          <article><small>파일 저장소</small><strong>로컬 + Cloudinary 분리 저장</strong><span><%= rankingOperations.operations.storage.productionSafe ? "운영 준비 완료" : "영구 디스크 설정 필요" %> · 디스크 <%= rankingOperations.operations.storage.localCapacity.usedPercent == null ? "확인 불가" : `${rankingOperations.operations.storage.localCapacity.usedPercent}%` %> · R2 백업 <%= rankingOperations.operations.storage.r2BackupConfigured ? "연결됨" : "미연결" %></span></article>
          <article><small>이메일</small><strong><%= rankingOperations.operations.emailConfigured ? "연결됨" : "설정 필요" %></strong><span>SMTP 환경 변수</span></article>
          <article><small>공유 세션</small><strong><%= rankingOperations.operations.sharedSessionConfigured ? "연결됨" : "미연결" %></strong><span>다중 서버 배포 전 필요</span></article>
          <article><small>스케줄러</small><strong><%= rankingOperations.operations.schedulerEnabled ? "실행 허용" : "중지됨" %></strong><span>시즌·차감·알림 작업</span></article>
        </div>
        <div class="maintenance-actions">
          <% [["SETTLEMENT_RETRY", "대기 경기 정산 재처리"], ["ACCESS_CYCLE_RETRY", "일일 차감·만료 재처리"], ["NOTIFICATION_RETRY", "종료 예정 알림 재처리"], ["SEASON_RETRY", "시즌 작업 재처리"], ["STORAGE_BACKUP", "운영자 파일 R2 백업"], ["STORAGE_RESTORE_DRILL", "R2 복원 점검·누락 복구"]].forEach(([task, label]) => { %>
            <form action="/admin/arena-audit/maintenance" method="POST"><input type="hidden" name="task" value="<%= task %>" /><button type="submit"><%= label %></button></form>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

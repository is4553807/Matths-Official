<%
  const formatDateTime = (value) => value ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "medium", timeStyle: "medium" }).format(new Date(value)) : "기록 없음";
  const elapsedLabel = (value) => {
    if (!value) return "기록 없음";
    const seconds = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 1000));
    return seconds < 60 ? `${seconds}초 전` : seconds < 3600 ? `${Math.floor(seconds / 60)}분 전` : `${Math.floor(seconds / 3600)}시간 전`;
  };
  const remainingLabel = (value) => {
    if (!value) return "기한 없음";
    const seconds = Math.floor((new Date(value).getTime() - Date.now()) / 1000);
    return seconds <= 0 ? `${Math.max(1, Math.ceil(Math.abs(seconds) / 60))}분 지남` : seconds < 3600 ? `${Math.ceil(seconds / 60)}분 남음` : `${Math.ceil(seconds / 3600)}시간 남음`;
  };
  const modeLabel = { NORMAL: "일반전", COMPETITIVE: "경쟁전", FRIENDLY: "친선전" };
  const participantName = (participant) => participant.nickname || participant.realName || participant.email || participant.id || "확인 필요";
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena에서 현재 진행 중인 경기 상태" />
    <title>진행 중인 경기 | Matths 운영센터</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" /><link rel="stylesheet" href="/css/admin.css" /><link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "arena-live-matches" }) %>
    <main class="admin-main admin-arena-live-matches">
      <header class="admin-heading">
        <div><p>LIVE MATCH MONITOR</p><h1>진행 중인 경기</h1><span>비동기 과거 기록 대결과 친선전의 현재 응시자·풀이 업로드·운영 검토 상태를 확인합니다.</span></div>
        <strong><%= liveMatches.stats.total %><small>진행 경기</small></strong>
      </header>
      <section class="arena-live-toolbar" aria-label="갱신 정보"><div><span class="arena-live-pulse" aria-hidden="true"></span><strong>15초마다 자동 갱신</strong><small>마지막 조회 <%= formatDateTime(liveMatches.generatedAt) %></small></div><a href="/admin/arena-live-matches">지금 새로고침</a></section>
      <section class="admin-stat-grid arena-live-stats" aria-label="진행 경기 요약">
        <article><span>현재 풀이 중</span><strong><%= liveMatches.stats.live %><small>건</small></strong></article>
        <article><span>시작 대기</span><strong><%= liveMatches.stats.waiting %><small>건</small></strong></article>
        <article><span>연결 확인</span><strong><%= liveMatches.stats.stale %><small>건</small></strong></article>
        <article><span>풀이 업로드 대기</span><strong><%= liveMatches.stats.evidence %><small>건</small></strong></article>
        <article><span>운영 검토</span><strong><%= liveMatches.stats.held %><small>건</small></strong></article>
        <article><span>결과 처리 대기</span><strong><%= liveMatches.stats.settlement %><small>건</small></strong></article>
      </section>
      <% if (!liveMatches.matches.length) { %><section class="admin-panel arena-live-empty"><span aria-hidden="true">✓</span><h2>현재 진행 중인 경기가 없습니다.</h2><p>새 경기가 시작되면 이 화면에 자동으로 나타납니다.</p></section><% } %>
      <section class="arena-live-grid" aria-label="진행 중인 경기 목록">
        <% liveMatches.matches.forEach((match) => { const activeAttempt = match.attempts.find((attempt) => attempt.userId === match.currentPlayer.id) || match.attempts[0] || null; %>
          <article class="admin-panel arena-live-card is-<%= match.stage.key.toLowerCase() %>">
            <header><div><span><%= modeLabel[match.mode] || match.mode %> · <%= match.asynchronous ? "과거 기록 대결" : "실시간 참가자 대결" %></span><h2><%= match.tierPairLabel || "현재 규칙 기준 경기" %></h2><small>경기 ID <%= match.id %></small></div><b class="arena-live-status is-<%= match.stage.key.toLowerCase() %>"><%= match.stage.label %></b></header>
            <div class="arena-live-participants">
              <section><span>현재 응시자</span><strong><%= participantName(match.currentPlayer) %></strong><small><%= match.currentPlayer.email || "이메일 미등록" %></small></section>
              <span class="arena-live-versus" aria-hidden="true">VS</span>
              <section><span><%= match.opponentKind === "HISTORICAL_RECORD" ? "과거 기록 소유자" : "상대 참가자" %></span><strong><%= participantName(match.opponent) %></strong><small><%= match.opponentKind === "HISTORICAL_RECORD" ? "이미 확정된 기록 · 재응시 없음" : (match.opponent.email || "이메일 미등록") %></small></section>
            </div>
            <div class="arena-live-progress">
              <div><span>현재 진행</span><strong><%= activeAttempt?.currentQuestion ? `${activeAttempt.currentQuestion}/5번 문제` : activeAttempt?.statusLabel || "시작 전" %></strong><small>입력 답안 <%= activeAttempt?.answeredCount || 0 %>개</small></div>
              <div><span>최근 활동</span><strong><%= elapsedLabel(activeAttempt?.lastHeartbeatAt) %></strong><small><%= formatDateTime(activeAttempt?.lastHeartbeatAt) %></small></div>
              <div class="<%= match.deadlineOverdue ? 'is-overdue' : '' %>"><span>현재 단계 기한</span><strong><%= remainingLabel(match.deadlineAt) %></strong><small><%= formatDateTime(match.deadlineAt) %></small></div>
            </div>
            <footer><span>경기 상태 <b><%= match.status %></b></span><span>성립 <%= formatDateTime(match.requestedAt) %></span><span>시작 <%= formatDateTime(match.startedAt) %></span></footer>
          </article>
        <% }) %>
      </section>
    </main>
    <script>window.setInterval(() => { if (document.visibilityState === "visible") window.location.reload(); }, <%= Number(liveMatches.refreshIntervalSeconds || 15) * 1000 %>);</script>
  </body>
</html>

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena 경기 풀이 증거와 무결성 검토 관리" />
    <title>Arena 경기·무결성 관리 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [["$", "$"], ["\\(", "\\)"]],
          displayMath: [["\\[", "\\]"]],
          processEscapes: true,
        },
        options: {
          skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"],
        },
      };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-svg.js" defer></script>
  </head>
  <body class="admin-page">
    <%
      const arenaSeconds = (value) => value == null ? "기록 없음" : `${(Number(value) / 1000).toFixed(1)}초`;
      const arenaDate = (value) => value ? new Date(value).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) : "-";
      const arenaRole = (value) => value === "CHALLENGER" ? "공격자" : "방어자";
      const arenaAnomalyLabel = (value) => ({
        FAST_COMPLETION_UNDER_FIVE_MINUTES: "전체 풀이시간 5분 미만",
        MULTIPLE_RAPID_CORRECT_ANSWERS: "1분 이내 정답 문항 3개 이상",
        VERY_SMALL_EVIDENCE_FILE: "비정상적으로 작은 증거 파일",
        REPEATED_FOCUS_LOSS: "화면 이탈 5회 이상",
        MATCH_PAGE_EXITED: "경기 중 문제 화면 이탈",
        SAME_EVIDENCE_AS_OPPONENT: "상대와 동일한 증거 파일",
      }[value] || value);
    %>
    <%- include("partials/admin-navigation", { activePage: "arena-matches" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div>
          <p>GOAT ARENA</p>
          <h1>Arena 경기·무결성 관리</h1>
          <span>풀이 증거와 장기 계정·경기 연관 신호를 확인하고, 자동 제재 없이 운영자가 최종 판단합니다.</span>
        </div>
      </header>

      <section class="admin-stat-grid" aria-label="Arena 증거 요약">
        <article><span>전체 제출</span><strong><%= evidenceEntries.length %></strong></article>
        <article><span>이상 징후</span><strong><%= evidenceEntries.filter((entry) => entry.status === "ANOMALY_FLAGGED").length %></strong></article>
        <article><span>정상 제출</span><strong><%= evidenceEntries.filter((entry) => entry.status === "ON_TIME").length %></strong></article>
      </section>

      <section id="integrity-review" class="admin-panel arena-integrity-review">
        <div class="admin-panel-heading">
          <div>
            <p>INTEGRITY REVIEW</p>
            <h2>계정·경기 연관성 검토</h2>
          </div>
          <span class="arena-integrity-count"><%= reviewStatus === "completed" ? `${integrityReview.completedCount}건 처리 완료` : `${integrityReview.heldCount + integrityReview.openCount}건 처리 필요` %></span>
        </div>
        <p class="arena-integrity-guidance">
          기기·네트워크·결제·페이백 연관 신호와 경기 패턴을 함께 살핍니다. 원본 기기·네트워크 정보는 저장하거나 표시하지 않으며, 위험 점수만으로 계정을 자동 제재하지 않습니다.
        </p>
        <% if (adminNotice) { %>
          <p class="arena-integrity-success-notice" role="status"><%= adminNotice %></p>
        <% } %>
        <nav class="admin-todo-status-tabs arena-integrity-status-tabs" aria-label="무결성 검토 상태">
          <a class="<%= reviewStatus === 'pending' ? 'active' : '' %>" href="/admin/arena-matches?reviewStatus=pending#integrity-review" <%= reviewStatus === "pending" ? 'aria-current="page"' : '' %>>처리 필요 <span><%= integrityReview.heldCount + integrityReview.openCount %></span></a>
          <a class="<%= reviewStatus === 'completed' ? 'active' : '' %>" href="/admin/arena-matches?reviewStatus=completed#integrity-review" <%= reviewStatus === "completed" ? 'aria-current="page"' : '' %>>처리 완료 <span><%= integrityReview.completedCount %></span></a>
        </nav>
        <% if (reviewStatus === "pending") { %>
        <div class="arena-held-match-grid">
          <% integrityReview.heldMatches.forEach((match) => { %>
            <% const attemptsFinished = match.attempts.length === 2 && match.attempts.every((attempt) => attempt.status === "SUBMITTED" || (attempt.status === "EVIDENCE_REQUIRED" && Number(attempt.currentQuestionIndex || 0) >= 5)); %>
            <% const matchComplete = attemptsFinished && match.attempts.every((attempt) => attempt.status === "SUBMITTED" && attempt.evidence); %>
            <% const hasActiveSupplementalRequest = match.attempts.some((attempt) => attempt.evidence?.supplementalRequest?.status === "REQUESTED" && attempt.evidence.supplementalRequest.deadlineAt && new Date(attempt.evidence.supplementalRequest.deadlineAt).getTime() > Date.now()); %>
            <% const screenedAttempt = match.attempts.find((attempt) => attempt.evidence?.screenedAsWinner) || match.attempts.find((attempt) => attempt.role === match.integrityScreenedRole); %>
            <% const screenedRole = screenedAttempt?.role || match.integrityScreenedRole || ""; %>
            <% const reviewOverdue = match.integrityReviewDeadlineAt && new Date(match.integrityReviewDeadlineAt).getTime() < Date.now(); %>
            <details id="match-<%= match.id %>" class="arena-held-match-card" data-arena-review-details>
              <summary class="arena-held-match-overview">
                <span class="arena-held-match-overview-header">
                  <span>
                    <small><%= match.division === "MAIN" ? "RANKED" : "UNRANKED" %> · <%= match.matchType === "REVENGE" ? "복수전" : match.matchType === "FRIENDLY" ? "친선 경기" : "일반 쟁탈전" %></small>
                    <strong class="arena-held-match-tier-pair"><%= match.tierPairLabel || "티어 조합 확인 필요" %></strong>
                    <span><%= match.todo?.title || "경기 정산 보류" %></span>
                  </span>
                  <b><%= match.integrityStatus || "PENDING" %></b>
                </span>
                <span class="arena-held-match-description"><%= match.todo?.description || "자동 정산 전에 운영자 확인이 필요한 경기입니다." %></span>
                <span class="arena-held-match-summary" role="list">
                  <span role="listitem"><small>공격자</small><strong><%= match.challengerUser?.realName || match.challengerUser?.name || match.challengerUser?.email || "확인 필요" %></strong></span>
                  <span role="listitem"><small>방어자</small><strong><%= match.defenderUser?.realName || match.defenderUser?.name || match.defenderUser?.email || "확인 필요" %></strong></span>
                  <span role="listitem"><small>문제 팩</small><strong><%= match.problemPack?.displayName || match.problemPack?.version || "문제 팩 없음" %></strong></span>
                  <% match.attempts.forEach((attempt) => { %>
                    <span role="listitem"><small><%= attempt.role === "CHALLENGER" ? "공격자 응시" : "방어자 응시" %></small><strong><%= attempt.status %> · <%= attempt.currentQuestionIndex %>/5</strong></span>
                  <% }) %>
                </span>
              </summary>
              <div class="arena-held-match-expanded">
                <div class="arena-integrity-review-deadline <%= reviewOverdue ? 'is-overdue' : '' %>">
                  <span>내부 자동 신호 확인 대상 <b><%= screenedRole ? arenaRole(screenedRole) : "확인 필요" %></b></span>
                  <span>검토 시작 <b><%= arenaDate(match.integrityReviewStartedAt) %></b></span>
                  <span>24시간 목표 <b><%= arenaDate(match.integrityReviewDeadlineAt) %></b></span>
                  <% if (reviewOverdue) { %><strong>검토 목표 시간이 지났습니다. 무혐의 판정 시 실제 정지 시간 전체를 이용 기간에 보상합니다.</strong><% } %>
                </div>
                <section class="arena-supplemental-review-board">
                  <header>
                    <div><small>SUPPLEMENTAL EVIDENCE</small><h3>추가 소명 자료</h3></div>
                    <p>요청 버튼을 누른 시점부터 24시간을 계산합니다. 기한 안에 응답이 없으면 해당 참가자의 소명 자료는 미제출로 확정됩니다.</p>
                  </header>
                  <div class="arena-supplemental-review-grid">
                    <% match.attempts.forEach((attempt) => { %>
                      <% const supplemental = attempt.evidence?.supplementalRequest || { status: "NONE", files: [] }; %>
                      <% const supplementalDeadlineMs = supplemental.deadlineAt ? new Date(supplemental.deadlineAt).getTime() : 0; %>
                      <% const supplementalExpired = supplemental.status === "EXPIRED" || (supplemental.status === "REQUESTED" && supplementalDeadlineMs > 0 && supplementalDeadlineMs <= Date.now()); %>
                      <% const supplementalActive = supplemental.status === "REQUESTED" && !supplementalExpired; %>
                      <article
                        class="arena-supplemental-review-card <%= supplemental.status === 'SUBMITTED' ? 'is-submitted' : supplementalExpired ? 'is-expired' : supplementalActive ? 'is-active' : '' %>"
                        data-admin-supplemental-card
                      >
                        <header>
                          <div><small><%= arenaRole(attempt.role) %></small><strong><%= attempt.user?.realName || attempt.user?.name || attempt.user?.email || "사용자" %></strong></div>
                          <b data-admin-supplemental-status><%= supplemental.status === "SUBMITTED" ? "제출 완료" : supplementalExpired ? "추가 소명자료 미제출" : supplementalActive ? "제출 대기" : "미요청" %></b>
                        </header>
                        <% if (supplemental.requestedAt) { %>
                          <dl>
                            <div><dt>요청 시각</dt><dd><%= arenaDate(supplemental.requestedAt) %></dd></div>
                            <div><dt>제출 마감</dt><dd><%= arenaDate(supplemental.deadlineAt) %></dd></div>
                          </dl>
                        <% } %>
                        <% if (supplementalActive) { %>
                          <div class="arena-admin-supplemental-timer" data-admin-supplemental-timer data-deadline="<%= new Date(supplemental.deadlineAt).toISOString() %>" data-server-now="<%= new Date().toISOString() %>">
                            <small>남은 응답 시간</small><strong>24:00:00</strong>
                          </div>
                        <% } %>
                        <% if (supplemental.requestMessage) { %><p class="arena-supplemental-request-message"><%= supplemental.requestMessage %></p><% } %>
                        <% if (supplemental.files?.length) { %>
                          <div class="arena-admin-evidence-files">
                            <% supplemental.files.forEach((file, index) => { %>
                              <a href="/admin/arena-matches/evidence/<%= attempt.evidence._id %>/<%= encodeURIComponent(file.storedName) %>" target="_blank" rel="noopener"><span><%= arenaRole(attempt.role) %> 소명 자료 <%= index + 1 %></span><small><%= file.originalName %></small></a>
                            <% }) %>
                          </div>
                        <% } %>
                        <% if (supplemental.status === "NONE") { %>
                          <% if (!attempt.evidence || attempt.evidence.originalEvidenceSubmitted === false) { %><p class="arena-supplemental-unavailable">필수 풀이 증거는 미제출 상태입니다. 추가 소명 자료는 별도로 요청할 수 있습니다.</p><% } %>
                          <form method="post" action="/admin/arena-matches/<%= match.id %>/supplemental-evidence/<%= attempt.role %>/request" class="arena-supplemental-request-form">
                            <label><span><%= arenaRole(attempt.role) %>에게 전달할 요청 사유</span><textarea name="requestMessage" rows="2" maxlength="500" placeholder="추가로 확인할 풀이 단계나 자료를 안내해 주세요."></textarea></label>
                            <button type="submit" class="admin-secondary-button"><%= arenaRole(attempt.role) %>에게 추가 소명 자료 요청</button>
                          </form>
                        <% } %>
                      </article>
                    <% }) %>
                  </div>
                </section>
                <div class="arena-match-investigation">
                <% match.attempts.forEach((attempt) => { %>
                  <details class="arena-attempt-review" open>
                    <summary>
                      <span><%= arenaRole(attempt.role) %> · <%= attempt.user?.realName || attempt.user?.name || attempt.user?.email || "사용자" %></span>
                      <b><%= attempt.correctCount ?? "-" %>/5 · <%= arenaSeconds(attempt.activeSolveTimeMs) %></b>
                    </summary>
                    <div class="arena-attempt-meta">
                      <span>상태 <b><%= attempt.status %></b></span>
                      <span>제출 <b><%= arenaDate(attempt.submittedAt) %></b></span>
                      <span>증거 <b><%= attempt.evidence ? attempt.evidence.status : "미제출" %></b></span>
                      <span>자동 신호 <b><%= attempt.evidence?.screenedAsWinner ? "내부 확인 대상" : "운영 검토 포함" %></b></span>
                    </div>
                    <% if (attempt.evidence?.anomalyFlags?.length) { %>
                      <p class="arena-admin-flags"><%= attempt.evidence.anomalyFlags.map(arenaAnomalyLabel).join(" · ") %></p>
                    <% } %>
                    <div class="arena-question-review-list">
                      <% attempt.questions.forEach((question) => { %>
                        <details class="arena-question-review" data-arena-question-details>
                          <summary>
                            <span>문항 <%= question.number %> · <%= question.typeId %></span>
                            <b class="<%= question.correct ? 'is-correct' : 'is-wrong' %>"><%= question.correct ? "정답" : "오답" %> · <%= arenaSeconds(question.responseTimeMs) %></b>
                          </summary>
                          <p class="arena-question-prompt math-content"><%= formatAdminMath(question.prompt) %></p>
                          <dl>
                            <div><dt>제출 답</dt><dd class="math-content"><%= formatAdminMath(question.submittedAnswer || "미입력") %></dd></div>
                            <div><dt>정답</dt><dd class="math-content"><%= formatAdminMath(question.correctAnswer) %></dd></div>
                            <div><dt>풀이시간</dt><dd><%= arenaSeconds(question.responseTimeMs) %></dd></div>
                          </dl>
                          <% if (question.solution) { %><details class="arena-solution-review" data-arena-question-details><summary>공식 풀이과정 보기</summary><p class="math-content"><%= formatAdminMath(question.solution) %></p></details><% } %>
                        </details>
                      <% }) %>
                    </div>
                    <div class="arena-admin-evidence-files">
                      <% if (!attempt.evidence?.files?.length) { %><span class="arena-evidence-missing">업로드된 풀이 증거가 없습니다.</span><% } %>
                      <% attempt.evidence?.files?.forEach((file, index) => { %>
                        <a href="/admin/arena-matches/evidence/<%= attempt.evidence._id %>/<%= encodeURIComponent(file.storedName) %>" target="_blank" rel="noopener">
                          <span>풀이 증거 <%= index + 1 %> 열기</span><small><%= file.originalName %></small>
                        </a>
                      <% }) %>
                    </div>
                  </details>
                <% }) %>
                </div>
              <details class="arena-sanction-history">
                <summary>참가자 과거 제재·검토 기록</summary>
                <% match.participants.forEach((participant) => { %>
                  <section>
                    <h4><%= arenaRole(participant.role) %> · <%= participant.user?.realName || participant.user?.name || participant.user?.email || "사용자" %></h4>
                    <p>계정 상태 <b><%= participant.user?.accountStatus || "-" %></b> · 누적 경고 <b><%= participant.user?.warningCount ?? 0 %>회</b></p>
                    <% if (!participant.history.riskCases.length && !participant.history.adminActions.length) { %><small>과거 무결성 검토·운영 제재 기록이 없습니다.</small><% } %>
                    <ul>
                      <% participant.history.riskCases.forEach((entry) => { %><li><b>무결성 <%= entry.status %></b><span><%= arenaDate(entry.createdAt) %> · 위험 점수 <%= entry.riskScore %></span></li><% }) %>
                      <% participant.history.adminActions.forEach((entry) => { %><li><b><%= entry.action %></b><span><%= arenaDate(entry.createdAt) %> · <%= entry.detail || "메모 없음" %></span></li><% }) %>
                    </ul>
                  </section>
                <% }) %>
              </details>
              <% if (match.reviewActions?.length) { %>
                <details class="arena-sanction-history"><summary>이 경기의 운영 검토 메모 <%= match.reviewActions.length %>건</summary><ul><% match.reviewActions.forEach((entry) => { %><li><b><%= entry.action %></b><span><%= arenaDate(entry.createdAt) %> · <%= entry.detail %></span></li><% }) %></ul></details>
              <% } %>
              <form class="arena-held-review-form" method="post" action="/admin/arena-matches/<%= match.id %>/review" data-supplemental-review-form>
                <label><span>판단 근거·운영 메모</span><textarea name="note" rows="3" maxlength="1000" required placeholder="감지 사유가 실제 위반인지, 정상 풀이로 판단한 근거가 무엇인지 구체적으로 기록해 주세요."></textarea></label>
                <% if (!attemptsFinished) { %><p class="arena-current-match-notice">현재 경기는 계속 진행됩니다. 양측이 5문제를 모두 끝낸 뒤 공격자·방어자의 답안, 풀이시간과 증거를 함께 검토하고 최종 판정할 수 있습니다.</p><% } else if (!matchComplete) { %><p class="arena-current-match-notice">양측 풀이가 끝났지만 필수 풀이 증거가 누락되었습니다. 미제출 자체를 포함해 양측의 위반 여부를 판정하세요. 업로드 시스템 오류가 확인된 경우에만 시스템 오류 확인을 선택하면 경기를 취소하고 예치를 전액 반환한 뒤 참가자 잠금을 해제합니다.</p><% } else if (hasActiveSupplementalRequest) { %><p class="arena-current-match-notice">추가 소명 자료의 24시간 제출 기한이 진행 중입니다. 제출 완료 또는 기한 종료 후 최종 판정할 수 있습니다.</p><% } %>
                <div>
                  <button type="submit" name="decision" value="NOTE" class="admin-secondary-button">메모 저장</button>
                  <button type="submit" name="decision" value="CLEAR" class="admin-primary-button" <%= hasActiveSupplementalRequest ? "disabled data-enable-after-supplemental" : "" %>><%= matchComplete ? "이상 없음 · 정산 재개" : attemptsFinished ? "시스템 오류 확인 · 경기 취소/제한 해제" : "이상 없음 · 제한 해제" %></button>
                  <button type="submit" name="decision" value="CHALLENGER_CHEATING" class="admin-danger-button" <%= attemptsFinished && !hasActiveSupplementalRequest ? "" : attemptsFinished ? "disabled data-enable-after-supplemental" : "disabled" %>>공격자 부정행위 확정</button>
                  <button type="submit" name="decision" value="DEFENDER_CHEATING" class="admin-danger-button" <%= attemptsFinished && !hasActiveSupplementalRequest ? "" : attemptsFinished ? "disabled data-enable-after-supplemental" : "disabled" %>>방어자 부정행위 확정</button>
                  <button type="submit" name="decision" value="BOTH_CHEATING" class="admin-danger-button" <%= attemptsFinished && !hasActiveSupplementalRequest ? "" : attemptsFinished ? "disabled data-enable-after-supplemental" : "disabled" %>>양측 부정행위 확정</button>
                </div>
              </form>
              <small>경기 ID · <%= match.id %></small>
              </div>
            </details>
          <% }) %>
        </div>
        <% if (!integrityReview.heldMatches.length) { %>
          <p class="admin-empty">현재 정산이 보류된 Arena 경기가 없습니다.</p>
        <% } %>
        <% if (!integrityReview.cases.length) { %>
          <p class="admin-empty">현재 검토가 필요한 장기 무결성 위험 건이 없습니다.</p>
        <% } %>
        <div class="arena-integrity-case-grid">
          <% integrityReview.cases.forEach((riskCase) => { %>
            <article id="integrity-case-<%= riskCase.id %>" class="arena-integrity-case <%= riskCase.riskLevel === "CRITICAL" ? "is-critical" : "" %>">
              <header>
                <div>
                  <small><%= riskCase.riskLevel === "CRITICAL" ? "우선 검토" : "검토 필요" %></small>
                  <h3><%= riskCase.user?.realName || riskCase.user?.name || "사용자" %></h3>
                  <span><%= riskCase.user?.email || "계정 정보 확인 필요" %></span>
                </div>
                <b>위험 점수 <%= riskCase.riskScore %></b>
              </header>
              <ul class="arena-integrity-reasons">
                <% riskCase.reasons.forEach((reason) => { %>
                  <li>
                    <strong><%= reason.label %> <em>+<%= reason.points %></em></strong>
                    <span><%= reason.description %></span>
                  </li>
                <% }) %>
              </ul>
              <p class="arena-integrity-links">
                <strong>연관 계정</strong>
                <span>
                  <%= riskCase.linkedUsers.length
                    ? riskCase.linkedUsers.map((linked) => linked.realName || linked.name || linked.email).join(" · ")
                    : "없음" %>
                </span>
                <strong>관련 경기</strong>
                <span><%= riskCase.relatedMatchIds?.length || 0 %>건</span>
              </p>
              <div class="arena-integrity-actions">
                <form method="post" action="/admin/arena-integrity/<%= riskCase.id %>/review">
                  <label>
                    <span>검토 메모</span>
                    <textarea name="note" rows="2" maxlength="1000" required placeholder="판단 근거를 기록해 주세요."></textarea>
                  </label>
                  <button type="submit" name="decision" value="CLEAR" class="admin-secondary-button">이상 없음 · 신규 경기 제한 해제</button>
                  <button type="submit" name="decision" value="RESTRICT" class="admin-danger-button">위험 확인 · 신규 경기 제한</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
        <% } else { %>
          <% if (!integrityReview.completedReviews.length) { %><p class="admin-empty">아직 완료된 Arena 무결성 검토가 없습니다.</p><% } %>
          <div class="arena-integrity-completed-grid">
            <% integrityReview.completedReviews.forEach((review) => { %>
              <article>
                <header>
                  <div>
                    <small><%= review.type === "MATCH" ? "경기 검토" : "계정 연관성 검토" %></small>
                    <h3><%= review.user?.realName || review.user?.name || review.user?.email || "사용자" %></h3>
                  </div>
                  <b><%= review.action.endsWith("cleared") ? "이상 없음" : review.action.includes("both_cheating") ? "양측 부정행위" : review.action.includes("challenger_cheating") ? "공격자 부정행위" : review.action.includes("defender_cheating") ? "방어자 부정행위" : "위반 확인" %></b>
                </header>
                <p><%= review.note || "운영 메모 없음" %></p>
                <dl>
                  <div><dt>처리 시각</dt><dd><%= arenaDate(review.reviewedAt) %></dd></div>
                  <div><dt>처리 관리자</dt><dd><%= review.reviewer?.realName || review.reviewer?.name || review.reviewer?.email || "관리자" %></dd></div>
                  <div><dt><%= review.type === "MATCH" ? "경기 ID" : "검토 ID" %></dt><dd><%= review.matchId || review.caseId %></dd></div>
                </dl>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <details class="admin-panel arena-recent-evidence-panel">
        <summary class="admin-panel-heading arena-recent-evidence-summary"><div><p>EVIDENCE</p><h2>최근 풀이 증거</h2></div><span>클릭해서 펼치기</span></summary>
        <div class="arena-recent-evidence-content">
        <% if (!evidenceEntries.length) { %>
          <p class="admin-empty">아직 제출된 Arena 풀이 증거가 없습니다.</p>
        <% } %>
        <div class="arena-admin-evidence-grid">
          <% evidenceEntries.forEach((entry) => { %>
            <article id="evidence-<%= entry.id %>" class="arena-admin-evidence <%= entry.status === "ANOMALY_FLAGGED" ? "is-flagged" : "" %>">
              <header>
                <div>
                  <small><%= entry.match?.tierPairLabel || "티어 조합 확인 필요" %></small>
                  <h3><%= entry.user?.realName || entry.user?.name || "사용자" %></h3>
                  <span><%= entry.user?.email || "" %></span>
                </div>
                <b><%= entry.status === "ANOMALY_FLAGGED" ? "이상 징후" : "정상 제출" %></b>
              </header>
              <% if (entry.anomalyFlags?.length) { %>
                <p class="arena-admin-flags"><%= entry.anomalyFlags.map(arenaAnomalyLabel).join(" · ") %></p>
              <% } %>
              <p class="arena-admin-attempt-summary">
                <span><%= entry.attempt?.role === "CHALLENGER" ? "공격자" : "방어자" %></span>
                <span><%= entry.attempt?.correctCount ?? "-" %> / 5문항</span>
                <span><%= entry.attempt?.score ?? "-" %>점</span>
                <span><%= entry.attempt?.activeSolveTimeMs != null ? `${(Number(entry.attempt.activeSolveTimeMs) / 1000).toFixed(1)}초` : "풀이시간 확인 중" %></span>
              </p>
              <div class="arena-admin-evidence-files">
                <% entry.files.forEach((file, index) => { %>
                  <a href="/admin/arena-matches/evidence/<%= entry.id %>/<%= encodeURIComponent(file.storedName) %>" target="_blank" rel="noopener">
                    <span>풀이 <%= index + 1 %></span>
                    <small><%= file.originalName %></small>
                  </a>
                <% }) %>
              </div>
            </article>
          <% }) %>
        </div>
        </div>
      </details>
    </main>
    <script>
      const formatSupplementalRemaining = (milliseconds) => {
        const remaining = Math.max(0, milliseconds);
        const hours = Math.floor(remaining / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);
        return [hours, minutes, seconds].map((value) => String(value).padStart(2, "0")).join(":");
      };
      const renderAdminSupplementalTimers = () => {
        document.querySelectorAll("[data-admin-supplemental-timer]").forEach((timer) => {
          const deadline = new Date(timer.dataset.deadline || "").getTime();
          const output = timer.querySelector("strong");
          if (!Number.isFinite(deadline) || !output) return;
          const serverNow = new Date(timer.dataset.serverNow || "").getTime();
          const clockOffset = Number.isFinite(serverNow) ? serverNow - Date.now() : 0;
          const delta = deadline - (Date.now() + clockOffset);
          output.textContent = delta <= 0 ? "00:00:00" : formatSupplementalRemaining(delta);
          if (delta > 0 || timer.dataset.expired === "true") return;
          timer.dataset.expired = "true";
          timer.classList.add("is-expired");
          const card = timer.closest("[data-admin-supplemental-card]");
          card?.classList.remove("is-active");
          card?.classList.add("is-expired");
          const status = card?.querySelector("[data-admin-supplemental-status]");
          if (status) status.textContent = "추가 소명자료 미제출";
          const matchDetails = timer.closest("[data-arena-review-details]");
          const activeTimers = [...(matchDetails?.querySelectorAll("[data-admin-supplemental-timer]") || [])]
            .some((entry) => entry.dataset.expired !== "true");
          if (!activeTimers) {
            matchDetails?.querySelectorAll("[data-enable-after-supplemental]").forEach((button) => {
              button.disabled = false;
              button.removeAttribute("data-enable-after-supplemental");
            });
          }
        });
      };
      renderAdminSupplementalTimers();
      window.setInterval(renderAdminSupplementalTimers, 1000);
      document.querySelectorAll("[data-arena-question-details]").forEach((details) => {
        details.addEventListener("toggle", () => {
          if (!details.open || !window.MathJax?.typesetPromise) return;
          window.MathJax.typesetPromise([details]).catch(() => {});
        });
      });
    </script>
  </body>
</html>

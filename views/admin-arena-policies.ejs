<%
  const overview = policyData;
  const config = overview.config;
  const matchmaking = overview.matchmaking;
  const formatDate = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "medium", timeStyle: "short" }).format(new Date(value))
    : "기록 없음";
  const number = (value) => Number(value || 0).toLocaleString("ko-KR");
  const yesNo = (value) => value ? "적용" : "미적용";
  const modeLabel = { NORMAL: "일반전", COMPETITIVE: "경쟁전", FRIENDLY: "친선전" };
  const statusLabel = {
    AVAILABLE: "사용 가능", RESERVED: "예약 중", REVIEW_REQUIRED: "검토 대기", INVALID: "무효",
    MATCHED: "성립", READY: "시작 대기", IN_PROGRESS: "풀이 중", EVIDENCE_REQUIRED: "풀이 업로드 대기",
    SUBMITTED: "제출 완료", HELD: "운영 검토", SETTLED: "확정", RESOLVED: "결과 확정", CANCELLED: "취소",
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arena 운영 설정 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "arena-policies" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div>
          <p>GOAT ARENA OPERATIONS</p>
          <h1>Arena 운영 설정</h1>
          <span>현재 서비스가 실제로 사용하는 경기 규칙과 운영 상태만 표시합니다.</span>
        </div>
        <strong><%= config.rulesetVersion %><small>규칙 버전</small></strong>
      </header>

      <% if (feedback) { %><div class="admin-feedback" role="status"><%= feedback %></div><% } %>
      <% if (error) { %><div class="admin-feedback admin-feedback--error" role="alert"><%= error %></div><% } %>

      <section class="admin-panel" id="matchmaking-control">
        <div class="admin-panel-heading">
          <div><p>MATCHMAKING CONTROL</p><h2>신규 경기 접수</h2></div>
          <span><%= matchmaking.isPaused ? "현재 일시정지" : "24시간 접수 중" %></span>
        </div>
        <p><%= matchmaking.isPaused ? `정지 사유: ${matchmaking.reason || "사유 미입력"}` : "요일 제한 없이 일반전·친선전·게스트 친선전의 신규 경기를 접수합니다. 경쟁전은 별도 환경 스위치가 켜진 경우에만 접수합니다." %></p>
        <form class="admin-form" method="post" action="/admin/arena-policies/matchmaking">
          <label><span>운영 메모</span><input name="reason" maxlength="500" value="<%= matchmaking.isPaused ? matchmaking.reason : '' %>" placeholder="일시정지할 때 사유를 입력하세요." /></label>
          <button type="submit" name="action" value="<%= matchmaking.isPaused ? 'RESUME' : 'PAUSE' %>"><%= matchmaking.isPaused ? "신규 경기 접수 재개" : "신규 경기 접수 일시정지" %></button>
        </form>
        <small>마지막 접수 <%= formatDate(matchmaking.lastAdmissionAt) %> · 접수 순번 <%= number(matchmaking.admissionSequence) %></small>
      </section>

      <section class="admin-stat-grid" aria-label="Arena 운영 현황">
        <article><span>경쟁 프로필</span><strong><%= number(overview.profiles.total) %><small>명</small></strong></article>
        <article><span>경쟁전 해금</span><strong><%= number(overview.profiles.unlocked) %><small>명</small></strong></article>
        <article><span>배치 완료</span><strong><%= number(overview.profiles.placed) %><small>명</small></strong></article>
        <article><span>배치 대기</span><strong><%= number(overview.profiles.awaitingPlacement) %><small>명</small></strong></article>
        <article><span>경쟁전 MMR 정산</span><strong><%= number(overview.ratingSettlements) %><small>건</small></strong></article>
        <article><span>배치 검토 대기</span><strong><%= number(overview.placementReviewQueue.length) %><small>명</small></strong></article>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>ACCOUNT PLANS</p><h2>계정 플랜</h2></div><span>관리자 계정은 별도 무제한 권한 유지</span></div>
        <div class="admin-stat-grid">
          <% config.plans.forEach((plan) => { %>
            <article><span><%= plan.label %></span><strong><%= number(overview.accountPlans[plan.code]) %><small>명</small></strong><small><%= plan.priceAmount ? `월 ${number(plan.priceAmount)}원 · ${plan.billingPeriodDays}일` : "무료" %></small></article>
          <% }) %>
        </div>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>ACTIVE RULES</p><h2>경기 모드별 적용 규칙</h2></div><span>운영 코드와 동일한 값</span></div>
        <div class="admin-table-wrap">
          <table>
            <thead><tr><th>모드</th><th>매칭</th><th>문제·시간</th><th>풀이</th><th>반영</th><th>부정행위 감지</th></tr></thead>
            <tbody>
              <tr><td><strong>일반전</strong></td><td>비슷한 실력의 사용자 기록 · 같은 문항은 다음 <%= config.normal.questionRepeatWindowMatches %>경기에서 제외</td><td><%= config.normal.questionCount %>문항 · 문항당 <%= config.normal.minutesPerQuestion %>분</td><td>필수</td><td>XP · 비공개 매칭 MMR 반영</td><td>감지 적용 · 사용자 불이익 없음 · 기록만 검토 대기</td></tr>
              <tr><td><strong>경쟁전</strong><small><%= config.competitive.enabled ? "환경 스위치 ON" : "환경 스위치 OFF" %></small></td><td>비슷한 실력의 사용자 기록</td><td><%= config.competitive.questionCount %>문항 · 문항당 <%= config.competitive.minutesPerQuestion %>분</td><td>필수</td><td>내부 MMR 갱신 후 공개 경쟁전 점수 산정</td><td><%= yesNo(config.competitive.integrityChecks) %></td></tr>
              <tr><td><strong>친선전</strong></td><td>친구 초대</td><td><%= config.friendly.questionCount %>문항 · 문항당 <%= config.friendly.minutesPerQuestion %>분</td><td>필수</td><td>MMR·XP 미반영</td><td><%= yesNo(config.friendly.integrityChecks) %></td></tr>
              <tr><td><strong>게스트 친선전</strong></td><td>로그인한 발신자가 만든 3일 링크 · 다중 참가 순위전</td><td>발신자와 동일한 5문항 · 문항당 10분</td><td>필수 · 데스크톱 파일/모바일 격자 풀이판</td><td>MMR·XP 미반영 · 닉네임+생년월일 조합별 1회</td><td><%= yesNo(config.guestFriendly.integrityChecks) %></td></tr>
              <tr><td><strong>주간 모의고사</strong></td><td>개별 응시</td><td>시험 설정 기준</td><td>시험 제출 규칙</td><td>응시자의 내부 MMR만 반영 · 경쟁전 점수 미반영 · 미응시 0</td><td>모의고사 전용 검증</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>COMPETITIVE RATING</p><h2>경쟁전 MMR·배치 설정</h2></div><span>출시 전 시뮬레이션 재검증 필요</span></div>
        <div class="admin-stat-grid">
          <article><span>기본 Rating</span><strong><%= config.competitive.glicko2.defaultRating %></strong></article>
          <article><span>기본 RD</span><strong><%= config.competitive.glicko2.defaultRatingDeviation %></strong></article>
          <article><span>기본 Volatility</span><strong><%= config.competitive.glicko2.defaultVolatility %></strong></article>
          <article><span>Tau</span><strong><%= config.competitive.glicko2.tau %></strong></article>
          <article><span>해금 조건</span><strong>일반전 <%= config.competitive.requiredNormalMatches %>경기</strong></article>
          <article><span>배치 횟수</span><strong><%= config.competitive.placementAttempts.minimum %>~<%= config.competitive.placementAttempts.maximum %>회</strong></article>
        </div>
        <p>일반전과 경쟁전은 정오답과 문항 난도를 반영한 내부 성취지표를 먼저 비교하고, 두 지표가 설정된 근소 범위 안일 때 유효 풀이 시간을 비교합니다. 단순 정답 수만으로 승패를 확정하지 않습니다.</p>
        <p>MMR은 매칭과 공개 경쟁전 점수 증감 폭을 정하는 내부 지표입니다. 사용자가 확인하는 랭킹은 공개 경쟁전 점수로만 계산하며, 주간 모의고사는 공개 점수를 바꾸지 않습니다.</p>
        <p>배치 표본이 적을수록 초기 RD와 Volatility를 높게 두고, 이후 Glicko-2 RD가 매 경기 연속적으로 수렴합니다. 5경기와 6경기 사이에 갑자기 변동 폭을 바꾸는 경계는 없습니다. 모든 수치는 출시 전 검증이 필요한 설정값입니다.</p>
        <div class="admin-table-wrap">
          <table><thead><tr><th>유효 배치 표본</th><th>초기 RD 가설</th><th>초기 Volatility 가설</th></tr></thead><tbody>
            <% config.competitive.glicko2.placementRatingDeviationBySampleCount.forEach((rd, index) => { %><tr><td><%= index + 1 %>회</td><td><%= Number(rd).toFixed(2) %></td><td><%= Number(config.competitive.glicko2.placementVolatilityBySampleCount[index]).toFixed(2) %></td></tr><% }) %>
          </tbody></table>
        </div>
        <details>
          <summary>티어별 공개 경쟁전 점수 기준 보기</summary>
          <div class="admin-table-wrap"><table><thead><tr><th>티어</th><th>경쟁전 점수 범위</th><th>현재 인원</th></tr></thead><tbody>
            <% config.competitive.tiers.forEach((tier) => { %><tr><td><strong><%= tier.label %></strong></td><td><%= number(tier.minMmr) %> ~ <%= Number.isFinite(tier.maxMmr) ? number(tier.maxMmr) : "이상" %></td><td><%= number(overview.profiles.byTier[tier.name]) %>명</td></tr><% }) %>
          </tbody></table></div>
        </details>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>DELIVERY RECOVERY</p><h2>알림과 원본 삭제 처리 상태</h2></div></div>
        <div class="admin-stat-grid">
          <article><span>이메일 재시도</span><strong><%= number(overview.operationalDelivery?.emailRetry || 0) %><small>건</small></strong></article>
          <article><span>이메일 발송 결과 확인 필요</span><strong><%= number(overview.operationalDelivery?.emailUnknown || 0) %><small>건</small></strong></article>
          <article><span>원본 삭제 실패</span><strong><%= number(overview.operationalDelivery?.deletionFailed || 0) %><small>건</small></strong></article>
          <article><span>장시간 처리 중인 앱 요청</span><strong><%= number(overview.operationalDelivery?.pendingCommands || 0) %><small>건</small></strong></article>
        </div>
      </section>

      <section class="admin-panel" id="rating-health">
        <div class="admin-panel-heading"><div><p>ONE-SIDED RATING HEALTH</p><h2>최근 30일 단방향 MMR 상태</h2></div><span><%= overview.oneSidedRatingHealth.status === "WITHIN_THRESHOLD" ? "허용 범위" : overview.oneSidedRatingHealth.status === "NO_DATA" ? "데이터 없음" : "검토 필요" %></span></div>
        <div class="admin-stat-grid">
          <article><span>정산 표본</span><strong><%= number(overview.oneSidedRatingHealth.settlementCount) %><small>건</small></strong></article>
          <article><span>평균 MMR 변화</span><strong><%= Number(overview.oneSidedRatingHealth.averageMmrDelta).toFixed(2) %></strong><small>경고 기준 ±<%= Number(overview.oneSidedRatingHealth.driftWarningThreshold).toFixed(2) %></small></article>
          <article><span>누적 MMR 순변화</span><strong><%= Number(overview.oneSidedRatingHealth.netMmrDelta).toFixed(2) %></strong></article>
          <article><span>평균 절대 변동</span><strong><%= Number(overview.oneSidedRatingHealth.averageAbsoluteMmrDelta).toFixed(2) %></strong></article>
          <article><span>정산 전 평균 MMR</span><strong><%= Number(overview.oneSidedRatingHealth.averageRatingBefore).toFixed(2) %></strong></article>
          <article><span>정산 후 평균 MMR</span><strong><%= Number(overview.oneSidedRatingHealth.averageRatingAfter).toFixed(2) %></strong></article>
        </div>
        <div class="admin-table-wrap"><table><thead><tr><th>결과</th><th>경기 수</th><th>평균 내부 MMR 변화</th><th>평균 공개 점수 변화</th></tr></thead><tbody>
          <% overview.oneSidedRatingHealth.outcomes.forEach((row) => { %><tr><td><%= row.outcome === "CHALLENGER_WIN" ? "도전자 승" : row.outcome === "DEFENDER_WIN" ? "도전자 패" : "무승부" %></td><td><%= number(row.count) %></td><td><%= Number(row.averageMmrDelta).toFixed(2) %></td><td><%= Number(row.averageScoreDelta).toFixed(2) %></td></tr><% }) %>
        </tbody></table></div>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>HISTORICAL RECORD POOL</p><h2>과거 기록 풀</h2></div><a href="/admin/arena-match-history">전체 경기 기록 →</a></div>
        <div class="admin-table-wrap"><table><thead><tr><th>모드</th><th>사용 가능</th><th>예약 중</th><th>검토 대기</th><th>무효</th></tr></thead><tbody>
          <% ["NORMAL", "COMPETITIVE"].forEach((mode) => { const row = overview.records[mode] || {}; %><tr><td><strong><%= modeLabel[mode] %></strong></td><td><%= number(row.AVAILABLE) %></td><td><%= number(row.RESERVED) %></td><td><%= number(row.REVIEW_REQUIRED) %></td><td><%= number(row.INVALID) %></td></tr><% }) %>
        </tbody></table></div>
      </section>

      <section class="admin-panel" id="normal-record-review">
        <div class="admin-panel-heading"><div><p>NORMAL RECORD REVIEW</p><h2>일반전 상대 기록 검토</h2></div><span>사용자 패널티·이메일 없음</span></div>
        <p>감지 신호가 있는 일반전도 사용자 결과와 XP는 정상 확정됩니다. 해당 경기 기록만 상대 기록 풀에서 보류되며, 승인하면 즉시 다시 사용 가능합니다.</p>
        <% if (overview.normalRecordReviewQueue?.length) { %>
          <div class="admin-policy-list">
            <% overview.normalRecordReviewQueue.forEach((entry) => { %>
              <article class="admin-policy-card">
                <header><div><span>기록 풀 검토 대기</span><h3><%= entry.nickname || entry.realName || entry.email || entry.userId %></h3><small>경기 <%= entry.matchId %> · <%= formatDate(entry.createdAt) %></small></div></header>
                <p>감지 신호: <%= entry.integrityFlags?.length ? entry.integrityFlags.join(" · ") : "상세 신호 없음" %></p>
                <form class="admin-form" method="post" action="/admin/arena-records/<%= entry.recordId %>/integrity-review">
                  <label><span>검토 근거</span><textarea name="note" rows="3" maxlength="1000" required placeholder="풀이 기록과 감지 신호를 확인한 근거를 입력하세요."></textarea></label>
                  <div><button type="submit" name="decision" value="APPROVE">문제 없음 · 기록 풀 복귀</button><button type="submit" name="decision" value="REJECT">기록 무효 처리</button></div>
                </form>
              </article>
            <% }) %>
          </div>
        <% } else { %><p class="admin-empty">검토 대기 중인 일반전 상대 기록이 없습니다.</p><% } %>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>MATCH LEDGER</p><h2>모드별 경기 상태</h2></div><span>최근 조회 <%= formatDate(overview.generatedAt) %></span></div>
        <div class="admin-table-wrap"><table><thead><tr><th>모드</th><th>진행 중</th><th>상태별 원장</th></tr></thead><tbody>
          <% Object.entries(overview.matches).forEach(([mode, statuses]) => { %><tr><td><strong><%= modeLabel[mode] || mode %></strong></td><td><%= number(overview.activeMatchesByMode[mode]) %></td><td><%= Object.entries(statuses).map(([status, count]) => `${statusLabel[status] || status} ${number(count)}`).join(" · ") %></td></tr><% }) %>
        </tbody></table></div>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>GUEST & RECOVERY</p><h2>게스트 링크·배치 복구</h2></div></div>
        <div class="admin-stat-grid">
          <article><span>열린 게스트 링크</span><strong><%= number(overview.guestChallenges.OPEN) %><small>건</small></strong></article>
          <article><span>만료 링크</span><strong><%= number(overview.guestChallenges.EXPIRED) %><small>건</small></strong></article>
          <article><span>누적 고유 참가자</span><strong><%= number(overview.guestParticipation.uniqueParticipants) %><small>명</small></strong></article>
          <article><span>완료 기록</span><strong><%= number(overview.guestParticipation.attempts.SETTLED) %><small>건</small></strong></article>
          <article><span>진행·제출 대기</span><strong><%= number((overview.guestParticipation.attempts.READY || 0) + (overview.guestParticipation.attempts.IN_PROGRESS || 0) + (overview.guestParticipation.attempts.EVIDENCE_REQUIRED || 0)) %><small>건</small></strong></article>
          <article><span>서버 오류 복구</span><strong><%= number(overview.placementAdjustments.SERVER_ERROR) %><small>건</small></strong></article>
          <article><span>운영자 시도 초기화</span><strong><%= number(overview.placementAdjustments.OPERATOR_RESET) %><small>건</small></strong></article>
        </div>
        <p>서버 오류는 배치 시도를 차감하지 않습니다. 사용자 중단은 자동 복구하지 않으며, 5회 소진 후 추가 시도는 승인된 운영자 초기화 기록이 있어야 합니다.</p>
        <% if (overview.placementReviewQueue?.length) { %>
          <div class="admin-policy-list">
            <% overview.placementReviewQueue.forEach((entry) => { %>
              <article class="admin-policy-card">
                <header><div><span>운영자 검토 필요 · <%= entry.attemptsUsed %>/5회 사용</span><h3><%= entry.nickname || entry.realName || entry.email || entry.userId %></h3><small><%= entry.email %> · 최근 상태 <%= formatDate(entry.updatedAt) %></small></div></header>
                <form class="admin-form" method="post" action="/admin/arena-users/<%= entry.userId %>/placement/reset" onsubmit="return confirm('서버 기록을 검토했고 이 사용자의 배치 시도를 초기화할까요? 기존 응시 기록은 보존됩니다.')">
                  <input type="hidden" name="requestId" value="placement-reset:<%= entry.userId %>:<%= Date.now() %>" />
                  <label><span>검토 근거</span><textarea name="reason" rows="3" maxlength="1000" required placeholder="오류 로그와 응시 이벤트를 확인한 근거를 입력하세요."></textarea></label>
                  <button type="submit">승인 기록 후 시도 초기화</button>
                </form>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="admin-empty">현재 운영자 배치 복구 검토가 필요한 사용자가 없습니다.</p>
        <% } %>

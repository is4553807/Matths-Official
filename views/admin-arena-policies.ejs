<%
  const publicArenaText = typeof arenaPublicText === "function"
    ? arenaPublicText
    : (value) => String(value ?? "").replace(/Sub\s+Division/g, "Unranked").replace(/Main\s+Division/g, "Ranked");
  const formatDateTime = (value) =>
    value
      ? new Intl.DateTimeFormat("ko-KR", {
          timeZone: "Asia/Seoul",
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(value))
      : "별도 종료 시각 없음";
  const now = new Date(policyData.now);
  const formatLocalInput = (value) => {
    const date = value ? new Date(value) : new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Seoul",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      })
        .formatToParts(date)
        .filter((part) => part.type !== "literal")
        .map((part) => [part.type, part.value])
    );
    return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}`;
  };
  const numberValue = (name, fallback) => {
    const value = ["MAIN", "MOCK_EXAM_ONLY", "LEARNING_PACKAGE"].includes(oldInput?.policyDivision)
      ? undefined
      : oldInput?.[name];
    return value === undefined || value === "" ? fallback : value;
  };
  const subBasePolicy = policyData.sub.upcomingPolicy || policyData.sub.activePolicy || {};
  const attackParticipationDays = policyData.paybackRules.minimumAttackParticipationDays;
  const paybackCycleDays = policyData.paybackRules.cycleDays;
  const mainBasePolicy = policyData.main.upcomingPolicy || policyData.main.activePolicy || {};
  const mainValue = (name, fallback) => {
    const value = oldInput?.policyDivision === "MAIN" ? oldInput?.[name] : undefined;
    return value === undefined || value === "" ? (mainBasePolicy?.[name] ?? fallback) : value;
  };
  const checkedValue = (name, fallback = true) => {
    if (!oldInput) return fallback;
    if (["MAIN", "MOCK_EXAM_ONLY", "LEARNING_PACKAGE"].includes(oldInput.policyDivision)) return fallback;
    const value = oldInput[name];
    const values = Array.isArray(value) ? value : [value];
    return values.some((entry) => ["true", "1", "on"].includes(String(entry).toLowerCase()));
  };
  const defaultBands = (subBasePolicy.payback?.bands?.length
    ? subBasePolicy.payback.bands
    : [
        { minScoreDays: 0, maxScoreDays: 29, ratePercent: 0 },
        { minScoreDays: 30, maxScoreDays: 34, ratePercent: 50 },
        { minScoreDays: 35, maxScoreDays: 39, ratePercent: 80 },
        { minScoreDays: 40, maxScoreDays: "", ratePercent: 100 },
      ]).map((band) => ({
        ...band,
        maxScoreDays: band.maxScoreDays ?? "",
      }));
  const oldBandMins = Array.isArray(oldInput?.bandMinScores)
    ? oldInput.bandMinScores
    : oldInput?.bandMinScores !== undefined
      ? [oldInput.bandMinScores]
      : [];
  const oldBandMaxes = Array.isArray(oldInput?.bandMaxScores)
    ? oldInput.bandMaxScores
    : oldInput?.bandMaxScores !== undefined
      ? [oldInput.bandMaxScores]
      : [];
  const oldBandRates = Array.isArray(oldInput?.bandRates)
    ? oldInput.bandRates
    : oldInput?.bandRates !== undefined
      ? [oldInput.bandRates]
      : [];
  const bandRows = oldBandMins.length
    ? oldBandMins.map((minScoreDays, index) => ({
        minScoreDays,
        maxScoreDays: oldBandMaxes[index] ?? "",
        ratePercent: oldBandRates[index] ?? "",
      }))
    : defaultBands;
  const policyState = (policy) => {
    if (policy.status === "DRAFT") return "작성 중";
    if (policy.status === "RETIRED") return "종료";
    const startsAt = new Date(policy.effectiveFrom);
    const endsAt = policy.effectiveUntil ? new Date(policy.effectiveUntil) : null;
    if (startsAt > now) return "적용 예정";
    if (endsAt && endsAt <= now) return "적용 종료";
    return "적용 중";
  };
  const policyTitle = (policy) =>
    publicArenaText(policy.displayName || `${formatDateTime(policy.effectiveFrom)} 적용 정책`);
  const formatWon = (value) => `${new Intl.NumberFormat("ko-KR").format(Number(value) || 0)}원`;
  const learningPackage = policyData.learningPackage.activePolicy;
  const minimumPolicyDateTime = formatLocalInput(new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000));
  const tierRows = [
    ["BRONZE", "브론즈", 1],
    ["SILVER", "실버", 1],
    ["GOLD", "골드", 2],
    ["PLATINUM", "플래티넘", 2],
    ["EMERALD", "에메랄드", 3],
    ["DIAMOND", "다이아몬드", 3],
    ["MASTER", "마스터", 4],
    ["GRANDMASTER", "그랜드마스터", 4],
    ["CHALLENGER", "챌린저", 4],
  ];
  const activeSubLimits = new Map(
    (subBasePolicy.dailyMatchLimitsByTier || []).map((row) => [row.tier, row])
  );
  const subLimitValue = (tier, fallback) => {
    const inputName = `subDefenseLimit_${tier}`;
    const submitted = oldInput?.policyDivision === "MAIN" ? undefined : oldInput?.[inputName];
    if (submitted !== undefined && submitted !== "") return submitted;
    return activeSubLimits.get(tier)?.defenseLimit ?? fallback;
  };
  const totalPolicyCount =
    policyData.policies.length +
    policyData.main.policies.length +
    policyData.mockExamOnly.policies.length +
    (policyData.mainShop?.policies?.length || 0);
  const matchmaking = policyData.matchmakingControl || { isPaused: false };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GOAT Arena 정책·상품 관리 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/contrast.css" />

  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "arena-policies" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div>
          <p>정책 버전 관리</p>
          <h1>GOAT Arena 정책·상품 관리</h1>
          <span>상품 가격, Unranked, Ranked, 상점 정책을 영역별로 나누어 관리합니다.</span>
        </div>
        <strong><%= totalPolicyCount %><small>개 정책</small></strong>
      </header>

      <% if (feedback) { %><div class="admin-feedback" role="status"><%= feedback %></div><% } %>
      <% if (error) { %><div class="admin-feedback admin-feedback--error" role="alert"><span aria-hidden="true">!</span><%= error %></div><% } %>

      <section class="admin-panel admin-matchmaking-control <%= matchmaking.isPaused ? 'is-paused' : 'is-running' %>" id="matchmaking-control">
        <div class="admin-panel-heading">
          <div>
            <p>GLOBAL MATCHMAKING CONTROL</p>
            <h2>전체 매치메이킹 <%= matchmaking.isPaused ? "일시정지 중" : "운영 중" %></h2>
          </div>
          <span><%= matchmaking.isPaused ? "신규 경기·복수전·Ranked 초대 생성과 초대 수락이 정지되어 있습니다. 진행 중인 경기는 계속 완료할 수 있습니다." : "Unranked·Ranked의 신규 경기와 초대가 정상적으로 생성됩니다." %></span>
        </div>
        <div class="admin-matchmaking-state">
          <strong><span aria-hidden="true"></span><%= matchmaking.isPaused ? "PAUSED" : "ACTIVE" %></strong>
          <p>
            <% if (matchmaking.isPaused) { %>
              정지 시각 <b><%= formatDateTime(matchmaking.pausedAt) %></b><% if (matchmaking.reason) { %> · 사유 <b><%= matchmaking.reason %></b><% } %>
            <% } else { %>
              최근 재개 <b><%= matchmaking.resumedAt ? formatDateTime(matchmaking.resumedAt) : "초기 운영 상태" %></b>
            <% } %>
          </p>
        </div>
        <form class="admin-matchmaking-form" action="/admin/arena-policies/matchmaking" method="POST" onsubmit="return confirm('<%= matchmaking.isPaused ? '신규 매치메이킹을 다시 시작할까요?' : '신규 매치메이킹을 일시정지할까요? 진행 중 경기는 계속됩니다.' %>');">
          <% if (!matchmaking.isPaused) { %>
            <label><span>운영 메모 <small>사용자에게도 정지 사유로 표시됩니다.</small></span><input name="reason" maxlength="500" placeholder="예: 서버 점검 및 문제 데이터 교체" /></label>
            <input type="hidden" name="action" value="PAUSE" />
            <button class="danger" type="submit">모든 신규 매치메이킹 일시정지</button>
          <% } else { %>
            <input type="hidden" name="action" value="RESUME" />
            <button type="submit">모든 신규 매치메이킹 재개</button>
          <% } %>
        </form>
      </section>
      <div class="admin-feedback" role="note">Unranked·Ranked·패키지 정책은 등록 시점으로부터 최소 30일 뒤 적용됩니다. 단, Ranked 상점의 가격·판매 상태는 저장 즉시 적용되며, 두 경우 모두 전체 활성 사용자에게 이메일과 사이트 우편함 공지가 생성됩니다.</div>

      <nav class="admin-policy-jump" aria-label="Arena 정책 영역 바로가기">
        <a href="#product-policies"><span>01</span>상품·가격</a>
        <a href="#main-shop-policy"><span>02</span>Ranked 상점</a>
        <a href="#sub-policy"><span>03</span>Unranked</a>
        <a href="#main-policy"><span>04</span>Ranked</a>
      </nav>

      <section class="admin-stat-grid admin-policy-overview" aria-label="현재 적용 정책">
        <article><span>현재 Unranked 정책</span><strong><%= policyTitle(learningPackage) %></strong></article>
        <article><span>학습권 패키지 가격</span><strong><%= formatWon(learningPackage.priceAmount) %></strong></article>
        <article><span>정기권 학습 가능 일수</span><strong><%= learningPackage.initialLearningDays %><small>일</small></strong></article>
        <article><span>페이백 점수</span><strong><%= learningPackage.initialPaybackScoreDays %><small>점</small></strong></article>
      </section>

      <section class="admin-policy-domain-heading" id="product-policies">
        <div><span>PRODUCT POLICIES</span><h2>상품과 가격</h2></div>
        <p>사용자가 구매하는 두 상품의 현재 가격과 허용 기능을 관리합니다.</p>
      </section>

      <div class="admin-policy-product-grid">
      <section class="admin-panel admin-policy-create" id="learning-package">
        <div class="admin-panel-heading">
          <div><p>29일 학습 패키지</p><h2>학습·모의고사·Arena 패키지 가격 관리</h2></div>
          <span>29일 동안 전체 학습 기능과 배치고사, 주간 공식 모의고사, GOAT Arena를 이용하는 상품입니다.</span>
        </div>
        <div class="admin-policy-summary-grid">
          <span>현재 가격 <b><%= formatWon(learningPackage.priceAmount) %></b></span>
          <span>정기권 학습 가능 일수 <b><%= learningPackage.initialLearningDays %>일</b></span>
          <span>페이백 점수 초깃값 <b><%= learningPackage.initialPaybackScoreDays %>점</b></span>
          <span>배치고사·GOAT Arena <b>허용</b></span>
          <span>페이백 최소 점수 <b><%= learningPackage.payback?.minimumScoreDays ?? 30 %>점</b></span>
          <span>공격 출석 조건 <b><%= learningPackage.payback?.minimumAttackParticipationDays ?? attackParticipationDays %> / <%= learningPackage.initialLearningDays %>일</b></span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/learning-package/price" method="POST">
          <div class="admin-policy-field-grid">
            <label>
              <span>새 패키지 가격 <small>원</small></span>
              <input type="number" name="priceAmount" min="0" max="1000000" step="1" value="<%= oldInput?.policyDivision === 'LEARNING_PACKAGE' ? oldInput.priceAmount : learningPackage.priceAmount %>" required />
            </label>
            <label class="wide">
              <span>변경 사유·운영 메모</span>
              <input name="changeSummary" maxlength="1000" value="<%= oldInput?.policyDivision === 'LEARNING_PACKAGE' ? oldInput.changeSummary || '' : '' %>" placeholder="예: 첫 달 프로모션 종료 후 29일 정상가 적용" />
            </label>
          </div>
          <button type="submit">새 가격 정책 적용</button>
        </form>
        <br />
        <% if (policyData.learningPackage.policies.length) { %>
          <div class="admin-policy-list">
            <% policyData.learningPackage.policies.forEach((policy) => { const learningState = policyState(policy); %>
              <article class="admin-policy-card <%= learningState === '적용 중' ? 'is-current' : '' %>">
                <header>
                  <div><span><%= learningState %></span><h3><%= publicArenaText(policy.displayName) %></h3><small><%= formatDateTime(policy.effectiveFrom) %>부터</small></div>
                  <strong><%= formatWon(policy.priceAmount) %></strong>
                </header>
                <% if (policy.changeSummary) { %><p><%= policy.changeSummary %></p><% } %>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="admin-panel admin-policy-create" id="mock-exam-package">
        <div class="admin-panel-heading">
          <div><p>Matths 주간 공식 모의고사 이용권</p><h2>모의고사 패키지 월 이용 가격 관리</h2></div>
          <span>주간 공식 모의고사만 허용하고 배치고사와 GOAT Arena는 제한하는 별도 상품입니다.</span>
        </div>
        <div class="admin-policy-summary-grid">
          <span>현재 월 가격 <b><%= formatWon(policyData.mockExamOnly.activePolicy.monthlyPriceAmount) %></b></span>
          <span>이용 기간 <b><%= policyData.mockExamOnly.activePolicy.billingPeriodDays %>일</b></span>
          <span>주간 공식 모의고사 <b>허용</b></span>
          <span>배치고사·GOAT Arena <b>제한</b></span>
          <span>기존 기록 반영 기준 <b><%= policyData.mockExamOnly.activePolicy.placementCalibrationMinimumWeeklyExams %>회 이상</b></span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/mock-exam-only/price" method="POST">
          <div class="admin-policy-field-grid">
            <label>
              <span>새 월 가격 <small>원</small></span>
              <input type="number" name="monthlyPriceAmount" min="0" max="1000000" step="1" value="<%= oldInput?.policyDivision === 'MOCK_EXAM_ONLY' ? oldInput.monthlyPriceAmount : policyData.mockExamOnly.activePolicy.monthlyPriceAmount %>" required />
            </label>
            <label class="wide">
              <span>변경 사유·운영 메모</span>
              <input name="changeSummary" maxlength="1000" value="<%= oldInput?.policyDivision === 'MOCK_EXAM_ONLY' ? oldInput.changeSummary || '' : '' %>" placeholder="예: 첫 달 프로모션 종료 후 정상가 적용" />
            </label>
          </div>
          <button type="submit">새 가격 정책 적용</button>
        </form>
        <br />
        <% if (policyData.mockExamOnly.policies.length) { %>
          <div class="admin-policy-list">
            <% policyData.mockExamOnly.policies.forEach((policy) => { const mockState = policyState(policy); %>
              <article class="admin-policy-card <%= mockState === '적용 중' ? 'is-current' : '' %>">
                <header>
                  <div><span><%= mockState %></span><h3><%= publicArenaText(policy.displayName) %></h3><small><%= formatDateTime(policy.effectiveFrom) %>부터</small></div>
                  <strong><%= formatWon(policy.monthlyPriceAmount) %></strong>
                </header>
                <% if (policy.changeSummary) { %><p><%= policy.changeSummary %></p><% } %>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
      </div>

      <section class="admin-panel admin-policy-create" id="main-shop-policy">
        <div class="admin-panel-heading">
          <div><p>Ranked 상점</p><h2>판매 가격·아이템 상태 관리</h2></div>
          <span>저장 즉시 새 가격·판매 상태가 적용됩니다. 전체 사용자에게는 항목별 핵심 변경점을 불릿으로 안내합니다.</span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/main-shop" method="POST">
          <div class="admin-policy-field-grid">
            <% policyData.mainShop.activePolicy.items.forEach((item) => { %>
              <label>
                <span><%= item.displayName %> <small>학습일</small></span>
                <input type="number" name="price_<%= item.itemCode %>" min="1" max="365" step="1" value="<%= oldInput?.policyDivision === 'MAIN_SHOP' ? oldInput[`price_${item.itemCode}`] : item.priceDays %>" required />
                <span><input type="checkbox" name="enabledItems" value="<%= item.itemCode %>" <%= item.enabled ? "checked" : "" %> /> 현재 판매</span>
              </label>
            <% }) %>
            <label class="wide">
              <span>변경 사유·운영 메모</span>
              <input name="changeSummary" maxlength="1000" value="<%= oldInput?.policyDivision === 'MAIN_SHOP' ? oldInput.changeSummary || '' : '' %>" placeholder="예: 2차 편의 기능 판매 시작" />
            </label>
          </div>
          <button type="submit">상점 정책 즉시 적용·전체 공지</button>
        </form>
        <br />
      </section>

      <section class="admin-policy-domain-heading">
        <div><span>UNRANKED</span><h2>Unranked 정책</h2></div>
        <p>학습권, 페이백 점수와 페이백 자격을 별도 버전으로 관리합니다.</p>
      </section>

      <section class="admin-panel admin-policy-create" id="sub-policy">
        <div class="admin-panel-heading">
          <div><p>Unranked</p><h2>학습권·페이백 정책 만들기</h2></div>
          <span>작성 중 상태로 저장한 뒤 적용 일정에 등록하면 최소 30일의 사전 고지 기간을 거쳐 반영됩니다.</span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/sub" method="POST">
          <div class="admin-policy-field-grid">
            <label class="wide"><span>정책 이름</span><input name="displayName" minlength="2" maxlength="120" value="<%= oldInput?.displayName || "" %>" placeholder="예: 첫 달 무료 운영 정책" required /></label>
            <label><span>적용 시작 시각 <small>한국시간 · 최소 30일 뒤</small></span><input type="datetime-local" name="effectiveFrom" min="<%= minimumPolicyDateTime %>" value="<%= oldInput?.effectiveFrom || formatLocalInput() %>" required /></label>
            <label><span>학습권 패키지 가격 <small>원</small></span><input type="number" name="priceAmount" min="0" step="1" value="<%= numberValue("priceAmount", subBasePolicy.priceAmount ?? 29000) %>" required /></label>
            <label><span>정기권 학습 가능 일수 초깃값 <small>고정</small></span><input type="number" name="initialLearningDays" value="29" readonly required /></label>
            <label><span>페이백 점수 초깃값</span><input type="number" name="initialPaybackScoreDays" min="0" step="1" value="<%= numberValue("initialPaybackScoreDays", subBasePolicy.initialPaybackScoreDays ?? 29) %>" required /></label>
            <label><span>이용 주기 시작 시각 <small>결제 다음 날 · 고정</small></span><input type="time" name="paymentDayCutoffKst" value="00:00" readonly required /></label>
            <label><span>재구매 유예 시간</span><input type="number" name="renewalGraceHours" min="0" step="1" value="<%= numberValue("renewalGraceHours", subBasePolicy.renewalGraceHours ?? 72) %>" required /></label>
            <label><span>랭크 복귀전 티어 하향 단계</span><input type="number" name="lateRenewalTierPenalty" min="1" step="1" value="<%= numberValue("lateRenewalTierPenalty", subBasePolicy.lateRenewalTierPenalty ?? 1) %>" required /></label>
            <label><span>일반 쟁탈전 적용 일수 <small>고정</small></span><input type="number" name="normalStakeDays" value="1" readonly required /></label>
            <label><span>복수전 적용 일수 <small>고정</small></span><input type="number" name="revengeStakeDays" value="2" readonly required /></label>
          </div>

          <fieldset class="admin-policy-fieldset">
            <legend>일일 일반 쟁탈전 상한</legend>
            <p>일반 공격은 전 티어 하루 3회 고정입니다. 방어 상한만 티어별로 조정할 수 있으며, 복수전은 아래 횟수에 포함하지 않습니다.</p>
            <div class="admin-policy-limit-grid">
              <% tierRows.forEach(([tier, label, defaultDefense]) => { %>
                <article>
                  <strong><%= label %></strong>
                  <p>공격 <strong>3회 고정</strong></p>
                  <label><span>방어</span><input type="number" name="subDefenseLimit_<%= tier %>" min="0" max="20" step="1" value="<%= subLimitValue(tier, defaultDefense) %>" required /></label>
                </article>
              <% }) %>
            </div>
          </fieldset>

          <fieldset class="admin-policy-fieldset">
            <legend>페이백 자격</legend>
            <div class="admin-policy-field-grid">
              <label><span>최소 공격 출석일 <small><%= paybackCycleDays %>일 중</small></span><input type="number" name="minimumAttackParticipationDays" value="<%= attackParticipationDays %>" readonly required /></label>
              <label><span>최소 페이백 점수</span><input type="number" name="minimumScoreDays" min="0" step="1" value="<%= numberValue("minimumScoreDays", subBasePolicy.payback?.minimumScoreDays ?? 30) %>" required /></label>
            </div>
            <p><%= paybackCycleDays %>일 이용 주기 중 서로 다른 한국 날짜 <%= attackParticipationDays %>일에 Unranked 일반 쟁탈전 또는 복수전의 공격자로 5개 답안과 필수 풀이 증거를 정상 제출해야 합니다. 공격 시작만으로는 인정하지 않고 승패는 관계없으며, 같은 날 여러 번 정상 제출해도 공격 출석은 1일로 계산합니다. 출석일은 연속될 필요가 없습니다.</p>
          </fieldset>

          <fieldset class="admin-policy-fieldset">
            <legend>페이백 점수 구간</legend>
            <p>0점부터 빈틈없이 이어져야 하며, 마지막 줄의 종료 점수는 비워야 합니다.</p>
            <div class="admin-policy-band-list">
              <% bandRows.forEach((band, index) => { %>
                <div>
                  <strong><%= index + 1 %>구간</strong>
                  <label><span>시작 점수</span><input type="number" name="bandMinScores" min="0" step="1" value="<%= band.minScoreDays %>" required /></label>
                  <label><span>종료 점수</span><input type="number" name="bandMaxScores" min="0" step="1" value="<%= band.maxScoreDays %>" <%= index === bandRows.length - 1 ? "" : "required" %> /></label>
                  <label><span>페이백 비율</span><input type="number" name="bandRates" min="0" max="100" step="1" value="<%= band.ratePercent %>" required /></label>
                </div>
              <% }) %>
            </div>
          </fieldset>

          <div class="admin-policy-checks">
            <label class="admin-checkbox"><input type="hidden" name="packagePurchaseRequiresZeroBalance" value="false" /><input type="checkbox" name="packagePurchaseRequiresZeroBalance" value="true" <%= checkedValue("packagePurchaseRequiresZeroBalance", subBasePolicy.packagePurchaseRequiresZeroBalance ?? true) ? "checked" : "" %> /><span>정기권 학습 가능 일수가 0일이고 마지막 공식 공격 제출 기간이 끝났을 때만 새 패키지 구매 허용</span></label>
            <label class="admin-checkbox"><input type="hidden" name="packagePurchaseRequiresZeroLockedBalance" value="false" /><input type="checkbox" name="packagePurchaseRequiresZeroLockedBalance" value="true" <%= checkedValue("packagePurchaseRequiresZeroLockedBalance", subBasePolicy.packagePurchaseRequiresZeroLockedBalance ?? true) ? "checked" : "" %> /><span>경기 예치 학습일수가 0일일 때만 새 패키지 구매 허용</span></label>
          </div>
          <label><span>변경 사유·운영 메모</span><textarea name="changeSummary" rows="4" maxlength="1000" placeholder="이전 정책에서 바뀐 가격과 페이백 조건을 적어주세요."><%= oldInput?.changeSummary || "" %></textarea></label>
          <button type="submit">30일 후 적용 예약·전체 공지</button>
        </form>
      </section>

      <details class="admin-panel admin-policy-history">
        <summary class="admin-policy-history-summary"><div><p>Unranked</p><h2>학습권·페이백 정책 이력</h2></div><span><%= policyData.policies.length %>개 <b>펼치기</b></span></summary>
        <div class="admin-policy-history-body">
        <% if (!policyData.policies.length) { %><p class="admin-empty">등록된 Arena 정책이 없습니다.</p><% } %>
        <div class="admin-policy-list">
          <% policyData.policies.forEach((policy) => { const state = policyState(policy); %>
            <article class="admin-policy-card <%= state === "적용 중" ? "is-current" : "" %>">
              <header>
                <div><span><%= state %></span><h3><%= policyTitle(policy) %></h3><small><%= formatDateTime(policy.effectiveFrom) %>부터 · <%= policy.effectiveUntil ? `${formatDateTime(policy.effectiveUntil)}까지` : "후속 정책 적용 전까지" %></small></div>
                <strong><%= formatWon(policy.priceAmount) %></strong>
              </header>
              <div class="admin-policy-summary-grid">
                <span>정기권 학습 가능 일수 <b><%= policy.initialLearningDays %>일</b></span>
                <span>페이백 점수 <b><%= policy.initialPaybackScoreDays %>점</b></span>
                <span>일반 쟁탈전 <b><%= policy.matchStakeDays?.normal ?? 1 %>점 예치</b></span>
                <span>복수전 <b><%= policy.matchStakeDays?.revenge ?? 2 %>점 예치</b></span>
                <% if (policy.payback?.minimumAttackParticipationDays !== undefined && policy.payback?.minimumAttackParticipationDays !== null) { %>
                  <span>공격 출석 <b><%= policy.payback.minimumAttackParticipationDays %> / <%= policy.initialLearningDays %>일</b></span>
                <% } else { %>
                  <span>이전 공격 기준 <b>연속 <%= policy.payback?.minimumStreakDays ?? policy.initialLearningDays %>일</b></span>
                <% } %>
                <span>승패 조건 <b>없음</b></span>
              </div>
              <div class="admin-policy-bands">
                <% (policy.payback?.bands || []).forEach((band) => { %><span><%= band.maxScoreDays === null || band.maxScoreDays === undefined ? `${band.minScoreDays}점 이상` : `${band.minScoreDays}~${band.maxScoreDays}점` %> <b><%= band.ratePercent %>%</b></span><% }) %>
              </div>
              <div class="admin-policy-bands" aria-label="티어별 일일 공격·방어 상한">
                <% (policy.dailyMatchLimitsByTier || []).forEach((row) => { const tier = tierRows.find(([code]) => code === row.tier); %>
                  <span><%= tier?.[1] || row.tier %> <b>공격 3 · 방어 <%= row.defenseLimit %></b></span>
                <% }) %>
              </div>
              <% if (policy.changeSummary) { %><p><%= policy.changeSummary %></p><% } %>
              <% if (policy.status === "DRAFT") { %>
                <div class="admin-policy-actions">
                  <form action="/admin/arena-policies/sub/<%= policy._id %>/activate" method="POST" onsubmit="return confirm('이 Unranked 정책을 적용 일정에 등록할까요?');"><button type="submit">적용 일정에 등록</button></form>
                  <form action="/admin/arena-policies/sub/<%= policy._id %>/retire" method="POST" onsubmit="return confirm('이 작성 중 정책을 종료할까요?');"><button class="danger" type="submit">작성 취소</button></form>
                </div>
              <% } else if (policy.status === "ACTIVE" && new Date(policy.effectiveFrom) > now) { %>
                <div class="admin-policy-actions"><form action="/admin/arena-policies/sub/<%= policy._id %>/retire" method="POST" onsubmit="return confirm('이 적용 예정 정책을 취소할까요?');"><button class="danger" type="submit">적용 예정 취소</button></form></div>
              <% } %>
            </article>
          <% }) %>
        </div>
        </div>
      </details>

      <section class="admin-policy-domain-heading">
        <div><span>RANKED</span><h2>Ranked 정책</h2></div>
        <p>경기 초대, 티어 차이별 예치 일수와 복수전 정산 기준을 관리합니다.</p>
      </section>

      <section class="admin-stat-grid" id="main-policy" aria-label="현재 Ranked 정책">
        <article><span>현재 Ranked 정책</span><strong><%= policyData.main.activePolicy ? policyTitle(policyData.main.activePolicy) : "적용 정책 없음" %></strong></article>
        <article><span>최대 티어 차이</span><strong><%= policyData.main.activePolicy?.maximumTargetTierGap ?? "—" %><small><%= policyData.main.activePolicy ? "단계" : "" %></small></strong></article>
        <article><span>복수전 예치 배수</span><strong><%= policyData.main.activePolicy?.revengeStakeMultiplier ?? "—" %><small><%= policyData.main.activePolicy ? "배" : "" %></small></strong></article>
        <article><span>복수전 수수료</span><strong><%= policyData.main.activePolicy?.revengeFeeDays ?? "—" %><small><%= policyData.main.activePolicy ? "일" : "" %></small></strong></article>
      </section>

      <section class="admin-panel admin-policy-create">
        <div class="admin-panel-heading">
          <div><p>Ranked</p><h2>Ranked 경기 정책 만들기</h2></div>
          <span>목표 티어 차이별 최소 예치 일수와 초대·복수전 조건은 활성 Ranked 정책을 실제 경기 코드에서 직접 조회합니다.</span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/main" method="POST">
          <input type="hidden" name="policyDivision" value="MAIN" />
          <div class="admin-policy-field-grid">
            <label class="wide"><span>정책 이름</span><input name="displayName" minlength="2" maxlength="120" value="<%= oldInput?.policyDivision === "MAIN" ? oldInput.displayName || "" : "" %>" placeholder="예: Ranked 정식 운영 정책" required /></label>
            <label><span>적용 시작 시각 <small>한국시간 · 최소 30일 뒤</small></span><input type="datetime-local" name="effectiveFrom" min="<%= minimumPolicyDateTime %>" value="<%= oldInput?.policyDivision === "MAIN" ? oldInput.effectiveFrom || formatLocalInput() : formatLocalInput() %>" required /></label>
            <label><span>Ranked 진입 보너스</span><input type="number" name="mainEntryBonusDays" min="0" step="1" value="<%= mainValue("mainEntryBonusDays", 2) %>" required /></label>
            <label><span>Unranked 이월 차감 기준</span><input type="number" name="mainCarryoverBaseDays" min="0" step="1" value="<%= mainValue("mainCarryoverBaseDays", 29) %>" required /></label>
            <label><span>최대 티어 차이</span><input type="number" name="maximumTargetTierGap" min="1" step="1" value="<%= mainValue("maximumTargetTierGap", 3) %>" required /></label>
            <label><span>초대 자동 취소 수수료</span><input type="number" name="invitationCancellationFeeDays" min="0" step="1" value="<%= mainValue("invitationCancellationFeeDays", 1) %>" required /></label>
            <label><span>최근 상대 제외 기간</span><input type="number" name="repeatOpponentExclusionDays" min="0" step="1" value="<%= mainValue("repeatOpponentExclusionDays", 7) %>" required /></label>
            <label><span>목표 티어별 활성 예약 상한</span><input type="number" name="maximumActiveInvitationReservationsPerTargetTier" min="1" max="1" step="1" value="1" readonly required /></label>
            <label><span>초대 동시 발송 인원 <small>비우면 전체 적격 후보</small></span><input type="number" name="invitationOfferBatchSize" min="1" step="1" value="<%= mainValue("invitationOfferBatchSize", "") %>" /></label>
            <label><span>복수전 예치 배수</span><input type="number" name="revengeStakeMultiplier" min="1" step="1" value="<%= mainValue("revengeStakeMultiplier", 2) %>" required /></label>
            <label><span>복수전 기본 수수료</span><input type="number" name="revengeFeeDays" min="0" step="1" value="<%= mainValue("revengeFeeDays", 1) %>" required /></label>
          </div>
          <fieldset class="admin-policy-fieldset">
            <legend>티어 차이별 최소 예치 일수</legend>
            <p>현재 확정값은 1단계 1일, 2단계 2일, 3단계 3일이며 최대 3단계입니다.</p>
            <div class="admin-policy-band-list">
              <% [1, 2, 3].forEach((gap) => { %>
                <div>
                  <strong><%= gap %>단계 차이</strong>
                  <input type="hidden" name="mainTierGaps" value="<%= gap %>" />
                  <label><span>최소 예치 일수</span><input type="number" name="mainMinimumStakeDays" min="1" step="1" value="<%= Array.isArray(oldInput?.mainMinimumStakeDays) && oldInput?.policyDivision === "MAIN" ? oldInput.mainMinimumStakeDays[gap - 1] : (mainBasePolicy.stakeDaysByTierGap || []).find((band) => Number(band.tierGap) === gap)?.stakeDays ?? gap %>" required /></label>
                </div>
              <% }) %>
            </div>
          </fieldset>
          <label><span>변경 사유·운영 메모</span><textarea name="changeSummary" rows="4" maxlength="1000"><%= oldInput?.policyDivision === "MAIN" ? oldInput.changeSummary || "" : "" %></textarea></label>
          <button type="submit">30일 후 적용 예약·전체 공지</button>
        </form>
      </section>

      <details class="admin-panel admin-policy-history">
        <summary class="admin-policy-history-summary"><div><p>Ranked</p><h2>Ranked 경기 정책 이력</h2></div><span><%= policyData.main.policies.length %>개 <b>펼치기</b></span></summary>
        <div class="admin-policy-history-body">
        <% if (!policyData.main.policies.length) { %><p class="admin-empty">등록된 Ranked 정책이 없습니다.</p><% } %>
        <div class="admin-policy-list">
          <% policyData.main.policies.forEach((policy) => { const state = policyState(policy); %>
            <article class="admin-policy-card <%= state === "적용 중" ? "is-current" : "" %>">
              <header>
                <div><span><%= state %></span><h3><%= policyTitle(policy) %></h3><small><%= formatDateTime(policy.effectiveFrom) %>부터</small></div>
                <strong>최대 <%= policy.maximumTargetTierGap %>단계</strong>
              </header>
              <div class="admin-policy-summary-grid">
                <% (policy.stakeDaysByTierGap || []).forEach((band) => { %><span><%= band.tierGap %>단계 차이 <b>최소 <%= band.stakeDays %>일</b></span><% }) %>
                <span>자동 취소 수수료 <b><%= policy.invitationCancellationFeeDays ?? 1 %>일</b></span>
                <span>직접 취소 <b>무료</b></span>
                <span>최근 상대 제외 <b><%= policy.repeatOpponentExclusionDays ?? 7 %>일</b></span>
                <span>목표 티어별 예약 <b>최대 <%= policy.maximumActiveInvitationReservationsPerTargetTier ?? 1 %>개</b></span>
                <span>복수전 <b><%= policy.revengeStakeMultiplier ?? 2 %>배 · <%= policy.revengeFeeDays ?? 1 %>일 수수료</b></span>
                <span>상대 선정 <b>서버 무작위</b></span>
              </div>
              <% if (policy.changeSummary) { %><p><%= policy.changeSummary %></p><% } %>
              <% if (policy.status === "DRAFT") { %>
                <div class="admin-policy-actions">
                  <form action="/admin/arena-policies/main/<%= policy._id %>/activate" method="POST"><button type="submit">적용 일정에 등록</button></form>
                  <form action="/admin/arena-policies/main/<%= policy._id %>/retire" method="POST"><button class="danger" type="submit">작성 취소</button></form>
                </div>
              <% } else if (policy.status === "ACTIVE" && new Date(policy.effectiveFrom) > now) { %>
                <div class="admin-policy-actions"><form action="/admin/arena-policies/main/<%= policy._id %>/retire" method="POST"><button class="danger" type="submit">적용 예정 취소</button></form></div>
              <% } %>
            </article>
          <% }) %>
        </div>
        </div>
      </details>
    </main>
  </body>
</html>

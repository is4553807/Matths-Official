<%
  const formatDateTime = (value) =>
    value
      ? new Intl.DateTimeFormat("ko-KR", {
          timeZone: "Asia/Seoul",
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(value))
      : "별도 종료 시각 없음";
  const formatLocalInput = (value) => {
    const date = value ? new Date(value) : new Date(Date.now() + 60 * 60 * 1000);
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat("en-CA", {
        timeZone: "Asia/Seoul",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      })
        .formatToParts(date)
        .filter((part) => part.type !== "literal")
        .map((part) => [part.type, part.value])
    );
    return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}`;
  };
  const numberValue = (name, fallback) => {
    const value = oldInput?.policyDivision === "MAIN" ? undefined : oldInput?.[name];
    return value === undefined || value === "" ? fallback : value;
  };
  const mainValue = (name, fallback) => {
    const value = oldInput?.policyDivision === "MAIN" ? oldInput?.[name] : undefined;
    return value === undefined || value === "" ? fallback : value;
  };
  const checkedValue = (name, fallback = true) => {
    if (!oldInput) return fallback;
    const value = oldInput[name];
    const values = Array.isArray(value) ? value : [value];
    return values.some((entry) => ["true", "1", "on"].includes(String(entry).toLowerCase()));
  };
  const defaultBands = [
    { minScoreDays: 0, maxScoreDays: 29, ratePercent: 0 },
    { minScoreDays: 30, maxScoreDays: 34, ratePercent: 50 },
    { minScoreDays: 35, maxScoreDays: 39, ratePercent: 80 },
    { minScoreDays: 40, maxScoreDays: "", ratePercent: 100 },
  ];
  const oldBandMins = Array.isArray(oldInput?.bandMinScores)
    ? oldInput.bandMinScores
    : oldInput?.bandMinScores !== undefined
      ? [oldInput.bandMinScores]
      : [];
  const oldBandMaxes = Array.isArray(oldInput?.bandMaxScores)
    ? oldInput.bandMaxScores
    : oldInput?.bandMaxScores !== undefined
      ? [oldInput.bandMaxScores]
      : [];
  const oldBandRates = Array.isArray(oldInput?.bandRates)
    ? oldInput.bandRates
    : oldInput?.bandRates !== undefined
      ? [oldInput.bandRates]
      : [];
  const bandRows = oldBandMins.length
    ? oldBandMins.map((minScoreDays, index) => ({
        minScoreDays,
        maxScoreDays: oldBandMaxes[index] ?? "",
        ratePercent: oldBandRates[index] ?? "",
      }))
    : defaultBands;
  const now = new Date(policyData.now);
  const policyState = (policy) => {
    if (policy.status === "DRAFT") return "작성 중";
    if (policy.status === "RETIRED") return "종료";
    const startsAt = new Date(policy.effectiveFrom);
    const endsAt = policy.effectiveUntil ? new Date(policy.effectiveUntil) : null;
    if (startsAt > now) return "적용 예정";
    if (endsAt && endsAt <= now) return "적용 종료";
    return "적용 중";
  };
  const policyTitle = (policy) =>
    policy.displayName || `${formatDateTime(policy.effectiveFrom)} 적용 정책`;
  const formatWon = (value) => `${new Intl.NumberFormat("ko-KR").format(Number(value) || 0)}원`;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arena 정책 관리 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "arena-policies" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div>
          <p>정책 버전 관리</p>
          <h1>Arena 정책 관리</h1>
          <span>Sub Division·학습권 패키지 정책과 Main Division 경기 정책을 서로 다른 버전으로 관리합니다.</span>
        </div>
        <strong><%= policyData.policies.length + policyData.main.policies.length %><small>개 정책</small></strong>
      </header>

      <% if (feedback) { %><div class="admin-feedback" role="status"><%= feedback %></div><% } %>
      <% if (error) { %><div class="admin-feedback admin-feedback--error" role="alert"><span aria-hidden="true">!</span><%= error %></div><% } %>

      <section class="admin-stat-grid" aria-label="현재 적용 정책">
        <article><span>현재 Sub Division 정책</span><strong><%= policyData.activePolicy ? policyTitle(policyData.activePolicy) : "적용 정책 없음" %></strong></article>
        <article><span>학습권 패키지 가격</span><strong><%= policyData.activePolicy ? formatWon(policyData.activePolicy.priceAmount) : "—" %></strong></article>
        <article><span>정기권 학습 가능 일수</span><strong><%= policyData.activePolicy?.initialLearningDays ?? "—" %><small><%= policyData.activePolicy ? "일" : "" %></small></strong></article>
        <article><span>페이백 점수</span><strong><%= policyData.activePolicy?.initialPaybackScoreDays ?? "—" %><small><%= policyData.activePolicy ? "점" : "" %></small></strong></article>
      </section>

      <section class="admin-panel admin-policy-create" id="sub-policy">
        <div class="admin-panel-heading">
          <div><p>Sub Division</p><h2>학습권·페이백 정책 만들기</h2></div>
          <span>작성 중 상태로 저장한 뒤 별도로 활성화해야 실제 일정에 반영됩니다.</span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/sub" method="POST">
          <div class="admin-policy-field-grid">
            <label class="wide"><span>정책 이름</span><input name="displayName" minlength="2" maxlength="120" value="<%= oldInput?.displayName || "" %>" placeholder="예: 첫 달 무료 운영 정책" required /></label>
            <label><span>적용 시작 시각 <small>한국시간</small></span><input type="datetime-local" name="effectiveFrom" value="<%= oldInput?.effectiveFrom || formatLocalInput() %>" required /></label>
            <label><span>학습권 패키지 가격 <small>원</small></span><input type="number" name="priceAmount" min="0" step="1" value="<%= numberValue("priceAmount", 0) %>" required /></label>
            <label><span>정기권 학습 가능 일수 초깃값</span><input type="number" name="initialLearningDays" min="1" step="1" value="<%= numberValue("initialLearningDays", 29) %>" required /></label>
            <label><span>페이백 점수 초깃값</span><input type="number" name="initialPaybackScoreDays" min="0" step="1" value="<%= numberValue("initialPaybackScoreDays", 29) %>" required /></label>
            <label><span>첫날 차감 기준 시각</span><input type="time" name="paymentDayCutoffKst" value="<%= oldInput?.paymentDayCutoffKst || "20:00" %>" required /></label>
            <label><span>재구매 유예 시간</span><input type="number" name="renewalGraceHours" min="0" step="1" value="<%= numberValue("renewalGraceHours", 72) %>" required /></label>
            <label><span>랭크 탈환 배치고사 티어 하향 단계</span><input type="number" name="lateRenewalTierPenalty" min="1" step="1" value="<%= numberValue("lateRenewalTierPenalty", 1) %>" required /></label>
            <label><span>일반 쟁탈전 적용 일수 <small>고정</small></span><input type="number" name="normalStakeDays" value="1" readonly required /></label>
            <label><span>복수전 적용 일수 <small>고정</small></span><input type="number" name="revengeStakeDays" value="2" readonly required /></label>
          </div>

          <fieldset class="admin-policy-fieldset">
            <legend>페이백 자격</legend>
            <div class="admin-policy-field-grid">
              <label><span>최소 연속 학습일</span><input type="number" name="minimumStreakDays" min="0" step="1" value="<%= numberValue("minimumStreakDays", 30) %>" required /></label>
              <label><span>최소 유료 일반 쟁탈전</span><input type="number" name="minimumPaidNormalAttacks" min="0" step="1" value="<%= numberValue("minimumPaidNormalAttacks", 2) %>" required /></label>
              <label><span>최소 페이백 점수</span><input type="number" name="minimumScoreDays" min="0" step="1" value="<%= numberValue("minimumScoreDays", 30) %>" required /></label>
            </div>
          </fieldset>

          <fieldset class="admin-policy-fieldset">
            <legend>페이백 점수 구간</legend>
            <p>0점부터 빈틈없이 이어져야 하며, 마지막 줄의 종료 점수는 비워야 합니다.</p>
            <div class="admin-policy-band-list">
              <% bandRows.forEach((band, index) => { %>
                <div>
                  <strong><%= index + 1 %>구간</strong>
                  <label><span>시작 점수</span><input type="number" name="bandMinScores" min="0" step="1" value="<%= band.minScoreDays %>" required /></label>
                  <label><span>종료 점수</span><input type="number" name="bandMaxScores" min="0" step="1" value="<%= band.maxScoreDays %>" <%= index === bandRows.length - 1 ? "" : "required" %> /></label>
                  <label><span>페이백 비율</span><input type="number" name="bandRates" min="0" max="100" step="1" value="<%= band.ratePercent %>" required /></label>
                </div>
              <% }) %>
            </div>
          </fieldset>

          <div class="admin-policy-checks">
            <label class="admin-checkbox"><input type="hidden" name="packagePurchaseRequiresZeroBalance" value="false" /><input type="checkbox" name="packagePurchaseRequiresZeroBalance" value="true" <%= checkedValue("packagePurchaseRequiresZeroBalance") ? "checked" : "" %> /><span>정기권 학습 가능 일수가 0일일 때만 새 패키지 구매 허용</span></label>
            <label class="admin-checkbox"><input type="hidden" name="packagePurchaseRequiresZeroLockedBalance" value="false" /><input type="checkbox" name="packagePurchaseRequiresZeroLockedBalance" value="true" <%= checkedValue("packagePurchaseRequiresZeroLockedBalance") ? "checked" : "" %> /><span>정산 대기 일수가 0일일 때만 새 패키지 구매 허용</span></label>
          </div>
          <label><span>변경 사유·운영 메모</span><textarea name="changeSummary" rows="4" maxlength="1000" placeholder="이전 정책에서 바뀐 가격과 페이백 조건을 적어주세요."><%= oldInput?.changeSummary || "" %></textarea></label>
          <button type="submit">작성 중 정책으로 저장</button>
        </form>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>Sub Division</p><h2>학습권·페이백 정책 이력</h2></div></div>
        <% if (!policyData.policies.length) { %><p class="admin-empty">등록된 Arena 정책이 없습니다.</p><% } %>
        <div class="admin-policy-list">
          <% policyData.policies.forEach((policy) => { const state = policyState(policy); %>
            <article class="admin-policy-card <%= state === "적용 중" ? "is-current" : "" %>">
              <header>
                <div><span><%= state %></span><h3><%= policyTitle(policy) %></h3><small><%= formatDateTime(policy.effectiveFrom) %>부터 · <%= policy.effectiveUntil ? `${formatDateTime(policy.effectiveUntil)}까지` : "후속 정책 적용 전까지" %></small></div>
                <strong><%= formatWon(policy.priceAmount) %></strong>
              </header>
              <div class="admin-policy-summary-grid">
                <span>정기권 학습 가능 일수 <b><%= policy.initialLearningDays %>일</b></span>
                <span>페이백 점수 <b><%= policy.initialPaybackScoreDays %>점</b></span>
                <span>일반 쟁탈전 <b><%= policy.matchStakeDays?.normal ?? 1 %>일</b></span>
                <span>복수전 <b><%= policy.matchStakeDays?.revenge ?? 2 %>일</b></span>
                <span>연속 학습 <b><%= policy.payback?.minimumStreakDays ?? 30 %>일 이상</b></span>
                <span>유료 일반 쟁탈전 <b><%= policy.payback?.minimumPaidNormalAttacks ?? 2 %>회 이상</b></span>
              </div>
              <div class="admin-policy-bands">
                <% (policy.payback?.bands || []).forEach((band) => { %><span><%= band.maxScoreDays === null || band.maxScoreDays === undefined ? `${band.minScoreDays}점 이상` : `${band.minScoreDays}~${band.maxScoreDays}점` %> <b><%= band.ratePercent %>%</b></span><% }) %>
              </div>
              <% if (policy.changeSummary) { %><p><%= policy.changeSummary %></p><% } %>
              <% if (policy.status === "DRAFT") { %>
                <div class="admin-policy-actions">
                  <form action="/admin/arena-policies/sub/<%= policy._id %>/activate" method="POST" onsubmit="return confirm('이 Sub Division 정책을 적용 일정에 등록할까요?');"><button type="submit">적용 일정에 등록</button></form>
                  <form action="/admin/arena-policies/sub/<%= policy._id %>/retire" method="POST" onsubmit="return confirm('이 작성 중 정책을 종료할까요?');"><button class="danger" type="submit">작성 취소</button></form>
                </div>
              <% } else if (policy.status === "ACTIVE" && new Date(policy.effectiveFrom) > now) { %>
                <div class="admin-policy-actions"><form action="/admin/arena-policies/sub/<%= policy._id %>/retire" method="POST" onsubmit="return confirm('이 적용 예정 정책을 취소할까요?');"><button class="danger" type="submit">적용 예정 취소</button></form></div>
              <% } %>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="admin-stat-grid" id="main-policy" aria-label="현재 Main Division 정책">
        <article><span>현재 Main Division 정책</span><strong><%= policyData.main.activePolicy ? policyTitle(policyData.main.activePolicy) : "적용 정책 없음" %></strong></article>
        <article><span>최대 티어 차이</span><strong><%= policyData.main.activePolicy?.maximumTargetTierGap ?? "—" %><small><%= policyData.main.activePolicy ? "단계" : "" %></small></strong></article>
        <article><span>복수전 배팅 배수</span><strong><%= policyData.main.activePolicy?.revengeStakeMultiplier ?? "—" %><small><%= policyData.main.activePolicy ? "배" : "" %></small></strong></article>
        <article><span>복수전 수수료</span><strong><%= policyData.main.activePolicy?.revengeFeeDays ?? "—" %><small><%= policyData.main.activePolicy ? "일" : "" %></small></strong></article>
      </section>

      <section class="admin-panel admin-policy-create">
        <div class="admin-panel-heading">
          <div><p>Main Division</p><h2>Main 경기 정책 만들기</h2></div>
          <span>목표 티어 차이별 최소 배팅과 초대·복수전 조건은 활성 Main 정책을 런타임에서 직접 조회합니다.</span>
        </div>
        <form class="admin-form" action="/admin/arena-policies/main" method="POST">
          <input type="hidden" name="policyDivision" value="MAIN" />
          <div class="admin-policy-field-grid">
            <label class="wide"><span>정책 이름</span><input name="displayName" minlength="2" maxlength="120" value="<%= oldInput?.policyDivision === "MAIN" ? oldInput.displayName || "" : "" %>" placeholder="예: Main Division 정식 운영 정책" required /></label>
            <label><span>적용 시작 시각 <small>한국시간</small></span><input type="datetime-local" name="effectiveFrom" value="<%= oldInput?.policyDivision === "MAIN" ? oldInput.effectiveFrom || formatLocalInput() : formatLocalInput() %>" required /></label>
            <label><span>Main 진입 보너스</span><input type="number" name="mainEntryBonusDays" min="0" step="1" value="<%= mainValue("mainEntryBonusDays", 2) %>" required /></label>
            <label><span>Sub 이월 차감 기준</span><input type="number" name="mainCarryoverBaseDays" min="0" step="1" value="<%= mainValue("mainCarryoverBaseDays", 29) %>" required /></label>
            <label><span>최대 티어 차이</span><input type="number" name="maximumTargetTierGap" min="1" step="1" value="<%= mainValue("maximumTargetTierGap", 3) %>" required /></label>
            <label><span>초대 자동 취소 수수료</span><input type="number" name="invitationCancellationFeeDays" min="0" step="1" value="<%= mainValue("invitationCancellationFeeDays", 1) %>" required /></label>
            <label><span>최근 상대 제외 기간</span><input type="number" name="repeatOpponentExclusionDays" min="0" step="1" value="<%= mainValue("repeatOpponentExclusionDays", 7) %>" required /></label>
            <label><span>목표 티어별 활성 예약 상한</span><input type="number" name="maximumActiveInvitationReservationsPerTargetTier" min="1" max="1" step="1" value="1" readonly required /></label>
            <label><span>초대 동시 발송 인원 <small>비우면 전체 적격 후보</small></span><input type="number" name="invitationOfferBatchSize" min="1" step="1" value="<%= mainValue("invitationOfferBatchSize", "") %>" /></label>
            <label><span>복수전 배팅 배수</span><input type="number" name="revengeStakeMultiplier" min="1" step="1" value="<%= mainValue("revengeStakeMultiplier", 2) %>" required /></label>
            <label><span>복수전 기본 수수료</span><input type="number" name="revengeFeeDays" min="0" step="1" value="<%= mainValue("revengeFeeDays", 1) %>" required /></label>
          </div>
          <fieldset class="admin-policy-fieldset">
            <legend>티어 차이별 최소 배팅</legend>
            <p>현재 확정값은 1단계 1일, 2단계 2일, 3단계 3일이며 최대 3단계입니다.</p>
            <div class="admin-policy-band-list">
              <% [1, 2, 3].forEach((gap) => { %>
                <div>
                  <strong><%= gap %>단계 차이</strong>
                  <input type="hidden" name="mainTierGaps" value="<%= gap %>" />
                  <label><span>최소 배팅 일수</span><input type="number" name="mainMinimumStakeDays" min="1" step="1" value="<%= Array.isArray(oldInput?.mainMinimumStakeDays) && oldInput?.policyDivision === "MAIN" ? oldInput.mainMinimumStakeDays[gap - 1] : gap %>" required /></label>
                </div>
              <% }) %>
            </div>
          </fieldset>
          <label><span>변경 사유·운영 메모</span><textarea name="changeSummary" rows="4" maxlength="1000"><%= oldInput?.policyDivision === "MAIN" ? oldInput.changeSummary || "" : "" %></textarea></label>
          <button type="submit">Main 정책을 작성 중으로 저장</button>
        </form>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>Main Division</p><h2>Main 경기 정책 이력</h2></div></div>
        <% if (!policyData.main.policies.length) { %><p class="admin-empty">등록된 Main Division 정책이 없습니다.</p><% } %>
        <div class="admin-policy-list">
          <% policyData.main.policies.forEach((policy) => { const state = policyState(policy); %>
            <article class="admin-policy-card <%= state === "적용 중" ? "is-current" : "" %>">
              <header>
                <div><span><%= state %></span><h3><%= policyTitle(policy) %></h3><small><%= formatDateTime(policy.effectiveFrom) %>부터</small></div>
                <strong>최대 <%= policy.maximumTargetTierGap %>단계</strong>
              </header>
              <div class="admin-policy-summary-grid">
                <% (policy.stakeDaysByTierGap || []).forEach((band) => { %><span><%= band.tierGap %>단계 차이 <b>최소 <%= band.stakeDays %>일</b></span><% }) %>
                <span>자동 취소 수수료 <b><%= policy.invitationCancellationFeeDays ?? 1 %>일</b></span>
                <span>직접 취소 <b>무료</b></span>
                <span>최근 상대 제외 <b><%= policy.repeatOpponentExclusionDays ?? 7 %>일</b></span>
                <span>목표 티어별 예약 <b>최대 <%= policy.maximumActiveInvitationReservationsPerTargetTier ?? 1 %>개</b></span>
                <span>복수전 <b><%= policy.revengeStakeMultiplier ?? 2 %>배 · <%= policy.revengeFeeDays ?? 1 %>일 수수료</b></span>
                <span>상대 선정 <b>서버 무작위</b></span>
              </div>
              <% if (policy.changeSummary) { %><p><%= policy.changeSummary %></p><% } %>
              <% if (policy.status === "DRAFT") { %>
                <div class="admin-policy-actions">
                  <form action="/admin/arena-policies/main/<%= policy._id %>/activate" method="POST"><button type="submit">적용 일정에 등록</button></form>
                  <form action="/admin/arena-policies/main/<%= policy._id %>/retire" method="POST"><button class="danger" type="submit">작성 취소</button></form>
                </div>
              <% } else if (policy.status === "ACTIVE" && new Date(policy.effectiveFrom) > now) { %>
                <div class="admin-policy-actions"><form action="/admin/arena-policies/main/<%= policy._id %>/retire" method="POST"><button class="danger" type="submit">적용 예정 취소</button></form></div>
              <% } %>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

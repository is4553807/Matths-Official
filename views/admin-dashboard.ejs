<%
  const formatDate = (date) =>
    new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(date));
  const inquiryStatus = {
    pending: "접수",
    in_review: "확인 중",
    replied: "답변 완료",
    closed: "종료",
  };
  const kstDateParts = Object.fromEntries(
    new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Seoul",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    })
      .formatToParts(new Date())
      .map((part) => [part.type, part.value])
  );
  const kstToday = [
    kstDateParts.year,
    kstDateParts.month,
    kstDateParts.day,
  ].join("-");
  const announcementInput =
    typeof oldInput === "object" && oldInput
      ? oldInput
      : {};
  const hasAnnouncementInput =
    Object.keys(announcementInput).length > 0;
  const withdrawalForm =
    typeof withdrawalInput === "object" && withdrawalInput
      ? withdrawalInput
      : {};
  const reserveForm =
    typeof reserveInput === "object" && reserveInput
      ? reserveInput
      : {};
  const money = (value) => Number(value || 0).toLocaleString("ko-KR");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>관리자 운영센터 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "dashboard" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div>
          <p>OPERATIONS</p>
          <h1>관리자 운영센터</h1>
          <span>공지, 문의, 자료와 사용자 상태를 한곳에서 관리합니다.</span>
        </div>
      </header>

      <% if (feedback) { %>
        <div class="admin-feedback" role="status"><%= feedback %></div>
      <% } %>
      <% if (error) { %>
        <div class="admin-feedback admin-feedback--error" role="alert">
          <span aria-hidden="true">!</span>
          <%= error %>
        </div>
      <% } %>

      <section class="admin-stat-grid" aria-label="운영 요약">
        <article><span>활성 학생</span><strong><%= adminData.stats.activeUsers %></strong></article>
        <article><span>활성 학부모</span><strong><%= adminData.stats.activeParents %></strong></article>
        <article><span>미처리 문의</span><strong><%= adminData.stats.pendingInquiries %></strong></article>
        <article><span>학원 승인 대기</span><strong><%= adminData.stats.pendingAcademies || 0 %></strong></article>
        <article><span>공개 공지</span><strong><%= adminData.stats.publishedAnnouncements %></strong></article>
        <article><span>아카이브</span><strong><%= adminData.stats.archiveItems %><small>개 · 폴더 <%= adminData.stats.archiveFolders %></small></strong></article>
      </section>

      <section class="admin-panel admin-academy-review-panel" id="academy-applications">
        <div class="admin-panel-heading">
          <div><p>ACADEMY REVIEW</p><h2>학원 등록 승인</h2></div>
          <div class="admin-academy-review-heading-action"><span>교사 역할 확인 후 승인된 학원만 사용자 선택 목록에 공개됩니다.</span><a href="/admin/academies">전체 학원 관리 →</a></div>
        </div>
        <div class="admin-academy-review-list">
          <% if (!(adminData.academyApplications || []).length) { %>
            <p class="admin-empty">검토 대기 중인 학원 등록 요청이 없습니다.</p>
          <% } %>
          <% (adminData.academyApplications || []).forEach((academy) => { const applicant = academy.createdByUserId; %>
            <article>
              <div>
                <span>검토 대기</span>
                <h3><%= academy.name %></h3>
                <p><strong><%= applicant.realName || applicant.name || "신청자" %></strong> · <%= applicant.email || "이메일 미확인" %></p>
                <small>계정 역할 <%= applicant.role === "teacher" ? "교사" : applicant.role %> · 요청 <%= formatDate(academy.createdAt) %></small>
              </div>
              <div class="admin-academy-review-actions">
                <form action="/admin/academies/<%= academy._id %>/approve" method="POST" onsubmit="return confirm('이 학원을 승인하고 사용자 목록에 공개할까요?')"><button type="submit">승인</button></form>
                <form action="/admin/academies/<%= academy._id %>/reject" method="POST" onsubmit="return confirm('이 학원 등록 요청을 거절할까요?')"><button class="is-danger" type="submit">거절</button></form>
              </div>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="admin-panel admin-revenue-panel" data-admin-revenue>
        <div class="admin-panel-heading">
          <div><p>SAFE FUNDS</p><h2>자금 현황</h2></div>
          <span>결제·페이백·출금 원장 기준 · 미확정 페이백 금액은 이익에서 제외</span>
        </div>
        <% if (!adminData.revenue.withdrawalsEnabled) { %>
          <div class="admin-feedback admin-feedback--error" role="alert">PG 수수료 준비금 비율이 설정되지 않아 사업자 출금이 잠겨 있습니다. 운영 환경에 FINANCE_PG_FEE_RESERVE_BPS를 먼저 설정하세요.</div>
        <% } %>
        <div class="admin-stat-grid admin-finance-grid">
          <article><span>총 누적 결제액</span><strong data-revenue="grossPayments"><%= money(adminData.revenue.grossPayments) %><small>원</small></strong></article>
          <article><span>누적 페이백 지급액</span><strong data-revenue="cumulativePaybackPaid"><%= money(adminData.revenue.cumulativePaybackPaid) %><small>원</small></strong></article>
          <article><span>페이백 준비금</span><strong data-revenue="paybackReserve"><%= money(adminData.revenue.paybackReserve) %><small>원</small></strong><small>미확정 유저 최대 지급 가능액</small></article>
          <article><span>확정·미송금 페이백</span><strong data-revenue="confirmedUnpaidPayback"><%= money(adminData.revenue.confirmedUnpaidPayback) %><small>원</small></strong></article>
          <article><span>PG 수수료 준비금</span><strong data-revenue="pgFeeReserve"><%= money(adminData.revenue.pgFeeReserve) %><small>원</small></strong><small><%= Number(adminData.revenue.pgFeeReserveBps || 0) / 100 %>% 적용 · 세금 제외</small></article>
          <article><span>기타 미지급 비용</span><strong data-revenue="otherUnpaidCosts"><%= money(adminData.revenue.otherUnpaidCosts) %><small>원</small></strong></article>
          <article><span>현재 실제 현금</span><strong data-revenue="actualCashBalance"><%= money(adminData.revenue.actualCashBalance) %><small>원</small></strong></article>
          <article><span>누적 확정이익</span><strong data-revenue="cumulativeConfirmedProfit"><%= money(adminData.revenue.cumulativeConfirmedProfit) %><small>원</small></strong></article>
          <article><span>누적 출금액</span><strong data-revenue="cumulativeWithdrawals"><%= money(adminData.revenue.cumulativeWithdrawals) %><small>원</small></strong></article>
          <article class="is-withdrawable"><span>현재 출금가능액</span><strong data-revenue="withdrawableAmount"><%= money(adminData.revenue.withdrawableAmount) %><small>원</small></strong><small>서버가 허용하는 최대 금액</small></article>
        </div>
        <div class="admin-finance-actions">
          <form class="admin-form" action="/admin/finance/withdrawals" method="post" onsubmit="return confirm('실제 사업자 계좌 출금을 완료했고 이 금액을 장부에 기록할까요?')">
            <label><span>출금액</span><input type="number" name="amount" min="1" step="1" max="<%= adminData.revenue.withdrawableAmount %>" value="<%= withdrawalForm.amount || '' %>" required /></label>
            <label><span>출금 목적·이체 기록</span><input type="text" name="operatorNote" maxlength="500" value="<%= withdrawalForm.operatorNote || '' %>" placeholder="예: 2026-08-13 사업자 계좌 출금" required /></label>
            <button type="submit" <%= !adminData.revenue.withdrawalsEnabled || Number(adminData.revenue.withdrawableAmount) < 1 ? 'disabled' : '' %>>출금 기록 저장</button>
          </form>
          <form class="admin-form" action="/admin/finance/other-unpaid-costs" method="post">
            <label><span>기타 미지급 비용 준비금</span><input type="number" name="amount" min="0" step="1" value="<%= reserveForm.amount ?? adminData.revenue.otherUnpaidCosts %>" required /></label>
            <label><span>변경 사유</span><input type="text" name="operatorNote" maxlength="500" value="<%= reserveForm.operatorNote || '' %>" placeholder="예: 미지급 외주비 반영" required /></label>
            <button type="submit">기타 준비금 저장</button>
          </form>
          <div class="admin-finance-history">
            <strong>최근 출금 기록</strong>
            <% if (!(adminData.revenue.recentWithdrawals || []).length) { %><p>아직 출금 기록이 없습니다.</p><% } %>
            <% (adminData.revenue.recentWithdrawals || []).forEach((item) => { %><p><b><%= money(item.amount) %>원</b><span><%= formatDate(item.completedAt) %> · <%= item.completedBy?.email || '운영자' %> · <%= item.operatorNote %></span></p><% }) %>
          </div>
        </div>
        <small data-revenue-updated>마지막 갱신 <%= new Date(adminData.revenue.updatedAt).toLocaleString("ko-KR", { timeZone: "Asia/Seoul" }) %></small>
      </section>
      <script>
        (() => {
          const root = document.querySelector("[data-admin-revenue]");
          if (!root) return;
          const format = (value) => `${Number(value || 0).toLocaleString("ko-KR")}<small>원</small>`;
          const refresh = async () => {
            const response = await fetch("/api/admin/revenue", { headers: { Accept: "application/json" } });
            if (!response.ok) return;
            const { revenue } = await response.json();
            ["grossPayments", "cumulativePaybackPaid", "paybackReserve", "confirmedUnpaidPayback", "pgFeeReserve", "otherUnpaidCosts", "actualCashBalance", "cumulativeConfirmedProfit", "cumulativeWithdrawals", "withdrawableAmount"].forEach((key) => {
              const node = root.querySelector(`[data-revenue="${key}"]`);
              if (node) node.innerHTML = format(revenue[key]);
            });
            const updated = root.querySelector("[data-revenue-updated]");
            if (updated) updated.textContent = `마지막 갱신 ${new Date(revenue.updatedAt).toLocaleString("ko-KR")}`;
          };
          window.setInterval(() => refresh().catch(() => {}), 15000);
        })();
      </script>

      <div class="admin-dashboard-grid">
        <section class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>ANNOUNCEMENT</p><h2>공지 발표</h2></div>
          </div>
          <form class="admin-form" action="/admin/announcements" method="POST">
            <label>
              <span>운영 게시판 분류</span>
              <select name="boardCategory">
                <option value="notice" <%= announcementInput.boardCategory === "notice" ? "selected" : "" %>>일반 공지</option>
                <option value="rules" <%= announcementInput.boardCategory === "rules" ? "selected" : "" %>>규칙</option>
                <option value="policies" <%= announcementInput.boardCategory === "policies" ? "selected" : "" %>>방침</option>
                <option value="manuals" <%= announcementInput.boardCategory === "manuals" ? "selected" : "" %>>설명서</option>
                <option value="inquiry-rules" <%= announcementInput.boardCategory === "inquiry-rules" ? "selected" : "" %>>문의 규칙</option>
              </select>
            </label>
            <label><span>제목</span><input name="title" minlength="2" maxlength="120" value="<%= announcementInput.title || "" %>" required /></label>
            <label><span>내용</span><textarea name="content" rows="7" minlength="5" maxlength="5000" required><%= announcementInput.content || "" %></textarea></label>
            <label>
              <span>대시보드 노출 종료일 <small>선택한 날짜의 자정 직전까지 표시 · 비워두면 직접 내릴 때까지 · KST 기준</small></span>
              <input
                type="date"
                name="dashboardEndDate"
                min="<%= kstToday %>"
                value="<%= announcementInput.dashboardEndDate || "" %>"
              />
            </label>
            <label class="admin-checkbox"><input type="checkbox" name="publishNow" value="true" <%= !hasAnnouncementInput || announcementInput.publishNow === "true" || announcementInput.publishNow === "on" ? "checked" : "" %> /><span>저장과 동시에 전체 사용자 우편함과 운영 게시판에 공개</span></label>
            <button type="submit">공지 저장</button>
          </form>
        </section>

        <section class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>RECENT INQUIRIES</p><h2>최근 문의</h2></div>
            <a href="/admin/inquiries">전체 보기 →</a>
          </div>
          <div class="admin-compact-list">
            <% if (!adminData.inquiries.length) { %>
              <p class="admin-empty">접수된 문의가 없습니다.</p>
            <% } %>
            <% adminData.inquiries.forEach((inquiry) => { %>
              <a href="/admin/inquiries">
                <span class="status-<%= inquiry.status %>"><%= inquiryStatus[inquiry.status] || "상태 확인 필요" %></span>
                <strong><%= inquiry.subject %></strong>
                <small><%= inquiry.authorNickname %> · <%= formatDate(inquiry.createdAt) %></small>
              </a>
            <% }) %>
          </div>
        </section>
      </div>

      <section class="admin-panel">
        <div class="admin-panel-heading">
          <div><p>ANNOUNCEMENT HISTORY</p><h2>공지·운영 게시판 이력</h2></div>
        </div>
        <div class="admin-announcement-list">
          <% if (!adminData.announcements.length) { %>
            <p class="admin-empty">등록된 공지가 없습니다.</p>
          <% } %>
          <% adminData.announcements.forEach((announcement) => { %>
            <article>
              <div>
                <span class="<%= announcement.isPublished ? 'is-live' : '' %>"><%= announcement.isPublished ? "공개 중" : "비공개" %></span>
                <span><%= ({ notice: "일반 공지", rules: "규칙", policies: "방침", manuals: "설명서", "inquiry-rules": "문의 규칙" })[announcement.boardCategory || "notice"] %></span>
                <h3><%= announcement.title %></h3>
                <p><%= announcement.content %></p>
                <small><%= formatDate(announcement.createdAt) %></small>
                <small>대시보드 노출: <%= announcement.dashboardEndsAt ? `${formatDate(announcement.dashboardEndsAt)}까지` : "직접 내릴 때까지" %></small>
              </div>
              <form action="/admin/announcements/<%= announcement._id %>/status" method="POST">
                <input type="hidden" name="publish" value="<%= announcement.isPublished ? 'false' : 'true' %>" />
                <button type="submit"><%= announcement.isPublished ? "공개 중지" : "지금 공개" %></button>
              </form>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

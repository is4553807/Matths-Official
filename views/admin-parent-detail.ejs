<%
  const parent = detail.parent;
  const formatDate = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "medium", timeStyle: "short" }).format(new Date(value))
    : "기록 없음";
  const gradeLabels = { 10: "고등학교 1학년", 11: "고등학교 2학년", 12: "고등학교 3학년", 13: "N수생", 14: "대학생", 15: "직장인" };
  const checkoutStatuses = { AWAITING_PG: "결제 대기", APPROVING: "승인 처리 중", REVIEW_REQUIRED: "운영자 확인 필요", AWAITING_DEPOSIT: "입금 대기", CANCELLED: "취소", EXPIRED: "만료", PAID: "결제 완료" };
  const alertStatuses = { PENDING: "발송 대기", SENT: "발송 완료", PREVIEW: "이전 미발송 기록", FAILED: "발송 실패" };
  const alertTypes = { LOW_LEARNING: "학습 저조", INACTIVITY: "장기 미접속" };
  const childNames = new Map((detail.links || []).filter((link) => link.childUserId).map((link) => [String(link.childUserId._id), link.childUserId.name]));
  const formatMinutes = (value) => {
    const minutes = Math.max(0, Math.round(Number(value) || 0));
    return minutes >= 60 ? `${Math.floor(minutes / 60)}시간 ${minutes % 60}분` : `${minutes}분`;
  };
  const formatPackage = (access) => {
    if (!access || access.packageType === "FREE") return "기본학습 패키지";
    if (access.packageType === "MOCK_EXAM_ONLY") return "Matths 주간 공식 모의고사 이용권";
    return "29일 학습권 패키지";
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= parent.username %> 학부모 관리 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "users" }) %>
    <main class="admin-main">
      <a class="admin-back" href="/admin/users?role=parent">← 학부모 목록</a>
      <header class="admin-heading user-detail-heading">
        <div>
          <p>PARENT ACCOUNT</p>
          <h1><%= parent.username %></h1>
          <span><%= parent.email %> · 가입 <%= formatDate(parent.createdAt) %></span>
        </div>
        <div class="admin-heading-actions">
          <strong class="<%= parent.isActive ? 'is-active' : 'is-inactive' %>"><%= parent.isActive ? '활성 학부모 계정' : '비활성화된 학부모 계정' %></strong>
          <span class="admin-inline-link">학부모 대시보드 기준으로 관리</span>
        </div>
      </header>
      <% if (feedback) { %><div class="admin-feedback" role="status"><%= feedback %></div><% } %>

      <section class="admin-user-summary">
        <article><span>연결 자녀</span><strong><%= detail.children.length %>명</strong><small>활성 연결 기준</small></article>
        <article><span>최근 로그인</span><strong><%= formatDate(parent.lastLoginAt) %></strong></article>
        <article><span>가입일</span><strong><%= formatDate(parent.createdAt) %></strong></article>
        <article><span>약관 동의</span><strong><%= formatDate(parent.acceptedTermsAt) %></strong></article>
        <article><span>역할</span><strong>학부모</strong><small>자녀 학습·결제 관리</small></article>
        <article><span>계정 상태</span><strong><%= parent.isActive ? '활성' : '비활성화' %></strong><small>학부모 로그인 및 자녀 확인 권한</small></article>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>ACCOUNT CONTROL</p><h2>학부모 계정 상태</h2></div></div>
        <div class="admin-action-grid">
          <form class="admin-form" action="/admin/parents/<%= parent._id %>/account-status" method="POST">
            <h3>이용 상태 변경</h3>
            <p>비활성화하면 해당 학부모 계정은 로그인·자녀 현황 조회·패키지 결제를 할 수 없습니다. 자녀 학습 데이터와 연결 기록은 유지됩니다.</p>
            <label><span>이용 상태</span><select name="isActive"><option value="true" <%= parent.isActive ? 'selected' : '' %>>활성</option><option value="false" <%= !parent.isActive ? 'selected' : '' %>>비활성화</option></select></label>
            <label><span>처리 사유</span><input name="reason" maxlength="500" required /></label>
            <button type="submit">학부모 계정 상태 저장</button>
          </form>
          <div class="admin-form">
            <h3>관리 범위</h3>
            <p>아래에서 자녀별 학습 현황·랭킹·현재 패키지·결제 요청·알림 발송 이력을 확인할 수 있습니다. 학생의 패키지 권한 자체를 변경해야 할 때는 각 자녀의 사용자 관리 화면으로 이동하세요.</p>
            <a class="admin-primary-button" href="/admin/users?role=parent">학부모 목록으로 이동</a>
          </div>
        </div>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>CHILDREN</p><h2>연결 자녀별 관리</h2></div><span>학부모 화면에서 보이는 핵심 정보와 알림 설정을 동일하게 확인·관리합니다.</span></div>
        <% if (!detail.children.length) { %>
          <p class="admin-empty">현재 활성으로 연결된 자녀 계정이 없습니다.</p>
        <% } %>
        <% detail.children.forEach((entry) => { const child = entry.child; const settings = entry.link.notificationSettings || {}; const lowLearning = settings.lowLearning || {}; const inactivity = settings.inactivity || {}; const affiliation = Number(child.schoolGrade) === 14 ? (child.university?.name || '대학교 미설정') : Number(child.schoolGrade) === 13 ? 'N수생' : Number(child.schoolGrade) === 15 ? '직장인' : (child.school?.name || '고등학교 미설정'); %>
          <article class="admin-panel" id="child-<%= child._id %>">
            <div class="admin-panel-heading"><div><p>CHILD ACCOUNT</p><h2><%= child.name %> <small>· <%= child.realName || '실명 미입력' %></small></h2></div><a href="/admin/users/<%= child._id %>">학생 계정 상세 관리 →</a></div>
            <div class="admin-metric-row">
              <div><span>소속</span><strong><%= affiliation %></strong><small><%= gradeLabels[Number(child.schoolGrade)] || '학습자' %></small></div>
              <div><span>오늘 학습</span><strong><%= formatMinutes(entry.dashboard.todayStudyMinutes) %></strong><small>오늘 풀이 <%= Number(entry.dashboard.todaySolvedProblems) || 0 %>문제</small></div>
              <div><span>이번 주 학습</span><strong><%= formatMinutes(entry.dashboard.weeklyStudyMinutes) %></strong><small>연속 학습 <%= Number(child.currentStreak) || 0 %>일</small></div>
              <div><span>정답률</span><strong><%= Number(entry.dashboard.correctRate) || 0 %>%</strong><small>오답률 <%= Math.max(0, 100 - (Number(entry.dashboard.correctRate) || 0)) %>%</small></div>
            </div>
            <div class="admin-metric-row admin-parent-metric-row">
              <div><span>현재 패키지</span><strong><%= formatPackage(entry.packageAccess) %></strong><small><%= entry.packageAccess?.cycle ? `남은 학습일수 ${entry.packageAccess.cycle.availableLearningDays || 0}일` : entry.packageAccess?.mockSubscription ? `${formatDate(entry.packageAccess.mockSubscription.endsAt)}까지` : '유료 권한 없음' %></small></div>
              <div><span>최종 종합 랭킹</span><strong><%= entry.ranking?.finalRank ?? '—' %><%= entry.ranking?.finalRank ? '위' : '' %></strong><small><%= entry.ranking ? `${entry.ranking.finalRating ?? '—'}점` : '랭킹 미확정' %></small></div>
              <div><span>GOAT Arena</span><strong><%= entry.ranking?.arenaRank || '미배정' %></strong><small><%= entry.ranking?.arenaDivision ? `${entry.ranking.arenaDivision === 'MAIN' ? 'RANKED' : 'UNRANKED'} · ${entry.ranking.gp ?? 0} GP` : '배치고사 후 표시' %></small></div>
              <div><span>최근 로그인</span><strong><%= formatDate(child.lastLoginAt) %></strong><small><%= child.accountStatus === 'withdrawn' ? '탈퇴 계정' : child.isActive === false ? '비활성화 계정' : '활성 계정' %></small></div>
            </div>
            <div class="admin-action-grid admin-parent-action-grid">
              <form class="admin-form" action="/admin/parents/<%= parent._id %>/children/<%= child._id %>/notifications" method="POST">
                <h3>학습·미접속 알림 설정</h3>
                <label class="admin-checkbox"><input type="checkbox" name="emailEnabled" value="1" <%= settings.emailEnabled !== false ? 'checked' : '' %> /><span>학부모 이메일 알림 받기</span></label>
                <label class="admin-checkbox"><input type="checkbox" name="lowLearningEnabled" value="1" <%= lowLearning.enabled ? 'checked' : '' %> /><span>학습 저조 알림 사용</span></label>
                <label><span>하루 최소 학습 시간</span><select name="minimumMinutesPerDay"><% [10,20,30,45,60].forEach((value) => { %><option value="<%= value %>" <%= Number(lowLearning.minimumMinutesPerDay || 20) === value ? 'selected' : '' %>><%= value %>분</option><% }) %></select></label>
                <label><span>학습 저조 연속 일수</span><select name="lowLearningConsecutiveDays"><% [2,3,5,7].forEach((value) => { %><option value="<%= value %>" <%= Number(lowLearning.consecutiveDays || 3) === value ? 'selected' : '' %>><%= value %>일</option><% }) %></select></label>
                <label class="admin-checkbox"><input type="checkbox" name="inactivityEnabled" value="1" <%= inactivity.enabled ? 'checked' : '' %> /><span>장기 미접속 알림 사용</span></label>
                <label><span>미접속 기준</span><select name="inactivityDays"><% [3,5,7,14,30].forEach((value) => { %><option value="<%= value %>" <%= Number(inactivity.days || 7) === value ? 'selected' : '' %>><%= value %>일</option><% }) %></select></label>
                <button type="submit">알림 설정 저장</button>
              </form>
              <form class="admin-form danger-form" action="/admin/parents/<%= parent._id %>/children/<%= child._id %>/unlink" method="POST">
                <h3>자녀 연결 해제</h3>
                <p>연결을 해제하면 이 학부모 계정에서 해당 학생의 학습 현황, 랭킹, 결제 요청 및 알림 설정을 더 이상 볼 수 없습니다. 학생의 데이터는 삭제되지 않습니다.</p>
                <label><span>해제 사유</span><textarea name="reason" rows="5" maxlength="500" required></textarea></label>
                <button type="submit">연결 해제</button>
              </form>
            </div>
          </article>
        <% }) %>
      </section>

      <div class="admin-detail-grid">
        <section class="admin-panel">
          <div class="admin-panel-heading"><div><p>PURCHASE HISTORY</p><h2>패키지 구매·결제 요청</h2></div><span>최대 최근 50건</span></div>
          <div class="admin-activity-list">
            <% if (!detail.checkoutIntents.length) { %><p class="admin-empty">이 학부모 계정의 패키지 결제 요청이 없습니다.</p><% } %>
            <% detail.checkoutIntents.forEach((intent) => { %>
              <div><span><%= checkoutStatuses[intent.status] || intent.status %> · <%= formatDate(intent.createdAt) %></span><strong><%= intent.productName %> · <%= Number(intent.amount || 0).toLocaleString('ko-KR') %>원</strong><p>대상 자녀: <%= childNames.get(String(intent.studentUserId)) || '연결 해제 또는 확인 필요' %> · 요청: <%= intent.requestedBy === 'PARENT' ? '학부모' : '학생' %></p><small>만료 예정 <%= formatDate(intent.expiresAt) %></small></div>
            <% }) %>
          </div>
        </section>
        <section class="admin-panel">
          <div class="admin-panel-heading"><div><p>ALERT DELIVERY</p><h2>학부모 알림 이력</h2></div><span>최대 최근 50건</span></div>
          <div class="admin-activity-list">
            <% if (!detail.alertDeliveries.length) { %><p class="admin-empty">아직 발송된 학습·미접속 알림이 없습니다.</p><% } %>
            <% detail.alertDeliveries.forEach((delivery) => { %>
              <div><span><%= alertStatuses[delivery.status] || delivery.status %> · <%= formatDate(delivery.sentAt || delivery.createdAt) %></span><strong><%= alertTypes[delivery.alertType] || delivery.alertType %></strong><p>대상 자녀: <%= childNames.get(String(delivery.childUserId)) || '연결 해제 또는 확인 필요' %></p><small><%= delivery.failureMessage || `기준일 ${delivery.dateKey || '—'}` %></small></div>
            <% }) %>
          </div>
        </section>
      </div>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>OPERATION HISTORY</p><h2>관리자 처리 이력</h2></div><span>이 학부모 계정에 연결된 운영 조치</span></div>
        <div class="admin-activity-list">
          <% if (!detail.actionLogs.length) { %><p class="admin-empty">기록된 관리자 처리 이력이 없습니다.</p><% } %>
          <% detail.actionLogs.forEach((log) => { %><div><span><%= formatDate(log.createdAt) %></span><strong><%= log.action %></strong><p><%= log.detail || '상세 사유 없음' %></p></div><% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

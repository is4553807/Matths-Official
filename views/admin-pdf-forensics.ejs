<%
  const formatDateTime = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", {
        timeZone: "Asia/Seoul",
        dateStyle: "long",
        timeStyle: "medium",
      }).format(new Date(value))
    : "-";
  const sourceLabels = {
    ARCHIVE: "Matths 아카이브",
    WEEKLY_MOCK: "Matths 주간 공식 모의고사",
    STORE: "Matths 상점",
    STUDY_HALL: "Matths 수험관",
    FORMULA: "Matths 공식집",
    ACADEMY_ASSIGNMENT: "학원 과제",
    ARENA_MATCH: "GOAT Arena 1대1 경기 화면",
  };
  const attemptStatusLabels = {
    READY: "시작 대기",
    IN_PROGRESS: "문제 풀이 중",
    EVIDENCE_REQUIRED: "풀이 증거 제출 대기",
    SUBMITTED: "제출 완료",
  };
  const traceCodeInput = typeof oldTraceCode === "undefined"
    ? ""
    : String(oldTraceCode || "");
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PDF·스크린샷·코드 유출 추적 | Matths 운영센터</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "pdf-forensics" }) %>
    <main class="admin-main admin-pdf-forensics">
      <header class="admin-heading">
        <div>
          <p>DOCUMENT &amp; SCREENSHOT FORENSICS</p>
          <h1>PDF·스크린샷·코드 유출 추적</h1>
          <span>파일의 숨김 정보·화면 워터마크를 분석하거나 보이는 추적 코드를 직접 입력해 발급·경기 기록을 조회합니다.</span>
        </div>
        <strong>3<small>중 식별 계층</small></strong>
      </header>

      <% if (error) { %>
        <div class="admin-feedback admin-feedback--error" role="alert"><span aria-hidden="true">!</span><%= error %></div>
      <% } %>

      <section class="admin-panel forensic-upload-panel">
        <div class="admin-panel-heading">
          <div><p>LEAKED MATERIAL INPUT</p><h2>유출 의심 파일·추적 코드 분석</h2></div>
          <span>파일과 추적 코드 중 한 가지만 선택하세요. 업로드 파일은 결과 생성 직후 삭제됩니다.</span>
        </div>
        <form action="/admin/pdf-forensics/analyze" method="POST" enctype="multipart/form-data" class="forensic-upload-form" data-forensic-analysis-form>
          <div class="forensic-input-options">
            <label>
              <span>파일 선택 <small>최대 50MB · PDF 또는 PNG·JPG·WEBP·HEIC</small></span>
              <input type="file" name="forensicFile" accept="application/pdf,image/png,image/jpeg,image/webp,image/heic,image/heif,.pdf,.png,.jpg,.jpeg,.webp,.heic,.heif" data-forensic-analysis-file />
            </label>
            <span class="forensic-input-or" aria-hidden="true">또는</span>
            <label>
              <span>추적 코드 직접 입력 <small>ARM-12자리 · MTH-16자리</small></span>
              <input type="text" name="traceCode" value="<%= traceCodeInput %>" maxlength="24" placeholder="ARM-8A73787C399A" autocomplete="off" autocapitalize="characters" spellcheck="false" data-forensic-trace-code />
            </label>
          </div>
          <button type="submit" data-forensic-analysis-submit>
            <span data-forensic-analysis-label>식별 정보 분석</span>
          </button>
          <p class="forensic-analysis-status" data-forensic-analysis-status hidden role="status" aria-live="polite">
            <span class="forensic-analysis-spinner" aria-hidden="true"></span>
            <span><strong>유출 자료 추적중</strong><small>워터마크와 사용자 식별 기록을 안전하게 대조하고 있습니다.</small></span>
          </p>
        </form>
      </section>

      <% if (analysis) { %>
        <% const isImageAnalysis = analysis.inputType === "IMAGE"; %>
        <% const isTraceCodeAnalysis = analysis.inputType === "TRACE_CODE"; %>
        <% if (analysis.inputType === "IMAGE" && analysis.imageMetadata) { %>
          <div class="admin-feedback admin-feedback--info" role="status">
            <span aria-hidden="true">i</span>
            <%= analysis.imageMetadata.format %> · <%= analysis.imageMetadata.width %>×<%= analysis.imageMetadata.height %>px · OCR 보정 <%= analysis.imageMetadata.ocrAttempts %>회
          </div>
        <% } %>
        <% if (isTraceCodeAnalysis) { %>
          <div class="admin-feedback admin-feedback--info" role="status">
            <span aria-hidden="true">i</span>
            <%= analysis.manualTraceCode %> · OCR 없이 발급·경기 원장을 정확 조회했습니다.
          </div>
        <% } %>
        <section class="admin-stat-grid forensic-summary" aria-label="분석 요약">
          <% if (isTraceCodeAnalysis) { %>
            <article><span>입력 방식</span><strong>직접 코드</strong></article>
          <% } else { %>
            <article><span><%= isImageAnalysis ? "분석 이미지" : "분석 페이지" %></span><strong><%= isImageAnalysis ? analysis.imageCount : analysis.pageCount %><small><%= isImageAnalysis ? "장" : "쪽" %></small></strong></article>
          <% } %>
          <article><span>추적 코드</span><strong><%= analysis.traceCodes.length %><small>개</small></strong></article>
          <% if (isTraceCodeAnalysis) { %>
            <article><span>조회 방식</span><strong>정확 일치</strong></article>
          <% } else { %>
            <article><span><%= isImageAnalysis ? "OCR 후보" : "페이지별 코드" %></span><strong><%= isImageAnalysis ? analysis.ocrCandidateCount : analysis.pageTraceCount %><small>개</small></strong></article>
          <% } %>
          <article><span>일치 식별 기록</span><strong><%= analysis.matches.length %><small>건</small></strong></article>
        </section>

        <% if (analysis.matches.length) { %>
          <section class="forensic-result-list" aria-label="사용자 식별 분석 결과">
            <% analysis.matches.forEach((match, index) => { %>
              <article class="admin-panel forensic-result-card">
                <header>
                  <div><span>일치 결과 <%= String(index + 1).padStart(2, "0") %></span><h2><%= match.username || match.email || match.userId %></h2></div>
                  <b class="<%= match.signatureVerified ? 'verified' : 'trace-only' %>"><%= match.signatureVerified ? "서명 검증 완료" : match.recognitionMethod === "MANUAL_TRACE_CODE" ? "직접 입력 코드 일치" : `스크린샷 일치 ${Math.round((match.ocrConfidence || 0) * 100)}%` %></b>
                </header>
                <dl>
                  <div><dt>사용자 ID</dt><dd><%= match.userId %></dd></div>
                  <div><dt>닉네임</dt><dd><%= match.username || "미등록" %></dd></div>
                  <div><dt>가입 이메일</dt><dd><%= match.email || "미등록" %></dd></div>
                  <div><dt>자료 출처</dt><dd><%= sourceLabels[match.sourceType] || match.sourceType %></dd></div>
                  <div><dt><%= match.sourceType === "ARENA_MATCH" ? "경기 ID" : "시험·상품 식별값" %></dt><dd><%= match.examId %></dd></div>
                  <div><dt><%= match.sourceType === "ARENA_MATCH" ? "경기 시작 시각" : "발급 시각" %></dt><dd><%= formatDateTime(match.downloadedAt) %></dd></div>
                  <div><dt>추적 코드</dt><dd><%= match.traceCode %></dd></div>
                  <div><dt><%= match.sourceType === "ARENA_MATCH" ? "경기 응시 ID" : "문서 발급 ID" %></dt><dd><%= match.sourceType === "ARENA_MATCH" ? match.attemptId : match.documentIssueId %></dd></div>
                  <% if (match.sourceType === "ARENA_MATCH") { %>
                    <div><dt>참가 역할</dt><dd><%= match.role === "CHALLENGER" ? "공격자" : "방어자" %></dd></div>
                    <div><dt>응시 상태</dt><dd><%= attemptStatusLabels[match.attemptStatus] || match.attemptStatus %></dd></div>
                  <% } %>
                  <% if (["IMAGE_OCR", "ARENA_IMAGE_OCR"].includes(match.recognitionMethod)) { %>
                    <div><dt>OCR 인식값</dt><dd><%= match.matchedCandidate %></dd></div>
                  <% } %>
                  <% if (match.recognitionMethod === "MANUAL_TRACE_CODE") { %>
                    <div><dt>직접 입력값</dt><dd><%= match.matchedCandidate %></dd></div>
                  <% } %>
                  <div class="wide"><dt>원본 파일명</dt><dd><%= match.originalName %></dd></div>
                </dl>
              </article>
            <% }) %>
          </section>
        <% } else if (analysis.validPayloads.length) { %>
          <section class="forensic-result-list" aria-label="PDF 파일 자체 서명 분석 결과">
            <% analysis.validPayloads.forEach((payload, index) => { %>
              <article class="admin-panel forensic-result-card">
                <header>
                  <div><span>파일 자체 서명 <%= String(index + 1).padStart(2, "0") %></span><h2>DB 계정 매핑 없음</h2></div>
                  <b class="verified">서명 검증 완료</b>
                </header>
                <dl>
                  <div><dt>내부 사용자 ID</dt><dd><%= payload.user_id %></dd></div>
                  <div><dt>시험·상품 식별값</dt><dd><%= payload.exam_id %></dd></div>
                  <div><dt>자료 출처</dt><dd><%= sourceLabels[payload.source_type] || payload.source_type %></dd></div>
                  <div><dt>발급 시각</dt><dd><%= formatDateTime(payload.downloaded_at) %></dd></div>
                  <div><dt>추적 코드</dt><dd><%= payload.trace_code %></dd></div>
                  <div><dt>문서 발급 ID</dt><dd><%= payload.document_issue_id %></dd></div>
                </dl>
              </article>
            <% }) %>
          </section>
        <% } %>
      <% } %>

      <section class="admin-panel forensic-guide">
        <div class="admin-panel-heading"><div><p>HOW IT WORKS</p><h2>식별 계층과 판정 한계</h2></div></div>
        <div>
          <article><b>01</b><strong>가시 추적 무늬·이미지 OCR</strong><span>PDF의 MTH 코드와 GOAT Arena 화면의 ARM 코드를 기울기·명암 보정해 스크린샷에서도 찾습니다.</span></article>
          <article><b>02</b><strong>서명된 문서 정보</strong><span>사용자 ID, 시험·상품 ID, 다운로드 시각을 위·변조 확인이 가능한 서버 서명과 PDF 메타데이터에 기록합니다.</span></article>
          <article><b>03</b><strong>페이지별 식별 코드</strong><span>일부 페이지만 유출되어도 찾을 수 있도록 페이지마다 서로 다른 미세 문자와 좌표 패턴을 삽입합니다.</span></article>
        </div>
        <p>PDF를 이미지로 바꿔도 반복 추적 코드가 남아 있으면 대조할 수 있습니다. 다만 워터마크를 심하게 잘라내거나 덧칠하고, 매우 낮은 해상도·강한 압축·과도한 회전이 적용된 이미지는 인식률이 낮아질 수 있습니다. 이미지 OCR 결과는 유사도와 원본 발급 기록을 함께 확인하고 단독으로 제재를 확정하는 자료로 사용하지 마세요.</p>
      </section>
    </main>
    <script>
      (() => {
        const form = document.querySelector("[data-forensic-analysis-form]");
        const submitButton = form?.querySelector("[data-forensic-analysis-submit]");
        const fileInput = form?.querySelector("[data-forensic-analysis-file]");
        const traceCodeInput = form?.querySelector("[data-forensic-trace-code]");
        const status = form?.querySelector("[data-forensic-analysis-status]");
        const label = form?.querySelector("[data-forensic-analysis-label]");

        const validateInputChoice = () => {
          const hasFile = Boolean(fileInput?.files?.length);
          const hasTraceCode = Boolean(traceCodeInput?.value?.trim());
          const message = hasFile === hasTraceCode
            ? hasFile
              ? "파일과 추적 코드 중 한 가지만 선택해야 합니다."
              : "파일을 선택하거나 추적 코드를 입력해야 합니다."
            : "";
          traceCodeInput?.setCustomValidity(message);
          return !message;
        };

        fileInput?.addEventListener("change", validateInputChoice);
        traceCodeInput?.addEventListener("input", validateInputChoice);

        form?.addEventListener("submit", (event) => {
          if (form.dataset.submitting === "true") {
            event.preventDefault();
            return;
          }
          if (!validateInputChoice() || !form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
            return;
          }

          form.dataset.submitting = "true";
          form.classList.add("is-submitting");
          form.setAttribute("aria-busy", "true");
          if (submitButton) submitButton.disabled = true;
          if (label) label.textContent = "유출 자료 추적중";
          if (status) status.hidden = false;
        });
      })();
    </script>
  </body>
</html>

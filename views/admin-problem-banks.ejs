<%
  const runtimeItems = (catalog.items || []).filter((item) =>
    /GOAT Arena 2\.x|배치고사 문제 은행|배치고사 심화 유형 은행|학습·평가 문제 생성기|평가지 구성 템플릿|Matths 주간 공식 모의고사/.test(item.name)
  );
  const statusLabel = (value) => value === "ACTIVE" ? "적용 중" : value === "RETIRED" ? "이전 버전" : value || "확인 필요";
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>문제 데이터 관리 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "problem-banks" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div><p>PROBLEM DATA CONTROL</p><h1>문제 데이터 관리</h1><span>현행 Arena 문제 생성 경로와 학습·평가 생성기만 관리합니다.</span></div>
        <strong><%= runtimeItems.length + typeCatalog.categories.reduce((sum, category) => sum + category.count, 0) %><small>개 관리 항목</small></strong>
      </header>

      <% if (error) { %><div class="admin-feedback admin-feedback--error" role="alert"><span aria-hidden="true">!</span><div><strong>처리하지 못했습니다.</strong><br /><%= error %></div></div><% } %>
      <% if (query.typeSync || query.typeRevised) { %>
        <div class="admin-feedback" role="status"><span aria-hidden="true">✓</span><div><strong><%= query.typeRevised ? "새 문제 유형 리비전을 적용했습니다." : "서버 생성기와 DB 문제 유형을 동기화했습니다." %></strong><br /><% if (query.typeSync) { %>신규 <%= Number(query.inserted || 0) %>개 · 소스 갱신 <%= Number(query.updated || 0) %>개입니다.<% } else { %>이전 리비전은 감사 이력으로 보존했습니다.<% } %></div></div>
      <% } %>

      <section class="admin-panel problem-data-overview">
        <div class="admin-panel-heading"><div><p>CURRENT ARENA CONTRACT</p><h2>현행 경기 문제 규칙</h2></div><span>운영 화면에서 임의 코드 실행 없음</span></div>
        <div class="admin-metric-row">
          <div><span>경기 문항</span><strong><%= catalog.arenaRuntime.questionCount %>문항</strong><small>문항당 <%= catalog.arenaRuntime.minutesPerQuestion %>분</small></div>
          <div><span>문제 세트</span><strong>서로 다름</strong><small>플레이어별 독립 생성</small></div>
          <div><span>난도 데이터</span><strong>정답률 기반</strong><small>내부 비교 지표에 사용</small></div>
          <div><span>풀이 제출</span><strong>필수</strong><small>일반전·경쟁전·친선전</small></div>
        </div>
        <div class="problem-data-guardrail" role="note"><strong>Arena 문제 구성은 코드 배포와 자동 검산을 거쳐 변경합니다.</strong><p>현재 경기에서 사용하지 않는 구형 난이도 카탈로그와 브라우저 초안 활성화 기능은 운영 메뉴에서 제거했습니다. 이미 시작한 경기와 과거 문제 팩은 당시 스냅샷을 그대로 유지합니다.</p></div>
        <div class="admin-policy-list">
          <% runtimeItems.forEach((item) => { %>
            <article class="admin-policy-card"><header><div><span><%= item.status %></span><h3><%= item.name %></h3><small><%= item.purpose %></small></div></header><% if (item.file) { %><code><%= item.file %></code><% } %></article>
          <% }) %>
        </div>
      </section>

      <section class="admin-panel problem-type-catalog" id="problem-type-catalog">
        <div class="admin-panel-heading problem-type-heading">
          <div><p>LEARNING & ASSESSMENT</p><h2>학습·평가 문제 유형</h2><span>개념학습, 평가센터와 배치고사 생성기를 버전별로 관리합니다.</span></div>
          <form method="post" action="/admin/problem-banks/types/sync" onsubmit="return confirm('서버 생성기를 검산하고 DB에 새 리비전으로 반영할까요?')"><input type="hidden" name="category" value="<%= typeCatalog.selectedCategory %>" /><button class="problem-type-sync-button" type="submit">서버 생성기 검산·동기화</button></form>
        </div>

        <nav class="problem-type-category-tabs" aria-label="문제 유형 분류">
          <% typeCatalog.categories.forEach((category) => { %><a href="/admin/problem-banks?category=<%= category.key %>#problem-type-catalog" class="<%= category.key === typeCatalog.selectedCategory ? 'is-active' : '' %>"><strong><%= category.label %></strong><small><%= category.count %>개</small></a><% }) %>
        </nav>
        <form class="admin-filter-form admin-audit-filter" method="get" action="/admin/problem-banks"><input type="hidden" name="category" value="<%= typeCatalog.selectedCategory %>" /><label class="wide"><span>유형 검색</span><input type="search" name="q" value="<%= typeCatalog.query %>" maxlength="120" placeholder="이름·코드·과목·개념" /></label><button type="submit">검색</button></form>

        <% if (!typeCatalog.entries.length) { %><p class="admin-empty">조건에 맞는 문제 유형이 없습니다.</p><% } else { %>
          <div class="admin-table-wrap"><table><thead><tr><th>문제 유형</th><th>범위</th><th>상태</th><th>가중치</th><th>검산</th><th>리비전</th><th>관리</th></tr></thead><tbody>
            <% typeCatalog.entries.forEach((entry) => { %><tr><td><strong><%= entry.displayName %></strong><small><code><%= entry.engineKey %></code></small></td><td><%= [entry.courseId, entry.unitId, entry.conceptId].filter(Boolean).join(" · ") || "공통" %></td><td><%= entry.enabled ? "출제 사용" : "출제 제외" %><%= entry.codeChanged ? " · 코드 변경 감지" : "" %></td><td><%= entry.selectionWeight %></td><td><%= entry.validationReport?.passed ? "통과" : "확인 필요" %></td><td>r<%= entry.revision %> · <%= statusLabel(entry.status) %></td><td><a href="/admin/problem-banks?category=<%= typeCatalog.selectedCategory %>&q=<%= encodeURIComponent(typeCatalog.query) %>&inspect=<%= entry._id %>#problem-type-catalog">코드·설정 보기</a></td></tr><% }) %>
          </tbody></table></div>
        <% } %>

        <% if (typeCatalog.inspected) { const inspected = typeCatalog.inspected; %>
          <section class="problem-type-inspector">
            <header><div><span>CURRENT SOURCE SNAPSHOT</span><h3><%= inspected.displayName %></h3><code><%= inspected.engineKey %></code></div><a href="/admin/problem-banks?category=<%= typeCatalog.selectedCategory %>#problem-type-catalog">닫기</a></header>
            <div class="problem-type-inspector-grid">
              <div class="problem-type-source-pane"><div><strong>DB 보존 소스 · r<%= inspected.revision %></strong><span><%= inspected.sourceFile %></span></div><pre><code><%= inspected.sourceSnapshot %></code></pre></div>
              <aside><form method="post" action="/admin/problem-banks/types/<%= inspected._id %>/revise" onsubmit="return confirm('현재 설정을 기반으로 새 리비전을 만들까요? 이전 리비전은 보존됩니다.')"><input type="hidden" name="category" value="<%= inspected.category %>" /><label class="problem-type-toggle"><input type="checkbox" name="enabled" value="1" <%= inspected.enabled ? 'checked' : '' %> /><span>신규 출제에 사용</span></label><label>출제 가중치<input type="number" name="selectionWeight" value="<%= inspected.selectionWeight %>" min="1" max="100" required /></label><label>운영 메모<textarea name="operatorNote" rows="5" maxlength="1000"><%= inspected.operatorNote || '' %></textarea></label><button type="submit">5회 검산 후 새 리비전 적용</button></form></aside>
            </div>
            <% if (inspected.currentServerHash && inspected.currentServerHash !== inspected.sourceHash) { %><div class="problem-type-source-warning"><strong>서버 코드 변경이 감지되었습니다.</strong><span>동기화를 실행하면 현재 설정을 유지한 새 리비전으로 추가됩니다.</span></div><% } %>
            <div class="problem-type-history"><h4>리비전 이력</h4><% typeCatalog.history.forEach((version) => { %><div><b>r<%= version.revision %></b><span><%= statusLabel(version.status) %></span><span><%= version.enabled ? '사용' : '출제 제외' %> · 가중치 <%= version.selectionWeight %></span><time><%= new Date(version.createdAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) %></time></div><% }) %></div>
          </section>
        <% } %>
      </section>
    </main>
  </body>
</html>

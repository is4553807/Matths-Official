<%
  const formatWon = (value) => `${new Intl.NumberFormat("ko-KR").format(Number(value) || 0)}원`;
  const formatDate = (value) => value ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "-";
  const statusLabels = { REQUESTED: "접수", CALCULATED: "산정 완료", COMPLETED: "취소 완료", REJECTED: "반려" };
  const pageHref = (page) => `/admin/refunds?status=${encodeURIComponent(refundData.status || "all")}&page=${page}`;
%>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>환불 관리 | Matths</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="stylesheet" href="/css/brand.css" />
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/contrast.css" />

</head>
<body class="admin-page">
  <%- include("partials/admin-navigation", { activePage: "refunds" }) %>
  <main class="admin-main">
    <header class="admin-heading"><div><p>PAYMENT REFUNDS</p><h1>환불 관리</h1><span>토스 결제는 환불 완료 버튼을 누르면 서버가 취소 API를 호출하고, 성공 응답을 확인한 뒤 권한을 종료합니다.</span></div><strong><%= refundData.total %><small>건</small></strong></header>
    <% if (feedback) { %><div class="admin-feedback" role="status"><%= feedback %></div><% } %>
    <form class="admin-filter-bar" method="get"><label><span>처리 상태</span><select name="status"><option value="all">전체</option><% Object.entries(statusLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= refundData.status === value ? "selected" : "" %>><%= label %></option><% }) %></select></label><button type="submit">필터 적용</button></form>

    <section class="admin-inquiry-list">
      <% if (!refundData.requests.length) { %><div class="admin-empty">조건에 맞는 환불 신청이 없습니다.</div><% } %>
      <% refundData.requests.forEach((request) => { const requester = request.userId || {}; %>
        <article class="admin-inquiry-card" id="refund-<%= request._id %>">
          <header><div><span><%= statusLabels[request.status] || request.status %></span><h2><%= request.productNameSnapshot %></h2><p><%= requester.realName || requester.name || "탈퇴 사용자" %> · <%= requester.email || "이메일 없음" %></p></div><div><strong><%= request.orderReferenceSnapshot %></strong><small>접수 <%= formatDate(request.requestedAt) %> · 처리기한 <%= formatDate(request.processingDeadlineAt) %></small></div></header>
          <div class="admin-inquiry-content"><strong>신청 경로: <%= request.requestedByType === "PARENT" ? "학부모 결제 관리" : "학생 문의" %></strong><br /><%= request.reasonDetail %></div>
          <% if (request.status === "REQUESTED") { %>
            <form class="admin-filter-bar" action="/admin/refunds/<%= request._id %>/calculate" method="post">
              <label><span>유료 기능 이용 여부</span><select name="paidFeatureUsed"><option value="false">이용 기록 없음</option><option value="true">한 번 이상 이용</option></select></label>
              <button type="submit">환불 예정액 산정</button>
            </form>
          <% } %>
          <% if (request.status === "CALCULATED") { %>
            <div class="admin-inquiry-content"><strong>자동 산정액 <%= formatWon(request.calculation?.calculatedAmount) %></strong><br />이용일수 <%= request.calculation?.usedDays %>일 · <%= request.calculation?.formula %><br />산정 관리자 <%= request.calculation?.calculatedBy?.realName || request.calculation?.calculatedBy?.name || "확인 필요" %></div>
            <form class="admin-inquiry-actions" action="/admin/refunds/<%= request._id %>/complete" method="post">
              <label>실제 승인금액<input name="approvedAmount" type="number" min="1" max="<%= request.calculation?.approvedAmount %>" value="<%= request.calculation?.calculatedAmount %>" required /></label>
              <label>취소 유형<select name="cancellationMode" required><option value="FULL" <%= request.calculation?.calculationType === "FULL" ? "selected" : "" %>>전체 취소</option><option value="PARTIAL" <%= request.calculation?.calculationType !== "FULL" ? "selected" : "" %>>부분 취소</option></select></label>
              <% if (request.paymentId?.provider !== "TOSS") { %>
                <label>결제사 취소 거래키<input name="providerCancellationTransactionKey" minlength="6" maxlength="200" required /></label>
                <label>결제사 취소 처리시각<input name="providerCancelledAt" type="datetime-local" required /></label>
              <% } else { %>
                <div class="admin-inquiry-content">토스 <%= request.paymentId.providerMode %> 취소 API가 승인금액을 원 결제수단으로 자동 취소합니다.</div>
              <% } %>
              <label>운영 메모<textarea name="operatorNote" maxlength="1000" rows="3" required></textarea></label>
              <button type="submit">결제 취소 및 환불 완료</button>
            </form>
          <% } %>
          <% if (request.status === "COMPLETED") { %>
            <div class="admin-inquiry-content"><strong><%= formatWon(request.decision?.approvedAmount) %> <%= request.decision?.cancellationMode === "FULL" ? "전체" : "부분" %> 취소 완료</strong><br />거래키 <%= request.decision?.providerCancellationTransactionKey %> · 처리 <%= formatDate(request.decision?.processedAt) %><br />처리 관리자 <%= request.decision?.processedBySnapshot?.name || request.decision?.processedBy?.realName || request.decision?.processedBy?.name || "확인 필요" %></div>
          <% } %>
        </article>
      <% }) %>
    </section>
    <nav class="admin-pagination" aria-label="환불 페이지"><a class="<%= refundData.page <= 1 ? 'disabled' : '' %>" href="<%= pageHref(Math.max(1, refundData.page - 1)) %>">← 이전</a><span><strong><%= refundData.page %></strong> / <%= refundData.totalPages %></span><a class="<%= refundData.page >= refundData.totalPages ? 'disabled' : '' %>" href="<%= pageHref(Math.min(refundData.totalPages, refundData.page + 1)) %>">다음 →</a></nav>
  </main>
</body>
</html>

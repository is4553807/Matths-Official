<%
  const editing = storeData.editing;
  const storeCategories = Array.isArray(storeData.categories) ? storeData.categories : [];
  const defaultStoreCategory = storeCategories.find((category) => category.isVisible)?.name || storeCategories[0]?.name || "";
  const formProduct = editing || { name:"", category:defaultStoreCategory, badge:"", subtitle:"", summary:"", price:"", originalPrice:"", popularityScore:0, status:"DRAFT", bundleItems:[], detailBlocks:[], productFiles:[] };
  const textBlocks = formProduct.detailBlocks.filter((block) => block.type === "TEXT");
  const formatBytes = (bytes) => Number(bytes) < 1024 ** 2 ? `${(Number(bytes) / 1024).toFixed(1)} KB` : `${(Number(bytes) / 1024 ** 2).toFixed(1)} MB`;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>상점 관리 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/store.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <script src="/js/admin-store.js" defer></script>
  </head>
  <body class="admin-page admin-store-page">
    <%- include("partials/admin-navigation", { activePage: "store" }) %>
    <main class="admin-main">
      <header class="admin-heading"><div><p>MATTHS STORE</p><h1>교재 상점 관리</h1><span>GOAT Arena 상점과 분리된 현금 판매 교재 카탈로그입니다.</span></div><strong><%= storeData.products.length %><small>개 상품</small></strong></header>
      <% if (feedback) { %><div class="store-admin-feedback <%= feedback.type %>" role="status"><%= feedback.message %></div><% } %>
      <% if (error) { %><div class="store-admin-feedback error" role="alert"><%= error %></div><% } %>

      <section class="admin-panel store-category-manager" id="store-categories">
        <div class="admin-panel-heading"><div><p>NAVIGATION</p><h2>Navbar 카테고리 관리</h2></div><span>끌어서 순서 변경</span></div>
        <p class="store-category-guide">공개한 카테고리만 사용자 상점 상단에 표시됩니다. 상품이 연결된 카테고리는 다른 분류로 옮긴 뒤 삭제할 수 있습니다.</p>
        <form class="store-category-create" action="/admin/store/categories" method="POST">
          <label><span>새 카테고리 이름</span><input name="name" maxlength="40" placeholder="예: 기출 분석" required /></label>
          <button type="submit">카테고리 추가</button>
        </form>
        <ol class="store-category-list" data-store-category-list>
          <% storeCategories.forEach((category) => { %>
            <li draggable="true" data-category-id="<%= category.id %>">
              <button class="store-category-drag" type="button" aria-label="<%= category.name %> 순서 이동">⋮⋮</button>
              <form class="store-category-edit" action="/admin/store/categories/<%= category.id %>" method="POST">
                <input name="name" value="<%= category.name %>" maxlength="40" required />
                <label><input type="checkbox" name="isVisible" <%= category.isVisible ? "checked" : "" %> /> 사용자 Navbar에 공개</label>
                <small>연결 상품 <%= category.productCount %>개</small>
                <button type="submit">저장</button>
              </form>
              <form action="/admin/store/categories/<%= category.id %>/delete" method="POST" onsubmit="return window.confirm('이 카테고리를 삭제할까요?');">
                <button class="store-category-delete" type="submit" <%= category.productCount > 0 ? "disabled" : "" %> title="<%= category.productCount > 0 ? '연결된 상품 분류를 먼저 변경해주세요.' : '카테고리 삭제' %>">삭제</button>
              </form>
            </li>
          <% }) %>
        </ol>
        <form class="store-category-order" action="/admin/store/categories/reorder" method="POST" data-store-category-order-form>
          <input type="hidden" name="categoryOrderJson" value="[]" data-store-category-order-json />
          <button type="submit">Navbar 순서 저장</button>
        </form>
      </section>

      <section class="admin-panel store-admin-editor" id="product-editor">
        <div class="admin-panel-heading"><div><p><%= editing ? "EDIT PRODUCT" : "NEW PRODUCT" %></p><h2><%= editing ? "묶음 상품 수정" : "새 묶음 상품 만들기" %></h2></div><% if (editing) { %><a href="/admin/store#product-editor">새 상품 입력</a><% } %></div>
        <form class="admin-form store-product-form" action="<%= editing ? `/admin/store/products/${editing.id}` : '/admin/store/products' %>" method="POST" enctype="multipart/form-data" data-store-product-form>
          <div class="store-form-grid">
            <label><span>묶음 상품 이름</span><input name="name" value="<%= formProduct.name %>" maxlength="120" required /></label>
            <label><span>분류</span><select name="category" required>
              <% if (formProduct.category && !storeCategories.some((category) => category.name === formProduct.category)) { %><option value="<%= formProduct.category %>" selected><%= formProduct.category %> · 이전 분류</option><% } %>
              <% storeCategories.forEach((category) => { %><option value="<%= category.name %>" <%= formProduct.category === category.name ? "selected" : "" %>><%= category.name %><%= category.isVisible ? "" : " · Navbar 숨김" %></option><% }) %>
            </select></label>
            <label><span>카드 배지</span><input name="badge" value="<%= formProduct.badge %>" maxlength="50" placeholder="예: 수능 직전 파이널" /></label>
            <label><span>한 줄 설명</span><input name="subtitle" value="<%= formProduct.subtitle %>" maxlength="180" /></label>
            <label><span>판매 가격(원)</span><input type="number" name="price" value="<%= formProduct.price %>" min="0" max="100000000" required /></label>
            <label><span>정가(선택)</span><input type="number" name="originalPrice" value="<%= formProduct.originalPrice || '' %>" min="0" max="100000000" /></label>
            <label><span>인기 정렬 점수</span><input type="number" name="popularityScore" value="<%= formProduct.popularityScore %>" min="0" max="1000000" /></label>
            <label><span>게시 상태</span><select name="status"><option value="DRAFT" <%= formProduct.status === 'DRAFT' ? 'selected' : '' %>>초안·비공개</option><option value="PUBLISHED" <%= formProduct.status === 'PUBLISHED' ? 'selected' : '' %>>판매 목록 공개</option><option value="ARCHIVED" <%= formProduct.status === 'ARCHIVED' ? 'selected' : '' %>>판매 종료</option></select></label>
          </div>
          <label><span>카드·상세 상단 요약</span><textarea name="summary" rows="4" maxlength="1000"><%= formProduct.summary %></textarea></label>
          <label><span>묶음 구성</span><textarea name="bundleItems" rows="6" placeholder="한 줄에 하나씩: 자료 이름 | 짧은 설명"><%= formProduct.bundleItems.map((item) => `${item.name}${item.description ? ` | ${item.description}` : ''}`).join('\n') %></textarea><small>업로드한 자료들을 사용자에게 보여줄 구성 단위로 정리합니다. 예: 문제지 PDF | 30문항 4회분</small></label>

          <div class="store-upload-grid">
            <label class="store-file-picker"><span>상품 썸네일 <%= editing ? "교체" : "업로드" %></span><input type="file" name="thumbnail" accept=".png,.jpg,.jpeg,.webp" <%= editing ? "" : "required" %> /><small>상품 카드와 상세 페이지 상단에 표시됩니다.</small></label>
            <label class="store-file-picker"><span>묶음 판매 자료</span><input type="file" name="productFiles" accept=".pdf,.zip,.doc,.docx,.xls,.xlsx,.ppt,.pptx" multiple /><small>비공개 서버 저장소에 보관하며 현재 사용자에게 직접 노출하지 않습니다.</small></label>
            <label class="store-file-picker"><span>상세 설명 PNG·이미지</span><input type="file" name="detailImages" accept=".png,.jpg,.jpeg,.webp" multiple /><small>업로드 순서대로 긴 상세 설명의 아래쪽에 렌더됩니다.</small></label>
          </div>

          <% if (editing?.assets?.length) { %><div class="store-admin-file-list"><strong>현재 연결된 파일</strong><% editing.assets.forEach((file) => { %><label><input type="checkbox" name="removeAssetIds" value="<%= file.id %>" /><span><b><%= file.kind === 'THUMBNAIL' ? '썸네일' : file.kind === 'DETAIL_IMAGE' ? '상세 이미지' : '판매 자료' %> · <%= file.originalName %></b><small><%= formatBytes(file.sizeBytes) %> · 선택 시 저장할 때 삭제</small></span></label><% }) %></div><% } %>

          <section class="store-rich-editor" data-store-editor data-initial-blocks="<%- JSON.stringify(textBlocks).replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/</g, '&lt;') %>">
            <header><div><p>DETAIL EDITOR</p><h3>파일 상세 설명</h3></div><button type="button" data-add-text-block>+ 문구 블록 추가</button></header>
            <p class="store-editor-guide">각 문구 블록마다 글자 크기·색상·굵기·밑줄·정렬을 정할 수 있습니다. 저장 시 허용된 서식 값만 DB에 기록됩니다.</p>
            <div data-text-block-list></div>
            <input type="hidden" name="detailBlocksJson" value="[]" data-detail-blocks-json />
          </section>
          <button type="submit"><%= editing ? "상품 변경사항 저장" : "묶음 상품 등록" %></button>
        </form>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>CATALOG</p><h2>등록 상품</h2></div><a href="/store" target="_blank" rel="noopener">사용자 상점 열기 →</a></div>
        <% if (!storeData.products.length) { %><p class="admin-empty">아직 등록한 상품이 없습니다.</p><% } else { %><div class="admin-store-list">
          <% storeData.products.forEach((product) => { %><article><div class="admin-store-thumb"><% if (product.thumbnail) { %><img src="/store/media/<%= product.id %>/<%= product.thumbnail.id %>" alt="" /><% } else { %><span>MATTHS</span><% } %></div><div><p><%= product.status === 'PUBLISHED' ? '공개' : product.status === 'DRAFT' ? '초안' : '판매 종료' %> · <%= product.category %></p><h3><%= product.name %></h3><span><%= product.bundleItems.length %>개 구성 · <%= new Intl.NumberFormat('ko-KR').format(product.price) %>원 · 조회 <%= product.viewCount %></span></div><div class="admin-store-actions"><a href="/admin/store?edit=<%= product.id %>#product-editor">수정</a><% if (product.status === 'PUBLISHED') { %><a href="/store/products/<%= product.slug %>" target="_blank" rel="noopener">보기</a><% } %><form action="/admin/store/products/<%= product.id %>/delete" method="POST" onsubmit="return window.confirm('상품과 연결된 서버 파일을 모두 삭제할까요? 되돌릴 수 없습니다.');"><button type="submit">삭제</button></form></div></article><% }) %>
        </div><% } %>
      </section>
    </main>
  </body>
</html>

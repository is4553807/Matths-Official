<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>테스트 리모콘 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  </head>
  <body class="admin-page admin-test-control-page">
    <%- include("partials/admin-navigation", { activePage: "test-control" }) %>
    <main class="admin-test-control-shell">
      <header class="admin-test-control-hero">
        <div><p>SAFE TEST CLOCK</p><h1>테스트 리모콘</h1><span>운영체제 시각을 바꾸지 않고, 테스트 화면에서만 미래 날짜를 미리 봅니다.</span></div>
        <strong class="<%= testData.clock.enabled ? 'is-ready' : 'is-locked' %>"><%= testData.clock.enabled ? "로컬 테스트 전용" : "운영 환경 잠금" %></strong>
      </header>

      <section class="admin-test-clock-grid">
        <article><small>실제 KST</small><strong><%= new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "full", timeStyle: "medium" }).format(new Date(testData.clock.realNow)) %></strong></article>
        <article class="virtual"><small>가상 KST</small><strong><%= new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "full", timeStyle: "medium" }).format(new Date(testData.clock.virtualNow)) %></strong><span>+<%= testData.clock.offsetDays %>일</span></article>
      </section>

      <section class="admin-test-control-panel">
        <header><div><p>TIME PREVIEW</p><h2>날짜 이동</h2></div><span>태그된 테스트 계정 전용</span></header>
        <div class="admin-test-control-actions">
          <% [1, 7, 19, 20, 29, 30].forEach((days) => { %>
            <form method="post" action="/admin/test-control/clock"><input type="hidden" name="offsetDays" value="<%= days %>" /><button type="submit" <%= testData.clock.enabled ? "" : "disabled" %>>+<%= days %>일</button></form>
          <% }) %>
          <form method="post" action="/admin/test-control/clock"><input type="hidden" name="offsetDays" value="0" /><button class="reset" type="submit" <%= testData.clock.enabled ? "" : "disabled" %>>실제 시간으로 초기화</button></form>
        </div>
        <div class="admin-test-warning"><strong>중요</strong><p>이 리모콘은 DB 만료시각·Cloudinary·R2·이메일·PG·MongoDB TTL·브라우저 시계를 바꾸지 않습니다. 실제 데이터를 미래로 처리하지 않고 결과를 미리 보는 안전한 방식입니다. 테스트 데이터 자체를 처음 상태로 되돌리려면 테스트 계정 시드 작업을 다시 실행합니다.</p></div>
      </section>

      <section class="admin-test-control-panel">
        <header><div><p>FIXTURE STATUS</p><h2>테스트 데이터 현황</h2></div><span>remark: test</span></header>
        <dl class="admin-test-counts">
          <div><dt>전체</dt><dd><%= testData.counts.users %></dd></div>
          <div><dt>Sub Division</dt><dd><%= testData.counts.sub %></dd></div>
          <div><dt>Main Division</dt><dd><%= testData.counts.main %></dd></div>
          <div><dt>활성 학습권</dt><dd><%= testData.counts.activeCycles %></dd></div>
          <div><dt>가상 시각상 만료</dt><dd><%= testData.counts.cyclesExpiredAtVirtualTime %></dd></div>
        </dl>
      </section>
    </main>
  </body>
</html>

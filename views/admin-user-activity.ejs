<%
  const member = activity.user;
  const categories = [
    ["learning", "학습 행동"],
    ["problems", "개념 문제"],
    ["quick", "40초 눈풀이"],
    ["assessments", "평가 기록"],
    ["community", "게시판"],
    ["moderation", "관리 작업"],
  ];
  const eventLabels = {
    "concept-opened": "개념 열기",
    "concept-closed": "개념 닫기",
    "step-viewed": "학습 단계 보기",
    "step-replayed": "학습 단계 다시 보기",
    "hint-used": "힌트 사용",
    "problem-opened": "문제 열기",
    "problem-attempted": "문제 답안 제출",
    "problem-correct": "문제 정답",
    "problem-wrong": "문제 오답",
    "topic-completed": "유형 완료",
    "topic-uncompleted": "유형 완료 취소",
    "concept-completed": "개념 완료",
    "review-started": "오답 복습 시작",
    "review-completed": "오답 복습 완료",
    "recommendation-shown": "추천 노출",
    "recommendation-clicked": "추천 클릭",
  };
  const statusLabels = {
    active: "응시 중",
    correct: "정답",
    wrong: "오답",
    expired: "시간 초과",
    draft: "저장 중",
    submitted: "제출",
    disqualified: "실격",
    published: "공개",
    hidden: "숨김",
    deleted: "삭제",
  };
  const scopeLabels = {
    placement: "배치고사",
    subunit: "중간 평가",
    unit: "기말 평가",
    course: "종합 평가",
  };
  const boardLabels = {
    integrated: "통합 게시판",
    school: "학교 게시판",
    repeater: "N수생 게시판",
  };
  const actionLabels = {
    "announcement.create": "공지 등록",
    "announcement.publish": "공지 공개",
    "announcement.unpublish": "공지 공개 중지",
    "user.nickname-request": "닉네임 변경 요청",
    "user.notification": "사이트 알림 발송",
    "user.email": "개별 이메일 발송",
    "user.password-reset": "비밀번호 재설정 발송",
    "user.deactivate": "계정 비활성화",
    "user.restore": "계정 복원",
    "user.role": "사용자 역할 변경",
    "user.account-status": "계정 상태 변경",
    "user.account-withdrawal": "계정 탈퇴 처리",
    "user.warning-count": "경고 횟수 수정",
    "inquiry.reply": "문의 이메일 답변",
    "inquiry.status": "문의 상태 변경",
    "private-mock.integrity-review": "Matths 주간 공식 모의고사 소명 검토",
    "private-mock.integrity-penalty": "Matths 주간 공식 모의고사 페널티 부여",
    "community.report-reviewing": "게시글 신고 검토 시작",
    "community.report-resolved": "게시글 신고 처리 완료",
    "community.report-rejected": "게시글 신고 반려",
    "community.post-warning": "게시글 경고",
  };
  const formatDate = (value) =>
    value
      ? new Intl.DateTimeFormat("ko-KR", {
          timeZone: "Asia/Seoul",
          dateStyle: "medium",
          timeStyle: "medium",
        }).format(new Date(value))
      : "기록 없음";
  const formatDuration = (value) => {
    const milliseconds = Math.max(0, Number(value) || 0);
    if (!milliseconds) return "0초";
    if (milliseconds < 1000) return `${milliseconds}밀리초`;
    const seconds = Math.floor(milliseconds / 1000);
    const minutes = Math.floor(seconds / 60);
    const remainder = seconds % 60;
    return minutes ? `${minutes}분 ${remainder}초` : `${seconds}초`;
  };
  const formatAnswer = (value) => {
    if (value === null || value === undefined || value === "") return "미응답";
    if (typeof value === "object") {
      try {
        return JSON.stringify(value);
      } catch (error) {
        return String(value);
      }
    }
    return String(value);
  };
  const formatMetadata = (value) => {
    if (!value || (typeof value === "object" && !Object.keys(value).length)) {
      return "";
    }
    try {
      return JSON.stringify(value, null, 2);
    } catch (error) {
      return String(value);
    }
  };
  const pageHref = (page) =>
    `/admin/users/${member._id}/activity?kind=${encodeURIComponent(activity.kind)}&page=${page}`;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= member.name %> 전체 활동 기록 | Matths Admin</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [["\\(", "\\)"]],
          displayMath: [["\\[", "\\]"]],
          processEscapes: true,
        },
        options: {
          enableSpeech: false,
          enableBraille: false,
          enableExplorer: false,
          skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"],
        },
      };
    </script>
    <script src="/vendor/mathjax/tex-svg.js" defer></script>
    <script src="/js/math-renderer.js" defer></script>
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "users" }) %>
    <main class="admin-main">
      <a class="admin-back" href="/admin/users/<%= member._id %>">← <%= member.name %> 사용자 관리</a>
      <header class="admin-heading">
        <div>
          <p>COMPLETE ACTIVITY LOG</p>
          <h1>전체 활동 기록</h1>
          <span><%= member.realName || "실명 미입력" %> · <%= member.email %></span>
        </div>
        <strong><%= activity.pagination.total %>건</strong>
      </header>

      <nav class="admin-activity-tabs" aria-label="활동 기록 종류">
        <% categories.forEach(([value, label]) => { %>
          <a
            class="<%= activity.kind === value ? 'active' : '' %>"
            href="/admin/users/<%= member._id %>/activity?kind=<%= value %>"
            <%- activity.kind === value ? 'aria-current="page"' : "" %>
          ><%= label %></a>
        <% }) %>
      </nav>

      <section class="admin-panel admin-full-activity">
        <% if (!activity.items.length) { %>
          <p class="admin-empty">이 종류의 활동 기록이 없습니다.</p>
        <% } %>

        <% activity.items.forEach((item) => { %>
          <% if (activity.kind === "learning") { %>
            <article class="admin-activity-record">
              <div class="admin-activity-record-heading">
                <span><%= eventLabels[item.eventType] || "학습 활동" %></span>
                <time><%= formatDate(item.occurredAt || item.createdAt) %></time>
              </div>
              <strong><%= [item.courseId, item.unitId, item.conceptId].filter(Boolean).join(" · ") || "공통 활동" %></strong>
              <dl>
                <div><dt>유형 번호</dt><dd><%= item.topicIndex ?? "—" %></dd></div>
                <div><dt>학습 단계</dt><dd><%= item.stepNumber ?? "—" %></dd></div>
                <div><dt>머문 시간</dt><dd><%= formatDuration(item.durationMs) %></dd></div>
                <div><dt>결과</dt><dd><%= item.correct === null || item.correct === undefined ? "—" : item.correct ? "정답" : "오답" %></dd></div>
              </dl>
              <% if (formatMetadata(item.metadata)) { %>
                <details>
                  <summary>이벤트 세부 데이터</summary>
                  <pre><%= formatMetadata(item.metadata) %></pre>
                </details>
              <% } %>
            </article>
          <% } %>

          <% if (activity.kind === "problems") { %>
            <% const problem = item.problemId || {}; %>
            <article class="admin-activity-record">
              <div class="admin-activity-record-heading">
                <span class="<%= item.isCorrect ? 'status-replied' : 'status-pending' %>"><%= item.isCorrect ? "정답" : "오답" %></span>
                <time><%= formatDate(item.submittedAt || item.createdAt) %></time>
              </div>
              <strong><%= item.courseId %> · <%= item.unitId %> · <%= item.conceptId %></strong>
              <div class="admin-activity-question math-content"><%= formatAdminMath(item.problemSnapshot?.stem || problem.stem || "문제 내용 없음") %></div>
              <dl>
                <div><dt>사용자 답안</dt><dd class="math-content"><%= formatAdminMath(item.submittedAnswer) %></dd></div>
                <div><dt>정답</dt><dd class="math-content"><%= formatAdminMath(problem.correctAnswer) %></dd></div>
                <div><dt>풀이 시간</dt><dd><%= formatDuration(item.responseTimeMs) %></dd></div>
                <div><dt>힌트·그래프</dt><dd>힌트 <%= item.hintsUsed || 0 %>회 · 그래프 <%= item.visualizationReplayCount || 0 %>회</dd></div>
              </dl>
            </article>
          <% } %>

          <% if (activity.kind === "quick") { %>
            <article class="admin-activity-record">
              <div class="admin-activity-record-heading">
                <span class="<%= item.status === 'correct' ? 'status-replied' : 'status-pending' %>"><%= statusLabels[item.status] || "상태 확인 필요" %></span>
                <time><%= formatDate(item.submittedAt || item.startedAt || item.createdAt) %></time>
              </div>
              <strong><%= item.pointValue %>점 · <%= item.topicLabel %> · <%= item.variantLabel || "문제 변형" %></strong>
              <div class="admin-activity-question math-content"><%= formatAdminMath(item.prompt) %></div>
              <dl>
                <div><dt>사용자 답안</dt><dd class="math-content"><%= formatAdminMath(item.submittedAnswer) %></dd></div>
                <div><dt>정답</dt><dd class="math-content"><%= formatAdminMath(item.answer) %></dd></div>
                <div><dt>풀이 시간</dt><dd><%= formatDuration(item.responseTimeMs) %></dd></div>
                <div><dt>제한 시간</dt><dd>40초</dd></div>
              </dl>
              <% if (item.solution) { %><p class="admin-activity-solution math-content"><%= formatAdminMath(item.solution) %></p><% } %>
            </article>
          <% } %>

          <% if (activity.kind === "assessments") { %>
            <article class="admin-activity-record">
              <div class="admin-activity-record-heading">
                <span class="<%= item.status === 'submitted' ? 'status-replied' : 'status-pending' %>"><%= statusLabels[item.status] || "상태 확인 필요" %></span>
                <time><%= formatDate(item.submittedAt || item.createdAt) %></time>
              </div>
              <strong><%= item.title %></strong>
              <dl>
                <div><dt>평가 범위</dt><dd><%= scopeLabels[item.scopeType] || "평가" %> · <%= [item.courseId, item.unitId, item.subunitId].filter(Boolean).join(" / ") %></dd></div>
                <div><dt>점수</dt><dd><%= item.scorePercent ?? "—" %>점</dd></div>
                <div><dt>통과 여부</dt><dd><%= item.passed === null || item.passed === undefined ? "—" : item.passed ? "통과" : "미통과" %></dd></div>
                <div><dt>응시 시간</dt><dd><%= formatDuration(item.elapsedTimeMs) %></dd></div>
              </dl>
              <a class="admin-inline-link" href="/admin/users/<%= member._id %>/assessments/<%= item._id %>">전체 문항과 답안 보기 →</a>
            </article>
          <% } %>

          <% if (activity.kind === "community") { %>
            <article class="admin-activity-record">
              <div class="admin-activity-record-heading">
                <span class="<%= item.status === 'published' ? 'status-replied' : 'status-pending' %>"><%= statusLabels[item.status] || "상태 확인 필요" %><%= item.warningIssued ? " · 경고 부여" : "" %></span>
                <time><%= formatDate(item.createdAt) %></time>
              </div>
              <strong><%= item.title %></strong>
              <p class="admin-activity-content"><%= item.content %></p>
              <dl>
                <div><dt>게시판</dt><dd><%= boardLabels[item.boardType] || "게시판" %><%= item.schoolName ? ` · ${item.schoolName}` : "" %></dd></div>
                <div><dt>조회수</dt><dd><%= item.viewCount || 0 %></dd></div>
                <div><dt>수정일</dt><dd><%= formatDate(item.editedAt) %></dd></div>
                <div><dt>관리 사유</dt><dd><%= item.moderationReason || "없음" %></dd></div>
              </dl>
            </article>
          <% } %>

          <% if (activity.kind === "moderation") { %>
            <article class="admin-activity-record">
              <div class="admin-activity-record-heading">
                <span><%= actionLabels[item.action] || "관리 작업" %></span>
                <time><%= formatDate(item.createdAt) %></time>
              </div>
              <strong><%= item.detail || "상세 사유 없음" %></strong>
              <p>처리 관리자: <%= item.adminUserId?.name || item.adminUserId?.email || "알 수 없음" %></p>
              <% if (formatMetadata(item.metadata)) { %>
                <details>
                  <summary>관리 작업 세부 데이터</summary>
                  <pre><%= formatMetadata(item.metadata) %></pre>
                </details>
              <% } %>
            </article>
          <% } %>
        <% }) %>
      </section>

      <% if (activity.pagination.totalPages > 1) { %>
        <nav class="admin-pagination" aria-label="활동 기록 페이지">
          <% if (activity.pagination.hasPrevious) { %>
            <a href="<%= pageHref(activity.pagination.page - 1) %>">← 이전</a>
          <% } else { %><span></span><% } %>
          <strong><%= activity.pagination.page %> / <%= activity.pagination.totalPages %></strong>
          <% if (activity.pagination.hasNext) { %>
            <a href="<%= pageHref(activity.pagination.page + 1) %>">다음 →</a>
          <% } else { %><span></span><% } %>
        </nav>
      <% } %>
    </main>
  </body>
</html>

<%
  const publicArenaText = typeof arenaPublicText === "function"
    ? arenaPublicText
    : (value) => String(value ?? "").replace(/Sub\s+Division/g, "일반전").replace(/Main\s+Division/g, "경쟁전");
  const member = detail.user;
  const isAdminProfile = member.role === "admin";
  const gradeLabels = {
    10: "고등학교 1학년",
    11: "고등학교 2학년",
    12: "고등학교 3학년",
    13: "N수생",
    14: "대학생",
    15: "직장인",
  };
  const formatDate = (date) =>
    date
      ? new Intl.DateTimeFormat("ko-KR", {
          timeZone: "Asia/Seoul",
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(date))
      : "기록 없음";
  const formatDateInput = (date) =>
    date
      ? new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Seoul",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).format(new Date(date))
      : "";
  const inquiryStatusLabels = {
    pending: "접수",
    in_review: "확인 중",
    replied: "답변 완료",
    closed: "종료",
  };
  const actionLabels = {
    "user.nickname": "닉네임 강제 수정",
    "user.notification": "사이트 알림 발송",
    "user.email": "개별 이메일 발송",
    "user.password-reset": "비밀번호 재설정 발송",
    "user.deactivate": "계정 비활성화",
    "user.restore": "계정 복원",
    "inquiry.reply": "문의 이메일 답변",
    "inquiry.status": "문의 상태 변경",
    "user.role": "사용자 역할 변경",
    "user.account-status": "계정 상태 변경",
    "user.account-withdrawal": "계정 탈퇴 처리",
    "user.warning-count": "경고 횟수 수정",
    "user.package-access": "레거시 패키지 권한 변경",
    "user.account-plan": "계정 플랜 변경",
    "private-mock.integrity-review": "Matths 주간 공식 모의고사 소명 검토",
    "private-mock.integrity-penalty": "Matths 주간 공식 모의고사 페널티 부여",
    "community.report-reviewing": "게시글 신고 검토 시작",
    "community.report-resolved": "게시글 신고 처리 완료",
    "community.report-rejected": "게시글 신고 반려",
    "community.post-warning": "게시글 경고",
  };
  const accountStatus =
    member.accountStatus ||
    (member.isActive ? "active" : "inactive");
  const isAnonymousRetainedAccount =
    accountStatus === "withdrawn" &&
    member.withdrawal?.dataRetention === "anonymous";
  const accountStatusLabels = {
    active: "활성",
    inactive: "비활성화",
    suspended: "정지",
    withdrawn: "탈퇴",
  };
  const roleLabels = {
    student: "학생",
    teacher: "교사",
    admin: "관리자",
    test: "운영 테스트 계정",
  };
  const learningStatusLabels = {
    "not-started": "시작 전",
    "in-progress": "학습 중",
    completed: "완료",
  };
  const assessmentStatusLabels = {
    "in-progress": "응시 중",
    "verification-required": "추가 실력 확인 대기",
    submitted: "제출 완료",
    abandoned: "중단",
    disqualified: "실격",
  };
  const placementPurposeLabels = {
    INITIAL: "입단 배치고사",
    SEASON: "시즌 배치고사",
    RENEWAL_RANK_ASSESSMENT: "랭크 복귀전",
  };
  const arenaMatchStatusLabels = {
    MATCHED: "과거 기록 연결",
    READY: "시작 대기",
    IN_PROGRESS: "풀이 중",
    EVIDENCE_REQUIRED: "풀이 업로드 대기",
    SUBMITTED: "제출 완료",
    RESOLVED: "결과 확정",
    HELD: "검토 보류",
    INVALID: "무효 경기",
    SETTLED: "정산 완료",
    CANCELLED: "취소",
  };
  const arenaRecentResultLabels = {
    WIN: "승리",
    LOSE: "패배",
    DRAW: "무승부",
    NO_RESULT: "결과 없음",
  };
  const formatDuration = (ms) => {
    const totalSeconds = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    if (hours) return `${hours}시간 ${minutes}분`;
    return `${minutes}분`;
  };
  const assessmentReason = (attempt) =>
    attempt.disqualifiedReason === "time-limit"
      ? "과거 버전 시간초과 기록"
      : assessmentStatusLabels[attempt.displayStatus || attempt.status] || "상태 확인 필요";
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= member.name %> 사용자 관리 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/weekly-mock-insights.css" />
  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "users" }) %>
    <main class="admin-main">
      <a class="admin-back" href="/admin/users">← 유저 목록</a>
      <header class="admin-heading user-detail-heading">
        <div>
          <p>USER PROFILE</p>
          <h1><%= member.name %></h1>
          <span><%= member.realName || "실명 미입력" %> · <%= member.email %></span>
        </div>
        <div class="admin-heading-actions">
          <strong class="<%= accountStatus === 'active' ? 'is-active' : 'is-inactive' %>"><%= accountStatusLabels[accountStatus] %> 계정<%= isAdminProfile ? "" : ` · 경고 ${member.warningCount || 0}회` %></strong>
          <% if (!isAdminProfile) { %><a href="/admin/users/<%= member._id %>/activity">전체 활동 기록 →</a><% } %>
        </div>
      </header>
      <% if (feedback) { %><div class="admin-feedback" role="status"><%= feedback %></div><% } %>

      <section class="admin-user-summary">
        <% if (!isAdminProfile) { %>
          <article><span>소속</span><strong><%= Number(member.schoolGrade) === 14 ? (member.university?.name || "대학교 미설정") : Number(member.schoolGrade) === 15 ? "직장인" : Number(member.schoolGrade) === 13 ? "N수생" : (member.school?.name || "미설정") %></strong><small><%= Number(member.schoolGrade) === 14 ? (member.university?.region || "") : (member.school?.region || "") %></small></article>
          <article><span>학습자 구분</span><strong><%= gradeLabels[member.schoolGrade] || "미설정" %></strong><small><%= member.educationStatus === "graduated" || [13, 15].includes(Number(member.schoolGrade)) ? "졸업·일반" : "재학" %></small></article>
          <article><span>본인확인</span><strong><%= member.identityVerificationStatus === "review-required" ? "중복 검토 필요" : (member.identityVerificationStatus === "verified" ? "확인 완료" : "미확인") %></strong><small><%= member.identityDuplicateAlertedAt ? "동일 실명·생년월일·고등학교 계정이 감지되었습니다." : "중복 감지 알림 없음" %></small></article>
        <% } %>
        <article><span>가입일</span><strong><%= formatDate(member.createdAt) %></strong></article>
        <article><span>최근 로그인</span><strong><%= formatDate(member.lastLoginAt) %></strong></article>
        <% if (!isAdminProfile) { %><article><span>누적 학습</span><strong><%= Math.round((member.totalStudySeconds || 0) / 60) %>분</strong></article><% } %>
        <% if (!isAdminProfile) { %><article><span>학습 streak</span><strong><%= detail.streak?.current || 0 %>일 연속</strong><small>최장 <%= detail.streak?.longest || 0 %>일 · 최근 인정일 <%= formatDate(detail.streak?.lastStudyDate) %></small></article><% } %>
        <% if (!isAdminProfile) { %><article><span>Arena 활동 레벨</span><strong>Lv.<%= detail.arenaActivityLevel?.level || 1 %></strong><small><%= detail.arenaActivityLevel?.isMaxLevel ? "최고 레벨" : `다음 레벨까지 ${detail.arenaActivityLevel?.matchesToNext || 0}판` %></small></article><% } %>
        <% if (!isAdminProfile) { %><article><span>Arena XP 인정 경기</span><strong><%= detail.arenaActivityLevel?.totalMatches || 0 %>판</strong><small>현행 XP 규칙에 따라 확정된 경기만 집계</small></article><% } %>
        <article><span>누적 접속</span><strong><%= ((Number(member.totalConnectedSeconds) || 0) / 3600).toFixed((Number(member.totalConnectedSeconds) || 0) >= 360000 ? 0 : 1) %>시간</strong><small>로그인 상태의 활성 탭 기준</small></article>
        <% if (!isAdminProfile) { %><article><span>최근 학습</span><strong><%= formatDate(detail.learning.currentConcept?.lastStudiedAt || member.lastStudyDate) %></strong><small>개념 진도·학습 이벤트 기준</small></article><% } %>
        <article><span>역할</span><strong><%= roleLabels[member.role] || "역할 확인 필요" %></strong></article>
        <article>
          <span>계정 상태</span>
          <strong><%= accountStatusLabels[accountStatus] %></strong>
          <small>
            <%= member.accountStatusReason || "처리 사유 없음" %>
            <%= accountStatus === "suspended" ? ` · ${member.suspendedUntil ? `${formatDate(member.suspendedUntil)}까지` : "무기한"}` : "" %>
            <%= accountStatus === "withdrawn" ? ` · ${member.withdrawal?.dataRetention === "anonymous" ? "익명 데이터 보존" : "활동 데이터 삭제"}` : "" %>
          </small>
        </article>
        <% if (!isAdminProfile) { %><%- include("partials/admin-weekly-mock-access", { member, weeklyMockAccess: detail.weeklyMockAccess }) %><% } %>
      </section>

      <% if (!isAdminProfile && detail.identityMatches?.length) { %>
        <section class="admin-panel">
          <div class="admin-panel-heading"><div><p>IDENTITY REVIEW</p><h2>동일 실명·생년월일·고등학교 계정</h2></div></div>
          <p>생년월일 원본은 이 화면에 표시하지 않습니다. 아래 계정은 실명·생년월일·고등학교가 모두 일치하므로 계정 중복 여부와 기록 귀속을 운영자가 확인해야 합니다.</p>
          <div class="admin-assessment-list">
            <% detail.identityMatches.forEach((match) => { %>
              <a href="/admin/users/<%= match._id %>"><strong><%= match.name %> · <%= match.realName || "실명 미입력" %></strong><span><%= match.email %></span><small><%= gradeLabels[match.schoolGrade] || "학년 미설정" %> · <%= accountStatusLabels[match.accountStatus || "active"] || "상태 확인 필요" %></small><b>계정 확인 →</b></a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (!isAdminProfile) { %>
        <section class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>ACCOUNT PLAN</p><h2>계정 플랜</h2></div>
          </div>
          <div class="admin-metric-row">
            <div>
              <span>현재 플랜</span>
              <strong><%= detail.packageAccess?.label || "무료 플랜" %></strong>
              <small>
                <% if (detail.packageAccess?.planCode === "PRO") { %>
                  월 <%= new Intl.NumberFormat("ko-KR").format(Number(detail.packageAccess.priceAmount) || 5500) %>원 · <%= formatDate(detail.packageAccess.endsAt) %>까지
                <% } else { %>
                  기간 제한 없이 무료 기능 이용
                <% } %>
              </small>
            </div>
          </div>
          <form class="admin-form" action="/admin/users/<%= member._id %>/package-access" method="POST">
            <h3>계정 플랜 변경</h3>
            <p>관리자 변경은 결제 매출로 집계하지 않습니다. Pro는 현재 설정된 월 이용 기간 동안 적용되며, 과거 결제·환불 기록은 감사 이력으로 그대로 보존됩니다.</p>
            <label><span>적용할 플랜</span>
              <select name="planCode" required>
                <option value="FREE" <%= detail.packageAccess?.planCode === "FREE" ? "selected" : "" %>>무료 플랜</option>
                <option value="PRO" <%= detail.packageAccess?.planCode === "PRO" ? "selected" : "" %>>Pro 플랜 · 월 5,500원</option>
              </select>
            </label>
            <label><span>변경 사유</span><input name="reason" maxlength="500" required /></label>
            <button type="submit">계정 플랜 적용</button>
          </form>
        </section>
      <% } %>

      <% if (!isAdminProfile) { %>
        <section class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>GOAT ARENA</p><h2>최근 5경기</h2></div>
            <a href="/admin/arena-match-history?participant=<%= member._id %>">전체 경기 기록 →</a>
          </div>
          <% if (detail.arenaRecentMatches?.length) { %>
            <div class="admin-arena-recent-list">
              <% detail.arenaRecentMatches.forEach((match) => {
                const mine = match.focusedParticipant || {};
                const opponent = match.opponent || {};
                const opponentName = opponent.nickname || opponent.realName || opponent.email || opponent.id || "상대 확인 필요";
                const result = mine.result || "NO_RESULT";
              %>
                <a class="admin-arena-recent-match" href="/admin/arena-match-history?query=<%= encodeURIComponent(match.id) %>">
                  <span class="admin-arena-recent-result is-<%= result.toLowerCase().replace(/_/g, "-") %>"><%= arenaRecentResultLabels[result] || result %></span>
                  <div>
                    <strong><%= match.gameMode === "COMPETITIVE" ? "경쟁전" : match.gameMode === "FRIENDLY" ? "친선전" : match.gameMode === "NORMAL" ? "일반전" : "이전 경기" %> · 상대 <%= opponentName %></strong>
                    <span><%= match.asynchronous ? "과거 기록 대결" : "동시 참가 경기" %> · <%= arenaMatchStatusLabels[match.status] || match.status %><%= match.tierPairLabel ? ` · ${match.tierPairLabel}` : "" %></span>
                    <small><%= formatDate(match.completedAt) %> · 경기 ID <%= match.id %></small>
                  </div>
                  <strong class="admin-arena-recent-score"><%= mine.correctCount !== null && mine.correctCount !== undefined ? `${mine.correctCount}개 정답` : "결과 없음" %><%= opponent.correctCount !== null && opponent.correctCount !== undefined ? ` : ${opponent.correctCount}개` : "" %></strong>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <p class="admin-empty">아직 완료된 GOAT Arena 경기가 없습니다.</p>
          <% } %>
        </section>
      <% } %>

      <%- include("partials/weekly-mock-heatmap", {
        insight: typeof weeklyMockInsights !== "undefined" ? weeklyMockInsights : null,
        title: "주간 모의고사 개념 강·약점",
        eyebrow: "운영자 전용 · 개별 유저 분석",
        showAllConcepts: true,
      }) %>

      <% if (!isAdminProfile) {
        const arenaConceptInsights = detail.arenaConceptInsights || {};
        const arenaConceptSummary = arenaConceptInsights.summary || {};
      %>
        <section class="admin-panel admin-arena-concept-panel">
          <div class="admin-panel-heading admin-arena-concept-heading">
            <div><p>1:1 CONCEPT SIGNAL</p><h2>경기 기반 개념 강·약점</h2></div>
            <span class="admin-private-badge">운영자 전용 · 사용자 비공개</span>
          </div>
          <p class="admin-arena-concept-note">정산 완료된 최근 <%= arenaConceptSummary.matchLimit || 100 %>경기 안에서 제출 답안을 문항의 실제 개념 태그로 다시 집계합니다. 보완 필요는 정답률 <%= Number(arenaConceptInsights.thresholds?.weakCorrectRateMax ?? 59) + 1 %>% 미만, 강점 후보는 <%= arenaConceptInsights.thresholds?.strongCorrectRateMin ?? 70 %>% 이상이며 진단이나 학생 공개 지표로 사용하지 않습니다.</p>
          <div class="admin-arena-concept-metrics">
            <div><span>분석 경기</span><strong><%= arenaConceptSummary.matchCount || 0 %>경기</strong></div>
            <div><span>분석 문항</span><strong><%= arenaConceptSummary.questionCount || 0 %>문항</strong></div>
            <div><span>경기 정답률</span><strong><%= arenaConceptSummary.correctRate || 0 %>%</strong></div>
            <div><span>감지 개념</span><strong><%= arenaConceptSummary.conceptCount || 0 %>개</strong></div>
          </div>
          <% if (arenaConceptSummary.questionCount) { %>
            <div class="admin-arena-concept-grid">
              <section class="admin-arena-concept-group is-weak">
                <header><div><p>NEEDS REVIEW</p><h3>보완이 필요한 개념</h3></div><strong><%= arenaConceptInsights.weakConcepts?.length || 0 %></strong></header>
                <% if (arenaConceptInsights.weakConcepts?.length) { %>
                  <div class="admin-arena-concept-list">
                    <% arenaConceptInsights.weakConcepts.forEach((concept) => { %>
                      <article>
                        <div><span><%= concept.courseLabel %> · 표본 <%= concept.confidence %></span><strong><%= concept.label %></strong><small>오답 <%= concept.incorrect %>/<%= concept.attempts %> · 정답률 <%= concept.correctRate %>%</small></div>
                        <div class="admin-arena-concept-bar" aria-label="정답률 <%= concept.correctRate %>%"><i style="width:<%= concept.correctRate %>%"></i></div>
                      </article>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="admin-empty">현재 기준에서 보완 필요로 분류된 개념이 없습니다.</p>
                <% } %>
              </section>
              <section class="admin-arena-concept-group is-strong">
                <header><div><p>STRENGTH CANDIDATE</p><h3>잘하는 개념 후보</h3></div><strong><%= arenaConceptInsights.strongConcepts?.length || 0 %></strong></header>
                <% if (arenaConceptInsights.strongConcepts?.length) { %>
                  <div class="admin-arena-concept-list">
                    <% arenaConceptInsights.strongConcepts.forEach((concept) => { %>
                      <article>
                        <div><span><%= concept.courseLabel %> · 표본 <%= concept.confidence %></span><strong><%= concept.label %></strong><small>정답 <%= concept.correct %>/<%= concept.attempts %> · 정답률 <%= concept.correctRate %>%</small></div>
                        <div class="admin-arena-concept-bar" aria-label="정답률 <%= concept.correctRate %>%"><i style="width:<%= concept.correctRate %>%"></i></div>
                      </article>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="admin-empty">현재 기준에서 강점 후보로 분류된 개념이 없습니다.</p>
                <% } %>
              </section>
            </div>
            <% if (arenaConceptInsights.observingConcepts?.length) { %>
              <p class="admin-arena-observing">관찰 중 · <%= arenaConceptInsights.observingConcepts.map((concept) => `${concept.label} ${concept.correctRate}%`).join(" · ") %></p>
            <% } %>
            <small class="admin-arena-concept-updated">최근 분석 답안 <%= formatDate(arenaConceptSummary.lastAnalyzedAt) %></small>
          <% } else { %>
            <p class="admin-empty">정산된 1:1 경기의 제출 답안이 쌓이면 개념 지표가 자동으로 표시됩니다.</p>
          <% } %>
        </section>
      <% } %>

      <% if (!isAdminProfile) { %><div class="admin-detail-grid">
        <section class="admin-panel">
          <div class="admin-panel-heading"><div><p>LEARNING</p><h2>학습 진행</h2></div></div>
          <% if (detail.learning.currentConcept) { %>
            <div class="admin-ranking-card">
              <strong><%= detail.learning.currentConcept.status === "in-progress" ? "현재 학습 개념" : "최근 학습 개념" %> · <%= detail.learning.currentConcept.conceptTitle %></strong>
              <span><%= detail.learning.currentConcept.courseTitle %> · <%= detail.learning.currentConcept.unitTitle %></span>
              <span><%= detail.learning.currentConcept.completionPercent %>% · <%= learningStatusLabels[detail.learning.currentConcept.status] || "상태 확인 필요" %> · 최근 학습 <%= formatDate(detail.learning.currentConcept.lastStudiedAt) %></span>
            </div>
          <% } else { %>
            <p class="admin-empty">현재 학습 중인 개념이 없습니다.</p>
          <% } %>
          <br>
          <div class="admin-metric-row">
            <div><span>시작 개념</span><strong><%= detail.learning.progressCount %></strong></div>
            <div><span>완료 개념</span><strong><%= detail.learning.completedCount %></strong></div>
            <div><span>문제 풀이</span><strong><%= detail.learning.totalAttempts %></strong></div>
            <div><span>정답률</span><strong><%= detail.learning.correctRate %>%</strong></div>
          </div>
          <div class="admin-progress-list">
            <% if (!detail.learning.progress.length) { %><p class="admin-empty">학습 기록이 없습니다.</p><% } %>
            <% detail.learning.progress.forEach((progress) => { %>
              <div>
                <span><%= progress.courseTitle %> · <%= progress.unitTitle %></span>
                <strong><%= progress.conceptTitle %></strong>
                <div><i style="width:<%= progress.completionPercent %>%"></i></div>
                <small><%= progress.completionPercent %>% · <%= learningStatusLabels[progress.status] || "상태 확인 필요" %> · <%= formatDate(progress.lastStudiedAt) %></small>
              </div>
            <% }) %>
          </div>
        </section>

        <section class="admin-panel">
          <div class="admin-panel-heading"><div><p>COMPETITIVE PROFILE</p><h2>경쟁전 배치·MMR</h2></div></div>
          <% const placement = detail.placement || {}; %>
          <% const arenaProfile = detail.arenaCompetitiveProfile || null; %>
          <% if (arenaProfile) { %>
            <div class="admin-ranking-card">
              <strong><%= arenaProfile.placementFinalizedAt ? `${arenaProfile.tier || "UNPLACED"} · MMR ${Math.round(Number(arenaProfile.rating) || 0)}` : "경쟁전 배치 대기" %></strong>
              <span>일반전 <%= Number(arenaProfile.normalMatchesCompleted) || 0 %>경기 · 배치 표본 <%= arenaProfile.placementSamples?.length || 0 %>개 · 사용 시도 <%= Number(arenaProfile.placementAttemptsUsed) || 0 %>/5회</span>
              <span><%= arenaProfile.placementFinalizedAt ? `RD ${Number(arenaProfile.ratingDeviation || 0).toFixed(1)} · 변동성 ${Number(arenaProfile.volatility || 0).toFixed(4)}` : (Number(arenaProfile.normalMatchesCompleted) || 0) >= 3 ? "경쟁전 해금 조건 충족 · 배치 필요" : `일반전 ${Math.max(0, 3 - (Number(arenaProfile.normalMatchesCompleted) || 0))}경기 추가 필요` %></span>
              <dl>
                <div><dt>경쟁전</dt><dd><%= Number(arenaProfile.competitiveMatchesCompleted) || 0 %>경기</dd></div>
                <div><dt>승</dt><dd><%= Number(arenaProfile.wins) || 0 %></dd></div>
                <div><dt>패</dt><dd><%= Number(arenaProfile.losses) || 0 %></dd></div>
                <div><dt>무</dt><dd><%= Number(arenaProfile.draws) || 0 %></dd></div>
              </dl>
            </div>
          <% } else { %>
            <p class="admin-empty">현행 경쟁전 프로필이 아직 생성되지 않았습니다.</p>
          <% } %>
          <% if (placement.latestCompleted) { %>
            <div class="admin-placement-state-card is-completed">
              <strong>최근 배치고사 제출 완료</strong>
              <span><%= placementPurposeLabels[placement.latestCompleted.placementPurpose] || "배치고사" %> · <%= placement.latestCompleted.scorePercent %>점 · <%= formatDate(placement.latestCompleted.submittedAt) %></span>
              <small>경쟁전 프로필의 유효 배치 표본과 최종 확정 여부를 함께 확인하세요.</small>
            </div>
          <% } else if (placement.active) { %>
            <div class="admin-placement-state-card is-active">
              <strong><%= assessmentStatusLabels[placement.active.displayStatus] %> · <%= placementPurposeLabels[placement.active.placementPurpose] || "배치고사" %></strong>
              <span>시작 <%= formatDate(placement.active.startedAt) %> · 저장 답안 <%= placement.active.answeredCount %>문항</span>
              <small><%= placement.active.remainingTimeMs === null ? "마감 시각을 계산할 수 없습니다." : `남은 시간 ${formatDuration(placement.active.remainingTimeMs)} · 마감 ${formatDate(placement.active.deadlineAt)}` %></small>
            </div>
          <% } else if (placement.latestTerminal) { %>
            <div class="admin-placement-state-card is-terminal">
              <strong>최근 배치고사 · <%= assessmentReason(placement.latestTerminal) %></strong>
              <span>시작 <%= formatDate(placement.latestTerminal.startedAt) %> · 종료 <%= formatDate(placement.latestTerminal.submittedAt) %> · 저장 답안 <%= placement.latestTerminal.answeredCount %>문항</span>
              <small>현재 배치고사는 제한시간 종료 시 저장 답안을 자동 제출·채점합니다. 이 기록은 중단·실격 등 별도 종료 사유를 확인해야 합니다.</small>
            </div>
          <% } else { %><p class="admin-empty">배치고사 응시 기록이 없습니다.</p><% } %>
          <div class="admin-assessment-list">
            <% if (!detail.assessments.length) { %><p class="admin-empty">시험 응시 기록이 없습니다.</p><% } %>
            <% detail.assessments.forEach((attempt) => { %>
              <a href="/admin/users/<%= member._id %>/assessments/<%= attempt._id %>">
                <strong><%= attempt.title %></strong>
                <span><%= assessmentReason(attempt) %> · <%= attempt.hasFinalScore ? `${attempt.scorePercent ?? 0}점` : "미채점" %> · 저장 답안 <%= attempt.answeredCount %>문항</span>
                <small>시작 <%= formatDate(attempt.startedAt || attempt.createdAt) %><%= attempt.submittedAt ? ` · 종료 ${formatDate(attempt.submittedAt)}` : attempt.deadlineAt ? ` · 마감 ${formatDate(attempt.deadlineAt)}` : "" %></small>
                <b><%= attempt.hasFinalScore ? "문항·제출 답안 확인" : "문항·저장 답안 확인" %> →</b>
              </a>
            <% }) %>
          </div>
        </section>
      </div><% } %>

      <% if (!isAdminProfile) { %><section class="admin-panel">
        <div class="admin-panel-heading"><div><p>DIRECT ACTIONS</p><h2>사용자에게 보내기</h2></div></div>
        <div class="admin-action-grid">
          <form class="admin-form" action="/admin/users/<%= member._id %>/notification" method="POST">
            <h3>사이트 알림</h3>
            <label><span>제목</span><input name="title" minlength="2" maxlength="100" required /></label>
            <label><span>내용</span><textarea name="message" rows="4" maxlength="1000" required></textarea></label>
            <label><span>이동 주소</span><input name="href" value="/main" pattern="/.*" /></label>
            <button type="submit">알림 보내기</button>
          </form>
          <form class="admin-form" action="/admin/users/<%= member._id %>/email" method="POST">
            <h3>가입 이메일로 전송</h3>
            <label><span>제목</span><input name="subject" minlength="2" maxlength="120" required /></label>
            <label><span>내용</span><textarea name="message" rows="7" minlength="5" maxlength="5000" required></textarea></label>
            <button type="submit">이메일 바로 전송</button>
          </form>
        </div>
      </section><% } %>

      <section class="admin-panel">
        <div class="admin-panel-heading"><div><p>ACCOUNT CONTROL</p><h2>계정 관리</h2></div></div>
        <div class="admin-action-grid">
          <form class="admin-form" action="/admin/users/<%= member._id %>/password-reset" method="POST">
            <h3>비밀번호 재설정</h3>
            <p>비밀번호 원문은 확인하지 않습니다. 가입 이메일로 10분 동안 한 번만 사용할 수 있는 재설정 링크를 보냅니다.</p>
            <button type="submit" <%= !member.isActive ? "disabled" : "" %>>재설정 이메일 보내기</button>
          </form>
          <% if (String(member._id) !== String(user.id)) { %>
            <form class="admin-form" action="/admin/users/<%= member._id %>/role" method="POST" data-role-form>
              <h3>역할 변경</h3>
              <label><span>역할</span>
                <select name="role" data-role-select>
                  <% Object.entries(roleLabels).filter(([value]) => value !== "test").forEach(([value, label]) => { %>
                    <option value="<%= value %>" <%= member.role === value ? "selected" : "" %>><%= label %></option>
                  <% }) %>
                </select>
              </label>
              <label data-teacher-expiry-field <%- member.role === "teacher" ? "" : "hidden" %>><span>학원 기능 유효기간</span><input type="date" name="teacherAccessExpiresAt" value="<%= formatDateInput(member.teacherAccessExpiresAt) %>" data-teacher-expiry-input /><small>선택한 날짜의 23:59(KST)까지 이용하며, 만료 2주 전에 원장과 운영자에게 알립니다.</small></label>
              <label><span>변경 사유</span><input name="reason" maxlength="300" required /></label>
              <button type="submit">역할 변경</button>
            </form>
            <form class="admin-form" action="/admin/users/<%= member._id %>/warnings" method="POST">
              <h3>경고 횟수 관리</h3>
              <p>경고가 3회 이상이면 학생·교사 계정이 즉시 무기한 정지됩니다. 경고 누적으로 정지된 계정은 2회 이하로 조정하면 다시 활성화되며, 0회가 되면 게시판 사진·파일 첨부 권한도 즉시 복구됩니다.</p>
              <label><span>경고 횟수</span><input type="number" name="warningCount" min="0" max="999" value="<%= member.warningCount || 0 %>" required /></label>
              <label><span>수정 사유</span><input name="reason" maxlength="500" required /></label>
              <button type="submit">경고 횟수 저장</button>
            </form>
            <form class="admin-form" action="/admin/users/<%= member._id %>/account-status" method="POST">
              <h3>계정 상태 변경</h3>
              <p>활성·비활성화·정지를 관리합니다. 계정 삭제는 아래의 별도 영역에서 처리합니다.</p>
              <label><span>계정 상태</span>
                <select
                  name="status"
                  data-account-status-select
                  <%= accountStatus === "withdrawn" ? "disabled" : "" %>
                >
                  <% Object.entries(accountStatusLabels).filter(([value]) => value !== "withdrawn").forEach(([value, label]) => { %>
                    <option value="<%= value %>" <%= accountStatus === value ? "selected" : "" %>><%= label %></option>
                  <% }) %>
                </select>
              </label>
              <label><span>정지 기간(일, 비우면 무기한)</span><input type="number" name="suspensionDays" min="1" max="3650" /></label>
              <label><span>처리 사유</span><input name="reason" maxlength="500" required /></label>
              <button type="submit" <%= accountStatus === "withdrawn" ? "disabled" : "" %>>
                <%= accountStatus === "withdrawn" ? "복구할 수 없는 탈퇴 계정" : "계정 상태 적용" %>
              </button>
            </form>
            <form class="admin-form danger-form" action="/admin/users/<%= member._id %>/delete" method="POST" data-admin-delete-form>
              <h3><%= isAnonymousRetainedAccount ? "익명 보존 데이터 영구 삭제" : "계정 삭제" %></h3>
              <% if (isAnonymousRetainedAccount) { %>
                <p>이 계정은 이미 개인정보를 제거한 익명 보존 계정입니다. 아래 작업을 실행하면 익명으로 남아 있던 학습·시험·Arena·게시판 데이터와 불필요한 관련 파일을 삭제합니다. 결제·환불 원장과 다른 회원의 경기·도전장 결과에 필요한 풀이 참조는 분리해 보존합니다.</p>
                <input type="hidden" name="dataRetention" value="purged" />
              <% } else { %>
                <p>로그인 정보와 개인정보는 두 방식 모두 제거됩니다. 삭제한 계정은 복구할 수 없습니다.</p>
                <fieldset class="admin-policy-fieldset">
                  <legend>데이터 처리 방식</legend>
                  <label class="admin-checkbox">
                    <input type="radio" name="dataRetention" value="anonymous" checked required />
                    <span><b>익명 보존</b> — 개인정보를 제거하고 학습·시험·Arena 통계를 익명 계정 ID로 보존</span>
                  </label>
                  <label class="admin-checkbox">
                    <input type="radio" name="dataRetention" value="purged" required />
                    <span><b>모든 데이터 삭제</b> — 계정, 학습기록, 시험·내부 실력 지표·랭킹, Arena 경기·증거, 게시글과 첨부파일까지 삭제</span>
                  </label>
                </fieldset>
              <% } %>
              <label><span>삭제 사유</span><input name="reason" maxlength="500" required /></label>
              <label><span>확인 문구</span><input name="confirmation" autocomplete="off" placeholder="계정삭제" required /></label>
              <button type="submit"><%= isAnonymousRetainedAccount ? "모든 데이터 영구 삭제" : "선택한 방식으로 계정 삭제" %></button>
            </form>
            <form class="admin-form" action="/admin/users/<%= member._id %>/nickname" method="POST">
              <h3>부적절한 닉네임 변경 요청</h3>
              <p>관리자가 닉네임을 직접 덮어쓰지 않습니다. 가입 이메일과 알림 우편함으로 사유와 본인 확인 링크를 보내며, 사용자는 로그인 후 중복 확인을 거쳐 새 닉네임을 정합니다.</p>
              <label><span>변경 요청 사유</span><textarea name="reason" rows="4" maxlength="500" required></textarea></label>
              <button type="submit">변경 요청 링크 보내기</button>
            </form>
          <% } %>
        </div>
      </section>

      <section class="admin-activity-grid" aria-label="사용자 관련 이력">
        <% if (!isAdminProfile) { %>
        <article class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>COMMUNITY</p><h2>게시판 활동</h2></div>
            <a href="/admin/community?search=<%= encodeURIComponent(member.name) %>">게시판 관리 →</a>
          </div>
          <div class="admin-activity-list">
            <% if (!detail.communityPosts.length) { %>
              <p class="admin-empty">게시글 작성 이력이 없습니다.</p>
            <% } %>
            <% detail.communityPosts.forEach((post) => { %>
              <div>
                <span class="<%= post.status === 'published' ? 'status-replied' : post.status === 'hidden' ? 'status-pending' : 'status-closed' %>"><%= post.authorDeletedAt ? "작성자 삭제" : { published: "공개", hidden: "숨김", deleted: "삭제" }[post.status] %><%= post.warningIssued ? " · 경고" : "" %></span>
                <strong><%= post.title %></strong>
                <p><%= post.content.length > 120 ? `${post.content.slice(0, 120)}…` : post.content %></p>
                <small><%= formatDate(post.createdAt) %><%= post.authorDeletedAt ? ` · 삭제 ${formatDate(post.authorDeletedAt)}` : "" %></small>
              </div>
            <% }) %>
          </div>
        </article>

        <article class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>INQUIRIES</p><h2>문의 이력</h2></div>
            <a href="/admin/inquiries">전체 문의 →</a>
          </div>
          <div class="admin-activity-list">
            <% if (!detail.inquiries.length) { %>
              <p class="admin-empty">문의 이력이 없습니다.</p>
            <% } %>
            <% detail.inquiries.forEach((inquiry) => { %>
              <div>
                <span class="status-<%= inquiry.status %>"><%= inquiryStatusLabels[inquiry.status] || "상태 확인 필요" %></span>
                <strong><%= inquiry.subject %></strong>
                <small><%= formatDate(inquiry.createdAt) %></small>
              </div>
            <% }) %>
          </div>
        </article>

        <article class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>NOTIFICATIONS</p><h2>개별 알림 이력</h2></div>
          </div>
          <div class="admin-activity-list">
            <% if (!detail.notifications.length) { %>
              <p class="admin-empty">보낸 사이트 알림이 없습니다.</p>
            <% } %>
            <% detail.notifications.forEach((notification) => { %>
              <div>
                <span class="<%= notification.readAt ? 'status-replied' : 'status-pending' %>"><%= notification.readAt ? "읽음" : "안 읽음" %></span>
                <strong><%= notification.title %></strong>
                <p><%= notification.message %></p>
                <small><%= formatDate(notification.createdAt) %></small>
              </div>
            <% }) %>
          </div>
        </article>
        <% } %>

        <article class="admin-panel">
          <div class="admin-panel-heading">
            <div><p>AUDIT LOG</p><h2>관리 작업 이력</h2></div>
          </div>
          <div class="admin-activity-list">
            <% if (!detail.actionLogs.length) { %>
              <p class="admin-empty">관리 작업 이력이 없습니다.</p>
            <% } %>
            <% detail.actionLogs.forEach((log) => { %>
              <div>
                <span><%= actionLabels[log.action] || "관리 작업" %></span>
                <strong><%= log.detail || "상세 기록 없음" %></strong>
                <small><%= formatDate(log.createdAt) %></small>
              </div>
            <% }) %>
          </div>
        </article>
      </section>
    </main>
    <script src="/js/admin-user-detail.js" defer></script>
  </body>
</html>

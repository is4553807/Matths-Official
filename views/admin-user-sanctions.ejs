<%
  const formatDateTime = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", {
        timeZone: "Asia/Seoul",
        dateStyle: "medium",
        timeStyle: "short",
      }).format(new Date(value))
    : "기록 없음";
  const page = sanctions.pagination.page;
  const totalPages = sanctions.pagination.totalPages;
  const personName = (person, fallback) => person
    ? String(person.realName || person.name || person.email || fallback)
    : fallback;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>최근 제재 내역 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/contrast.css" />

  </head>
  <body class="admin-page">
    <%- include("partials/admin-navigation", { activePage: "users" }) %>
    <main class="admin-main">
      <header class="admin-heading">
        <div><p>USER SANCTIONS</p><h1>최근 제재 내역</h1><span>운영자가 처리한 계정·게시판·무결성 제재와 해제 이력을 최신순으로 확인합니다.</span></div>
        <strong><%= sanctions.pagination.total %><small>건</small></strong>
      </header>
      <nav class="admin-user-tabs" aria-label="유저 관리 메뉴">
        <a href="/admin/users">사용자 목록</a>
        <a class="active" href="/admin/users/sanctions" aria-current="page">최근 제재 내역</a>
      </nav>
      <section class="admin-panel admin-sanction-history" aria-label="제재 처리 목록">
        <% if (!sanctions.rows.length) { %>
          <div class="admin-empty">기록된 제재 내역이 없습니다.</div>
        <% } else { %>
          <div class="admin-table-wrap"><table>
            <thead><tr><th>처리 시각</th><th>제재 유형</th><th>대상 사용자</th><th>처리 운영자</th><th>사유·상세</th></tr></thead>
            <tbody><% sanctions.rows.forEach((item) => { %><tr>
              <td><%= formatDateTime(item.createdAt) %></td>
              <td><strong><%= item.actionLabel %></strong><small><%= item.action %></small></td>
              <td><% if (item.target?._id) { %><a href="/admin/users/<%= item.target._id %>"><%= personName(item.target, "사용자") %></a><small><%= item.target.email || "" %></small><% } else { %><span>탈퇴·삭제된 사용자</span><small>식별정보 비공개</small><% } %></td>
              <td><strong><%= personName(item.actor, "운영자 계정 확인 필요") %></strong><small><%= item.actor?.email || "" %></small></td>
              <td><span><%= item.detail || "사유 기록 없음" %></span></td>
            </tr><% }) %></tbody>
          </table></div>
        <% } %>
      </section>
      <nav class="admin-pagination" aria-label="제재 내역 페이지">
        <a class="<%= page <= 1 ? 'disabled' : '' %>" href="/admin/users/sanctions?page=<%= Math.max(1, page - 1) %>">← 이전</a>
        <span><strong><%= page %></strong> / <%= totalPages %> · 페이지당 <%= sanctions.pagination.perPage %>건</span>
        <a class="<%= page >= totalPages ? 'disabled' : '' %>" href="/admin/users/sanctions?page=<%= Math.min(totalPages, page + 1) %>">다음 →</a>
      </nav>
    </main>
  </body>
</html>

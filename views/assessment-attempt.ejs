<%
  const learner =
    typeof user !== "undefined" &&
    user
      ? user
      : {};
  const gradeLabels = {
    10: "고등학교 1학년",
    11: "고등학교 2학년",
    12: "고등학교 3학년",
    13: "N수생",
  };
  const gradeLabel =
    gradeLabels[Number(learner.schoolGrade)] ||
    "학년 미설정";
  const isPlacement =
    attempt.scopeType === "placement";
  const placementVerification =
    Boolean(
      attempt
        .placementVerificationPending
    );
  const submitted =
    attempt.status === "submitted";
  const disqualified =
    attempt.status ===
    "disqualified";
  const terminal =
    submitted || disqualified;
  const placementTotalCorrect =
    isPlacement &&
    attempt.placementResult
      ? Number(
          attempt.placementResult
            .totalCorrect || 0
        )
      : 0;
  const initialQuestionIndex =
    Math.max(
      0,
      Math.min(
        attempt.questions.length - 1,
        Number(
          attempt.currentQuestionIndex
        ) || 0
      )
    );
  const backUrl = isPlacement
    ? "/war-of-masters"
    : "/assessments";
  const submitUrl = isPlacement
    ? `/war-of-masters/placement/${attempt._id}/submit`
    : `/assessments/${attempt._id}/submit`;
  const difficultyClass = (value) =>
    value === "advanced"
      ? "advanced"
      : value === "applied"
        ? "applied"
        : "mid-high";
  const placementCategoryLabels = {
    general: "기본",
    advanced: "심화",
    "semi-killer": "준킬러",
    killer: "킬러",
  };
  const choiceMarkers = [
    "①",
    "②",
    "③",
    "④",
    "⑤",
    "⑥",
    "⑦",
    "⑧",
    "⑨",
    "⑩",
  ];
  const choiceMarker = (index) =>
    choiceMarkers[index] ||
    `${index + 1}번`;
  const timeLimitMs =
    Number(attempt.timeLimitMs) ||
    (
      attempt.scopeType ===
      "subunit"
        ? 10
        : attempt.scopeType ===
            "unit"
          ? 30
          : 60
    ) * 60 * 1000;
  const timeLimitMinutes =
    Math.round(
      timeLimitMs / 60000
    );
  const timeLimitLabel =
    timeLimitMinutes >= 60 &&
    timeLimitMinutes % 60 === 0
      ? `${timeLimitMinutes / 60}시간`
      : timeLimitMinutes >= 1
        ? `${timeLimitMinutes}분`
        : `${Math.max(1, Math.round(timeLimitMs / 1000))}초`;
  const parsedDeadlineMs =
    new Date(
      attempt.deadlineAt
    ).getTime();
  const deadlineMs =
    Number.isFinite(
      parsedDeadlineMs
    )
      ? parsedDeadlineMs
      : Date.now() +
        timeLimitMs;
  const remainingTimeMs =
    disqualified
      ? 0
      : submitted
        ? Math.max(
            0,
            timeLimitMs -
              Number(
                attempt.elapsedTimeMs
              )
          )
        : Math.max(
            0,
            deadlineMs -
              Date.now()
          );
  const formatCountdown = (value) => {
    const remainingSeconds =
      Math.max(
        0,
        Math.ceil(
          (Number(value) || 0) /
            1000
        )
      );
    const minutes = Math.floor(
      remainingSeconds / 60
    );
    const seconds =
      remainingSeconds % 60;

    return [minutes, seconds]
      .map((part) =>
        String(part).padStart(2, "0")
      )
      .join(":");
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="<%= attempt.title %> 응시 화면"
    />
    <title><%= attempt.title %> | Matths</title>
    <link
      rel="stylesheet"
      href="/css/main.css"
    />
    <link
      rel="stylesheet"
      href="/css/assessment.css"
    />
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [["\\(", "\\)"]],
          displayMath: [["\\[", "\\]"]],
          processEscapes: true,
        },
        svg: {
          fontCache: "global",
        },
        options: {
          enableSpeech: false,
          enableBraille: false,
          enableExplorer: false,
        },
      };
    </script>
    <script
      src="/vendor/mathjax/tex-svg.js"
      defer
    ></script>
    <script src="/js/math-renderer.js" defer></script>
    <script src="/js/main.js" defer></script>
    <% if (!terminal) { %>
      <script
        src="/js/math-keyboard.js"
        defer
      ></script>
      <script
        src="/js/assessment.js"
        defer
      ></script>
    <% } %>
    <% if (isPlacement && submitted && attempt.placementResult) { %>
      <script src="/js/placement-story-card.js" defer></script>
    <% } %>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="assessment-page attempt-page <%= isPlacement ? 'placement-attempt-page' : '' %>">
    <a
      class="skip-link"
      href="#attempt-main"
    >
      본문으로 바로가기
    </a>

    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

      <aside class="sidebar" id="dashboard-sidebar" aria-label="학습 메뉴">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Matths 메인">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span>Matths</span>
          </a>
          <button class="sidebar-close" id="sidebar-close" type="button" aria-label="메뉴 닫기">×</button>
        </div>

        <%- include("partials/dashboard-navigation", {
          activePage: isPlacement ? "war-of-masters" : "assessments",
        }) %>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile" aria-label="<%= learner.name || "학생" %>님의 프로필 설정으로 이동" title="프로필 설정"><%= String(learner.name || "학생").slice(0, 1) %></a>
          <div class="profile-copy">
            <strong><%= learner.name || "학생" %>님</strong>
            <small><%= gradeLabel %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃" title="로그아웃">↗</button>
          </form>
        </div>
      </aside>

    <main
      class="dashboard-main attempt-main"
      id="attempt-main"
    >
      <header class="topbar assessment-dashboard-topbar">
        <div class="topbar-left">
          <button
            class="sidebar-open"
            id="sidebar-open"
            type="button"
            aria-label="학습 메뉴 열기"
            aria-controls="dashboard-sidebar"
            aria-expanded="false"
          >
            <span></span><span></span><span></span>
          </button>
          <div>
            <p><%= isPlacement ? "GOAT Arena" : "평가 센터" %></p>
            <h1>
              <%= disqualified
                ? isPlacement
                  ? "배치고사 처리 종료"
                  : "시간 초과 실격"
                : submitted
                  ? isPlacement
                    ? "배치고사 결과"
                    : "평가 결과"
                  : isPlacement
                    ? "배치고사 응시 중"
                    : "평가 응시 중" %>
            </h1>
          </div>
        </div>
        <div class="assessment-topbar-actions">
          <a class="back-dashboard secondary learning-home-button" href="/main">학습 홈으로</a>
          <a class="back-dashboard" href="<%= backUrl %>">
            <%= isPlacement ? "전장으로" : "평가 목록" %>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </header>

      <div
        class="attempt-timer <%= terminal ? 'finished' : 'movable' %> <%= disqualified ? 'disqualified' : '' %>"
        aria-label="평가 남은 시간"
        data-draggable-timer="<%= terminal ? 'false' : 'true' %>"
      >
        <% if (!terminal) { %>
          <button
            class="timer-drag-handle"
            type="button"
            aria-label="타이머 위치 이동"
            title="끌어서 타이머를 옮기세요. 두 번 누르면 원래 위치로 돌아갑니다."
          >
            <span aria-hidden="true">⠿</span>
          </button>
        <% } %>
        <span>
          TIME LIMIT · <%= timeLimitLabel %>
        </span>
        <strong
          id="assessment-timer"
          data-remaining-ms="<%= remainingTimeMs %>"
        ><%= formatCountdown(remainingTimeMs) %></strong>
        <small id="assessment-save-state">
          <%= disqualified
            ? isPlacement
              ? "배치고사 처리 종료"
              : "제한 시간 초과 · 실격"
            : submitted
              ? "제출 완료 · 제출 시각 확정"
              : isPlacement
                ? "답안 자동 저장 · 0초에 자동 제출"
                : "답안 자동 저장 · 0초에 자동 실격" %>
        </small>
      </div>

      <header class="attempt-heading">
        <div>
          <p class="eyebrow">
            <%= isPlacement
              ? "배치고사"
              : attempt.scopeType === "subunit"
              ? "소단원 평가"
              : attempt.scopeType === "unit"
                ? "대단원 평가"
                : "과목 평가" %>
          </p>
          <h1><%= attempt.title %></h1>
          <p><%= attempt.subtitle %></p>
          <p class="attempt-time-limit">
            제한 시간 <strong><%= timeLimitLabel %></strong>
            · <%= isPlacement
              ? "시간이 끝나면 저장된 답안이 자동 제출·채점됩니다."
              : "시간이 끝나면 자동으로 실격 처리됩니다." %>
          </p>
        </div>

        <% if (terminal) { %>
          <div
            class="result-score <%= disqualified ? 'disqualified' : attempt.passed ? 'passed' : 'failed' %>"
          >
            <span>
              <%= disqualified
                ? "시간 초과"
                : isPlacement
                  ? "배치 완료"
                  : attempt.passed
                  ? "통과"
                  : "재응시" %>
            </span>
            <strong>
              <% if (disqualified) { %>
                실격
              <% } else if (isPlacement) { %>
                <%= placementTotalCorrect %>
                <small>/ 30문항</small>
              <% } else { %>
                <%= attempt.scorePercent %>
                <small>점</small>
              <% } %>
            </strong>
            <p>
              <%= disqualified
                ? `${timeLimitLabel} 제한 시간을 초과했습니다.`
                : isPlacement
                  ? `${attempt.placementResult?.initialTier || "배치 산정 중"} · 초기 내부 실력 지표 ${attempt.placementResult?.initialRating ?? "-"}`
                  : attempt.passed
                  ? "80점 기준을 통과했습니다."
                  : "80점 이상이면 통과합니다." %>
            </p>
          </div>
        <% } else { %>
          <div class="attempt-progress-card">
            <span>답변 완료</span>
            <strong>
              <b id="answered-count">0</b>
              / <%= attempt.questions.length %>
            </strong>
            <div aria-hidden="true">
              <i id="answered-progress"></i>
            </div>
            <p>
              정답 제출 후에는 답을 바꿀 수 없습니다.
            </p>
          </div>
        <% } %>
      </header>

      <% if (isPlacement && submitted && attempt.placementResult) {
        const placementResult = attempt.placementResult;
        const estimatedTopPercent =
          placementResult.estimatedTopPercent !== null &&
          placementResult.estimatedTopPercent !== undefined
            ? Number(placementResult.estimatedTopPercent)
            : placementResult.percentile === null || placementResult.percentile === undefined
              ? null
              : Math.max(0, Math.round((100 - Number(placementResult.percentile)) * 10) / 10);
        const actualCohortSize = Number(placementResult.cohortSize || 0);
        const actualCohortRank = Number(placementResult.cohortRank || 0);
        const actualRankMinimumCohortSize = Number(
          placementResult.actualRankMinimumCohortSize || 100
        );
        const actualRankPublished =
          actualCohortSize >= actualRankMinimumCohortSize &&
          actualCohortRank > 0;
        const estimatedRankPopulation = Number(
          placementResult.estimatedRankPopulation || 10000
        );
        const estimatedRank = Number(
          placementResult.estimatedRank ||
            Math.max(
              1,
              Math.ceil(
                (Number(estimatedTopPercent || 0) / 100) *
                  estimatedRankPopulation
              )
            )
        );
      %>
        <section
          class="placement-result-summary"
          aria-label="배치고사 세부 결과"
        >
          <article>
            <span>전체 정답</span>
            <strong>
              <%= placementTotalCorrect %>
              <small>/ 30</small>
            </strong>
            <p>문항별 채점 결과와 해설은 공개하지 않습니다.</p>
          </article>
          <article>
            <span>예상 순위</span>
            <strong>
              <% if (estimatedTopPercent === null) { %>
                순위 산정 중
              <% } else { %>
                <%= estimatedRankPopulation.toLocaleString("ko-KR") %>명 중 예상
                <%= estimatedRank.toLocaleString("ko-KR") %><small>위</small>
              <% } %>
            </strong>
            <p>
              <% if (estimatedTopPercent !== null) { %>
                예상 상위 <%= estimatedTopPercent %>%
              <% } %>
              <% if (actualRankPublished) { %>
                <br />현재 실제 응시자 <%= actualCohortSize.toLocaleString("ko-KR") %>명 중 공동 <%= actualCohortRank.toLocaleString("ko-KR") %>위
              <% } %>
            </p>
          </article>
        </section>
        <%- include("partials/placement-story-card", {
          learner,
          placementResult,
          placementTotalCorrect,
        }) %>
      <% } %>

      <% if (!(isPlacement && terminal)) { %>
      <form
        class="assessment-paper"
        id="assessment-paper"
        action="<%= submitUrl %>"
        method="post"
      >
        <% if (isPlacement && !terminal) { %>
          <input
            type="hidden"
            name="activeQuestionId"
            id="active-question-id"
            value="<%= attempt.questions[initialQuestionIndex]?.questionId || '' %>"
          />
          <input
            type="hidden"
            name="currentQuestionIndex"
            id="current-question-index"
            value="<%= initialQuestionIndex %>"
          />
          <section
            class="placement-question-navigator"
            data-placement-navigator
            aria-label="배치고사 문항 이동"
          >
            <div>
              <span>현재 문항</span>
              <strong>
                <b id="current-question-number"><%= initialQuestionIndex + 1 %></b>
                / <%= attempt.questions.length %>
              </strong>
              <small>다음 문항으로 이동할 때까지의 풀이 시간이 기록됩니다.</small>
            </div>
            <div
              class="placement-question-map"
              aria-label="문항 바로가기"
            >
              <% attempt.questions.forEach((question, index) => { %>
                <button
                  type="button"
                  data-question-jump="<%= index %>"
                  class="<%= index === initialQuestionIndex ? 'current' : '' %> <%= question.submittedAnswer !== null && String(question.submittedAnswer).trim() ? 'answered' : '' %>"
                  aria-label="<%= index + 1 %>번 문항"
                  aria-current="<%= index === initialQuestionIndex ? 'step' : 'false' %>"
                >
                  <%= index + 1 %>
                </button>
              <% }) %>
            </div>
          </section>
        <% } %>

        <% attempt.questions.forEach((question, index) => {
          const submittedChoiceIndex =
            question.inputMode === "multiple-choice"
              ? question.choices.findIndex(
                  (choice) =>
                    String(choice.key) ===
                    String(question.submittedAnswer)
                )
              : -1;
          const answerChoiceIndex =
            question.inputMode === "multiple-choice"
              ? question.choices.findIndex(
                  (choice) =>
                    String(choice.key) ===
                    String(question.answer)
                )
              : -1;
        %>
          <article
            class="assessment-question <%= submitted ? (question.isCorrect ? 'correct' : 'wrong') : '' %>"
            data-question
            data-question-index="<%= index %>"
            data-question-id="<%= question.questionId %>"
            <%= isPlacement && !terminal && index !== initialQuestionIndex ? "hidden" : "" %>
          >
            <header>
              <span class="question-number">
                <%= isPlacement
                  ? `${index + 1}.`
                  : String(index + 1).padStart(2, "0") %>
              </span>
              <% if (!isPlacement) { %>
                <span
                  class="difficulty-tag <%= difficultyClass(question.difficulty) %>"
                >
                  <%= difficultyLabels[question.difficulty] %>
                </span>
              <% } %>
              <span class="question-points">
                <%= isPlacement
                  ? `[${question.points}점]`
                  : `${question.points}점` %>
              </span>
              <% if (submitted) { %>
                <strong>
                  <%= question.isCorrect ? "정답" : "오답" %>
                </strong>
              <% } %>
            </header>

            <div class="question-prompt">
              <%= question.prompt %>
            </div>

            <% if (question.inputMode === "multiple-choice") { %>
              <div class="question-choices">
                <% question.choices.forEach((choice, choiceIndex) => { %>
                  <label>
                    <input
                      type="radio"
                      name="answers[<%= question.questionId %>]"
                      value="<%= choice.key %>"
                      <%= String(question.submittedAnswer ?? "") === String(choice.key) ? "checked" : "" %>
                      <%= terminal ? "disabled" : "" %>
                    />
                    <span class="choice-key">
                      <%= choiceMarker(choiceIndex) %>
                    </span>
                    <span><%= choice.text %></span>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <label class="short-answer">
                <span>답</span>
                <input
                  type="text"
                  name="answers[<%= question.questionId %>]"
                  value="<%= question.submittedAnswer ?? '' %>"
                  placeholder="<%= question.difficulty === 'advanced' ? '예: 12, 2' : '정답 입력' %>"
                  autocomplete="off"
                  data-math-input
                  <%= terminal ? "readonly" : "" %>
                />
              </label>
            <% } %>

            <% if (submitted) { %>
              <div class="question-review">
                <div>
                  <span>제출한 답</span>
                  <strong class="review-answer">
                    <% if (submittedChoiceIndex >= 0) { %>
                      <span class="choice-key">
                        <%= choiceMarker(submittedChoiceIndex) %>
                      </span>
                      <span>
                        <%= question.choices[submittedChoiceIndex].text %>
                      </span>
                    <% } else { %>
                      <%= question.submittedAnswer || "미응답" %>
                    <% } %>
                  </strong>
                </div>
                <div>
                  <span>정답</span>
                  <strong class="review-answer">
                    <% if (answerChoiceIndex >= 0) { %>
                      <span class="choice-key">
                        <%= choiceMarker(answerChoiceIndex) %>
                      </span>
                      <span>
                        <%= question.choices[answerChoiceIndex].text %>
                      </span>
                    <% } else { %>
                      <%= question.answer %>
                    <% } %>
                  </strong>
                </div>
                <p><%= question.solution %></p>
              </div>
            <% } %>
          </article>
        <% }) %>

        <% if (isPlacement && !terminal) { %>
          <nav
            class="placement-question-controls"
            aria-label="이전 또는 다음 문항"
          >
            <button
              type="button"
              data-question-previous
              <%= initialQuestionIndex === 0 ? "disabled" : "" %>
            >
              <span aria-hidden="true">←</span>
              이전 문항
            </button>
            <p>
              한 화면에는 한 문항만 표시됩니다.
              이동 전 답안과 풀이 시간이 자동 저장됩니다.
            </p>
            <button
              type="button"
              data-question-next
              <%= initialQuestionIndex === attempt.questions.length - 1 ? "disabled" : "" %>
            >
              다음 문항
              <span aria-hidden="true">→</span>
            </button>
          </nav>
        <% } %>

        <% if (!terminal) { %>
          <footer class="paper-submit">
            <div>
              <span><%= placementVerification ? "추가 확인" : isPlacement ? "배치 결과" : "통과 기준" %></span>
              <strong>
                <%= placementVerification
                  ? "준킬러 2문항 · 킬러 2문항"
                  : isPlacement
                    ? "100점 만점"
                    : `${attempt.passScore}점 이상` %>
              </strong>
              <p>
                <%= placementVerification
                  ? "네 문항의 결과를 기존 배치 결과와 합쳐 최종 초기 내부 실력 지표를 계산합니다."
                  : isPlacement
                  ? "미응답 문항은 오답으로 반영되어 초기 랭크에 불이익이 생길 수 있습니다."
                  : "비어 있는 답은 오답으로 처리됩니다." %>
              </p>
            </div>
            <button type="submit">
              <%= placementVerification ? "추가 확인 제출 및 티어 산정" : "답안 제출 및 채점" %>
            </button>
          </footer>
        <% } else { %>
          <footer class="paper-submit result-actions">
            <div>
              <span>
                <%= disqualified
                  ? "실격"
                  : "결과" %>
              </span>
              <strong>
                <%= disqualified
                  ? "제한 시간 초과"
                  : isPlacement
                    ? `${attempt.earnedPoints} / 100점 · ${attempt.placementResult?.initialTier || "배치 산정 중"}`
                    : `${attempt.earnedPoints} / ${attempt.totalPoints}점` %>
              </strong>
              <p>
                <%= disqualified
                  ? isPlacement
                    ? "이번 배치는 채점하지 않았습니다. 전장 페이지에서 새 배치고사를 시작할 수 있습니다."
                    : "이번 회차는 채점하지 않으며 새 회차에 다시 응시할 수 있습니다."
                  : isPlacement
                    ? "배점별 정답 수와 핵심 문항 결과가 초기 랭크 산정 자료로 저장되었습니다."
                    : "오답 해설을 확인한 뒤 새 회차에 응시할 수 있습니다." %>
              </p>
            </div>
            <a href="<%= backUrl %>">
              <%= isPlacement ? "GOAT Arena로 돌아가기" : "평가 센터로 돌아가기" %>
            </a>
          </footer>
        <% } %>
      </form>
      <% } else { %>
        <section class="paper-submit result-actions placement-secure-actions">
          <div>
            <span>
              <%= disqualified
                ? "실격"
                : "비공개 배치 결과" %>
            </span>
            <strong>
              <%= disqualified
                ? "제한 시간 초과"
                : `${placementTotalCorrect}문항 정답 · ${attempt.placementResult?.initialTier || "배치 산정 중"}` %>
            </strong>
            <p>
              <%= disqualified
                ? "이번 배치는 채점하지 않았습니다."
                : "배치고사 문항·제출 답·정답·해설은 비공개이며 집계 결과와 랭킹만 제공합니다." %>
            </p>
          </div>
          <a href="<%= backUrl %>">GOAT Arena로 돌아가기</a>
        </section>
      <% } %>
    </main>
    </div>
    <% if (!terminal) { %>
      <script
        id="assessment-attempt-config"
        type="application/json"
      ><%- JSON.stringify({
        attemptId: String(attempt._id),
        timeLimitMs,
        remainingTimeMs,
        draftUrl: isPlacement
          ? `/api/war-of-masters/placement/${attempt._id}/draft`
          : `/api/assessments/${attempt._id}/draft`,
        expireUrl: isPlacement
          ? `/api/war-of-masters/placement/${attempt._id}/expire`
          : `/api/assessments/${attempt._id}/expire`,
        attemptUrl: isPlacement
          ? `/war-of-masters/placement/${attempt._id}`
          : `/assessments/${attempt._id}`,
        backUrl,
        placement: isPlacement,
        initialQuestionIndex,
      }).replace(/</g, "\\u003c") %></script>
    <% } %>
  </body>
</html>

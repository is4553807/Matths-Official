<%
  const learner =
    typeof user !== "undefined" &&
    user
      ? user
      : {};
  const gradeLabels = {
    10: "고등학교 1학년",
    11: "고등학교 2학년",
    12: "고등학교 3학년",
    13: "N수생",
  };
  const gradeLabel =
    gradeLabels[Number(learner.schoolGrade)] ||
    "학년 미설정";
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="완료한 개념만으로 중간평가, 대단원 기말평가, 과목 종합평가에 응시하는 Matths 평가 센터입니다."
    />
    <title>평가 센터 | Matths</title>
    <link
      rel="stylesheet"
      href="/css/main.css"
    />
    <link
      rel="stylesheet"
      href="/css/assessment.css"
    />
    <link rel="stylesheet" href="/css/onboarding-tutorial.css" />
    <script src="/js/main.js" defer></script>
    <script
      src="/js/assessment-center.js"
      defer
    ></script>
    <script src="/js/onboarding-tutorial.js" defer></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="assessment-page">
    <a
      class="skip-link"
      href="#assessment-main"
    >
      본문으로 바로가기
    </a>

    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

      <aside class="sidebar" id="dashboard-sidebar" aria-label="학습 메뉴">
        <div class="sidebar-top">
          <%- include("partials/matths-brand", { href: "/", ariaLabel: "Matths 메인", className: "brand", tone: "light" }) %>
          <button class="sidebar-close" id="sidebar-close" type="button" aria-label="메뉴 닫기">×</button>
        </div>

        <%- include("partials/dashboard-navigation", {
          activePage: "assessments",
        }) %>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile" aria-label="<%= learner.name || "학생" %>님의 프로필 설정으로 이동" title="프로필 설정"><%= String(learner.name || "학생").slice(0, 1) %></a>
          <div class="profile-copy">
            <strong><%= learner.name || "학생" %>님</strong>
            <small><%= gradeLabel %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃" title="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main
        class="dashboard-main assessment-main"
        id="assessment-main"
      >
        <header class="topbar assessment-dashboard-topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>평가 센터</p>
              <p class="topbar-title">전체 과목 평가</p>
            </div>
          </div>
          <a class="back-dashboard learning-home-button" href="/main">학습 홈으로 <span aria-hidden="true">→</span></a>
        </header>

      <section class="assessment-hero" data-tutorial-target="assessment-overview">
        <div>
          <p class="eyebrow">
            평가 센터
          </p>
          <h1>
            배운 범위 안에서<br />
            제대로 확인합니다.
          </h1>
          <p>
            모든 과목을 확인할 수 있습니다. 지금 응시할 수
            없는 과목은 접혀 있으며, 개념 학습을 완료하면
            소단원 평가부터 차례로 열립니다.
          </p>
        </div>

        <div class="pass-rule" data-tutorial-target="assessment-rules">
          <span>통과 기준</span>
          <strong>
            <%= assessmentData.passScore %>
            <small>점</small>
          </strong>
          <p>
            대단원과 과목은 평가를 통과해야
            최종 완료로 기록됩니다.
          </p>
        </div>
      </section>

      <% assessmentData.courses.forEach((course, courseIndex) => { %>
        <details
          class="assessment-course <%= course.available ? 'available' : 'locked' %>"
          aria-labelledby="course-<%= course.id %>"
          <%= course.available ? "open" : "" %>
        >
          <summary class="course-heading" <%- courseIndex === 0 ? 'data-tutorial-target="assessment-course"' : '' %>>
            <div>
              <span>
                과목
                <%= String(courseIndex + 1).padStart(2, "0") %>
              </span>
              <h2 id="course-<%= course.id %>">
                <%= course.title %>
              </h2>
            </div>

            <div
              class="course-pass-state <%= course.courseFinal.passed ? 'passed' : '' %>"
            >
              <span>
                <%= course.available
                  ? `${course.unlockedAssessmentCount}개 평가 열림`
                  : "현재 응시 불가" %>
              </span>
              <strong>
                <%= course.courseFinal.passed
                  ? `과목 통과 · 최고 ${course.courseFinal.bestScore}점`
                  : course.available
                    ? "펼쳐서 평가 확인"
                    : "개념 학습 필요" %>
              </strong>
              <i aria-hidden="true">+</i>
            </div>
          </summary>

          <div class="assessment-course-body">
          <% if (!course.available) { %>
            <div class="locked-course-message">
              <span aria-hidden="true">⌁</span>
              <div>
                <h3>아직 이 과목의 평가에 응시할 수 없습니다.</h3>
                <p>
                  <%= course.lockReason %>
                  내 학습에서 이 과목의 개념을 모두 배우고 다시 오세요.
                </p>
                <a href="/my-learning">이 과목 학습하러 가기 →</a>
              </div>
            </div>
          <% } else { %>

          <div class="assessment-unit-list">
            <% course.units.forEach((unit, unitIndex) => { %>
              <article class="assessment-unit">
                <header>
                  <span>
                    <%= ["Ⅰ", "Ⅱ", "Ⅲ", "Ⅳ"][unitIndex] || unitIndex + 1 %>
                  </span>
                  <div>
                    <h3><%= unit.title %></h3>
                  </div>
                </header>

                <div class="subassessment-grid">
                  <% unit.subunits.forEach((subunit) => { %>
                    <div
                      class="subassessment-card <%= subunit.passed ? 'passed' : subunit.unlocked ? 'ready' : 'locked' %>"
                    >
                      <div class="assessment-state-icon" aria-hidden="true">
                        <%= subunit.passed ? "✓" : subunit.unlocked ? "→" : "·" %>
                      </div>

                      <div>
                        <span>소단원 중간평가 · 10문항</span>
                        <h4><%= subunit.title %></h4>
                        <p>
                          <%= subunit.activeAttemptId
                            ? "진행 중 · 작성한 답안 자동 저장"
                            : subunit.hasEmptyAttempt
                            ? "새 회차 준비 · 저장된 답안 없음"
                            : subunit.passed
                            ? `통과 · 최고 ${subunit.bestScore}점 · ${subunit.attempts}회 응시`
                            : subunit.attempts > 0
                            ? `미통과 · 최고 ${subunit.bestScore}점 · ${subunit.attempts}회 응시`
                            : subunit.unlocked
                              ? "응시 가능 · 중상 난이도"
                              : subunit.lockReason %>
                        </p>
                        <small>
                          <%= subunit.concepts
                            .map((concept) => concept.title)
                            .join(" · ") %>
                        </small>
                      </div>

                      <% if (subunit.activeAttemptId) { %>
                        <a
                          class="assessment-resume"
                          href="/assessments/<%= subunit.activeAttemptId %>"
                        >
                          이어서 응시
                        </a>
                      <% } else { %>
                        <form
                          action="/assessments/start"
                          method="post"
                        >
                        <input
                          type="hidden"
                          name="scopeType"
                          value="subunit"
                        />
                        <input
                          type="hidden"
                          name="courseId"
                          value="<%= course.id %>"
                        />
                        <input
                          type="hidden"
                          name="unitId"
                          value="<%= unit.id %>"
                        />
                        <input
                          type="hidden"
                          name="subunitId"
                          value="<%= subunit.id %>"
                        />
                        <button
                          type="submit"
                          <%= subunit.unlocked ? "" : "disabled" %>
                        >
                          <%= subunit.attempts > 0 || subunit.hasEmptyAttempt
                            ? "새 회차"
                            : "응시하기" %>
                        </button>
                        </form>
                      <% } %>
                    </div>
                  <% }) %>
                </div>

                <div
                  class="unit-final <%= unit.final.passed ? 'passed' : unit.final.unlocked ? 'ready' : 'locked' %>"
                >
                  <div>
                    <span>대단원 기말평가 · 20문항</span>
                    <h4>
                      <%= unit.title %> 종합
                    </h4>
                    <p>
                      중상 7문항 · 응용 8문항 · 심화 5문항
                    </p>
                  </div>

                  <div class="unit-final-action">
                    <strong>
                      <%= unit.final.activeAttemptId
                        ? "진행 중 · 작성한 답안 자동 저장"
                        : unit.final.hasEmptyAttempt
                        ? "새 회차 준비 · 저장된 답안 없음"
                        : unit.final.passed
                        ? `통과 · 최고 ${unit.final.bestScore}점`
                        : unit.final.attempts > 0
                        ? `미통과 · 최고 ${unit.final.bestScore}점`
                        : unit.final.unlocked
                          ? "응시 가능"
                          : unit.final.lockReason %>
                    </strong>
                    <% if (unit.final.activeAttemptId) { %>
                      <a
                        class="assessment-resume"
                        href="/assessments/<%= unit.final.activeAttemptId %>"
                      >
                        이어서 응시
                      </a>
                    <% } else { %>
                      <form
                        action="/assessments/start"
                        method="post"
                      >
                      <input
                        type="hidden"
                        name="scopeType"
                        value="unit"
                      />
                      <input
                        type="hidden"
                        name="courseId"
                        value="<%= course.id %>"
                      />
                      <input
                        type="hidden"
                        name="unitId"
                        value="<%= unit.id %>"
                      />
                      <button
                        type="submit"
                        <%= unit.final.unlocked ? "" : "disabled" %>
                      >
                        <%= unit.final.attempts > 0 || unit.final.hasEmptyAttempt
                          ? "새 회차"
                          : "기말평가 시작" %>
                      </button>
                      </form>
                    <% } %>
                  </div>
                  </div>
              </article>
            <% }) %>
          </div>

          <div
            class="course-final <%= course.courseFinal.passed ? 'passed' : course.courseFinal.unlocked ? 'ready' : 'locked' %>"
          >
            <div>
              <span>과목 종합평가 · 40문항</span>
              <h3>
                <%= course.title %> 과목 종합평가
              </h3>
              <p>
                과목 안에서 배운 개념과 응용·심화 문제를
                전 범위로 확인합니다.
              </p>
            </div>

            <div>
              <strong>
                <%= course.courseFinal.activeAttemptId
                  ? "진행 중 · 작성한 답안 자동 저장"
                  : course.courseFinal.hasEmptyAttempt
                  ? "새 회차 준비 · 저장된 답안 없음"
                  : course.courseFinal.passed
                  ? `통과 · 최고 ${course.courseFinal.bestScore}점`
                  : course.courseFinal.attempts > 0
                  ? `미통과 · 최고 ${course.courseFinal.bestScore}점`
                  : course.courseFinal.unlocked
                    ? "응시 가능"
                    : course.courseFinal.lockReason %>
              </strong>
              <% if (course.courseFinal.activeAttemptId) { %>
                <a
                  class="assessment-resume"
                  href="/assessments/<%= course.courseFinal.activeAttemptId %>"
                >
                  이어서 응시
                </a>
              <% } else { %>
                <form
                  action="/assessments/start"
                  method="post"
                >
                <input
                  type="hidden"
                  name="scopeType"
                  value="course"
                />
                <input
                  type="hidden"
                  name="courseId"
                  value="<%= course.id %>"
                />
                <button
                  type="submit"
                  <%= course.courseFinal.unlocked ? "" : "disabled" %>
                >
                  <%= course.courseFinal.attempts > 0 || course.courseFinal.hasEmptyAttempt
                    ? "새 회차"
                    : "종합평가 시작" %>
                </button>
                </form>
              <% } %>
            </div>
          </div>
          <% } %>
          </div>
        </details>
      <% }) %>
      </main>
    </div>
  <%- include("partials/onboarding-tutorial", { page: "assessments" }) %>
  <%- include("partials/business-footer") %>
  </body>
</html>

<!doctype html>
<html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>결제 준비 | Matths</title><link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" /><link rel="stylesheet" href="/css/main.css" /><link rel="stylesheet" href="/css/public-navigation.css" /><link rel="stylesheet" href="/css/brand.css" /><link rel="stylesheet" href="/css/parent.css" /></head>
<body class="checkout-page"><%- include('partials/public-navigation', { activePage: 'pricing', user }) %><main class="student-checkout-main"><section class="student-checkout-card"><p>본인 결제</p><h1><%= product.name %></h1><span><%= product.description %></span><dl><div><dt>이용 기간</dt><dd><%= product.periodLabel %></dd></div><div><dt>결제 예정 금액</dt><dd><strong><%= new Intl.NumberFormat('ko-KR').format(product.amount) %>원</strong></dd></div></dl>
<% if (!intent) { %>
  <section class="checkout-refund-table" aria-labelledby="checkout-refund-title">
    <h2 id="checkout-refund-title">결제 전 환불 기준</h2>
    <table><tbody>
      <tr><th>전액 환불</th><td><%= product.refundPolicy.fullRefund %></td></tr>
      <tr><th>부분 환불</th><td><%= product.refundPolicy.partialRefund %><br /><code><%= product.refundPolicy.formula %></code></td></tr>
      <tr><th>신청·처리</th><td><%= product.refundPolicy.application %> <%= product.refundPolicy.processing %></td></tr>
    </tbody></table>
  </section>
  <form method="post">
    <label><input type="checkbox" required /> 상품과 금액을 확인했습니다.</label>
    <label class="guardian-consent-check"><input type="checkbox" name="refundPolicyAccepted" value="true" required /><span>위 상품별 전액·부분 환불 기준, 산식, 신청방법과 3영업일 처리기한을 확인하고 동의합니다.</span></label>
    <button type="submit">결제 계속하기</button>
  </form>
<% } else { %>
  <div class="parent-pending-payment toss-checkout-shell">
    <div class="toss-checkout-heading">
      <strong>결제수단을 선택해 주세요.</strong>
      <% if (checkoutConfig.mode === "TEST") { %><span class="payment-test-badge">토스 테스트 결제 · 실제 청구 없음</span><% } %>
      <p>주문번호 <%= intent.orderId %></p>
    </div>
    <div id="payment-method"></div>
    <div id="agreement"></div>
    <p class="toss-payment-error" data-toss-payment-error role="alert" hidden></p>
    <button type="button" data-toss-payment-button disabled><%= new Intl.NumberFormat('ko-KR').format(intent.amount) %>원 결제하기</button>
  </div>
<% } %>
<a class="checkout-back" href="/pricing">이용권 비교로 돌아가기</a></section></main>
<% if (intent) { const checkoutPayload = JSON.stringify(checkoutConfig).replace(/</g, "\\u003c"); %>
<script src="https://js.tosspayments.com/v2/standard"></script>
<script>
  (() => {
    const config = <%- checkoutPayload %>;
    const button = document.querySelector("[data-toss-payment-button]");
    const errorBox = document.querySelector("[data-toss-payment-error]");
    const showError = (message) => {
      errorBox.textContent = String(message || "결제창을 열지 못했습니다. 잠시 후 다시 시도해 주세요.");
      errorBox.hidden = false;
    };
    (async () => {
      try {
        const tossPayments = window.TossPayments(config.clientKey);
        const widgets = tossPayments.widgets({ customerKey: config.customerKey });
        await widgets.setAmount({ currency: config.currency, value: config.amount });
        await Promise.all([
          widgets.renderPaymentMethods({ selector: "#payment-method", variantKey: config.paymentVariantKey }),
          widgets.renderAgreement({ selector: "#agreement", variantKey: config.agreementVariantKey }),
        ]);
        button.disabled = false;
        button.addEventListener("click", async () => {
          button.disabled = true;
          errorBox.hidden = true;
          try {
            await widgets.requestPayment({
              orderId: config.orderId,
              orderName: config.orderName,
              successUrl: config.successUrl,
              failUrl: config.failUrl,
              customerEmail: config.customerEmail || undefined,
              customerName: config.customerName || undefined,
            });
          } catch (error) {
            showError(error?.message);
            button.disabled = false;
          }
        });
      } catch (error) {
        showError(error?.message);
      }
    })();
  })();
</script>
<% } %>
</body></html>

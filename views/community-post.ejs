<%
  const loggedIn = typeof user !== "undefined" && Boolean(user);
  const boardLabels = { "high-school": "통합 고등학교 게시판", school: post.schoolName ? `${post.schoolName} 게시판` : "학교 게시판", retaker: "N수생 게시판", university: post.universityName ? `${post.universityName} 게시판` : "대학교 게시판", worker: "직장인 게시판" };
  const boardLabel = boardLabels[post.boardType] || "통합 고등학교 게시판";
  const formatDate = (date) => new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "long", timeStyle: "short" }).format(new Date(date));
  const backHref = ["school", "retaker", "university", "worker"].includes(post.boardType) ? `/community?board=${post.boardType}` : "/community?board=high-school";
  const gradeLabel = { 10: "1학년", 11: "2학년", 12: "3학년", 13: "N수생", 14: "대학생", 15: "직장인" }[Number(post.authorSchoolGrade)] || "";
  const anonymousSchoolLabel = Number(post.authorSchoolGrade) === 13 ? "N수생" : Number(post.authorSchoolGrade) === 14 ? "OO대학교 대학생" : Number(post.authorSchoolGrade) === 15 ? "직장인" : [post.authorRegion, "OO고등학교", gradeLabel].filter(Boolean).join(" ");
  const attachments = Array.isArray(post.attachments) ? post.attachments : [];
  const imageExtensions = new Set(["png", "jpg", "jpeg", "webp", "heic"]);
  const attachmentHref = (attachment, download = false) => `/community/${post._id}/attachments/${attachment._id}${download ? "?download=1" : ""}`;
  const isImage = (attachment) => imageExtensions.has(String(attachment.originalName || "").split(".").pop().toLowerCase()) && String(attachment.mimeType || "").startsWith("image/");
  const formatBytes = (bytes) => {
    const size = Number(bytes) || 0;
    if (size >= 1024 * 1024) return `${(size / (1024 * 1024)).toFixed(1)}MB`;
    if (size >= 1024) return `${Math.ceil(size / 1024)}KB`;
    return `${size}B`;
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= post.title %> | Matths 게시판</title>
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/matths-brand-tokens.css" />
    <link rel="stylesheet" href="/css/public-navigation.css" />
    <link rel="stylesheet" href="/css/community.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  </head>
  <body>
    <%- include("partials/public-navigation", { activePage: "community" }) %>
    <main class="community-post-main">
      <a class="community-back" href="<%= backHref %>">← <%= boardLabel %></a>
      <% if (created) { %><div class="community-feedback">게시글을 등록했습니다.</div><% } %>
      <% if (reported) { %><div class="community-feedback">신고가 접수되었습니다. 운영자가 확인하겠습니다.</div><% } %>
      <article class="community-post-detail">
        <header>
          <span><%= boardLabel %></span>
          <% if (post.isPopular) { %><b class="community-popular-badge">인기 글</b><% } %>
          <h1><%= post.title %></h1>
          <div>
            <strong><%= post.authorName %></strong>
            <% if (post.isAnonymous) { %><span class="community-anonymous-school"><%= anonymousSchoolLabel %></span><% } %>
            <small><%= formatDate(post.createdAt) %> · 조회 <%= post.viewCount || 0 %></small>
          </div>
        </header>
        <div class="community-post-content"><%= post.content %></div>
        <% if (attachments.length) { %>
          <section class="community-post-attachments" aria-labelledby="community-attachments-title">
            <header>
              <div><p>ATTACHMENTS</p><h2 id="community-attachments-title">첨부파일 <%= attachments.length %>개</h2></div>
              <span>사진을 누르면 원본으로 확인할 수 있습니다.</span>
            </header>
            <% const images = attachments.filter(isImage); %>
            <% if (images.length) { %>
              <div class="community-image-grid">
                <% images.forEach((attachment) => { %>
                  <a href="<%= attachmentHref(attachment) %>" target="_blank" rel="noopener">
                    <img src="<%= attachmentHref(attachment) %>" alt="<%= attachment.originalName %>" loading="lazy" />
                    <span><%= attachment.originalName %></span>
                  </a>
                <% }) %>
              </div>
            <% } %>
            <div class="community-file-list">
              <% attachments.forEach((attachment) => { %>
                <a href="<%= attachmentHref(attachment, true) %>">
                  <span aria-hidden="true"><%= isImage(attachment) ? "IMG" : "FILE" %></span>
                  <div><strong><%= attachment.originalName %></strong><small><%= formatBytes(attachment.sizeBytes) %></small></div>
                  <b>다운로드 ↓</b>
                </a>
              <% }) %>
            </div>
          </section>
        <% } %>
        <section class="community-vote-box" id="post-votes" aria-label="게시글 평가">
          <p>이 글이 도움이 되었나요?</p>
          <% if (loggedIn) { %>
            <div>
              <form action="/community/<%= post._id %>/vote" method="POST">
                <input type="hidden" name="value" value="1" />
                <button class="<%= viewerVote === 1 ? "selected" : "" %>" type="submit" aria-pressed="<%= viewerVote === 1 %>">
                  <span aria-hidden="true">↑</span> 추천 <strong><%= post.upvoteCount || 0 %></strong>
                </button>
              </form>
              <form action="/community/<%= post._id %>/vote" method="POST">
                <input type="hidden" name="value" value="-1" />
                <button class="down <%= viewerVote === -1 ? "selected" : "" %>" type="submit" aria-pressed="<%= viewerVote === -1 %>">
                  <span aria-hidden="true">↓</span> 비추천 <strong><%= post.downvoteCount || 0 %></strong>
                </button>
              </form>
            </div>
          <% } else { %>
            <div class="community-vote-readonly">
              <span>추천 <strong><%= post.upvoteCount || 0 %></strong></span>
              <span>비추천 <strong><%= post.downvoteCount || 0 %></strong></span>
              <a href="/login">로그인하고 평가하기</a>
            </div>
          <% } %>
          <small>같은 버튼을 다시 누르면 선택이 취소됩니다.</small>
        </section>
        <% if (loggedIn && String(user.id) !== String(post.authorId)) { %>
          <details class="community-report-box" <%= reportError ? "open" : "" %>>
            <summary><%= viewerReported ? "신고 접수 완료" : "게시글 신고" %></summary>
            <% if (viewerReported) { %>
              <p>이미 접수한 신고입니다. 운영자가 순서대로 확인합니다.</p>
            <% } else { %>
              <form action="/community/<%= post._id %>/report" method="POST">
                <% if (reportError) { %><div class="community-error" role="alert"><%= reportError %></div><% } %>
                <label for="report-reason">신고 사유</label>
                <textarea id="report-reason" name="reason" minlength="5" maxlength="1000" required placeholder="문제가 되는 내용을 구체적으로 적어주세요."><%= reportDraft || "" %></textarea>
                <button type="submit">신고 접수</button>
              </form>
            <% } %>
          </details>
        <% } %>
      </article>
      <section class="community-comments" id="comments">
        <header>
          <div>
            <p>COMMENTS</p>
            <h2>댓글 <%= comments.length %>개</h2>
          </div>
          <span>서로의 풀이와 생각을 존중해 주세요.</span>
        </header>

        <% if (commentCreated) { %>
          <div class="community-feedback" role="status">댓글을 등록했습니다.</div>
        <% } %>
        <% if (commentError) { %>
          <div class="community-error" role="alert"><%= commentError %></div>
        <% } %>

        <% if (loggedIn) { %>
          <form class="community-comment-form" action="/community/<%= post._id %>/comments" method="POST">
            <label for="comment-content">댓글 내용</label>
            <textarea id="comment-content" name="content" minlength="1" maxlength="2000" placeholder="수학적인 질문, 풀이 아이디어, 응원의 말을 남겨보세요." required><%= typeof commentDraft !== "undefined" ? commentDraft : "" %></textarea>
            <div class="community-comment-options">
              <label class="community-anonymous-choice compact">
                <input
                  type="checkbox"
                  name="isAnonymous"
                  <%= typeof commentAnonymousDraft !== "undefined" && commentAnonymousDraft ? "checked" : "" %>
                />
                <span>
                  <b>익명으로 댓글 작성</b>
                  <small>계정에 고정된 익명 번호가 표시됩니다.</small>
                </span>
              </label>
              <div><small>최대 2,000자</small><button type="submit">댓글 등록</button></div>
            </div>
          </form>
        <% } else { %>
          <div class="community-comment-login">
            <p>댓글을 작성하려면 로그인이 필요합니다.</p>
            <a href="/login">로그인하고 댓글 쓰기 →</a>
          </div>
        <% } %>

        <div class="community-comment-list">
          <% if (!comments.length) { %>
            <div class="community-comment-empty">첫 댓글을 남겨 대화를 시작해 보세요.</div>
          <% } %>
          <% comments.forEach((comment) => { %>
            <article>
              <header>
                <strong><%= comment.authorName %></strong>
                <time><%= formatDate(comment.createdAt) %></time>
              </header>
              <p><%= comment.content %></p>
            </article>
          <% }) %>
        </div>
      </section>
      <div class="community-post-actions"><a href="<%= backHref %>">목록으로</a><a class="primary" href="/community/new?board=<%= ["school", "retaker", "university", "worker"].includes(post.boardType) ? post.boardType : "high-school" %>">새 글 쓰기</a></div>
    </main>
  </body>
</html>

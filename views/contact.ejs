<%
  const contactUser = contactData.user;
  const inquiries = Array.isArray(contactData.inquiries)
    ? contactData.inquiries
    : [];
  const refundableOrders = Array.isArray(contactData.refundableOrders)
    ? contactData.refundableOrders
    : [];
  const statusLabels = {
    pending: "접수 완료",
    in_review: "관리자 확인 중",
    replied: "답변 완료",
    closed: "처리 종료",
  };
  const dateFormatter = new Intl.DateTimeFormat("ko-KR", {
    timeZone: "Asia/Seoul",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="로그인한 Matths 사용자가 학습 및 서비스 문의를 접수하는 페이지입니다."
    />
    <meta
      name="theme-color"
      content="#f7f8fc"
    />
    <title>문의하기 | Matths</title>
    <link
      rel="stylesheet"
      href="/css/faq.css"
    />
    <link
      rel="stylesheet"
      href="/css/contact.css"
    />
    <link
      rel="stylesheet"
      href="/css/public-navigation.css"
    />
    <link
      rel="stylesheet"
      href="/css/brand.css"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="64x64"
      href="/images/favicon-64.png"
    />
    <script
      src="/js/contact.js"
      defer
    ></script>
  </head>
  <body class="contact-page">
    <a
      class="skip-link"
      href="#contact-main"
    >
      본문으로 바로가기
    </a>

    <%- include("partials/public-navigation", { activePage: "" }) %>

    <main id="contact-main">
      <section class="inquiry-hero">
        <div
          class="inquiry-grid-pattern"
          aria-hidden="true"
        ></div>
        <div class="container inquiry-hero-inner">
          <div>
            <p class="inquiry-eyebrow">
              <span></span>
              MATTHS SUPPORT
            </p>
            <h1>
              궁금한 내용을<br />
              <em>직접 알려주세요.</em>
            </h1>
            <p>
              학습 내용, 문제 오류, 계정과 서비스 이용에
              관한 문의를 남길 수 있습니다.
            </p>
          </div>

          <aside
            class="contact-identity"
            aria-label="문의자 정보"
          >
            <header>
              <span>문의자 정보</span>
              <b>로그인 확인</b>
            </header>
            <div>
              <span
                class="identity-avatar"
                aria-hidden="true"
              ><%= contactUser.nickname.slice(0, 1) %></span>
              <p>
                <strong><%= contactUser.nickname %>님</strong>
                <small><%= contactUser.schoolName %></small>
              </p>
            </div>
            <dl>
              <div>
                <dt>답변 받을 이메일</dt>
                <dd><%= contactUser.email %></dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="inquiry-section">
        <div class="container inquiry-layout">
          <article class="inquiry-form-card">
            <div class="form-heading">
              <p>CONTACT FORM</p>
              <h2>문의 내용 작성</h2>
              <span>
                문제 화면이나 오류가 발생한 위치를 함께
                적으면 더 정확하게 확인할 수 있습니다.
              </span>
            </div>

            <div
              class="reply-notice"
              role="note"
            >
              <span aria-hidden="true">✉</span>
              <div>
                <strong>답변 안내</strong>
                <p>
                  관리자가 답변하면 회원가입한 이메일로
                  3~5일 이내에 연락드립니다.
                </p>
              </div>
            </div>

            <% if (feedback) { %>
              <div
                class="form-feedback <%= feedback.type %>"
                role="<%= feedback.type === 'error' ? 'alert' : 'status' %>"
              >
                <span aria-hidden="true">
                  <%= feedback.type === "error"
                    ? "!"
                    : feedback.type === "warning"
                      ? "i"
                      : "✓" %>
                </span>
                <p><%= feedback.message %></p>
              </div>
            <% } %>

            <form
              class="inquiry-form"
              action="/contact"
              method="POST"
              data-inquiry-form
            >
              <input type="hidden" name="requestId" value="<%= inquiryRequestId %>" />
              <fieldset class="inquiry-type-fieldset">
                <legend>문의 유형 <b aria-hidden="true">*</b></legend>
                <label><input type="radio" name="inquiryType" value="GENERAL" <%= oldInput.inquiryType !== "REFUND" ? "checked" : "" %> /> 일반 문의</label>
                <label><input type="radio" name="inquiryType" value="REFUND" <%= oldInput.inquiryType === "REFUND" ? "checked" : "" %> /> 환불 신청</label>
              </fieldset>

              <section class="refund-request-fields" data-refund-request-fields <%= oldInput.inquiryType === "REFUND" ? "" : "hidden" %>>
                <label for="refund-payment-id"><span>환불할 주문번호 <b aria-hidden="true">*</b></span></label>
                <select id="refund-payment-id" name="paymentId" data-refund-payment>
                  <option value="">주문번호를 선택해 주세요</option>
                  <% refundableOrders.forEach((order) => { %>
                    <option value="<%= order.id %>" <%= oldInput.paymentId === order.id ? "selected" : "" %>><%= order.orderReference %> - <%= order.approvedAt ? dateFormatter.format(new Date(order.approvedAt)) : "구매일 확인 필요" %> · <%= order.productName %> · 환불 가능 <%= new Intl.NumberFormat("ko-KR").format(order.remainingAmount) %>원</option>
                  <% }) %>
                </select>
                <% if (!refundableOrders.length) { %><p>현재 이 계정에서 환불 신청 가능한 실제 결제 주문이 없습니다. 관리자 무료 부여 이용권과 이미 처리 중이거나 전액 환불된 주문은 표시되지 않습니다.</p><% } %>
                <label for="refund-reason-type"><span>환불 사유</span></label>
                <select id="refund-reason-type" name="refundReasonType">
                  <option value="SIMPLE_CHANGE">단순 변심</option>
                  <option value="NOT_AS_DESCRIBED">표시·광고 또는 계약 내용과 다름</option>
                  <option value="SERVICE_FAILURE">서비스 제공 문제</option>
                  <option value="OTHER">기타</option>
                </select>
                <p>접수 후 상품별 산식으로 금액을 확인하며, 환불 가능 시 3영업일 이내 원 결제수단의 전체 또는 부분 취소를 요청합니다.</p>
              </section>

              <label for="inquiry-subject">
                <span>
                  제목
                  <b aria-hidden="true">*</b>
                </span>
                <small>
                  <output
                    id="subject-count"
                    for="inquiry-subject"
                  >0</output>/120
                </small>
              </label>
              <input
                id="inquiry-subject"
                name="subject"
                type="text"
                minlength="2"
                maxlength="120"
                required
                autocomplete="off"
                placeholder="문의 내용을 한 문장으로 적어주세요."
                value="<%= oldInput.subject %>"
              />

              <label for="inquiry-content">
                <span>
                  내용
                  <b aria-hidden="true">*</b>
                </span>
                <small>
                  <output
                    id="content-count"
                    for="inquiry-content"
                  >0</output>/5000
                </small>
              </label>
              <textarea
                id="inquiry-content"
                name="content"
                minlength="10"
                maxlength="5000"
                required
                rows="11"
                placeholder="문의 내용과 확인이 필요한 상황을 자세히 적어주세요."
              ><%= oldInput.content %></textarea>

              <div class="form-submit-row">
                <p>
                  문의 내용과 가입 이메일은 답변 및
                  처리 내역 확인을 위해 보관됩니다.
                </p>
                <button type="submit">
                  문의 접수
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </form>
            <script>
              (() => {
                const form = document.querySelector('[data-inquiry-form]');
                const fields = form?.querySelector('[data-refund-request-fields]');
                const payment = form?.querySelector('[data-refund-payment]');
                if (!form || !fields || !payment) return;
                const sync = () => {
                  const refund = form.querySelector('input[name="inquiryType"]:checked')?.value === 'REFUND';
                  fields.hidden = !refund;
                  payment.required = refund;
                };
                form.querySelectorAll('input[name="inquiryType"]').forEach((input) => input.addEventListener('change', sync));
                sync();
              })();
            </script>
          </article>

          <aside class="inquiry-side">
            <section class="support-process">
              <p>SUPPORT PROCESS</p>
              <h2>문의 처리 과정</h2>
              <ol>
                <li>
                  <span>01</span>
                  <div>
                    <strong>문의 접수</strong>
                    <p>
                      문의와 가입 이메일을 안전하게
                      저장합니다.
                    </p>
                  </div>
                </li>
                <li>
                  <span>02</span>
                  <div>
                    <strong>관리자 확인</strong>
                    <p>
                      관리자에게 이메일 알림을 보내고
                      내용을 확인합니다.
                    </p>
                  </div>
                </li>
                <li>
                  <span>03</span>
                  <div>
                    <strong>이메일 답변</strong>
                    <p>
                      회원가입한 이메일 주소로 답변을
                      전달합니다.
                    </p>
                  </div>
                </li>
              </ol>
            </section>

            <section class="recent-inquiries">
              <div>
                <p>MY INQUIRIES</p>
                <h2>최근 문의</h2>
              </div>

              <% if (inquiries.length) { %>
                <ul>
                  <% inquiries.forEach((inquiry) => { %>
                    <li>
                      <div>
                        <strong><%= inquiry.subject %></strong>
                        <small>
                          <%= dateFormatter.format(new Date(inquiry.createdAt)) %>
                        </small>
                      </div>
                      <span class="<%= inquiry.status %>">
                        <%= statusLabels[inquiry.status] || "접수 완료" %>
                      </span>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <div class="inquiry-empty">
                  <span aria-hidden="true">?</span>
                  <p>접수한 문의가 없습니다.</p>
                </div>
              <% } %>
            </section>

            <a
              class="faq-return"
              href="/faq"
            >
              <span aria-hidden="true">?</span>
              <div>
                <strong>FAQ 다시 확인하기</strong>
                <p>
                  자주 묻는 질문에서 바로 답을 찾을 수
                  있습니다.
                </p>
              </div>
              <b aria-hidden="true">→</b>
            </a>
          </aside>
        </div>
      </section>
    </main>

  <%- include("partials/business-footer") %>
  </body>
</html>

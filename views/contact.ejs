<%
  const contactUser = contactData.user;
  const inquiries = Array.isArray(contactData.inquiries)
    ? contactData.inquiries
    : [];
  const statusLabels = {
    pending: "접수 완료",
    in_review: "관리자 확인 중",
    replied: "답변 완료",
    closed: "처리 종료",
  };
  const dateFormatter = new Intl.DateTimeFormat("ko-KR", {
    timeZone: "Asia/Seoul",
    year: "numeric",
    month: "long",
    day: "numeric",
  });
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="로그인한 Matths 사용자가 학습 및 서비스 문의를 접수하는 페이지입니다."
    />
    <meta
      name="theme-color"
      content="#f7f8fc"
    />
    <title>문의하기 | Matths</title>
    <link
      rel="stylesheet"
      href="/css/faq.css"
    />
    <link
      rel="stylesheet"
      href="/css/contact.css"
    />
    <link
      rel="stylesheet"
      href="/css/brand.css"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="64x64"
      href="/images/favicon-64.png"
    />
    <script
      src="/js/contact.js"
      defer
    ></script>
  </head>
  <body class="contact-page">
    <a
      class="skip-link"
      href="#contact-main"
    >
      본문으로 바로가기
    </a>

    <header class="site-header">
      <nav
        class="navbar container"
        aria-label="주요 메뉴"
      >
        <a
          class="brand"
          href="/"
          aria-label="Matths 홈"
        >
          <span
            class="brand-mark"
            aria-hidden="true"
          >M</span>
          <span>Matths</span>
        </a>
        <div class="nav-links">
          <a href="/intro">서비스 소개</a>
          <a href="/visual-learning">시각화 학습</a>
          <a href="/learning-flow">학습 과정</a>
          <a href="/curriculum">교육과정</a>
          <a href="/faq">FAQ</a>
          <a
            class="active"
            href="/contact"
            aria-current="page"
          >문의하기</a>
        </div>
        <div class="nav-actions">
          <a
            class="login-link"
            href="/main"
          >대시보드</a>
          <a
            class="button button-primary button-small"
            href="/my-learning"
          >학습 계속하기</a>
        </div>
        <details class="mobile-menu">
          <summary aria-label="메뉴 열기">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div>
            <a href="/intro">서비스 소개</a>
            <a href="/visual-learning">시각화 학습</a>
            <a href="/learning-flow">학습 과정</a>
            <a href="/curriculum">교육과정</a>
            <a href="/faq">FAQ</a>
            <a href="/contact">문의하기</a>
            <a href="/main">대시보드</a>
          </div>
        </details>
      </nav>
    </header>

    <main id="contact-main">
      <section class="inquiry-hero">
        <div
          class="inquiry-grid-pattern"
          aria-hidden="true"
        ></div>
        <div class="container inquiry-hero-inner">
          <div>
            <p class="inquiry-eyebrow">
              <span></span>
              MATTHS SUPPORT
            </p>
            <h1>
              궁금한 내용을<br />
              <em>직접 알려주세요.</em>
            </h1>
            <p>
              학습 내용, 문제 오류, 계정과 서비스 이용에
              관한 문의를 남길 수 있습니다.
            </p>
          </div>

          <aside
            class="contact-identity"
            aria-label="문의자 정보"
          >
            <header>
              <span>문의자 정보</span>
              <b>로그인 확인</b>
            </header>
            <div>
              <span
                class="identity-avatar"
                aria-hidden="true"
              ><%= contactUser.nickname.slice(0, 1) %></span>
              <p>
                <strong><%= contactUser.nickname %>님</strong>
                <small><%= contactUser.schoolName %></small>
              </p>
            </div>
            <dl>
              <div>
                <dt>답변 받을 이메일</dt>
                <dd><%= contactUser.email %></dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="inquiry-section">
        <div class="container inquiry-layout">
          <article class="inquiry-form-card">
            <div class="form-heading">
              <p>CONTACT FORM</p>
              <h2>문의 내용 작성</h2>
              <span>
                문제 화면이나 오류가 발생한 위치를 함께
                적으면 더 정확하게 확인할 수 있습니다.
              </span>
            </div>

            <div
              class="reply-notice"
              role="note"
            >
              <span aria-hidden="true">✉</span>
              <div>
                <strong>답변 안내</strong>
                <p>
                  관리자가 답변하면 회원가입한 이메일로
                  3~5일 이내에 연락드립니다.
                </p>
              </div>
            </div>

            <% if (feedback) { %>
              <div
                class="form-feedback <%= feedback.type %>"
                role="<%= feedback.type === 'error' ? 'alert' : 'status' %>"
              >
                <span aria-hidden="true">
                  <%= feedback.type === "error"
                    ? "!"
                    : feedback.type === "warning"
                      ? "i"
                      : "✓" %>
                </span>
                <p><%= feedback.message %></p>
              </div>
            <% } %>

            <form
              class="inquiry-form"
              action="/contact"
              method="POST"
              data-inquiry-form
            >
              <label for="inquiry-subject">
                <span>
                  제목
                  <b aria-hidden="true">*</b>
                </span>
                <small>
                  <output
                    id="subject-count"
                    for="inquiry-subject"
                  >0</output>/120
                </small>
              </label>
              <input
                id="inquiry-subject"
                name="subject"
                type="text"
                minlength="2"
                maxlength="120"
                required
                autocomplete="off"
                placeholder="문의 내용을 한 문장으로 적어주세요."
                value="<%= oldInput.subject %>"
              />

              <label for="inquiry-content">
                <span>
                  내용
                  <b aria-hidden="true">*</b>
                </span>
                <small>
                  <output
                    id="content-count"
                    for="inquiry-content"
                  >0</output>/5000
                </small>
              </label>
              <textarea
                id="inquiry-content"
                name="content"
                minlength="10"
                maxlength="5000"
                required
                rows="11"
                placeholder="문의 내용과 확인이 필요한 상황을 자세히 적어주세요."
              ><%= oldInput.content %></textarea>

              <div class="form-submit-row">
                <p>
                  문의 내용과 가입 이메일은 답변 및
                  처리 기록을 위해 DB에 저장됩니다.
                </p>
                <button type="submit">
                  문의 접수
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </form>
          </article>

          <aside class="inquiry-side">
            <section class="support-process">
              <p>SUPPORT PROCESS</p>
              <h2>문의 처리 과정</h2>
              <ol>
                <li>
                  <span>01</span>
                  <div>
                    <strong>문의 접수</strong>
                    <p>
                      문의와 가입 이메일을 안전하게
                      저장합니다.
                    </p>
                  </div>
                </li>
                <li>
                  <span>02</span>
                  <div>
                    <strong>관리자 확인</strong>
                    <p>
                      관리자에게 이메일 알림을 보내고
                      내용을 확인합니다.
                    </p>
                  </div>
                </li>
                <li>
                  <span>03</span>
                  <div>
                    <strong>이메일 답변</strong>
                    <p>
                      회원가입한 이메일 주소로 답변을
                      전달합니다.
                    </p>
                  </div>
                </li>
              </ol>
            </section>

            <section class="recent-inquiries">
              <div>
                <p>MY INQUIRIES</p>
                <h2>최근 문의</h2>
              </div>

              <% if (inquiries.length) { %>
                <ul>
                  <% inquiries.forEach((inquiry) => { %>
                    <li>
                      <div>
                        <strong><%= inquiry.subject %></strong>
                        <small>
                          <%= dateFormatter.format(new Date(inquiry.createdAt)) %>
                        </small>
                      </div>
                      <span class="<%= inquiry.status %>">
                        <%= statusLabels[inquiry.status] || "접수 완료" %>
                      </span>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <div class="inquiry-empty">
                  <span aria-hidden="true">?</span>
                  <p>접수한 문의가 없습니다.</p>
                </div>
              <% } %>
            </section>

            <a
              class="faq-return"
              href="/faq"
            >
              <span aria-hidden="true">?</span>
              <div>
                <strong>FAQ 다시 확인하기</strong>
                <p>
                  자주 묻는 질문에서 바로 답을 찾을 수
                  있습니다.
                </p>
              </div>
              <b aria-hidden="true">→</b>
            </a>
          </aside>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a
          class="brand footer-brand"
          href="/"
        >
          <span
            class="brand-mark"
            aria-hidden="true"
          >M</span>
          <span>Matths</span>
        </a>
        <p>수학이 보이면, 풀이가 시작된다.</p>
        <div>
          <a href="/terms">이용약관</a>
          <a href="/privacy">개인정보처리방침</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>이메일 인증 | Matths</title>
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  </head>
  <body>
    <main class="auth-layout email-verification-layout">
      <section class="auth-panel" aria-labelledby="verification-title">
        <div class="auth-panel-inner">
          <div class="auth-heading">
            <p>ACTIVATE ACCOUNT</p>
            <h2 id="verification-title">이메일 인증</h2>
          </div>
          <div class="form-alert <%= state === 'activated' || state === 'pending' || state === 'resent' ? 'form-alert-success' : '' %>" role="status">
            <p><%= message %></p>
          </div>
          <% if (email) { %><p class="verification-email">가입 이메일: <strong><%= email %></strong></p><% } %>
          <% if (loginPath) { %>
            <p class="verification-link"><a href="<%= loginPath %>">로그인으로 이동</a></p>
          <% } else if (email) { %>
            <form class="auth-form" action="/verify-email/resend" method="POST">
              <button class="submit-button" type="submit">인증 메일 다시 보내기</button>
            </form>
            <p class="verification-link"><a href="/login">로그인으로 이동</a></p>
          <% } else { %>
            <p class="verification-link"><a href="/login">로그인으로 이동</a></p>
          <% } %>
        </div>
      </section>
    </main>
  </body>
</html>

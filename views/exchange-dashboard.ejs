<%
  const number = new Intl.NumberFormat("ko-KR", { maximumFractionDigits: 2 });
  const format = (value) => value == null ? "—" : number.format(value);
  const date = new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", dateStyle: "short", timeStyle: "short" });
%>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>대시보드 | Matths Exchange</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/matths-exchange-x-32.png" />
  <link rel="icon" type="image/svg+xml" sizes="any" href="/images/brand/matths-exchange-x.svg" />
  <script src="/js/exchange-theme.js"></script>
  <link rel="stylesheet" href="/css/exchange.css" />
</head>
<body>
  <%- include("partials/exchange-header", { exchangePage: "dashboard" }) %>
  <main class="terminal exchange-dashboard">
    <section class="market-bar" aria-labelledby="dashboard-title">
      <div class="market-identity">
        <h1 id="dashboard-title">Exchange 대시보드</h1>
      </div>
      <dl class="market-metrics dashboard-balances">
        <div><dt>총 잔액</dt><dd><%= format(data.total) %> TP</dd></div>
        <div><dt>공용 가용 잔액</dt><dd><%= format(data.available) %> TP</dd></div>
        <div><dt>시장별 잔액 합계</dt><dd><%= format(data.marketCash) %> TP</dd></div>
        <div><dt>포지션 증거금</dt><dd><%= format(data.positionCollateral) %> TP</dd></div>
        <div><dt>미체결 주문 예약</dt><dd><%= format(data.reserved) %> TP</dd></div>
      </dl>
    </section>

    <section class="panel dashboard-panel" aria-labelledby="positions-heading">
      <header class="panel-heading"><h2 id="positions-heading">현재 포지션</h2><span><%= data.positions.length %>건</span></header>
      <div class="activity-table">
        <% if (!data.positions.length) { %><p>현재 보유한 포지션이 없습니다.</p><% } else { %>
          <table>
            <thead><tr><th scope="col">시장</th><th scope="col">방향</th><th scope="col">계약 수</th><th scope="col">진입가</th><th scope="col">진입 금액</th><th scope="col">증거금</th><th scope="col">평가 손익</th></tr></thead>
            <tbody>
              <% for (const row of data.positions) { %>
                <tr><td><% if (row.market) { %><a href="/exchange/markets/<%= row.market.id %>"><%= row.market.title %></a><% } else { %>—<% } %></td>
                  <td class="<%= row.direction === 'long' ? 'bid' : 'ask' %>"><%= row.direction.toUpperCase() %></td>
                  <td><%= row.remaining %></td><td><%= format(row.price) %></td><td><%= format(row.notional) %> TP</td>
                  <td><%= format(row.collateral) %> TP</td><td><%= row.unrealized == null ? '—' : format(row.unrealized) + ' TP' %></td></tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section class="panel dashboard-panel" aria-labelledby="open-orders-heading">
      <header class="panel-heading"><h2 id="open-orders-heading">미체결 주문</h2><span><%= data.orders.length %>건</span></header>
      <div class="activity-table">
        <% if (!data.orders.length) { %><p>미체결 주문이 없습니다.</p><% } else { %>
          <table>
            <thead><tr><th scope="col">시장</th><th scope="col">주문</th><th scope="col">지정가</th><th scope="col">미체결 수량</th></tr></thead>
            <tbody>
              <% for (const row of data.orders) { %>
                <tr><td><% if (row.market) { %><a href="/exchange/markets/<%= row.market.id %>"><%= row.market.title %></a><% } else { %>—<% } %></td>
                  <td><%= row.direction.toUpperCase() %> · <%= row.action === 'open' ? '신규' : '청산' %></td><td><%= format(row.price) %></td><td><%= row.remaining %></td></tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section class="panel dashboard-panel" aria-labelledby="history-heading">
      <header class="panel-heading"><h2 id="history-heading">포지션 히스토리</h2><span>최근 50건</span></header>
      <div class="activity-table">
        <% if (!data.history.length) { %><p>청산하거나 정산한 포지션이 없습니다.</p><% } else { %>
          <table>
            <thead><tr><th scope="col">시장</th><th scope="col">방향</th><th scope="col">종료 수량</th><th scope="col">진입가</th><th scope="col">확정 손익</th><th scope="col">상태</th><th scope="col">갱신 · KST</th></tr></thead>
            <tbody>
              <% for (const row of data.history) { %>
                <tr><td><% if (row.market) { %><a href="/exchange/markets/<%= row.market.id %>"><%= row.market.title %></a><% } else { %>—<% } %></td>
                  <td><%= row.direction.toUpperCase() %></td><td><%= row.closed %></td><td><%= format(row.price) %></td>
                  <td><%= format(row.realized) %> TP</td><td><%= row.status %></td><td><%= row.updatedAt ? date.format(new Date(row.updatedAt)) : '—' %></td></tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>
    <footer class="terminal-footer"><%- include("partials/exchange-brand", { width: 118, height: 29 }) %><span>무료 모의거래 · TP는 현금으로 전환할 수 없습니다.</span></footer>
  </main>
</body>
</html>

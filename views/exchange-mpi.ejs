<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MPI 지수 | Matths Exchange</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/matths-exchange-x-32.png" />
  <link rel="icon" type="image/svg+xml" sizes="any" href="/images/brand/matths-exchange-x.svg" />
  <script src="/js/exchange-theme.js"></script>
  <link rel="stylesheet" href="/css/exchange.css" />
  <script src="/js/exchange-chart.js" defer></script>
  <script src="/js/exchange-mpi.js" defer></script>
</head>
<body>
  <%- include("partials/exchange-header", { exchangePage: "mpi" }) %>
  <main id="exchange-mpi" class="terminal" data-state="<%= JSON.stringify(initial) %>">
    <section class="market-bar mpi-summary" aria-labelledby="mpi-title">
      <div class="market-identity">
        <div class="market-label"><span id="mpi-source" class="market-status"><%= initial.source === "demo" ? "시연 데이터" : "공식 표본" %></span></div>
        <h1 id="mpi-title">MPI 지수</h1>
        <p id="mpi-market-name"><%= initial.market?.title || "맵쓰 주간 모의고사" %></p>
      </div>
      <dl class="market-metrics">
        <div><dt>최근 표본 MPI</dt><dd id="mpi-value">—</dd></div>
        <div><dt>표본 평균 원점수</dt><dd id="mpi-score">—</dd></div>
        <div><dt>모집단 / 추출 표본</dt><dd id="mpi-count">—</dd></div>
        <div><dt>표본 계산 시각 · KST</dt><dd id="mpi-time">—</dd></div>
        <div><dt>제출 반영 기준 · KST</dt><dd id="mpi-cutoff">—</dd></div>
      </dl>
    </section>
    <section class="panel mpi-panel" aria-labelledby="mpi-chart-heading">
      <header class="panel-heading">
        <h2 id="mpi-chart-heading">표본 지수 캔들</h2>
        <label class="market-select" id="mpi-select-wrap" hidden>회차 <select id="mpi-select" aria-label="회차 선택"></select></label>

      </header>
        <%- include("partials/exchange-chart-controls", { intervals, activeInterval: initial.interval }) %>
        <output class="candle-summary" data-candle-summary aria-label="캔들 시가·고가·저가·종가"></output>
      <div class="chart-area">
        <canvas id="mpi-chart" role="img" aria-label="표본 MPI 시가·고가·저가·종가 캔들"></canvas>
        <div class="chart-empty" id="mpi-empty"><strong>집계된 표본이 없습니다</strong><p>유효 응시 성적이 집계되면 지수가 표시됩니다.</p></div>
      </div>
      <footer class="chart-foot"><span id="mpi-note">새 유효 응시가 반영되는 분에 MPI를 다시 계산합니다.</span><span id="mpi-connection"></span></footer>
    </section>
  </main>
</body>
</html>

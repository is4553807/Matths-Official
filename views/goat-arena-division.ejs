<%
  const hasDivisionAccess =
    division === "SUB"
      ? arenaAccess.canUseSub
      : arenaAccess.canUseMain;
  const currentPool =
    division === "SUB"
      ? ranking.pools.sub
      : ranking.pools.main;
  const arenaNotificationState =
    typeof arenaNotifications !== "undefined"
      ? arenaNotifications
      : null;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="<%= divisionLabel %> GOAT Arena 기능 허브"
    />
    <meta name="theme-color" content="#070913" />
    <title><%= divisionLabel %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <%- include("partials/rank-motion-head") %>
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page arena-division-command-page arena-division-command-page--<%= division.toLowerCase() %>">
    <a class="arena-skip-link" href="#arena-division-main">본문으로 바로가기</a>

    <%- include("partials/goat-arena-navigation", {
      activeArenaPage,
      arenaUser,
    }) %>

    <main class="arena-page-main arena-division-command-main" id="arena-division-main">
      <header class="arena-page-heading arena-command-hero" data-arena-tutorial-target="division-hero">
        <div>
          <p><%= divisionLabel %> · COMMAND DECK</p>
          <h1><span><%= division === "SUB" ? "첫 번째" : "상위" %></span> 전장</h1>
        </div>
        <div class="arena-command-hero-copy">
          <p><%= division === "SUB"
              ? "배치고사 이후 첫 순위를 확보하고, 같은 티어의 상위 순위부터 바로 위 티어까지 순차적으로 도전하며 페이백 조건을 완성하는 전장입니다."
              : "Unranked를 돌파한 사용자가 학습일수를 운용해 상향 쟁탈전·하위 티어 초대전·복수전을 지휘하는 상위 전장입니다." %></p>
          <div class="arena-command-tags"><span><i></i><%= hasDivisionAccess ? "전장 연결 완료" : "열람 모드" %></span><span><%= division === "SUB" ? "자동 상대 배정" : "최대 3티어 작전" %></span><span>KST 시즌 운영</span></div>
        </div>
      </header>

      <section class="arena-division-status arena-command-status" data-arena-tutorial-target="division-status">
        <article>
          <small>이용 권한</small>
          <strong>
            <%= hasDivisionAccess
              ? (arenaAccess.isAdminPreview ? "운영자 열람" : "사용 가능")
              : "권한 없음" %>
          </strong>
          <span>
            <%= hasDivisionAccess
              ? "이 Division의 기능을 이용할 수 있습니다."
              : "페이지는 열람할 수 있지만 기능 버튼은 권한이 생길 때까지 표시되지 않습니다." %>
          </span>
        </article>
        <article>
          <small>내 티어 랭킹</small>
          <strong>
            <%= currentPool.current
              ? `${currentPool.current.tier} ${currentPool.current.tierRank}위`
              : "—" %>
          </strong>
          <span>표시 순위는 현재 티어 안에서의 랭킹입니다.</span>
        </article>
        <% if (division === "MAIN") { %>
          <article>
            <small>Ranked 매칭 범위</small>
            <strong>전체 Ranked</strong>
            <span>소속과 무관하게 같은 Ranked 티어 순위와 공식 경기를 계산합니다.</span>
          </article>
        <% } %>
        <article>
          <small><%= division === "MAIN" ? "사용 가능 학습일수" : "정기권 학습 가능 일수" %></small>
          <strong>
            <%= arenaAccess.learningRights.availableDays ?? "—" %>
          </strong>
          <span><%= arenaAccess.learningRights.unlimited
            ? "관리자 슈퍼계정은 만료와 일수 차감 없이 기능을 확인할 수 있습니다."
            : division === "MAIN"
              ? `총 ${arenaAccess.learningRights.totalMainDays ?? "—"}일 중 예약·경기 예치를 제외하고 지금 사용할 수 있는 일수입니다.`
              : "현재 학습권 패키지에서 사용할 수 있는 남은 일수입니다." %></span>
        </article>
      </section>

      <% if (hasDivisionAccess) { %>
        <section class="arena-feature-section arena-command-console" aria-labelledby="division-feature-title">
          <header>
            <div>
              <small>Division 기능</small>
              <h2 id="division-feature-title"><%= divisionKoreanLabel %> 기능</h2>
            </div>
            <p>
              <%= division === "MAIN" && activeMainPolicy
                ? `최대 ${activeMainPolicy.maximumTargetTierGap}단계 위 티어까지 도전할 수 있으며, 티어 차이에 따라 최소 예치 일수가 달라집니다.`
                : division === "SUB"
                  ? "같은 티어의 더 높은 순위 후보를 먼저 찾고, 후보가 없을 때만 바로 위 티어에서 상대를 정합니다. 일반 쟁탈전은 페이백 점수 1점을 예치합니다."
                  : "Ranked 경기를 다시 이용할 수 있게 되면 이 화면에서 안내합니다." %>
            </p>
          </header>

          <div class="arena-command-groups">
            <% let commandIndex = 0; featureGroups.forEach((group) => { %>
              <section class="arena-command-group" aria-labelledby="feature-group-<%= group.key.toLowerCase() %>" data-arena-tutorial-target="division-group-<%= group.key.toLowerCase() %>">
                <header>
                  <div><small><%= group.eyebrow %></small><h3 id="feature-group-<%= group.key.toLowerCase() %>"><%= group.title %></h3></div>
                  <p><%= group.description %></p>
                </header>
                <div class="arena-feature-grid">
                  <% group.features.forEach((feature) => { commandIndex += 1; %>
                    <% const featureActionCount = ["subActiveMatch", "mainActiveMatch"].includes(feature.key)
                      ? Math.max(Number(arenaNotificationState?.actionByDivision?.[division] || 0), Number(arenaNotificationState?.defenseByDivision?.[division] || 0))
                      : 0; %>
                    <% if (feature.href) { %>
                      <a class="arena-command-card" href="<%= feature.href %>" data-command-index="<%= String(commandIndex).padStart(2, '0') %>">
                    <% } else { %>
                      <button class="arena-command-card" type="button" data-arena-feature="<%= feature.key %>" data-feature-name="<%= feature.name %>">
                    <% } %>
                      <span><%= String(commandIndex).padStart(2, "0") %></span>
                      <small><%= group.eyebrow %></small>
                      <strong><%= feature.name %></strong>
                      <% if (featureActionCount > 0) { %><b class="arena-command-alert-dot" aria-label="지금 확인할 경기 <%= featureActionCount %>개"></b><% } %>
                      <em><%= feature.description %></em>
                      <i aria-hidden="true">→</i>
                    <% if (feature.href) { %></a><% } else { %></button><% } %>
                  <% }) %>
                </div>
              </section>
            <% }) %>
          </div>

          <p
            class="arena-feature-status"
            role="status"
            aria-live="polite"
            data-arena-feature-status
          ></p>
        </section>
      <% } else { %>
        <section class="arena-access-gate">
          <img
            src="/images/brand/matths-logo-light.svg"
            alt=""
          />
          <div>
            <small><%= divisionLabel %> 이용 권한 필요</small>
            <h2><%= divisionLabel %> 기능은 현재 사용할 수 없습니다.</h2>
            <p>
              Division 권한이 없는 사용자는 페이지와 설명을 볼 수 있지만
              쟁탈전·경기·학습권 패키지 기능 버튼은 표시되지 않습니다.
            </p>
          </div>
          <a href="/goat-arena/profile">Arena 프로필 확인</a>
        </section>
      <% } %>
    </main>
  <%- include("partials/business-footer") %>
  </body>
</html>

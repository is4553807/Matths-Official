<%
  const isNormal = division === "SUB";
  const competitiveProfile =
    typeof arenaCompetitiveProfile !== "undefined" && arenaCompetitiveProfile
      ? arenaCompetitiveProfile
      : {};
  const divisionActionMessage =
    typeof actionMessage === "string" ? actionMessage : "";
  const divisionActionError =
    typeof actionError === "string" ? actionError : "";
  const requiredNormalMatches = Number(competitiveProfile.requiredNormalMatches || 3);
  const normalMatchesCompleted = Math.min(
    Number(competitiveProfile.normalMatchesCompleted || 0),
    requiredNormalMatches
  );
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena <%= divisionLabel %> 경기 안내" />
    <meta name="theme-color" content="#070913" />
    <title><%= divisionLabel %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page arena-division-command-page arena-division-command-page--<%= division.toLowerCase() %>">
    <a class="arena-skip-link" href="#arena-division-main">본문으로 바로가기</a>

    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>

    <main class="arena-page-main arena-division-command-main" id="arena-division-main">
      <header class="arena-page-heading arena-command-hero" data-arena-tutorial-target="division-hero">
        <div>
          <p><%= isNormal ? "NORMAL MATCH" : "COMPETITIVE MATCH" %></p>
          <h1><span><%= divisionLabel %></span></h1>
        </div>
        <div class="arena-command-hero-copy">
          <p><%= isNormal
            ? "현재 실력에 맞는 유저 기록 또는 기준 풀이와 겨루는 일반전 베타입니다. 기준 풀이의 답안은 합성 데이터이며, 풀이 시간은 추정값입니다."
            : "비슷한 실력의 유저와 겨루고, 확정된 결과를 경쟁전 점수와 티어에 반영하는 경기입니다." %></p>
          <div class="arena-command-tags">
            <span><i></i>5문항</span>
            <span>문항당 10분</span>
            <span>풀이과정 제출</span>
          </div>
        </div>
      </header>

      <% if (divisionActionMessage) { %><p class="arena-challenge-notice success" role="status"><%= divisionActionMessage %></p><% } %>
      <% if (divisionActionError) { %><p class="arena-challenge-notice error" role="alert"><%= divisionActionError %></p><% } %>

      <section class="arena-division-status arena-command-status" data-arena-tutorial-target="division-status">
        <% if (isNormal) { %>
          <article><small>경기 상대</small><strong>유저 기록 · 기준 풀이</strong><span>현재 실력과 문제 난도를 기준으로 상대를 구성합니다.</span></article>
          <article><small>승리 기준</small><strong>내부 성취 평가</strong><span>정오답, 문제 난도와 풀이 시간을 함께 반영합니다.</span></article>
          <article><small>문제 구성</small><strong>비슷한 난도</strong><span>양쪽은 서로 다른 다섯 문제를 받을 수 있습니다.</span></article>
        <% } else { %>
          <article><small>참가 조건</small><strong>일반전 <%= requiredNormalMatches %>경기</strong><span>유효한 일반전 기록으로 배치고사 참가 조건을 채웁니다.</span></article>
          <article><small>배치고사</small><strong>1~5회</strong><span>완료한 배치 결과로 첫 경쟁전 점수와 티어를 정합니다.</span></article>
          <article><small>경기 결과</small><strong>점수 · 티어</strong><span>확정된 경기 결과가 현재 도전자에게 반영됩니다.</span></article>
        <% } %>
      </section>

      <section class="arena-feature-section arena-command-console" aria-labelledby="division-feature-title">
        <header>
          <div>
            <small><%= isNormal ? "NORMAL RULES" : "COMPETITIVE RULES" %></small>
            <h2 id="division-feature-title"><%= divisionLabel %> 경기 방식</h2>
          </div>
          <p><%= isNormal
            ? "다섯 문제를 모두 풀고 풀이과정을 제출하면 상대와의 경기 결과를 확인할 수 있습니다."
            : "배치를 마친 뒤 비슷한 실력의 유저와 대결하며, 정답·문제 난도·풀이 시간을 반영한 내부 평가로 승패를 정합니다." %></p>
        </header>

        <div class="arena-command-groups">
          <section class="arena-command-group" aria-labelledby="match-flow-title">
            <header>
              <div><small>HOW TO PLAY</small><h3 id="match-flow-title">경기 진행</h3></div>
              <p>한 문제씩 제한 시간 안에 풀고 답안과 풀이과정을 확정합니다.</p>
            </header>
            <div class="arena-feature-grid">
              <article class="arena-command-card"><span>01</span><small>MATCH</small><strong>상대 찾기</strong><em><%= isNormal ? "현재 실력에 맞는 유저 기록 또는 기준 풀이를 찾습니다." : "현재 실력이 비슷한 유저를 찾습니다." %></em></article>
              <article class="arena-command-card"><span>02</span><small>SOLVE</small><strong>5문항 풀이</strong><em>각 문항을 최대 10분 동안 풀고 풀이과정을 제출합니다.</em></article>
              <article class="arena-command-card"><span>03</span><small>RESULT</small><strong>결과 확인</strong><em>양쪽 문제, 정오답, 풀이 시간과 제출한 풀이과정을 함께 확인합니다.</em></article>
            </div>
          </section>
        </div>

        <% if (isNormal) { %>
          <form action="/goat-arena/sub/challenges" method="post" class="arena-final-actions">
            <button type="submit">일반전 시작하기</button>
            <a href="/goat-arena/rules/sub">일반전 규정 보기</a>
          </form>
        <% } else { %>
          <div class="arena-system-summary">
            <span><b>일반전 기록</b><%= normalMatchesCompleted %> / <%= requiredNormalMatches %>경기</span>
            <span><b>배치 기록</b><%= Number(competitiveProfile.placementAttempts || 0) %> / <%= Number(competitiveProfile.maximumPlacementAttempts || 5) %>회</span>
            <span><b>현재 티어</b><%= competitiveProfile.tierLabel || competitiveProfile.provisionalTierLabel || "미배치" %></span>
          </div>
          <div class="arena-final-actions">
            <a href="/war-of-masters">배치고사 보기</a>
            <a href="/goat-arena/rules/main">경쟁전 규정 보기</a>
          </div>
        <% } %>
      </section>
    </main>
    <%- include("partials/business-footer") %>
  </body>
</html>

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= errorTitle %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <%- include("partials/rank-motion-head") %>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  </head>
  <body class="goat-arena-page arena-inner-page">
    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>
    <main class="arena-error-main">
      <section class="arena-access-error-card">
        <span><%= errorStatus %></span>
        <p>ACCESS CONTROL</p>
        <h1><%= errorTitle %></h1>
        <div><%= errorMessage %></div>
        <small class="arena-error-code">오류 코드 <strong><%= typeof errorCode !== "undefined" && errorCode ? errorCode : `HTTP_${errorStatus}` %></strong></small>
        <div class="arena-error-actions">
          <a href="<%= returnHref %>"><%= returnLabel %></a>
          <a href="<%= typeof errorFaqHref !== "undefined" && errorFaqHref ? errorFaqHref : `/faq?code=${errorStatus}#faq-error-${errorStatus}` %>">FAQ에서 코드 확인</a>
        </div>
      </section>
    </main>
  </body>
</html>

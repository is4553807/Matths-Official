<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= divisionLabel %> <%= feature.name %>" />
    <meta name="theme-color" content="#070913" />
    <title><%= feature.name %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <link rel="icon" type="image/jpeg" href="/images/goat-arena/goat-arena-logo.jpg" />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page">
    <a class="arena-skip-link" href="#arena-feature-main">본문으로 바로가기</a>
    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>

    <main class="arena-page-main" id="arena-feature-main">
      <header class="arena-page-heading">
        <div>
          <p><%= divisionLabel %></p>
          <h1><%= feature.name %></h1>
        </div>
        <p><%= feature.description %></p>
      </header>

      <section class="arena-division-status">
        <article>
          <small>이용 권한</small>
          <strong><%= hasDivisionAccess ? "사용 가능" : "권한 없음" %></strong>
          <span><%= hasDivisionAccess ? "현재 Division 권한과 이용 상태가 확인되었습니다." : "현재는 안내만 볼 수 있으며 실행 기능은 표시되지 않습니다." %></span>
        </article>
        <article>
          <small>현재 Arena 상태</small>
          <strong><%= standing ? `${standing.tier} ${standing.arenaPosition}위` : "—" %></strong>
          <span><%= standing ? `${standing.gp} GOAT Point` : "현재 Division 순위가 아직 없습니다." %></span>
        </article>
        <article>
          <small>사용 가능 학습일수</small>
          <strong><%= arenaAccess.learningRights.availableDays ?? "—" %></strong>
          <span>예약되거나 경기 정산 중인 일수는 별도로 보호됩니다.</span>
        </article>
      </section>

      <% if (hasDivisionAccess) { %>
        <section class="arena-feature-section" aria-labelledby="feature-ready-title">
          <header>
            <div>
              <small>기능 준비</small>
              <h2 id="feature-ready-title">이 기능을 사용할 준비가 되어 있습니다.</h2>
            </div>
            <p>소속 Division, 이용 권한, 남은 학습일수와 현재 운영 규칙을 확인한 뒤 이 화면에서 기능을 시작합니다.</p>
          </header>
          <div class="arena-feature-grid">
            <button type="button" disabled><span>01</span><strong>현재 상태 확인</strong><em>진행 중 경기와 사용 가능한 권한을 불러옵니다.</em><i aria-hidden="true">✓</i></button>
            <button type="button" disabled><span>02</span><strong>정책 조건 확인</strong><em>경기 생성 시점의 Division 정책과 학습일수 조건을 고정합니다.</em><i aria-hidden="true">✓</i></button>
            <button type="button" disabled><span>03</span><strong>기능 준비 중</strong><em><%= feature.name %>의 실행 기능은 다음 업데이트에서 열립니다.</em><i aria-hidden="true">→</i></button>
          </div>
        </section>
      <% } else { %>
        <section class="arena-access-gate">
          <img src="/images/goat-arena/goat-arena-logo.jpg" alt="" />
          <div><small><%= divisionLabel %> 이용 권한 필요</small><h2>현재는 이 기능을 사용할 수 없습니다.</h2><p>소속 Division과 활성 학습권 조건이 충족되면 실행 버튼이 표시됩니다.</p></div>
          <a href="/goat-arena/profile">Arena 프로필 확인</a>
        </section>
      <% } %>

      <p><a class="arena-back-link" href="/goat-arena/<%= division.toLowerCase() %>">← <%= divisionLabel %>으로 돌아가기</a></p>
    </main>
  </body>
</html>

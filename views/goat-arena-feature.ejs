<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="<%= divisionLabel %> <%= feature.name %>" />
    <meta name="theme-color" content="#070913" />
    <title><%= feature.name %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <%- include("partials/rank-motion-head") %>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page">
    <a class="arena-skip-link" href="#arena-feature-main">본문으로 바로가기</a>
    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>

    <main class="arena-page-main" id="arena-feature-main">
      <header class="arena-page-heading">
        <div>
          <p><%= divisionLabel %></p>
          <h1><%= feature.name %></h1>
        </div>
        <p><%= feature.description %></p>
      </header>

      <section class="arena-division-status">
        <article>
          <small>이용 권한</small>
          <strong><%= hasDivisionAccess ? "사용 가능" : "권한 없음" %></strong>
          <span><%= hasDivisionAccess ? "현재 Division 권한과 이용 상태가 확인되었습니다." : "현재는 안내만 볼 수 있으며 실행 기능은 표시되지 않습니다." %></span>
        </article>
        <article>
          <small>현재 Arena 상태</small>
          <strong><%= arenaAccess.standing ? `${arenaAccess.standing.tier} ${arenaAccess.standing.arenaPosition}위` : "—" %></strong>
          <span><%= arenaAccess.standing ? `${arenaAccess.standing.gp} GOAT Point` : "현재 Division 순위가 아직 없습니다." %></span>
        </article>
        <article>
          <small>사용 가능 학습일수</small>
          <strong><%= arenaAccess.learningRights.availableDays ?? "—" %></strong>
          <span>예약되거나 경기 정산 중인 일수는 별도로 보호됩니다.</span>
        </article>
      </section>

      <% if (hasDivisionAccess) { %>
        <section class="arena-feature-section arena-live-feature" aria-labelledby="feature-live-title">
          <header>
            <div>
              <small><%= featureData?.eyebrow || "LIVE DATA" %></small>
              <h2 id="feature-live-title"><%= featureData?.title || feature.name %></h2>
            </div>
            <% if (featureData?.description) { %><p><%= featureData.description %></p><% } %>
          </header>

          <% if (featureData?.cards?.length) { %>
            <div class="arena-live-metrics" aria-label="현재 상태 요약">
              <% featureData.cards.forEach((card) => { %>
                <article>
                  <small><%= card.label %></small>
                  <strong><%= card.value %></strong>
                </article>
              <% }) %>
            </div>
          <% } %>

          <% if (featureData?.items?.length) { %>
            <div class="arena-live-list">
              <% featureData.items.forEach((item) => { %>
                <article class="arena-live-item <%= item.tone ? `arena-live-item--${item.tone}` : '' %>">
                  <div class="arena-live-item-copy">
                    <span><%= item.status || "기록" %></span>
                    <strong><%= item.title %></strong>
                    <p><%= item.description %></p>
                  </div>
                  <div class="arena-live-item-meta">
                    <% if (item.occurredAt) { %>
                      <time datetime="<%= new Date(item.occurredAt).toISOString() %>"><%= new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" }).format(new Date(item.occurredAt)) %></time>
                    <% } %>
                    <% if (item.href) { %>
                      <a href="<%= item.href %>"><%= item.hrefLabel || "확인" %></a>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="arena-live-empty">
              <span aria-hidden="true">◇</span>
              <strong><%= featureData?.emptyMessage || "현재 표시할 기록이 없습니다." %></strong>
              <p>새 기록이 생성되면 이 화면에 자동으로 반영됩니다.</p>
            </div>
          <% } %>

          <% if (featureData?.action) { %>
            <p class="arena-live-action"><a href="<%= featureData.action.href %>"><%= featureData.action.label %> <span aria-hidden="true">→</span></a></p>
          <% } %>
        </section>
      <% } else { %>
        <section class="arena-access-gate">
          <img src="/images/matths-mark.png" alt="" />
          <div><small><%= divisionLabel %> 이용 권한 필요</small><h2>현재는 이 기능을 사용할 수 없습니다.</h2><p>소속 Division과 활성 학습권 조건이 충족되면 실행 버튼이 표시됩니다.</p></div>
          <a href="/goat-arena/profile">Arena 프로필 확인</a>
        </section>
      <% } %>

      <p><a class="arena-back-link" href="/goat-arena/<%= division.toLowerCase() %>">← <%= divisionLabel %>로 돌아가기</a></p>
    </main>
  </body>
</html>

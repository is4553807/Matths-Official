<%
  const invitationStatusLabels = {
    SEARCHING: "상대 찾는 중",
    OFFERED: "수락 대기 중",
    PAUSED: "일요일 매칭 보류",
    MATCH_FORMING: "경기 확정 중",
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ranked 상향 쟁탈전과 하위 티어 초대 관리" />
    <meta name="theme-color" content="#070913" />
    <title>Ranked 경기 | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <%- include("partials/rank-motion-head") %>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page arena-battle-page arena-battle-page--main">
    <a class="arena-skip-link" href="#main-battle-main">본문으로 바로가기</a>
    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>

    <main class="arena-page-main main-battle-main arena-battle-main" id="main-battle-main">
      <header class="arena-page-heading arena-command-hero arena-command-hero--main">
        <div><p>Ranked · COMMAND CENTER</p><h1>상위 전장 <span>지휘소</span></h1></div>
        <div class="arena-command-hero-copy"><p>상대 사용자를 직접 고르지 않고 목표 티어와 예치 학습일수만 선택합니다. 참가 조건을 충족하고 최근 7일 동안 만나지 않은 후보 중 상대가 무작위로 정해집니다.</p><div class="arena-command-tags"><span><i></i>무작위 매칭</span><span>최대 3티어 작전</span><span>최근 상대 7일 제외</span></div></div>
      </header>

      <% if (actionError) { %><div class="arena-action-message is-error" role="alert"><strong>요청을 완료하지 못했습니다.</strong><span><%= actionError %></span></div><% } %>
      <% if (actionMessage) { %><div class="arena-action-message" role="status"><strong>처리 완료</strong><span><%= actionMessage %></span></div><% } %>

      <section class="main-battle-status arena-command-status">
        <article><small>현재 티어</small><strong><%= battleData.currentTier || '미배정' %></strong></article>
        <article><small>매칭 범위</small><strong>전체 Ranked</strong><span>소속과 무관하게 목표 티어 안에서 매칭</span></article>
        <article><small>사용 가능 학습일수</small><strong><%= battleData.availableLearningDays %><span>일</span></strong></article>
        <article><small>동시 공식 경기</small><strong><%= battleData.activeMatch ? '1경기 진행 중' : '없음' %></strong><% if (battleData.activeMatch) { %><a href="/goat-arena/matches/<%= battleData.activeMatch.id %>">경기로 이동</a><% } %></article>
      </section>

      <% if (!battleData.eligible) { %>
        <section class="arena-feature-lock is-<%= battleRestrictionNotice.tone %>">
          <span aria-hidden="true">◇</span>
          <h2><%= battleRestrictionNotice.title %></h2>
          <p><%= battleRestrictionNotice.description %></p>
          <% if (battleRestrictionNotice.detail) { %>
            <p class="arena-feature-lock-detail"><%= battleRestrictionNotice.detail %></p>
          <% } %>
          <% if (battleRestrictionNotice.showRestrictionUntil) { %>
            <p class="arena-challenge-penalty-notice">제한 해제: <strong><%= formatMatchmakingRestriction(battleData.matchmakingRestrictedUntil) %> (KST)</strong></p>
          <% } %>
        </section>
      <% } else { %>
        <section class="main-battle-action-grid arena-main-operation-grid">
          <article class="arena-operation-card arena-operation-card--attack">
            <header><span class="arena-operation-code">OPERATION 01</span><small>하위 → 상위</small><h2>상위 티어 쟁탈전</h2><p>선택한 상위 티어에서 상대 한 명이 무작위로 정해지고 상대는 의무 참가합니다. 공격자만 학습일수를 예치하며, 승리하면 예치금을 그대로 돌려받고 Arena 상태를 가져옵니다.</p></header>
            <form action="/goat-arena/main/challenges" method="post">
              <input type="hidden" name="requestId" value="<%= requestId %>:upward" />
              <label><span>목표 상위 티어</span><select name="targetTier" data-main-upward-target required><option value="">선택</option><% battleData.upwardTargets.forEach((tier) => { %><option value="<%= tier.label %>" data-min-stake="<%= tier.minimumStakeDays %>"><%= tier.label %> · <%= tier.gap %>단계 위</option><% }) %></select></label>
              <label><span>예치 학습일수</span><input type="number" name="stakeDays" min="1" max="<%= Math.max(1, Math.min(5, battleData.availableLearningDays - 1)) %>" data-main-upward-stake required /><small>1단계 차이 1일 이상 · 2단계 2일 이상 · 3단계 3일 이상이며, 모든 상향 쟁탈전의 최대 예치는 5일입니다. 예치 뒤 최소 1일을 남겨야 합니다.</small></label>
              <button type="submit" <%= battleData.activeMatch ? 'disabled' : '' %>>무작위 매칭 시작</button>
            </form>
          </article>

          <article class="arena-operation-card arena-operation-card--invite" id="main-invitation-create">
            <header><span class="arena-operation-code">OPERATION 02</span><small>상위 → 하위</small><h2>하위 티어 초대전</h2><p>학습일수를 예약하고 하위 티어 후보들에게 일괄 초대합니다. 먼저 수락을 완료한 한 명과만 경기하며, 수락 뒤에는 양측이 같은 학습일수를 예치합니다.</p></header>
            <form action="/goat-arena/main/invitations" method="post">
              <input type="hidden" name="requestId" value="<%= requestId %>:invitation" />
              <label><span>목표 하위 티어</span><select name="targetTier" required><option value="">선택</option><% battleData.lowerTargets.forEach((tier) => { %><option value="<%= tier.label %>"><%= tier.label %> · <%= tier.gap %>단계 아래</option><% }) %></select></label>
              <label><span>예약할 학습일수</span><input type="number" name="stakeDays" min="1" max="<%= Math.max(1, battleData.availableLearningDays - 1) %>" required /><small>매치 성립 전에는 예약 상태이며, 수락 시 양측 경기 예치로 전환됩니다.</small></label>
              <button type="submit" <%= battleData.activeMatch ? 'disabled' : '' %>>하위 티어에 초대 보내기</button>
            </form>
          </article>
        </section>

        <section class="main-friendly-board" id="main-friendly-match">
          <header>
            <div><small>FRIENDLY MATCH</small><h2>친선 경기 초대</h2></div>
            <p>친구의 닉네임을 검색해 초대하세요. 수락 순간 양측에서 이용 수수료 1일씩만 차감되며, 승패와 관계없이 티어·순위·학습일수는 이동하지 않습니다.</p>
          </header>
          <div class="main-friendly-search">
            <form action="/goat-arena/main/battle#main-friendly-match" method="get">
              <label><span>친구 닉네임</span><input type="search" name="friendlyNickname" value="<%= friendlyData.query %>" minlength="2" maxlength="40" placeholder="닉네임 2글자 이상 입력" required /></label>
              <button type="submit">닉네임 검색</button>
            </form>
            <small>친선 경기는 활성 Ranked 사용자끼리만 이용할 수 있으며, 초대 수락 전까지 학습일수는 차감되지 않습니다.</small>
          </div>
          <% if (friendlyData.query) { %>
            <div class="main-friendly-results" aria-live="polite">
              <% if (!friendlyData.searchResults.length) { %>
                <p class="empty">현재 초대할 수 있는 Ranked 사용자를 찾지 못했습니다. 닉네임, 이용 상태 또는 진행 중 경기를 확인해 주세요.</p>
              <% } %>
              <% friendlyData.searchResults.forEach((candidate) => { %>
                <article>
                  <div><strong><%= candidate.nickname %></strong><span><%= candidate.tier %> · 사용 가능 학습일수 <%= candidate.availableLearningDays %>일</span></div>
                  <form action="/goat-arena/main/friendly-invitations" method="post">
                    <input type="hidden" name="requestId" value="<%= requestId %>:friendly:<%= candidate.userId %>" />
                    <input type="hidden" name="inviteeUserId" value="<%= candidate.userId %>" />
                    <button type="submit" <%= battleData.activeMatch ? 'disabled' : '' %>>1일씩 차감 후 초대</button>
                  </form>
                </article>
              <% }) %>
            </div>
          <% } %>
          <div class="main-friendly-columns">
            <article>
              <h3>받은 친선 초대</h3>
              <% if (!friendlyData.receivedInvitations.length) { %><p class="empty">현재 받은 친선 초대가 없습니다.</p><% } %>
              <% friendlyData.receivedInvitations.forEach((invitation) => { const inviter = invitation.inviterUserId || {}; %>
                <div class="main-friendly-invitation-item">
                  <strong><%= inviter.name || inviter.username || '닉네임 확인 중' %></strong>
                  <span>수락 시 양측 1일씩 차감 · 순위와 학습일수 이전 없음</span>
                  <div class="main-invitation-actions">
                    <form action="/goat-arena/main/friendly-invitations/<%= invitation._id %>/respond" method="post"><input type="hidden" name="response" value="ACCEPT" /><button type="submit" <%= battleData.activeMatch ? 'disabled' : '' %>>조건 확인 후 수락</button></form>
                    <form action="/goat-arena/main/friendly-invitations/<%= invitation._id %>/respond" method="post"><input type="hidden" name="response" value="DECLINE" /><button class="secondary" type="submit">거절</button></form>
                  </div>
                </div>
              <% }) %>
            </article>
            <article>
              <h3>보낸 친선 초대</h3>
              <% if (!friendlyData.sentInvitations.length) { %><p class="empty">현재 보낸 친선 초대가 없습니다.</p><% } %>
              <% friendlyData.sentInvitations.forEach((invitation) => { const invitee = invitation.inviteeUserId || {}; %>
                <div class="main-friendly-invitation-item">
                  <strong><%= invitee.name || invitee.username || '닉네임 확인 중' %></strong>
                  <span>상대 수락 대기 중 · 수락 전에는 무료 취소 가능</span>
                  <form action="/goat-arena/main/friendly-invitations/<%= invitation._id %>/cancel" method="post"><button class="secondary" type="submit">초대 취소</button></form>
                </div>
              <% }) %>
            </article>
          </div>
        </section>

        <section class="main-invitation-board" id="main-invitations">
          <header><div><small>초대 관리</small><h2>받은 초대와 보낸 예약</h2></div><p>6시간 자동 방어 유예 중에도 자발적인 초대전은 알림을 받고 수락하거나 거절할 수 있습니다. 보낸 예약은 상대가 수락하기 전까지 무료로 취소할 수 있습니다.</p></header>
          <div class="main-invitation-columns">
            <article><h3>받은 초대</h3><% if (!battleData.receivedOffers.length) { %><p class="empty">현재 받은 초대가 없습니다.</p><% } %><% battleData.receivedOffers.forEach((offer) => { const invitation = offer.invitationRequestId || {}; const stake = Number(invitation.stakeDays || 0); %><div class="main-invitation-item main-invitation-item--offer"><header><span>상위 티어 초대전</span><strong><%= invitation.initiatorArenaTier || '상위 티어' %> → <%= invitation.targetTier || battleData.currentTier || '현재 티어' %></strong><small>티어 차이 <%= offer.tierGap || '—' %>단계 · 양측 <%= stake %>일씩 예치</small></header><dl><div><dt>수락 후 승리</dt><dd>내 예치 <%= stake %>일 반환 + 상대 예치 <%= stake %>일 획득 · Arena 상태 교환</dd></div><div><dt>수락 후 패배</dt><dd>내 예치 <%= stake %>일이 상대에게 이전 · Arena 상태 유지</dd></div></dl><p>수락하면 위 조건으로 즉시 공식 경기 참가와 동일 예치에 동의하게 됩니다.</p><div class="main-invitation-actions"><form action="/goat-arena/main/invitation-offers/<%= offer._id %>/respond" method="post"><input type="hidden" name="response" value="ACCEPT" /><button type="submit">조건 확인 후 수락</button></form><form action="/goat-arena/main/invitation-offers/<%= offer._id %>/respond" method="post"><input type="hidden" name="response" value="DECLINE" /><button class="secondary" type="submit">거절</button></form></div></div><% }) %></article>
            <article><h3>보낸 예약</h3><% if (!battleData.sentInvitations.length) { %><p class="empty">현재 대기 중인 예약이 없습니다.</p><% } %><% battleData.sentInvitations.forEach((invitation) => { %><div class="main-invitation-item"><span><b><%= invitation.targetTier %></b> 대상 · <%= invitation.stakeDays %>일 예약 · <%= invitationStatusLabels[invitation.status] || "상태 확인 중" %></span><form action="/goat-arena/main/invitations/<%= invitation._id %>/cancel" method="post"><button class="secondary" type="submit">무료 취소</button></form></div><% }) %></article>
          </div>
        </section>
      <% } %>
    </main>
    <script>
      (() => {
        const target = document.querySelector("[data-main-upward-target]");
        const stake = document.querySelector("[data-main-upward-stake]");
        if (!target || !stake) return;
        const syncStakeBounds = () => {
          const minimum = Number(target.selectedOptions[0]?.dataset.minStake || 1);
          stake.min = String(minimum);
          if (stake.value && Number(stake.value) < minimum) stake.value = String(minimum);
        };
        target.addEventListener("change", syncStakeBounds);
        syncStakeBounds();
      })();
    </script>
  </body>
</html>

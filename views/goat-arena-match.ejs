<%
  const courseLabels = {
    algebra: "대수",
    "calculus-1": "미적분Ⅰ",
    "probability-statistics": "확률과 통계",
  };
  const coverageLabel =
    matchData.problemPack
      ?.curriculumCoverage
      ?.map((courseId) =>
        courseLabels[courseId] || courseId
      )
      .join(" · ") || "배정 대기";
  const isFriendlyMatch =
    matchData.gameMode === "FRIENDLY" || matchData.matchType === "FRIENDLY";
  const showIntegrityNotice =
    matchData.gameMode === "COMPETITIVE" &&
    !isFriendlyMatch &&
    Boolean(matchData.integrityWatermark);
  const asyncCompetitiveResultView =
    typeof asyncCompetitiveResult !== "undefined" ? asyncCompetitiveResult : null;
  const asyncNormalResultView =
    typeof asyncNormalResult !== "undefined" ? asyncNormalResult : null;
  const asyncHistoricalResult = asyncCompetitiveResultView || asyncNormalResultView || null;
  const isNormalAsync = Boolean(asyncNormalResultView);
  const formatDuration = (value) => {
    if (value === null || value === undefined || !Number.isFinite(Number(value))) {
      return "기록 없음";
    }
    const seconds = Math.max(0, Math.round((Number(value) || 0) / 1000));
    return `${Math.floor(seconds / 60)}분 ${String(seconds % 60).padStart(2, "0")}초`;
  };
  const formatAccuracy = (value) => Number.isFinite(Number(value))
    ? `${(Number(value) * 100).toFixed(1).replace(/\.0$/, "")}%`
    : "확인 불가";
  const formatAdjustedScore = (value) => Number.isFinite(Number(value))
    ? Number(value).toFixed(2)
    : "기록 없음";
  const matchReturnHref = matchData.gameMode === "FRIENDLY"
    ? "/goat-arena/friends"
    : matchData.gameMode === "COMPETITIVE"
      ? "/goat-arena/main"
      : "/goat-arena/sub";
  const arenaReturnHref = matchReturnHref;
  const arenaReturnLabel = matchData.gameMode === "FRIENDLY"
    ? "친구 페이지로"
    : `${matchData.divisionLabel}으로`;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena 1대1 <%= matchData.matchTitle %> 응시" />
    <meta name="theme-color" content="#070913" />
    <title>1대1 <%= matchData.matchTitle %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css?noteGrid=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [["$", "$"], ["\\(", "\\)"]],
          displayMath: [["\\[", "\\]"]],
          processEscapes: true,
        },
        options: {
          enableSpeech: false,
          enableBraille: false,
          enableExplorer: false,
          skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"],
        },
      };
    </script>
    <script src="/vendor/mathjax/tex-svg.js" defer></script>
    <script src="/js/math-renderer.js" defer></script>
    <script src="/js/matths-note-grid.js" defer></script>
    <script src="/js/arena-solution-evidence.js" defer></script>
    <script src="/js/goat-arena-v2.js" defer></script>
    <% if (matchData.inProgress || asyncHistoricalResult) { %>
      <script src="/js/arena-problem-visualization.js" defer></script>
    <% } %>
    <% if (matchData.inProgress) { %>
      <script src="/js/goat-arena-web-board.js?noteGrid=1" defer></script>
      <script src="/js/goat-arena-match.js" defer></script>
    <% } %>
  </head>
  <body class="goat-arena-page arena-inner-page arena-match-page">
    <a class="arena-skip-link" href="#arena-match-main">본문으로 바로가기</a>

    <%- include("partials/goat-arena-navigation", {
      activeArenaPage,
      arenaUser,
    }) %>
    <main class="arena-page-main arena-match-main" id="arena-match-main">
      <a class="arena-challenge-back" href="<%= matchReturnHref %>">← <%= matchData.matchType === 'FRIENDLY' ? '친선 경기' : `${matchData.divisionLabel} 경기` %>로 돌아가기</a>

      <header class="arena-page-heading arena-match-heading">
        <div>
          <p><%= matchData.divisionLabel %> · 1대1</p>
          <h1><%= matchData.matchTitle %></h1>
        </div>
        <p><%= matchData.gameMode === "FRIENDLY"
            ? "친선전은 XP와 경쟁전 점수 변동 없이 같은 5문제로 진행합니다. 각자 시작 버튼을 누른 시점부터 같은 제한 시간이 흐릅니다."
            : matchData.competitiveAsync || matchData.normalAsync
              ? (matchData.normalAsync
                ? "일반전 베타에서 검수된 기준 풀이 또는 비슷한 실력의 유저와 겨룹니다. 정오답·문제 난도·풀이 시간을 함께 평가합니다."
                : "비슷한 실력의 유저와 경기합니다. 양쪽 문제는 서로 다를 수 있으며 정답·문제 난도·풀이 시간을 반영한 내부 평가로 승패를 정합니다.")
              : "두 참가자는 같은 5문항과 같은 제한 시간을 사용합니다. 경기 후 풀이과정을 제출합니다." %></p>
      </header>

      <% if (matchPrepared) { %>
        <p class="arena-challenge-notice success" role="status"><%= matchData.normalAsync || matchData.competitiveAsync
          ? "경기 문제와 문항별 제한 시간이 준비되었습니다."
          : "두 참가자에게 같은 문제와 제한 시간이 준비되었습니다." %></p>
      <% } %>
      <% if (matchStarted) { %>
        <p class="arena-challenge-notice success" role="status">내 경기 제한 시간이 시작되었습니다.</p>
      <% } %>
      <% if (evidenceSubmitted) { %>
        <p class="arena-challenge-notice success" role="status"><%= matchData.competitiveAsync || matchData.normalAsync
          ? (matchData.gameMode === "COMPETITIVE"
            ? "풀이과정이 제출되었습니다. 경기 비교와 공정성 확인 후 결과를 표시합니다."
            : "풀이과정이 제출되었습니다. 문항 난도와 풀이를 비교한 결과를 표시합니다.")
          : "풀이 증거가 제출되었습니다. 상대 제출이 끝나면 결과를 판정합니다." %></p>
      <% } %>
      <% if (matchError) { %>
        <p class="arena-challenge-notice error" role="alert"><%= matchError %></p>
      <% } %>
      <% if (["READY", "IN_PROGRESS"].includes(matchData.matchStatus) && ["READY", "IN_PROGRESS"].includes(matchData.attempt?.status)) { %>
        <% const forfeitMode = matchData.gameMode === "COMPETITIVE" ? "competitive" : matchData.gameMode === "FRIENDLY" ? "friendly" : "normal"; %>
        <form class="arena-match-forfeit" action="/goat-arena/matches/<%= matchData.id %>/forfeit" method="post" data-arena2-forfeit data-arena-forfeit-mode="<%= forfeitMode %>">
          <small><%= forfeitMode === "competitive"
            ? "포기하면 패배로 확정되어 경쟁전 점수에 반영됩니다."
            : forfeitMode === "friendly"
              ? "포기하면 상대 승리로 종료되며 XP와 경쟁전 점수는 변하지 않습니다."
              : "포기하면 패배로 기록되어 다음 경기 난이도 조정에 반영되며 XP는 지급되지 않습니다." %></small>
          <button class="arena-button secondary" type="submit">경기 포기</button>
        </form>
      <% } %>

      <section class="arena-match-status-grid" aria-label="경기 상태">
        <article>
          <small>경기 상태</small>
          <strong><%= matchData.matchStatusLabel %></strong>
          <span>경기 진행 상태와 제출 내용이 안전하게 저장됩니다.</span>
        </article>
        <article>
          <small>내 역할</small>
          <strong><%= matchData.roleLabel %></strong>
          <span>상대의 실명·학교·지역·연락처는 공개하지 않습니다.</span>
        </article>
        <article>
          <small>상대</small>
          <strong><%= matchData.opponentName %></strong>
          <span>매치가 성립한 뒤 확인되는 서비스 닉네임입니다.</span>
        </article>
      </section>

      <% if (asyncHistoricalResult) { const displayedCompetitors = [asyncHistoricalResult.challenger, asyncHistoricalResult.historicalOpponent].filter(Boolean).sort((left, right) => Number(right.isViewer) - Number(left.isViewer)); %>
        <section class="arena-match-wait-card" aria-labelledby="arena-async-result-title">
          <small><%= asyncHistoricalResult.provisional ? "운영자 검토 중 · 잠정 비교" : `${isNormalAsync ? "일반전" : "경쟁전"} · 최종 결과` %></small>
          <h2 id="arena-async-result-title"><%= asyncHistoricalResult.verdictLabel %></h2>
          <p><%= asyncHistoricalResult.explanation %></p>
          <% if (!asyncHistoricalResult.firstRecord) { %><p>정오답과 문제 난도를 반영한 내부 성취 지표가 근소하면 풀이 시간을 보조 기준으로 사용합니다.</p><% } %>
        </section>

        <section class="arena-match-result-scoreboard" aria-label="경기 결과 비교">
          <% displayedCompetitors.forEach((competitor) => { %>
            <article>
              <small><%= competitor.isViewer ? "나" : "상대" %> · <%= competitor.user.name %></small>
              <strong>정답 <%= competitor.totalCorrect %>/5</strong>
              <span><%= competitor.completionTimeEstimated ? "추정 풀이 시간" : "풀이 시간" %> <%= formatDuration(competitor.completionTimeMs) %></span>
              <span>난이도 보정 성취지표 <%= formatAdjustedScore(competitor.difficultyAdjustedScore) %></span>
            </article>
          <% }) %>
        </section>

        <div class="arena-match-choices" role="tablist" aria-label="실제 문제 세트">
          <% displayedCompetitors.forEach((competitor, index) => { %><button type="button" role="tab" id="arena-result-tab-<%= competitor.side %>" aria-controls="arena-result-panel-<%= competitor.side %>" aria-selected="<%= index === 0 ? "true" : "false" %>" class="<%= index === 0 ? "selected" : "" %>" <%= index === 0 ? "" : "tabindex=-1" %> data-arena-result-tab="<%= competitor.side %>"><b><%= index + 1 %></b><span><%= competitor.isViewer ? "내 문제" : "상대 문제" %></span></button><% }) %>
        </div>

        <% displayedCompetitors.forEach((competitor) => { %>
          <section class="arena-match-wait-card" id="arena-result-panel-<%= competitor.side %>" role="tabpanel" aria-labelledby="arena-result-tab-<%= competitor.side %>" <%= competitor.isViewer ? "" : "hidden" %> data-arena-result-panel="<%= competitor.side %>">
            <small><%= competitor.isViewer ? "내 출제 세트" : competitor.isBaseline ? "검수된 기준 문항" : "상대 출제 세트" %></small>
            <h2><%= competitor.user.name %> · 정답 <%= competitor.totalCorrect %>/5</h2>
            <div class="arena-match-question-list">
              <% competitor.questions.forEach((question) => { %>
                <article class="arena-match-question arena-match-problem-paper">
                  <header>
                    <span><%= String(question.slot).padStart(2, "0") %></span>
                    <div><small>문항 <%= question.slot %> · 기준 정답률 <%= question.sourceAccuracyLabel || formatAccuracy(question.sourceAccuracyRate) %></small><strong><%= question.correct ? "정답" : "오답" %></strong></div>
                  </header>
                  <div class="arena-match-question-prompt"><%= question.prompt %></div>
                  <% if (question.choices?.length) { %>
                    <ol><% question.choices.forEach((choice) => { %><li><%= choice.text || choice %></li><% }) %></ol>
                  <% } %>
                  <% if (question.visualization) { %>
                    <figure class="arena-match-visualization" data-arena-visualization="<%= encodeURIComponent(JSON.stringify(question.visualization)) %>">
                      <svg viewBox="0 0 760 440" role="img" aria-label="해당 문항에 실제 제시된 그래프 또는 자료"></svg>
                      <figcaption>경기 당시 문항에 포함된 그래프·자료입니다.</figcaption>
                    </figure>
                  <% } %>
                  <div class="arena-match-submitted-answer">
                    <small><%= competitor.isViewer ? "내 제출 답안" : "상대 제출 답안" %></small>
                    <strong class="math-content"><%= question.submittedAnswer || "미제출" %></strong>
                  </div>
                </article>
              <% }) %>
            </div>
            <h3>제출된 전체 풀이 과정</h3>
            <ul class="arena-result-solution-list">
              <% competitor.solutions.forEach((file) => { %>
                <li><a href="<%= file.href %>" target="_blank" rel="noopener">
                  <% if (/^image\/(?:jpeg|png|webp|gif)$/i.test(file.mimeType || "")) { %>
                    <img src="<%= file.href %>" alt="<%= competitor.isViewer ? "내" : "상대" %> <%= file.questionSlot ? `${file.questionSlot}번 문항` : `${file.index}번째` %> 풀이과정" loading="lazy" />
                  <% } %>
                  <span><%= file.questionSlot ? `${file.questionSlot}번 문항 풀이` : `${file.index}. ${file.originalName}` %></span>
                </a></li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
        <script>
          (() => {
            const tabs = [...document.querySelectorAll("[data-arena-result-tab]")];
            const panels = [...document.querySelectorAll("[data-arena-result-panel]")];
            const select = (side) => {
              tabs.forEach((tab) => {
                const selected = tab.dataset.arenaResultTab === side;
                tab.classList.toggle("selected", selected);
                tab.setAttribute("aria-selected", String(selected));
                tab.tabIndex = selected ? 0 : -1;
              });
              panels.forEach((panel) => {
                panel.hidden = panel.dataset.arenaResultPanel !== side;
              });
            };
            tabs.forEach((tab, index) => {
              tab.addEventListener("click", () => select(tab.dataset.arenaResultTab));
              tab.addEventListener("keydown", (event) => {
                if (!["ArrowLeft", "ArrowRight"].includes(event.key)) return;
                event.preventDefault();
                const step = event.key === "ArrowRight" ? 1 : -1;
                const next = tabs[(index + step + tabs.length) % tabs.length];
                select(next.dataset.arenaResultTab);
                next.focus();
              });
            });
          })();
        </script>
        <% if ((isNormalAsync || Boolean(asyncCompetitiveResultView)) && matchData.settled && matchData.role === "CHALLENGER") { %>
          <section class="arena-match-wait-card arena-guest-share-card" aria-labelledby="arena-guest-invite-title" data-guest-share-card>
            <header class="arena-guest-share-heading">
              <div>
                <small>친선전 · 단체 도전장</small>
                <h2 id="arena-guest-invite-title">같은 5문제로 단톡방 순위전을 열어보세요.</h2>
              </div>
              <span>링크 생성 후 3일간 유효</span>
            </header>
            <p>단톡방에 링크를 공유하면 여러 명이 로그인 없이 참여할 수 있습니다. 문제를 모두 푼 참가자는 도전장 순위와 상세 결과를 확인할 수 있습니다.</p>

            <form class="arena-guest-share-create" action="/goat-arena/matches/<%= matchData.id %>/guest-invitations" method="post" data-guest-share-form <%= guestInvitePath ? "hidden" : "" %>>
              <button type="submit" data-guest-share-create-button>
                <span>도전장 뿌리기</span>
                <b aria-hidden="true">→</b>
              </button>
            </form>

            <div class="arena-guest-share-link-panel" data-guest-share-panel <%= guestInvitePath ? "" : "hidden" %>>
              <label for="arena-guest-share-link">도전장 링크</label>
              <div class="arena-guest-share-link-row">
                <input id="arena-guest-share-link" type="text" readonly value="<%= guestInvitePath %>" data-guest-share-link />
                <button type="button" data-guest-share-copy>링크 복사</button>
              </div>
              <a href="<%= guestInvitePath || '#' %>" data-guest-share-open <%= guestInvitePath ? "" : "hidden" %>>도전장 순위 페이지 열기 <span aria-hidden="true">↗</span></a>
            </div>
            <p class="arena-guest-share-status" data-guest-share-status data-state="<%= guestInvitePath ? 'success' : '' %>" role="status" aria-live="polite"><%= guestInvitePath ? "도전장 링크가 준비되었습니다." : "" %></p>
          </section>
        <% } %>
      <% } %>

      <% if (matchData.settled && matchData.result && !isNormalAsync) { %>
        <section class="arena-match-result-card <%= matchData.didDraw ? 'is-draw' : matchData.didWin ? 'is-win' : 'is-loss' %>">
          <div class="arena-match-result-verdict">
            <small>자동 채점·정산 완료</small>
            <h2><%= matchData.didDraw ? "DRAW" : matchData.didWin ? "VICTORY" : "DEFEAT" %></h2>
            <p><%= matchData.gameMode === "COMPETITIVE"
                ? "경쟁전 결과가 점수와 티어에 반영되었습니다."
                : matchData.gameMode === "FRIENDLY"
                  ? "친선전이 종료되었습니다. XP와 경쟁전 점수는 변하지 않습니다."
                  : matchData.result.settlementSummary.xpAwarded
                    ? "일반전이 종료되었습니다. 계정 XP가 지급되며 공개 점수와 티어는 변하지 않습니다."
                    : "일반전이 운영 판정으로 종료되었습니다. XP와 공개 점수는 변하지 않습니다." %></p>
            <% if (matchData.gameMode === "COMPETITIVE" && (!matchData.competitiveAsync || matchData.role === "CHALLENGER")) { const pointChange = matchData.result.settlementSummary.competitiveScore || {}; const displayedDelta = Math.round(pointChange.delta || 0); %>
              <div class="arena-match-status-grid">
                <article><small>기존 경쟁전 점수</small><strong><%= Math.round(pointChange.before || 0) %></strong></article>
                <article><small>변경량</small><strong><%= displayedDelta >= 0 ? "+" : "" %><%= displayedDelta %></strong></article>
                <article><small>현재 경쟁전 점수</small><strong><%= Math.round(pointChange.after || 0) %></strong></article>
                <article><small>티어</small><strong><%= pointChange.tierBefore || "-" %><%= pointChange.tierBefore !== pointChange.tierAfter ? ` → ${pointChange.tierAfter}` : "" %></strong></article>
              </div>
            <% } else if (matchData.competitiveAsync && matchData.role !== "CHALLENGER") { %>
              <p>이번 결과는 현재 도전자의 점수와 티어에 반영되며, 상대의 이미 확정된 점수와 전적은 유지됩니다.</p>
            <% } %>
          </div>
          <% if (!matchData.competitiveAsync && !matchData.normalAsync) { %>
          <div class="arena-match-result-scoreboard" aria-label="경기 결과 비교">
            <article>
              <small>나</small>
              <strong><%= matchData.result.myScore?.score ?? 0 %>점</strong>
              <span>정답 <%= matchData.result.myScore?.correctCount ?? 0 %>문항</span>
              <span>정답 문항 <%= formatDuration(matchData.result.myScore?.correctAnswerSolveTimeMs) %></span>
              <span>전체 <%= formatDuration(matchData.result.myScore?.totalSolveTimeMs) %></span>
            </article>
            <b aria-hidden="true">VS</b>
            <article>
              <small>상대</small>
              <strong><%= matchData.result.opponentScore?.score ?? 0 %>점</strong>
              <span>정답 <%= matchData.result.opponentScore?.correctCount ?? 0 %>문항</span>
              <span>정답 문항 <%= formatDuration(matchData.result.opponentScore?.correctAnswerSolveTimeMs) %></span>
              <span>전체 <%= formatDuration(matchData.result.opponentScore?.totalSolveTimeMs) %></span>
            </article>
          </div>
          <% } %>
          <a href="<%= arenaReturnHref %>"><%= arenaReturnLabel %> <span aria-hidden="true">→</span></a>
        </section>
      <% } else if (matchData.canPrepare) { %>
        <section class="arena-match-lobby-card">
          <div>
            <small>경기 문제 준비 전</small>
            <h2>경기 조건을 먼저 고정합니다.</h2>
            <p>현재 실력에 맞춘 주관식 5문항을 배정합니다. 각 문항은 최대 10분 동안 풀며, 답은 1~999 자연수로 입력합니다.</p>
          </div>
          <form action="/goat-arena/matches/<%= matchData.id %>/prepare" method="post">
            <button type="submit">경기 문제 준비 <span aria-hidden="true">→</span></button>
          </form>
        </section>
      <% } else if (matchData.problemPack && matchData.attempt?.status === "READY") { %>
        <section class="arena-match-lobby-card ready">
          <div>
            <small>응시 준비 완료</small>
            <h2>시작하면 내 제한 시간이 바로 흐릅니다.</h2>
            <p>한번 시작한 타이머는 화면을 닫아도 멈추지 않습니다. 현재 문항의 답은 다음 버튼을 누르기 전까지만 바꿀 수 있으며 모든 변경은 자동 저장됩니다.</p>
          </div>
          <dl>
            <div><dt>문항</dt><dd><%= matchData.problemPack.questionCount %>문항</dd></div>
            <div><dt>제한 시간</dt><dd>문항당 <%= matchData.problemPack.timeLimitLabel %></dd></div>
            <div><dt>범위</dt><dd><%= coverageLabel %></dd></div>
          </dl>
          <form action="/goat-arena/matches/<%= matchData.id %>/start" method="post">
            <input type="hidden" name="requestId" value="<%= startRequestId %>" />
            <button type="submit" <%= matchData.canStart ? "" : "disabled" %>>경기 시작 <span aria-hidden="true">→</span></button>
          </form>
        </section>
      <% } else if (matchData.inProgress) { %>
        <section
          class="arena-match-workspace"
          data-arena-match-attempt
          data-match-id="<%= matchData.id %>"
          data-server-now="<%= matchData.serverNow %>"
          data-deadline="<%= matchData.attempt.deadlineAt.toISOString() %>"
          data-solve-start="<%= matchData.attempt.startedAt.toISOString() %>"
          data-final-question="<%= Number(matchData.attempt.currentQuestionIndex) === 4 ? 'true' : 'false' %>"
          data-question-number="<%= Number(matchData.attempt.currentQuestionIndex) + 1 %>"
          data-question-time-limit-ms="<%= matchData.problemPack.timeLimitMs %>"
        >
          <% if (matchStarted && Number(matchData.attempt.currentQuestionIndex) === 0) { %>
            <div class="arena-fight-overlay is-match-start" aria-hidden="true">
              <span>READY</span>
              <strong>FIGHT!</strong>
              <em>QUESTION 1</em>
            </div>
          <% } else if (questionIntroduced === Number(matchData.attempt.currentQuestionIndex) + 1) { %>
            <div class="arena-question-intro" aria-hidden="true">
              <small>NEXT ROUND</small>
              <strong>QUESTION <%= Number(matchData.attempt.currentQuestionIndex) + 1 %></strong>
              <i></i>
            </div>
          <% } %>
          <% if (showIntegrityNotice) { %>
          <aside class="arena-match-integrity-notice" role="note" aria-label="경기 AI 사용 금지 및 화면 식별 안내">
            <div aria-hidden="true">AI</div>
            <section>
              <small>ACTIVE MATCH · AI USE PROHIBITED</small>
              <strong><%= matchData.integrityWatermark.title %> · <%= matchData.integrityWatermark.shortText %></strong>
              <p><%= matchData.integrityWatermark.notice %></p>
            </section>
            <span><%= arenaUser.nickname %> · <%= matchData.integrityWatermark.traceCode %> · MATCH <%= matchData.integrityWatermark.matchReference %> · <%= matchData.integrityWatermark.role %></span>
          </aside>
          <% } %>
          <header class="arena-match-timer-bar">
            <div>
              <small>남은 시간</small>
              <strong data-arena-match-timer>--:--</strong>
            </div>
            <div>
              <small>답안 저장</small>
              <strong data-arena-match-save-state>자동 저장 준비</strong>
            </div>
            <div>
              <small>진행</small>
              <strong><b data-arena-match-answered><%= Number(matchData.attempt.currentQuestionIndex) + 1 %></b> / 5</strong>
            </div>
          </header>
          <div class="timed-connectivity-status" data-arena-connectivity role="status" aria-live="polite" hidden>
            <span data-arena-connectivity-message></span>
            <button type="button" data-arena-connectivity-retry>지금 다시 저장</button>
          </div>

          <div class="arena-match-question-list">
            <% matchData.questions.forEach((question) => { %>
              <article class="arena-match-question arena-match-problem-paper" data-arena-question="<%= question.questionKey %>">
                <% if (showIntegrityNotice) { %>
                <div class="arena-match-integrity-watermark" aria-hidden="true">
                  <% for (let watermarkRow = 0; watermarkRow < 7; watermarkRow += 1) { %>
                    <span>
                      <b><%= matchData.integrityWatermark.shortText %> · <%= matchData.integrityWatermark.traceCode %></b>
                      <small><%= arenaUser.nickname %> · <%= matchData.integrityWatermark.englishText %></small>
                    </span>
                  <% } %>
                </div>
                <% } %>
                <header>
                  <span><%= String(question.number).padStart(2, "0") %></span>
                  <div>
                    <small><%= question.sourceDifficultyCode ? `${question.sourceDifficultyCode} · ` : "" %><%= question.categoryLabel %> · <%= courseLabels[question.courseId] || question.courseId %></small>
                    <strong><%= question.points %>점</strong>
                  </div>
                  <% if (question.targetAccuracy?.label) { %>
                    <aside class="arena-match-question-accuracy" aria-label="<%= question.targetAccuracy.basisLabel %> <%= question.targetAccuracy.label %>">
                      <small><%= question.targetAccuracy.basisLabel || "목표 정답률 구간" %></small>
                      <strong><%= question.targetAccuracy.label %></strong>
                      <% if (question.targetAccuracy.rangeLabel) { %><span><%= question.targetAccuracy.rangeLabel %></span><% } %>
                    </aside>
                  <% } %>
                </header>
                <div class="arena-match-question-prompt"><%= question.prompt %></div>
                <% if (question.visualization) { %>
                  <figure
                    class="arena-match-visualization"
                    data-arena-visualization="<%= encodeURIComponent(JSON.stringify(question.visualization)) %>"
                  >
                    <div class="arena-match-visualization-heading">
                      <strong>문제에 제시된 그래프·자료</strong>
                      <span>식·점·좌표·보조선이 문제 조건과 함께 표시됩니다.</span>
                    </div>
                    <svg viewBox="0 0 760 440" role="img" aria-label="현재 문항의 식과 좌표로 생성된 그래프 또는 자료"></svg>
                    <figcaption>그래프와 표에 표시된 모든 라벨과 수치는 문제의 일부입니다.</figcaption>
                  </figure>
                <% } %>

                <label class="arena-match-short-answer">
                  <span>답</span>
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[1-9][0-9]{0,2}"
                    maxlength="3"
                    value="<%= question.savedAnswer %>"
                    data-arena-answer="<%= question.questionKey %>"
                    autocomplete="off"
                    aria-label="<%= question.number %>번 주관식 답"
                  />
                </label>
                <small class="arena-match-answer-guide">정답은 1부터 999까지의 자연수로 입력합니다.</small>
                <section class="arena-inline-solution" data-arena-inline-solution data-question-slot="<%= question.number %>" aria-label="<%= question.number %>번 풀이과정 작성란">
                  <header>
                    <div><strong>풀이과정</strong><small>태블릿·휴대폰에서는 격자 풀이판에 직접 작성합니다.</small></div>
                    <div><button type="button" data-arena-board-undo>되돌리기</button><button type="button" data-arena-board-clear>지우기</button></div>
                  </header>
                  <canvas width="1200" height="900" data-arena-board-canvas></canvas>
                  <p data-arena-board-state role="status">풀이판 준비 중</p>
                </section>
              </article>
            <% }) %>
          </div>

          <footer class="arena-match-submit-panel">
            <div>
              <strong><%= Number(matchData.attempt.currentQuestionIndex) === 4 ? "마지막 답안을 확정하시겠습니까?" : "현재 답안을 확정하고 다음 문제로 이동하시겠습니까?" %></strong>
              <span>다음 버튼을 누르면 현재 답이 확정되며 이전 문제를 다시 보거나 수정할 수 없습니다.</span>
            </div>
            <button type="button" data-arena-match-submit><%= Number(matchData.attempt.currentQuestionIndex) === 4 ? "5번 완료 · 증거 제출로" : "다음 문제" %></button>
            <p data-arena-match-error role="alert" aria-live="assertive" hidden></p>
          </footer>
        </section>
      <% } else if (matchData.evidenceRequired) { %>
        <section class="arena-match-wait-card arena-evidence-card" data-evidence-deadline="<%= matchData.attempt.evidenceDeadlineAt?.toISOString() %>" data-evidence-server-now="<%= matchData.serverNow %>" data-stored-board-evidence data-boards-url="/api/goat-arena/matches/<%= matchData.id %>/solution-boards" data-finalize-url="/api/goat-arena/matches/<%= matchData.id %>/solution-boards/finalize">
          <div class="arena-evidence-heading">
            <div class="arena-match-wait-mark" aria-hidden="true">↥</div>
            <div class="arena-evidence-copy">
              <small>풀이 증거 제출</small>
              <h2>문제 화면은 종료되었습니다.</h2>
              <p>직접 풀이한 종이를 촬영해 마지막 답안 확정 후 1분 안에 전송하세요. 제한시간 안에 제출이 접수되면 파일 전송 중 시간이 지나도 정상 제출로 인정합니다.</p>
            </div>
            <div class="arena-evidence-timer" aria-live="polite">
              <span>제출까지 남은 시간</span>
              <strong class="arena-evidence-countdown" data-evidence-countdown>01:00</strong>
              <small>마지막 답안 확정 시점부터 계산됩니다.</small>
            </div>
          </div>
          <div class="arena-stored-board-previews" data-stored-board-previews hidden></div>
          <button type="button" data-stored-board-finalize hidden>작성한 5개 풀이판 제출</button>
          <p data-stored-board-state role="status"></p>
          <form action="/goat-arena/matches/<%= matchData.id %>/evidence" method="post" enctype="multipart/form-data" data-arena-evidence-form data-stored-board-photo-form>
            <label class="arena-evidence-dropzone">
              <span>풀이 사진 선택</span>
              <strong>1~5장의 JPG · PNG · WEBP · HEIC</strong>
              <small>한 장을 누르거나 여러 장을 한 번에 선택하세요. 경기당 총 30MB까지 제출할 수 있습니다.</small>
              <input type="file" name="evidenceFiles" accept=".jpg,.jpeg,.png,.webp,.heic,image/*" capture="environment" multiple required data-arena-evidence-input />
            </label>
            <div class="arena-evidence-selection" data-arena-evidence-selection>아직 선택한 사진이 없습니다.</div>
            <button type="submit" data-arena-evidence-submit>풀이 증거 제출</button>
            <p class="arena-evidence-submit-state" data-arena-evidence-state role="status" hidden></p>
          </form>
          <button type="button" data-arena-inline-finalize hidden>작성한 5개 풀이판 제출</button>
        </section>
        <script>
          (() => {
            const card = document.querySelector("[data-evidence-deadline]");
            const output = card?.querySelector("[data-evidence-countdown]");
            const deadline = new Date(card?.dataset.evidenceDeadline || 0).getTime();
            const serverNow = new Date(card?.dataset.evidenceServerNow || 0).getTime();
            const clockOffset = serverNow - Date.now();
            const form = card?.querySelector("[data-arena-evidence-form]");
            const input = card?.querySelector("[data-arena-evidence-input]");
            const selection = card?.querySelector("[data-arena-evidence-selection]");
            const submitButton = card?.querySelector("[data-arena-evidence-submit]");
            const submitState = card?.querySelector("[data-arena-evidence-state]");
            const inlineFinalize = card?.querySelector("[data-arena-inline-finalize]");
            const touchBoardMode = window.MatthsNoteGrid.isTouchBoardDevice();
            let submitting = false;
            if (touchBoardMode && inlineFinalize) {
              form.hidden = true;
              inlineFinalize.hidden = false;
              inlineFinalize.addEventListener("click", async () => {
                inlineFinalize.disabled = true;
                inlineFinalize.textContent = "풀이판 제출 중…";
                try {
                  const response = await fetch("/api/goat-arena/matches/<%= matchData.id %>/solution-boards/finalize", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: "{}",
                    credentials: "same-origin",
                  });
                  const payload = await response.json().catch(() => ({}));
                  if (!response.ok) throw new Error(payload.message || "풀이판을 제출하지 못했습니다.");
                  window.location.assign("/goat-arena/matches/<%= matchData.id %>?evidence=1");
                } catch (error) {
                  inlineFinalize.disabled = false;
                  inlineFinalize.textContent = "작성한 5개 풀이판 제출";
                  if (submitState) {
                    submitState.hidden = false;
                    submitState.textContent = error.message;
                  }
                }
              });
            }
            const refreshSelection = () => {
              const files = [...(input?.files || [])];
              const total = files.reduce((sum, file) => sum + file.size, 0);
              if (selection) {
                selection.textContent = files.length
                  ? `${files.length}장 선택 · ${(total / 1024 / 1024).toFixed(1)}MB · ${files.map((file) => file.name).join(" · ")}`
                  : "아직 선택한 사진이 없습니다.";
              }
              if (submitButton && !submitting) submitButton.disabled = files.length < 1 || files.length > 5 || total > 30 * 1024 * 1024;
            };
            const tick = () => {
              const seconds = Math.max(0, Math.ceil((deadline - (Date.now() + clockOffset)) / 1000));
              if (output) output.textContent = `00:${String(seconds).padStart(2, "0")}`;
              if (seconds <= 0 && !submitting) card?.querySelectorAll("input, button").forEach((item) => item.disabled = true);
            };
            input?.addEventListener("change", refreshSelection);
            form?.addEventListener("submit", (event) => {
              const files = [...(input?.files || [])];
              const total = files.reduce((sum, file) => sum + file.size, 0);
              if (!files.length || files.length > 5 || total > 30 * 1024 * 1024) {
                event.preventDefault();
                if (submitState) {
                  submitState.hidden = false;
                  submitState.textContent = !files.length ? "풀이 사진을 한 장 이상 선택해 주세요." : "사진은 최대 5장·총 30MB까지 제출할 수 있습니다.";
                }
                return;
              }
              submitting = true;
              if (input) input.disabled = false;
              if (submitButton) {
                submitButton.disabled = true;
                submitButton.textContent = "안전하게 업로드하는 중…";
              }
              if (submitState) {
                submitState.hidden = false;
                submitState.textContent = "창을 닫지 마세요. 사진을 암호화된 비공개 저장소로 전송하고 있습니다.";
              }
            });
            refreshSelection();
            tick();
            window.setInterval(tick, 250);
          })();
        </script>
      <% } else if (matchData.submitted) { %>
        <section class="arena-match-wait-card">
          <div class="arena-match-wait-mark" aria-hidden="true">✓</div>
          <small>내 답안 제출 완료</small>
          <h2><%= matchData.attempt.submissionMode === "TIME_LIMIT" ? "제한 시간이 끝나 최종 저장 답안이 제출되었습니다." : "최종 답안이 안전하게 제출되었습니다." %></h2>
          <p><%= matchData.gameMode === "FRIENDLY"
              ? "상대도 제출하면 채점 후 친선 경기 결과를 확정합니다."
              : matchData.gameMode === "COMPETITIVE"
                ? "풀이과정 제출 뒤 채점과 공정성 확인을 진행합니다. 유효한 경기로 확정되기 전에는 XP와 경쟁전 점수가 변경되지 않습니다."
                : "풀이과정 제출 뒤 상대 기록과 비교해 일반전 결과를 확정합니다." %></p>
          <a href="<%= arenaReturnHref %>"><%= arenaReturnLabel %> <span aria-hidden="true">→</span></a>
        </section>
      <% } else { %>
        <section class="arena-match-wait-card">
          <div class="arena-match-wait-mark" aria-hidden="true">⌛</div>
          <small>경기 처리 중</small>
          <h2><%= matchData.matchStatusLabel %></h2>
          <p>현재 단계의 처리가 끝나면 이 화면에서 다음 상태를 확인할 수 있습니다.</p>
        </section>
      <% } %>
    </main>
  <%- include("partials/business-footer") %>
  </body>
</html>

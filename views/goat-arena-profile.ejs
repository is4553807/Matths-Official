<%
  const competitiveProfile =
    typeof arenaCompetitiveProfile !== "undefined" && arenaCompetitiveProfile
      ? arenaCompetitiveProfile
      : {};
  const connectedHours = Math.max(0, Number(user.totalConnectedSeconds) || 0) / 3600;
  const connectedHoursLabel = connectedHours < 0.1
    ? "0시간"
    : `${connectedHours.toFixed(connectedHours >= 100 ? 0 : 1)}시간`;
  const tutorialChapterMeta = {
    common: {
      eyebrow: "ARENA BASICS",
      title: "Arena 기본 안내",
      description: "Arena 상태와 현재 경기 모드에서 플레이를 시작하는 위치를 확인합니다.",
    },
    normal: {
      eyebrow: "NORMAL GUIDE",
      title: "일반전 안내",
      description: "일반전 경기와 기록을 확인합니다.",
    },
    competitive: {
      eyebrow: "COMPETITIVE GUIDE",
      title: "경쟁전 안내",
      description: "경쟁전 경기 방식과 기록을 확인합니다.",
    },
    friends: {
      eyebrow: "FRIENDS GUIDE",
      title: "친구 안내",
      description: "친선전 초대와 단체 도전장 이용 방법을 확인합니다.",
    },
  };
  const tutorialStatusMeta = {
    PENDING: { label: "진행 전", className: "is-pending" },
    COMPLETED: { label: "완료", className: "is-completed" },
    SKIPPED: { label: "건너뜀", className: "is-skipped" },
    NOT_REQUIRED: { label: "미해금", className: "is-locked" },
  };
  const profileArenaTutorial =
    typeof arenaTutorial !== "undefined" && arenaTutorial
      ? arenaTutorial
      : { availableChapters: ["common"], chapters: {} };
  const knownTutorialChapters = [
    "common",
    "normal",
    "competitive",
    "friends",
  ];
  const availableTutorialChapters = Array.isArray(profileArenaTutorial.availableChapters)
    ? profileArenaTutorial.availableChapters.filter((chapter) => knownTutorialChapters.includes(chapter))
    : [];
  const profileTutorialChapters = availableTutorialChapters.length
    ? availableTutorialChapters
    : ["common"];
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="GOAT Arena 티어, 경기 기록 및 활동 프로필"
    />
    <meta name="theme-color" content="#070913" />
    <title>내 프로필 | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page">
    <a class="arena-skip-link" href="#arena-profile-main">본문으로 바로가기</a>

    <%- include("partials/goat-arena-navigation", {
      activeArenaPage,
      arenaUser,
    }) %>

    <main class="arena-page-main" id="arena-profile-main">
      <header class="arena-page-heading">
        <div>
          <p>내 Arena 프로필</p>
          <h1>GOAT Arena 프로필</h1>
        </div>
        <p>
          Matths 학습 프로필과 분리된 Arena 전용 상태입니다.
          현재 경기 모드, 티어와 Arena 활동 기록을 한곳에서 확인합니다.
        </p>
      </header>

      <section class="arena-profile-hero">
        <div class="arena-profile-identity">
          <div class="arena-avatar-unit arena-avatar-unit--hero" aria-hidden="true">
            <span class="arena-avatar-frame">
              <img src="<%= arenaUser.avatar.imageSrc %>" alt="" />
            </span>
            <span class="arena-level-plate">
              <small>LEVEL</small>
              <b><%= String(arenaActivityLevel.level).padStart(2, "0") %></b>
            </span>
          </div>
          <div>
            <small>Arena 사용자 · 활동 Lv.<%= arenaActivityLevel.level %></small>
            <h2><%= arenaUser.displayName %></h2>
            <p><%= arenaUser.schoolName %> · <%= arenaUser.gradeLabel %></p>
          </div>
        </div>

        <dl>
          <div>
            <dt>일반전 완료</dt>
            <dd><%= Number(competitiveProfile.normalMatchesCompleted || 0) %><small>경기</small></dd>
          </div>
          <div>
            <dt>경쟁전 티어</dt>
            <dd class="arena-profile-tier-value">
              <span><%= competitiveProfile.tierLabel || "미배치" %></span>
            </dd>
          </div>
          <div>
            <dt>경쟁전 점수</dt>
            <dd><%= competitiveProfile.competitiveScore ?? "—" %></dd>
          </div>
          <div>
            <dt>경쟁전 전적</dt>
            <dd><%= Number(competitiveProfile.wins || 0) %>승 · <%= Number(competitiveProfile.losses || 0) %>패 · <%= Number(competitiveProfile.draws || 0) %>무</dd>
          </div>
          <div>
            <dt>누적 접속시간</dt>
            <dd><%= connectedHoursLabel %></dd>
          </div>
          <div>
            <dt>Arena 활동 레벨</dt>
            <dd>
              Lv.<%= arenaActivityLevel.level %>
              <small><%= arenaActivityLevel.isMaxLevel ? "MAX" : `다음 레벨까지 ${arenaActivityLevel.matchesToNext}판` %></small>
            </dd>
          </div>
          <div>
            <dt>공식 Arena Match</dt>
            <dd>
              <%= arenaActivityLevel.totalMatches %>
              <small>판 완료</small>
            </dd>
          </div>
        </dl>
      </section>

      <section class="arena-avatar-section" id="arena-avatar" aria-labelledby="arena-avatar-title">
        <header>
          <div>
            <small>PROFILE LOADOUT</small>
            <h2 id="arena-avatar-title">프로필 이미지 선택</h2>
          </div>
          <p>직접 올린 사진은 Matths 프로필 설정에서 바꿀 수 있고, 여기서는 기본 Arena 아바타로 전환할 수 있습니다.</p>
        </header>

        <% if (avatarUpdated) { %>
          <div class="arena-account-feedback is-success" role="status">프로필 이미지를 변경했습니다.</div>
        <% } %>

        <% if (arenaUser.avatar.isCustom) { %>
          <div class="arena-custom-avatar-note">
            <span><img src="<%= arenaUser.avatar.imageSrc %>" alt="" /></span>
            <div>
              <small>CUSTOM PROFILE PHOTO</small>
              <strong>현재 직접 올린 사진을 사용 중입니다.</strong>
              <p>새 사진으로 바꾸려면 Matths 프로필 설정에서 기기의 사진을 선택하세요.</p>
            </div>
            <a href="/profile#avatar-settings">내 사진 바꾸기 <b aria-hidden="true">→</b></a>
          </div>
        <% } %>

        <form class="arena-avatar-form" method="post" action="/goat-arena/profile/avatar">
          <fieldset>
            <legend>사용할 프로필 이미지</legend>
            <div class="arena-avatar-picker">
              <% arenaProfileAvatars.forEach((avatar) => { %>
                <% const selected = arenaUser.avatar.code === avatar.code; %>
                <label class="arena-avatar-option <%= selected ? 'is-selected' : '' %>">
                  <input type="radio" name="avatarCode" value="<%= avatar.code %>" <%= selected ? "checked" : "" %> required />
                  <span class="arena-avatar-option-image"><img src="<%= avatar.imageSrc %>" alt="" /></span>
                  <span class="arena-avatar-option-copy">
                    <strong><%= avatar.label %></strong>
                    <small><%= avatar.description %></small>
                  </span>
                  <b><%= selected ? "사용 중" : "선택" %></b>
                </label>
              <% }) %>
            </div>
          </fieldset>
          <button type="submit"><span>프로필 이미지 저장</span><b aria-hidden="true">→</b></button>
        </form>
      </section>

      <section class="arena-profile-tutorial-section" aria-labelledby="arena-guest-records-title">
        <header>
          <div>
            <small>CLAIMED GUEST MATCHES</small>
            <h2 id="arena-guest-records-title">가입 전에 완료한 도전장 기록</h2>
          </div>
          <p>같은 닉네임의 게스트 소유 증명을 확인해 이 계정에 연결한 기록입니다.</p>
        </header>
        <div class="arena-profile-tutorial-grid">
          <% if (!claimedGuestRecords.length) { %>
            <p>연결된 단체 도전장 기록이 없습니다.</p>
          <% } %>
          <% claimedGuestRecords.forEach((record) => { %>
            <article>
              <div><small>단체 도전장 · <%= record.attemptNumber %>번째 시도</small><span class="is-completed">연결 완료</span></div>
              <h3><%= record.creatorName %>님의 단체 도전장</h3>
              <p>정답 <%= record.totalCorrect %>/5 · 완료 기록</p>
              <form action="<%= record.href %>" method="get"><button type="submit">문제와 풀이과정 다시 보기 <b aria-hidden="true">→</b></button></form>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="arena-profile-tutorial-section" aria-labelledby="arena-profile-tutorial-title">
        <header>
          <div>
            <small>GUIDED TOUR</small>
            <h2 id="arena-profile-tutorial-title">GOAT Arena 튜토리얼</h2>
          </div>
          <p>튜토리얼은 화면별로 따로 저장됩니다. 해당 화면에 처음 들어갔을 때만 짧게 나타나며, 여기서 원하는 안내만 다시 볼 수 있습니다.</p>
        </header>
        <div class="arena-profile-tutorial-grid">
          <% profileTutorialChapters.forEach((chapter) => {
            const chapterMeta = tutorialChapterMeta[chapter];
            const chapterState = profileArenaTutorial.chapters?.[chapter] || { status: "PENDING" };
            const statusMeta = tutorialStatusMeta[chapterState.status] || tutorialStatusMeta.PENDING;
          %>
            <article>
              <div>
                <small><%= chapterMeta.eyebrow %></small>
                <span class="<%= statusMeta.className %>"><%= statusMeta.label %></span>
              </div>
              <h3><%= chapterMeta.title %></h3>
              <p><%= chapterMeta.description %></p>
              <form method="post" action="/goat-arena/profile/tutorial/restart">
                <input type="hidden" name="chapter" value="<%= chapter %>" />
                <button type="submit"><%= chapterState.status === "PENDING" ? "튜토리얼 시작하기" : "튜토리얼 다시 보기" %> <b aria-hidden="true">→</b></button>
              </form>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="arena-profile-session-section" aria-labelledby="arena-session-title">
        <div>
          <small>SESSION CONTROL</small>
          <h2 id="arena-session-title">로그인 세션</h2>
          <p>공용 기기에서는 이용을 마친 뒤 반드시 로그아웃해 주세요.</p>
        </div>
        <form action="/logout" method="post">
          <button type="submit">GOAT Arena 로그아웃</button>
        </form>
      </section>
    </main>
  <%- include("partials/business-footer") %>
  </body>
</html>

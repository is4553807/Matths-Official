<%
  const formatWon = (value) =>
    `${new Intl.NumberFormat("ko-KR").format(Number(value) || 0)}원`;
  const formatKstDate = (value) =>
    new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(value));
  const formatKstDateTime = (value) =>
    new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      year: "numeric",
      month: "long",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    }).format(new Date(value));
  const paybackBandLabel = (band) =>
    band.maxScoreDays === null
      ? `${band.minScoreDays}점 이상`
      : `${band.minScoreDays}~${band.maxScoreDays}점`;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena <%= rulebook.division === 'SUB' ? 'Sub Division' : 'Main Division' %> 공식 경기 규정" />
    <meta name="theme-color" content="#070913" />
    <title><%= rulebook.title %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <link rel="icon" type="image/jpeg" href="/images/goat-arena/goat-arena-logo.jpg" />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page arena-rulebook-page">
    <a class="arena-skip-link" href="#arena-rulebook-main">본문으로 바로가기</a>
    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>

    <main class="arena-page-main arena-rulebook-main" id="arena-rulebook-main">
      <header class="arena-rulebook-hero">
        <div>
          <p><%= rulebook.eyebrow %></p>
          <h1><%= rulebook.title %></h1>
          <span><%= rulebook.intro %></span>
        </div>
        <nav class="arena-rulebook-switcher" aria-label="Division 규정 전환">
          <a class="<%= rulebook.division === 'SUB' ? 'active' : '' %>" href="/goat-arena/rules/sub">Sub Division 규정</a>
          <a class="<%= rulebook.division === 'MAIN' ? 'active' : '' %>" href="/goat-arena/rules/main">Main Division 규정</a>
        </nav>
      </header>

      <section class="arena-rulebook-summary" aria-labelledby="rule-summary-title">
        <div><small>경기 공통 요약</small><h2 id="rule-summary-title">먼저 알아둘 6가지</h2></div>
        <ol>
          <% rulebook.summary.forEach((item) => { %><li><%= item %></li><% }) %>
        </ol>
      </section>

      <% if (rulebook.problemDesign) { const design = rulebook.problemDesign; %>
        <section class="arena-question-standard" aria-labelledby="arena-question-standard-title">
          <header>
            <div>
              <small>SUB · MAIN 공통 출제 기준</small>
              <h2 id="arena-question-standard-title">1대1 준킬러 문제는 이렇게 정합니다.</h2>
            </div>
            <span>준킬러 출제 기준 · 2판</span>
          </header>

          <article class="arena-question-standard-block">
            <div class="arena-question-standard-number">01</div>
            <div>
              <small>난이도 기준</small>
              <h3>항상 방어자 티어를 기준으로 출제합니다.</h3>
              <ul><% design.principles.forEach((line) => { %><li><%= line %></li><% }) %></ul>
              <div class="arena-question-table-wrap">
                <table>
                  <thead><tr><th scope="col">기본 매치업</th><th scope="col">방어자 앵커</th><th scope="col">난이도</th></tr></thead>
                  <tbody><% design.matchupRows.forEach((row) => { %><tr><th scope="row"><%= row.matchup %></th><td><%= row.anchor %></td><td><strong><%= row.difficultyTier %></strong></td></tr><% }) %></tbody>
                </table>
              </div>
            </div>
          </article>

          <article class="arena-question-standard-block">
            <div class="arena-question-standard-number">02</div>
            <div>
              <small>목표 정답률</small>
              <h3>방어자에게는 변별력 있게, 도전자에게는 승리 가능성이 남게 설계합니다.</h3>
              <ul><% design.accuracyPrinciples.forEach((line) => { %><li><%= line %></li><% }) %></ul>
              <div class="arena-question-table-wrap">
                <table>
                  <thead><tr><th scope="col">난이도</th><th scope="col">앵커 티어</th><th scope="col">방어자 목표</th><th scope="col">도전자 예상</th></tr></thead>
                  <tbody><% design.accuracyRows.forEach((row) => { %><tr><th scope="row"><%= row.difficultyTier %></th><td><%= row.anchor %></td><td><%= row.defenderAccuracy %></td><td><%= row.challengerAccuracy %></td></tr><% }) %></tbody>
                </table>
              </div>
            </div>
          </article>

          <article class="arena-question-standard-block">
            <div class="arena-question-standard-number">03</div>
            <div>
              <small>준킬러 정의와 경기 규격</small>
              <h3>워밍업 없이 5문항 모두 준킬러로 구성합니다.</h3>
              <blockquote><%= design.semiKillerDefinition %></blockquote>
              <p><%= design.excludedQuestion %></p>
              <dl><% design.matchSpec.forEach(([label, value]) => { %><div><dt><%= label %></dt><dd><%= value %></dd></div><% }) %></dl>
            </div>
          </article>
        </section>
      <% } %>

      <% if (rulebook.division === "MAIN") { %>
        <% if (rulebook.mainPolicy) { const policy = rulebook.mainPolicy; %>
          <section class="arena-main-policy" aria-labelledby="main-policy-title">
            <header>
              <div>
                <small>현재 활성 운영 기준</small>
                <h2 id="main-policy-title">Main 경기 예치 기준</h2>
                <p>관리자가 활성화한 정책의 실제 값을 읽어 신규 상향 쟁탈전에 적용합니다.</p>
              </div>
              <strong><%= policy.displayName %></strong>
            </header>
            <dl>
              <div>
                <dt>최대 티어 차이</dt>
                <dd><%= policy.maximumTargetTierGap %>단계</dd>
              </div>
              <div>
                <dt>상대 재매칭 제외</dt>
                <dd><%= policy.repeatOpponentExclusionDays %>일</dd>
              </div>
              <div>
                <dt>복수전 예치 배수</dt>
                <dd>원경기의 <%= policy.revengeStakeMultiplier %>배</dd>
              </div>
              <div>
                <dt>복수전 수수료</dt>
                <dd><%= policy.revengeFeeDays %>일</dd>
              </div>
            </dl>
            <div class="arena-main-policy-bands" aria-label="티어 차이별 최소 예치 일수">
              <% policy.stakeDaysByTierGap.forEach((band) => { %>
                <article>
                  <small><%= band.tierGap %>단계 차이</small>
                  <strong>최소 <%= band.stakeDays %>일 예치</strong>
                </article>
              <% }) %>
            </div>
            <p class="arena-main-policy-condition">
              <%= policy.requiresOpponentDaysGreaterThanStake
                ? "양측 모두 예치 후 사용할 정기권 학습 가능 일수가 최소 1일 남아야 경기가 성립합니다."
                : "현재 운영 기준에서는 상대의 경기 후 잔여 학습일 조건을 적용하지 않습니다." %>
            </p>
            <footer>
              적용일
              <time datetime="<%= new Date(policy.effectiveFrom).toISOString() %>"><%= formatKstDateTime(policy.effectiveFrom) %></time>
              (KST)
              <% if (policy.effectiveUntil) { %>
                · 종료 예정
                <time datetime="<%= new Date(policy.effectiveUntil).toISOString() %>"><%= formatKstDateTime(policy.effectiveUntil) %></time>
                (KST)
              <% } %>
            </footer>
          </section>
        <% } else { %>
          <section class="arena-main-policy-empty" role="status">
            <small>운영 기준 확인 필요</small>
            <h2>Main Division 신규 경기가 잠시 중단되었습니다.</h2>
            <p>현재 적용 중인 Main Division 운영 정책이 없습니다. 정책이 활성화되면 최대 티어 차이와 최소 예치 일수가 이 화면에 자동 표시됩니다.</p>
          </section>
        <% } %>
      <% } %>

      <% if (rulebook.paybackPolicy) { const policy = rulebook.paybackPolicy; %>
        <section class="arena-payback-policy" aria-labelledby="payback-policy-title">
          <header>
            <div>
              <small>현재 활성 정책</small>
              <h2 id="payback-policy-title">페이백 기준</h2>
              <p>결제 시점에 적용된 정책 버전으로 자격과 최종 금액을 판정합니다.</p>
            </div>
            <strong><%= policy.displayName %></strong>
          </header>
          <dl>
            <div><dt>패키지 가격</dt><dd><%= formatWon(policy.priceAmount) %></dd></div>
            <div><dt>정기권 학습 가능 일수</dt><dd><%= policy.initialLearningDays %>일</dd></div>
            <div><dt>전일 학습</dt><dd><%= policy.minimumStreakDays %>일 모두</dd></div>
            <div><dt>유료 일반 쟁탈전</dt><dd><%= policy.minimumPaidNormalAttacks %>회 이상</dd></div>
            <div><dt>최소 페이백 점수</dt><dd><%= policy.minimumScoreDays %>점</dd></div>
          </dl>
          <div class="arena-payback-table-wrap">
            <table>
              <thead><tr><th scope="col">페이백 점수</th><th scope="col">페이백 비율</th><th scope="col">예상 페이백 금액</th></tr></thead>
              <tbody>
                <% policy.bands.forEach((band) => { %>
                  <tr><th scope="row"><%= paybackBandLabel(band) %></th><td><%= band.ratePercent %>%</td><td><%= formatWon(band.expectedPaybackAmount) %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="arena-payback-table-wrap" aria-labelledby="sub-daily-limit-title">
            <h3 id="sub-daily-limit-title">티어별 일일 일반 쟁탈전 상한</h3>
            <table>
              <thead><tr><th scope="col">티어</th><th scope="col">공격</th><th scope="col">방어</th></tr></thead>
              <tbody>
                <% policy.dailyMatchLimitsByTier.forEach((row) => { %>
                  <tr><th scope="row"><%= row.tierLabel || row.tier %></th><td><%= row.attackLimit %>회</td><td><%= row.defenseLimit %>회</td></tr>
                <% }) %>
              </tbody>
            </table>
            <p>KST 날짜 기준으로 성립한 일반 쟁탈전만 집계하며 복수전은 제외합니다. 경기 뒤 티어가 바뀌면 새 티어 한도가 즉시 적용되고, 도전자로 승리하면 그날 남은 일반 공격·방어가 잠깁니다.</p>
            <p>페이백 점수가 0점이어도 패키지 이용 기간에는 방어할 수 있습니다. 정기권 학습 가능 일수가 0일이 되면 공격과 방어가 모두 잠깁니다.</p>
          </div>
          <footer>최근 수정일 <time datetime="<%= new Date(policy.lastModifiedAt).toISOString() %>"><%= formatKstDate(policy.lastModifiedAt) %></time> (KST)</footer>
        </section>
      <% } %>

      <% if (rulebook.upcomingPolicy) { const upcoming = rulebook.upcomingPolicy; %>
        <section class="arena-upcoming-policy" aria-labelledby="arena-upcoming-policy-title">
          <header>
            <div>
              <small>30일 사전 고지</small>
              <h2 id="arena-upcoming-policy-title">변경 예정 운영 기준</h2>
            </div>
            <strong><time datetime="<%= new Date(upcoming.effectiveFrom).toISOString() %>"><%= formatKstDateTime(upcoming.effectiveFrom) %></time> KST 적용</strong>
          </header>
          <p>적용 전까지는 위의 현재 기준을 사용하며, 적용 시점부터 신규 경기와 이용 판정에 아래 기준을 사용합니다.</p>
          <% if (rulebook.division === "SUB") { %>
            <div class="arena-payback-table-wrap">
              <table>
                <thead><tr><th scope="col">티어</th><th scope="col">일일 공격</th><th scope="col">일일 방어</th></tr></thead>
                <tbody>
                  <% upcoming.dailyMatchLimitsByTier.forEach((row) => { %>
                    <tr><th scope="row"><%= row.tierLabel || row.tier %></th><td><%= row.attackLimit %>회</td><td><%= row.defenseLimit %>회</td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <dl>
              <div><dt>최대 티어 차이</dt><dd><%= upcoming.maximumTargetTierGap %>단계</dd></div>
              <div><dt>최근 상대 제외</dt><dd><%= upcoming.repeatOpponentExclusionDays %>일</dd></div>
              <div><dt>복수전 배수</dt><dd><%= upcoming.revengeStakeMultiplier %>배</dd></div>
              <div><dt>복수전 수수료</dt><dd><%= upcoming.revengeFeeDays %>일</dd></div>
            </dl>
          <% } %>
        </section>
      <% } %>

      <% if (rulebook.division === "MAIN") { %>
        <section class="arena-dormancy-overview" aria-labelledby="arena-dormancy-title">
          <header>
            <div>
              <small>MAIN DIVISION DORMANCY</small>
              <h2 id="arena-dormancy-title">휴면 판단 한눈에 보기</h2>
            </div>
            <p>로그인 횟수가 아니라 공식 경기와 주간 공식 모의고사 완료 기록으로 판단합니다.</p>
          </header>
          <ol class="arena-dormancy-timeline">
            <li><span>활동일</span><strong>미활동 기록 초기화</strong><small>공식 1대1 경기 완료 또는 주간 공식 모의고사 제출</small></li>
            <li><span>1~19일</span><strong>하루 1일씩 차감</strong><small>중간에 공식 활동을 완료하면 휴면으로 넘어가지 않습니다.</small></li>
            <li><span>20일째</span><strong>마지막 활동 확인</strong><small>활동하면 직전 19일 차감만 유지하고 미활동 기록을 초기화합니다.</small></li>
            <li><span>다음 날 00:00</span><strong>Sub Division 강등</strong><small>20일째까지 활동이 없을 때 KST 기준으로 휴면 강등합니다.</small></li>
          </ol>
          <div class="arena-dormancy-outcomes">
            <article>
              <small>20일 차감 뒤 잔여 일수 있음</small>
              <strong>Sub 강등 · Main 재진입용 별도 보관</strong>
              <p>Sub 학습일수와 페이백 점수에는 넣지 않으며, 일반 Sub 과정을 거쳐 Main에 다시 진입할 때만 복원합니다.</p>
            </article>
            <article>
              <small>20일 차감 뒤 잔여 일수 없음</small>
              <strong>Sub Division 강등 · 복원 없음</strong>
              <p>새 패키지와 배치고사를 포함한 일반 Sub Division 절차를 그대로 따릅니다.</p>
            </article>
          </div>
          <footer>Sub Division에는 별도의 휴면 상태를 적용하지 않습니다.</footer>
        </section>
      <% } %>

      <div class="arena-rulebook-layout">
        <aside>
          <strong><%= rulebook.division === "SUB" ? "Sub Division" : "Main Division" %></strong>
          <nav aria-label="규정 목차">
            <% rulebook.rules.forEach((rule) => { %><a href="#rule-<%= rule.number %>">규정 <%= rule.number %> · <%= rule.title %></a><% }) %>
          </nav>
        </aside>

        <div class="arena-rulebook-list">
          <% rulebook.rules.forEach((rule, ruleIndex) => { %>
            <section class="arena-rule-group" id="rule-<%= rule.number %>">
              <header><span>규정 <%= rule.number %></span><h2><%= rule.title %></h2></header>
              <div>
                <% rule.sections.forEach((section, sectionIndex) => { %>
                  <details <%= ruleIndex === 0 && sectionIndex === 0 ? "open" : "" %>>
                    <summary><span>제<%= sectionIndex + 1 %>절</span><strong><%= section.title %></strong><i aria-hidden="true"></i></summary>
                    <ul><% section.body.forEach((line) => { %><li><%= line %></li><% }) %></ul>
                  </details>
                <% }) %>
              </div>
            </section>
          <% }) %>
        </div>
      </div>
    </main>
  </body>
</html>

<%
  const formatKstDate = (value) =>
    new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(value));
  const isNormal = rulebook.division === "SUB";
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GOAT Arena <%= rulebook.mode.mode %> 경기 규정" />
    <meta name="theme-color" content="#070913" />
    <title><%= rulebook.title %> | GOAT Arena</title>
    <link rel="stylesheet" href="/css/goat-arena.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/goat-arena.js" defer></script>
  </head>
  <body class="goat-arena-page arena-inner-page arena-rulebook-page" data-current-rulebook-version="<%= rulebook.revision %>">
    <a class="arena-skip-link" href="#arena-rulebook-main">본문으로 바로가기</a>
    <%- include("partials/goat-arena-navigation", { activeArenaPage, arenaUser }) %>

    <main class="arena-page-main arena-rulebook-main" id="arena-rulebook-main">
      <header class="arena-rulebook-hero">
        <div>
          <p><%= rulebook.eyebrow %></p>
          <h1><%= rulebook.title %></h1>
          <span><%= rulebook.intro %></span>
        </div>
        <nav class="arena-rulebook-switcher" aria-label="경기 규정 바로가기">
          <a href="/goat-arena/rules">전체 안내</a>
          <a class="<%= isNormal ? 'active' : '' %>" href="/goat-arena/rules/sub"<% if (isNormal) { %> aria-current="page"<% } %>>일반전</a>
          <a class="<%= isNormal ? '' : 'active' %>" href="/goat-arena/rules/main"<% if (!isNormal) { %> aria-current="page"<% } %>>경쟁전</a>
        </nav>
      </header>

      <section class="arena-rulebook-summary" aria-labelledby="rule-summary-title">
        <div>
          <small><%= rulebook.mode.eyebrow %></small>
          <h2 id="rule-summary-title">한눈에 보는 <%= rulebook.mode.mode %></h2>
        </div>
        <ol>
          <% rulebook.summary.forEach((item) => { %><li><%= item %></li><% }) %>
        </ol>
      </section>

      <div class="arena-rulebook-layout">
        <aside aria-label="이 페이지의 세부 규정">
          <strong><%= rulebook.mode.mode %> 자세히 보기</strong>
          <nav>
            <a href="#difficulty">티어별 문제 난이도</a>
            <a href="#details">경기 진행과 결과</a>
          </nav>
        </aside>

        <div class="arena-rulebook-list">
          <section class="arena-rule-group arena-question-standard" id="difficulty" aria-labelledby="difficulty-title">
            <header>
              <span>TIER DIFFICULTY · <%= rulebook.difficulty.codeRange %></span>
              <h2 id="difficulty-title">티어별 문제 난이도</h2>
            </header>
            <div>
              <details>
                <summary>
                  <span>01</span>
                  <strong>티어별 5문항 구성을 확인하세요</strong>
                  <i aria-hidden="true"></i>
                </summary>
                <div class="arena-rule-detail-body">
                  <p><%= rulebook.difficulty.headline %></p>
                  <ul>
                    <% rulebook.difficulty.notes.forEach((note) => { %><li><%= note %></li><% }) %>
                  </ul>
                  <div class="arena-question-table-wrap">
                    <table class="arena-difficulty-plan-table">
                      <thead>
                        <tr>
                          <th scope="col">티어</th>
                          <% for (let order = 1; order <= rulebook.questionCount; order += 1) { %>
                            <th scope="col"><%= order %>번</th>
                          <% } %>
                          <th scope="col">문항 구성</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% rulebook.difficulty.rows.forEach((row) => { %>
                          <tr>
                            <th scope="row"><%= row.tierLabel %><br /><small><%= row.stage %></small></th>
                            <% row.slots.forEach((slot) => { %>
                              <td data-label="<%= slot.order %>번"><span><%= slot.label %></span></td>
                            <% }) %>
                            <td data-label="문항 구성"><strong><%= row.compositionLabel %></strong></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <p class="arena-rule-detail-note">출제 범위는 <%= rulebook.difficulty.curriculum.join(", ") %>이며, 실제 문항은 경기마다 달라질 수 있습니다.</p>
                </div>
              </details>
            </div>
          </section>

          <section class="arena-rule-group" id="details" aria-labelledby="details-title">
            <header>
              <span>HOW IT WORKS</span>
              <h2 id="details-title">경기 진행과 결과</h2>
            </header>
            <div>
              <% rulebook.sections.forEach((section, index) => { %>
                <details>
                  <summary>
                    <span><%= String(index + 1).padStart(2, "0") %></span>
                    <strong><%= section.title %></strong>
                    <i aria-hidden="true"></i>
                  </summary>
                  <ul><% section.body.forEach((line) => { %><li><%= line %></li><% }) %></ul>
                </details>
              <% }) %>
            </div>
          </section>
        </div>
      </div>

      <nav class="arena-rulebook-footer-actions" aria-label="다음 이동">
        <a href="<%= rulebook.otherMode.href %>"><%= rulebook.otherMode.mode %> 규정 보기</a>
        <a class="primary" href="<%= rulebook.mode.playHref %>"><%= rulebook.mode.mode %> 시작하기</a>
      </nav>
      <p class="arena-rulebook-updated">최근 수정일 <time datetime="<%= new Date(rulebook.lastModifiedAt).toISOString() %>"><%= formatKstDate(rulebook.lastModifiedAt) %></time> (KST)</p>
    </main>
    <%- include("partials/business-footer") %>
  </body>
</html>

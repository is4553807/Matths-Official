<%
  const landingNavigation =
    typeof accountNavigation !== "undefined" && accountNavigation
      ? accountNavigation
      : {
          authenticated: typeof user !== "undefined" && Boolean(user),
          role: typeof user !== "undefined" ? user?.role : "guest",
          dashboardHref: typeof user !== "undefined" && user ? "/main" : "/login",
          primaryHref: typeof user !== "undefined" && user ? "/my-learning" : "/register",
          primaryLabel: typeof user !== "undefined" && user ? "학습 계속하기" : "무료로 시작하기",
          arenaHref: typeof user !== "undefined" && user ? "/goat-arena" : "/#goat-arena",
        };
  const loggedIn = landingNavigation.authenticated;
  const studentLoggedIn = ["student", "test"].includes(landingNavigation.role);
  const learningHref = landingNavigation.primaryHref;
  const learningLabel = landingNavigation.primaryLabel;
  const landingServiceUrls =
    typeof serviceUrls !== "undefined" && serviceUrls
      ? serviceUrls
      : { public: "", app: "", academy: "", parents: "" };
  const serviceHref = (surface, path) => {
    const origin = String(landingServiceUrls[surface] || "").replace(/\/$/, "");
    return `${origin}${path}`;
  };
  const studentServiceHref = serviceHref("app", "/main");
  const academyServiceHref = serviceHref("academy", "/academy");
  const parentServiceHref = serviceHref("parents", "/parent");
  const weeklyMockHref = serviceHref("app", "/private-mock-exams");
  const goatArenaHref = serviceHref("app", "/goat-arena");
  const appStoreHref = "https://apps.apple.com/app/id6803569629";
  const rolePrimaryLabel = !loggedIn
    ? "무료로 시작하기"
    : studentLoggedIn
      ? "학습 계속하기"
      : landingNavigation.role === "teacher"
        ? "학원 대시보드"
        : landingNavigation.role === "parent"
          ? "학부모 대시보드"
          : "대시보드로 이동";
  const arenaContractView =
    typeof arenaContract !== "undefined" ? arenaContract : null;

  /* mainPage(A3)의 읽기 전용 집계만 소비한다. 집계 실패 시 순위를 지어내지 않는다. */
  const arenaRaw =
    typeof arenaSpotlight !== "undefined" && arenaSpotlight ? arenaSpotlight : null;
  const arenaTopEntries = Array.isArray(arenaRaw && arenaRaw.topEntries)
    ? arenaRaw.topEntries
        .filter((entry) => entry && entry.displayName && entry.tierLabel)
        .slice(0, 3)
    : [];
  const arenaCurrentRaw = studentLoggedIn && arenaRaw && arenaRaw.currentEntry
    ? arenaRaw.currentEntry
    : null;
  const arenaCurrentEntry =
    arenaCurrentRaw && arenaCurrentRaw.tierLabel
      ? {
          displayName: arenaCurrentRaw.displayName || "Matths 학생",
          division: String(arenaCurrentRaw.division || "").toUpperCase(),
          divisionLabel:
            arenaCurrentRaw.divisionLabel ||
            (String(arenaCurrentRaw.division || "").toUpperCase() === "MAIN"
              ? "Ranked"
              : "Unranked"),
          tierLabel: arenaCurrentRaw.tierLabel,
          tierPosition:
            arenaCurrentRaw.tierPosition !== null &&
            arenaCurrentRaw.tierPosition !== undefined &&
            Number.isSafeInteger(Number(arenaCurrentRaw.tierPosition))
            ? Number(arenaCurrentRaw.tierPosition)
            : null,
          rankPoint:
            arenaCurrentRaw.rankPoint !== null &&
            arenaCurrentRaw.rankPoint !== undefined &&
            Number.isFinite(Number(arenaCurrentRaw.rankPoint))
            ? Number(arenaCurrentRaw.rankPoint)
            : null,
          overallRank:
            Number.isSafeInteger(Number(arenaCurrentRaw.overallRank)) &&
            Number(arenaCurrentRaw.overallRank) > 0
              ? Number(arenaCurrentRaw.overallRank)
              : null,
          cohortLabel:
            String(arenaCurrentRaw.cohortLabel || "사용자군 순위"),
          cohortRank:
            Number.isSafeInteger(Number(arenaCurrentRaw.cohortRank)) &&
            Number(arenaCurrentRaw.cohortRank) > 0
              ? Number(arenaCurrentRaw.cohortRank)
              : null,
        }
      : null;
  const arena = {
    available: Boolean(arenaRaw && arenaRaw.available),
    seasonLabel: (arenaRaw && arenaRaw.seasonLabel) || null,
    activeCount:
      arenaRaw && typeof arenaRaw.activeCount === "number" && Number.isFinite(arenaRaw.activeCount)
        ? arenaRaw.activeCount
        : null,
    topEntries: arenaTopEntries,
  };
  const arenaShowCurrent = studentLoggedIn && Boolean(arenaCurrentEntry);
  const arenaShowRanking = studentLoggedIn && arena.available && arena.topEntries.length > 0;
  const arenaCtaHref = studentLoggedIn
    ? landingNavigation.arenaHref
    : loggedIn
      ? landingNavigation.dashboardHref
      : landingNavigation.primaryHref;
  const arenaCtaLabel = studentLoggedIn
    ? "GOAT Arena 입장"
    : loggedIn
      ? "대시보드로 이동"
      : "무료로 배치 시작";
  const arenaRankingHref = studentLoggedIn
    ? landingNavigation.arenaHref
    : loggedIn
      ? landingNavigation.dashboardHref
      : landingNavigation.dashboardHref;
  const arenaRankingLabel = studentLoggedIn
    ? "내 아레나 확인"
    : loggedIn
      ? "대시보드로 이동"
      : "로그인하고 확인";
  const tierSlugMap = {
    브론즈: "bronze",
    실버: "silver",
    골드: "gold",
    플래티넘: "platinum",
    에메랄드: "emerald",
    다이아몬드: "diamond",
    마스터: "master",
    그랜드마스터: "grandmaster",
    챌린저: "challenger",
  };
  const tierSlug = (label) => {
    const normalized = String(label || "").trim().toLowerCase();
    return tierSlugMap[label] ||
      ["bronze", "silver", "gold", "platinum", "emerald", "diamond", "master", "grandmaster", "challenger"].find(
        (value) => normalized.includes(value)
      ) || "bronze";
  };
%>
<!doctype html>
<html lang="ko" data-home-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="개념 이해부터 문제 풀이, 주간 모의고사와 GOAT Arena까지 하나의 흐름으로 이어지는 고등수학 학습 플랫폼 Matths입니다."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matths" />
    <meta property="og:title" content="Matths — 이해에서 실전까지 이어지는 고등수학" />
    <meta
      property="og:description"
      content="개념 이해부터 문제 풀이, 주간 모의고사와 GOAT Arena까지 하나의 흐름으로 이어지는 고등수학 학습 플랫폼입니다."
    />
    <meta property="og:url" content="https://www.matths.kr/" />
    <meta property="og:image" content="https://www.matths.kr/images/matths-symbol-color.png" />
    <meta name="naver-site-verification" content="c5941b4b6f5449203b5f5d6935c841aeef150487" />
    <meta name="theme-color" content="#f7f8fc" />
    <title>Matths — 이해에서 실전까지 이어지는 고등수학</title>
    <link rel="canonical" href="https://www.matths.kr/" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/index.css" />
    <link rel="stylesheet" href="/css/home-public-navigation.css" />
    <link rel="stylesheet" href="/css/contrast.css" />

    <script src="/js/index.js" defer></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />

  </head>

  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <%- include("partials/home-public-navigation", { activePage: "home", suppressGlobalSkipLink: true }) %>

    <main id="main-content">
      <section class="platform-hero" aria-labelledby="platform-hero-title">
        <div class="platform-hero-glow platform-hero-glow-one" aria-hidden="true"></div>
        <div class="platform-hero-glow platform-hero-glow-two" aria-hidden="true"></div>
        <div class="container platform-hero-layout">
          <div class="platform-hero-copy">
            <p class="platform-kicker"><span aria-hidden="true"></span>고등수학을 끝까지 연결하는 학습 플랫폼</p>
            <h1 id="platform-hero-title">
              이해하고, 풀고,<br />
              <em>실력으로 증명하세요.</em>
            </h1>
            <p>
              움직이는 개념 학습부터 오답 복습, 주간 모의고사와 1 대 1 랭크전까지.<br />
              Matths가 흩어진 공부를 하나의 성장 흐름으로 연결합니다.
            </p>
            <div class="platform-hero-actions">
              <a class="button button-primary button-large c-button c-button--primary" href="<%= learningHref %>">
                <%= rolePrimaryLabel %> <span aria-hidden="true">→</span>
              </a>
              <a class="button button-secondary button-large platform-app-button" href="<%= appStoreHref %>" target="_blank" rel="noopener noreferrer" aria-label="App Store에서 Matths 앱 다운로드">
                <span class="apple-mark" aria-hidden="true"></span>
                App Store에서 다운로드
              </a>
            </div>
            <dl class="platform-hero-facts" aria-label="Matths 학습 콘텐츠 요약">
              <div><dt>교육과정</dt><dd>13과목</dd></div>
              <div><dt>개념 학습</dt><dd>220개념</dd></div>
              <div><dt>학습 연결</dt><dd>웹 · 모바일</dd></div>
            </dl>
          </div>

          <div class="platform-flow-card" aria-label="Matths 학습 흐름">
            <div class="platform-flow-head">
              <div><span>오늘의 학습</span><strong>개념에서 실전까지</strong></div>
              <i><span aria-hidden="true"></span>학습 중</i>
            </div>
            <ol class="platform-flow-steps">
              <li class="is-complete">
                <span>01</span>
                <div><strong>개념을 움직여 이해</strong><small>시각화로 원리와 변화 확인</small></div>
                <i aria-hidden="true">✓</i>
              </li>
              <li class="is-current">
                <span>02</span>
                <div><strong>문제를 풀며 적용</strong><small>막힌 장면부터 다시 학습</small></div>
                <i aria-hidden="true">진행</i>
              </li>
              <li>
                <span>03</span>
                <div><strong>실전에서 증명</strong><small>주간 모의고사 · GOAT Arena</small></div>
                <i aria-hidden="true">다음</i>
              </li>
            </ol>
            <div class="platform-flow-progress">
              <span><i aria-hidden="true"></i></span>
              <p><strong>이번 주 학습 흐름</strong><b>68%</b></p>
            </div>
          </div>
        </div>
      </section>

      <section class="service-entry" id="services" aria-labelledby="service-entry-title">
        <div class="container">
          <div class="section-heading section-heading-centered">
            <p>바로가기</p>
            <h2 id="service-entry-title">필요한 Matths로 바로 이동하세요.</h2>
            <span>학생, 선생님, 학부모가 같은 학습 기록을 각자의 화면에서 이어봅니다.</span>
          </div>
          <div class="service-entry-grid">
            <a class="service-entry-card is-student" href="<%= studentServiceHref %>">
              <span class="service-entry-icon" aria-hidden="true">01</span>
              <div><strong>학생 페이지</strong><p>오늘의 학습과 오답을 이어서 풀어요.</p></div>
              <i aria-hidden="true">→</i>
            </a>
            <a class="service-entry-card is-academy" href="<%= academyServiceHref %>">
              <span class="service-entry-icon" aria-hidden="true">02</span>
              <div><strong>학원 페이지</strong><p>수업, 학생, 출결과 성장을 관리해요.</p></div>
              <i aria-hidden="true">→</i>
            </a>
            <a class="service-entry-card is-parent" href="<%= parentServiceHref %>">
              <span class="service-entry-icon" aria-hidden="true">03</span>
              <div><strong>학부모 페이지</strong><p>자녀의 학습 흐름과 변화를 확인해요.</p></div>
              <i aria-hidden="true">→</i>
            </a>
            <a class="service-entry-card is-mock" href="<%= weeklyMockHref %>">
              <span class="service-entry-icon" aria-hidden="true">04</span>
              <div><strong>주간 모의고사</strong><p>매주 같은 기준으로 실력을 점검해요.</p></div>
              <i aria-hidden="true">→</i>
            </a>
            <a class="service-entry-card is-arena" href="<%= goatArenaHref %>">
              <span class="service-entry-icon" aria-hidden="true">05</span>
              <div><strong>GOAT Arena</strong><p>1 대 1 랭크전에서 풀이로 증명해요.</p></div>
              <i aria-hidden="true">→</i>
            </a>
          </div>
        </div>
      </section>

      <section class="learning-journey" id="learning-journey" aria-labelledby="learning-journey-title">
        <div class="container learning-journey-layout">
          <div class="section-heading">
            <p>하나의 학습 흐름</p>
            <h2 id="learning-journey-title">공부가 끊기지 않도록,<br />다음 행동까지 보여줍니다.</h2>
            <span>진도만 채우는 것이 아니라 이해, 적용, 점검의 기록을 연결해 지금 무엇을 해야 하는지 알려드립니다.</span>
            <a href="/learning-flow">학습 과정 자세히 보기 <span aria-hidden="true">→</span></a>
          </div>
          <ol class="learning-journey-list">
            <li>
              <span>01</span>
              <div><strong>이해</strong><h3>움직이는 개념으로 원리를 봅니다.</h3><p>그래프와 도형의 변화를 직접 따라가며 공식이 만들어지는 과정을 이해합니다.</p></div>
            </li>
            <li>
              <span>02</span>
              <div><strong>적용</strong><h3>풀이와 오답을 하나의 기록으로 남깁니다.</h3><p>어디서 막혔는지 찾고, 필요한 개념부터 다시 이어서 학습합니다.</p></div>
            </li>
            <li>
              <span>03</span>
              <div><strong>증명</strong><h3>모의고사와 Arena로 실력을 확인합니다.</h3><p>정해진 시간과 같은 기준 안에서 쌓인 이해를 실제 결과로 바꿉니다.</p></div>
            </li>
          </ol>
        </div>
      </section>

      <section class="arena-hero" id="goat-arena" aria-labelledby="arena-hero-title">
        <div class="arena-atmosphere" aria-hidden="true">
          <i class="arena-grid"></i>
          <i class="arena-orbit arena-orbit-one"></i>
        </div>

        <div class="container arena-hero-layout">
          <div class="arena-hero-copy">
            <p class="arena-kicker">
              <span>현재 시즌</span>
              GOAT Arena<% if (arena.seasonLabel) { %> · <%= arena.seasonLabel %><% } %>
            </p>
            <h2 id="arena-hero-title"><span>고등수학</span> <strong>1 vs 1 랭크전</strong></h2>

            <%- include("partials/arena-contract", { contract: arenaContractView }) %>

            <div class="arena-hero-actions">
              <a class="button button-arena-primary button-large c-button c-button--primary" href="<%= arenaCtaHref %>">
                <%= arenaCtaLabel %> <span aria-hidden="true">→</span>
              </a>
              <a class="arena-hero-support-link" href="#learning-lab">
                학습 기능 보기
              </a>
            </div>

            <dl class="arena-live-facts" aria-label="GOAT Arena 현재 현황">
              <div><dt>문항</dt><dd>주관식 5개</dd></div>
              <div><dt>제한 시간</dt><dd>문항당 10분</dd></div>
              <div><dt>풀이 증거</dt><dd>종료 후 60초</dd></div>
            </dl>
          </div>

          <div
            class="arena-console"
            aria-label="<%= arenaShowCurrent ? '내 GOAT Arena 티어' : loggedIn ? '이번 시즌 상위 랭킹' : '로그인 후 확인 가능한 GOAT Arena 랭킹' %>"
          >
            <div class="arena-console-head">
              <div>
                <span><%= arenaShowCurrent ? "내 GOAT Arena" : loggedIn ? "이번 시즌" : "GOAT Arena" %></span>
                <strong><%= arenaShowCurrent ? "현재 내 티어" : loggedIn ? "현재 상위 순위" : "랭킹 확인" %></strong>
              </div>
              <% if (arenaShowCurrent || arenaShowRanking) { %>
                <i><span aria-hidden="true"></span> <%= arenaShowCurrent ? "연결됨" : "갱신 중" %></i>
              <% } %>
            </div>

            <% if (arenaShowCurrent) { %>
              <section class="arena-my-standing" aria-label="내 GOAT Arena 티어">
                <div class="arena-my-standing-main">
                  <img
                    src="/images/ranks/<%= tierSlug(arenaCurrentEntry.tierLabel) %>.webp"
                    alt=""
                    width="150"
                    height="150"
                  />
                  <div>
                    <span><%= arenaCurrentEntry.divisionLabel %></span>
                    <strong><%= arenaCurrentEntry.tierLabel %></strong>
                    <small><%= arenaCurrentEntry.displayName %></small>
                  </div>
                </div>
                <dl class="arena-my-standing-stats">
                  <div>
                    <dt>티어 내 순위</dt>
                    <dd><%= arenaCurrentEntry.tierPosition ? `${arenaCurrentEntry.tierPosition}위` : "집계 중" %></dd>
                  </div>
                  <div>
                    <dt>현재 GP</dt>
                    <dd><%= arenaCurrentEntry.rankPoint !== null ? arenaCurrentEntry.rankPoint.toLocaleString("ko-KR") : "집계 중" %></dd>
                  </div>
                  <div>
                    <dt>종합랭킹 순위</dt>
                    <dd><%= arenaCurrentEntry.overallRank ? `${arenaCurrentEntry.overallRank}위` : "집계 중" %></dd>
                  </div>
                  <div>
                    <dt><%= arenaCurrentEntry.cohortLabel %></dt>
                    <dd><%= arenaCurrentEntry.cohortRank ? `${arenaCurrentEntry.cohortRank}위` : "집계 중" %></dd>
                  </div>
                </dl>
                <a href="/goat-arena">내 Arena로 이동 <span aria-hidden="true">→</span></a>
              </section>
            <% } else if (arenaShowRanking) { %>
              <ol class="arena-ranking-board">
                <% arena.topEntries.forEach((entry, index) => { %>
                  <li>
                    <span class="arena-rank-number"><%= String(index + 1).padStart(2, "0") %></span>
                    <img
                      src="/images/ranks/<%= tierSlug(entry.tierLabel) %>.webp"
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                      decoding="async"
                      fetchpriority="low"
                    />
                    <span class="arena-player">
                      <strong><%= entry.displayName %></strong>
                      <small><%= entry.tierLabel %></small>
                    </span>
                    <% if (Number.isFinite(Number(entry.rankPoint))) { %>
                      <b><%= Number(entry.rankPoint).toLocaleString("ko-KR") %><small> GP</small></b>
                    <% } %>
                  </li>
                <% }) %>
              </ol>
            <% } else { %>
              <div class="arena-ranking-unavailable" role="status">
                <strong><%= loggedIn ? "Arena 티어가 아직 연결되지 않았습니다." : "로그인 후 Arena 순위를 확인할 수 있습니다." %></strong>
                <p><%= loggedIn ? "배치고사를 완료해 첫 Arena 티어를 받은 뒤 이곳에서 바로 확인할 수 있습니다." : "로그인하면 현재 티어와 종합랭킹, 사용자군 순위를 확인할 수 있습니다." %></p>
                <a href="<%= arenaRankingHref %>"><%= arenaRankingLabel %> <span aria-hidden="true">→</span></a>
              </div>
            <% } %>

            <div class="arena-console-foot">
              <span><%= arenaShowCurrent ? arenaCurrentEntry.divisionLabel : "Ranked" %></span>
              <p><%= arenaShowCurrent ? "공식 Arena Standing과 실시간으로 연결됩니다." : "같은 규칙에서 결과로 증명합니다." %></p>
              <span>1 : 1</span>
            </div>
          </div>
        </div>
      </section>

      <section class="learning-proof" id="learning-lab" aria-labelledby="learning-title">
        <div class="hero-grid-pattern" aria-hidden="true"></div>
        <div class="container hero-layout">
          <div class="hero-copy">
            <p class="eyebrow"><span aria-hidden="true"></span>13과목 수학 학습실</p>
            <h2 id="learning-title">막힌 개념은,<br /><em>움직여서 다시 본다.</em></h2>
            <p class="hero-description">
              외우던 공식을 움직이는 그림으로 이해하세요.<br />
              틀린 문제는 막힌 장면부터 다시 보여드립니다.
            </p>
            <div class="hero-actions">
              <a class="button button-primary button-large" href="<%= learningHref %>">
                <%= learningLabel %> <span aria-hidden="true">→</span>
              </a>
              <a class="button button-secondary button-large" href="/curriculum">교육과정 보기</a>
            </div>
          </div>

          <div class="hero-visual" aria-label="이차함수 그래프 시각화 학습 예시">
            <div class="lesson-window" data-current-step="1">
              <div class="window-header">
                <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="lesson-title">
                  <small>공통수학1 · 이차함수</small>
                  <strong id="lesson-step-title" aria-live="polite">먼저, 기본 그래프를 확인합니다.</strong>
                </div>
                <span class="step-label" id="lesson-step-label">1 / 4단계</span>
              </div>
              <div class="lesson-canvas">
                <div class="formula-box">
                  <span id="lesson-formula">y = x²</span>
                  <small id="lesson-formula-hint">꼭짓점은 (0, 0)</small>
                </div>
                <div class="graph" aria-hidden="true">
                  <i class="axis axis-x"></i><i class="axis axis-y"></i>
                  <span class="axis-name axis-name-x">x</span><span class="axis-name axis-name-y">y</span>
                  <i class="original-curve"></i><i class="moved-curve"></i><i class="vertex"></i><i class="vertex-pulse"></i>
                  <span class="move-arrow move-arrow-horizontal">→ 2</span>
                  <span class="move-arrow move-arrow-vertical">↑ 1</span>
                  <span class="point-label" id="lesson-point-label">(0, 0)</span>
                </div>
                <div class="coach-note" aria-live="polite">
                  <span class="coach-avatar" aria-hidden="true">M</span>
                  <p><strong id="lesson-coach-title">출발점을 먼저 기억하세요.</strong><br /><span id="lesson-coach-body">y = x²의 꼭짓점은 원점입니다.</span></p>
                </div>
              </div>
              <div class="window-footer">
                <div class="progress-dots" role="group" aria-label="이차함수 시각화 단계 선택">
                  <button class="step-button active" type="button" data-step="1" aria-label="Step 1 기본 그래프" aria-pressed="true"><span>1</span></button>
                  <button class="step-button" type="button" data-step="2" aria-label="Step 2 오른쪽으로 2 이동" aria-pressed="false"><span>2</span></button>
                  <button class="step-button" type="button" data-step="3" aria-label="Step 3 위로 1 이동" aria-pressed="false"><span>3</span></button>
                  <button class="step-button" type="button" data-step="4" aria-label="Step 4 꼭짓점 확인" aria-pressed="false"><span>4</span></button>
                </div>
                <a href="/visual-learning">시각화 학습 살펴보기 <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </div>
        <div class="container home-summary" aria-label="학습 콘텐츠 요약">
          <div><strong>220개념</strong><span>13과목 학습 경로</span></div>
          <a href="/curriculum">전체 교육과정 보기 <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="weekly-proof" id="weekly-mock" aria-labelledby="weekly-proof-title">
        <div class="container weekly-proof-layout">
          <div class="weekly-proof-preview" aria-label="주간 모의고사 결과 예시">
            <div class="weekly-preview-head">
              <div><span>9월 2주차</span><strong>주간 모의고사</strong></div>
              <i>제출 완료</i>
            </div>
            <div class="weekly-score">
              <div><strong>84</strong><span>점</span></div>
              <p><b>지난주보다 12점 상승</b><small>취약 개념 2개를 복습 목록에 담았습니다.</small></p>
            </div>
            <div class="weekly-bars" aria-hidden="true">
              <span><i style="--bar: 78%"></i><b>함수</b></span>
              <span><i style="--bar: 92%"></i><b>수열</b></span>
              <span><i style="--bar: 66%"></i><b>확률</b></span>
              <span><i style="--bar: 84%"></i><b>미적분</b></span>
            </div>
            <a href="<%= weeklyMockHref %>">이번 주 모의고사 확인 <span aria-hidden="true">→</span></a>
          </div>
          <div class="section-heading weekly-proof-copy">
            <p>주간 모의고사</p>
            <h2 id="weekly-proof-title">이번 주의 공부를<br />이번 주에 확인하세요.</h2>
            <span>정해진 시간 안에서 문제를 풀고, 점수만이 아니라 과목·개념별 취약 지점까지 확인합니다. 결과는 다음 복습으로 바로 이어집니다.</span>
            <ul>
              <li><i aria-hidden="true">✓</i>매주 누적되는 성취도와 변화</li>
              <li><i aria-hidden="true">✓</i>개념 단위로 이어지는 오답 복습</li>
              <li><i aria-hidden="true">✓</i>학생·학원·학부모 화면에 연결되는 결과</li>
            </ul>
            <a class="button button-primary button-large c-button c-button--primary" href="<%= weeklyMockHref %>">주간 모의고사 바로가기 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="audience-proof" id="for-everyone" aria-labelledby="audience-proof-title">
        <div class="container">
          <div class="section-heading section-heading-centered">
            <p>함께 보는 성장</p>
            <h2 id="audience-proof-title">학생의 한 번의 학습이<br />모두에게 필요한 정보가 됩니다.</h2>
          </div>
          <div class="audience-proof-grid">
            <article>
              <span>학생</span>
              <h3>오늘 할 공부가 선명해집니다.</h3>
              <p>최근 학습, 오답, 복습과 실전 결과를 한곳에서 이어서 확인합니다.</p>
              <a href="<%= studentServiceHref %>">학생 페이지 <span aria-hidden="true">→</span></a>
            </article>
            <article>
              <span>학원 · 선생님</span>
              <h3>수업 밖의 학습까지 연결됩니다.</h3>
              <p>학생별 진도와 취약 개념, 과제와 출결을 확인하고 다음 지도를 준비합니다.</p>
              <a href="<%= academyServiceHref %>">학원 페이지 <span aria-hidden="true">→</span></a>
            </article>
            <article>
              <span>학부모</span>
              <h3>점수 너머의 변화를 확인합니다.</h3>
              <p>자녀가 무엇을 배우고 어디서 성장하는지 이해하기 쉬운 흐름으로 봅니다.</p>
              <a href="<%= parentServiceHref %>">학부모 페이지 <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section class="app-download" id="app-download" aria-labelledby="app-download-title">
        <div class="container app-download-layout">
          <div class="app-download-copy">
            <p>Matths 모바일 앱</p>
            <h2 id="app-download-title">iPad와 iPhone에서<br />어디서든 이어서 학습하세요.</h2>
            <span>모바일 앱에서 풀이에 집중하고, 웹에서 학습 기록과 다음 계획을 이어보세요. 같은 계정으로 학습 흐름이 연결됩니다.</span>
            <a class="app-store-badge" href="<%= appStoreHref %>" target="_blank" rel="noopener noreferrer" aria-label="App Store에서 Matths 앱 다운로드">
              <span class="app-store-symbol" aria-hidden="true"></span>
              <span><small>다운로드하기</small><strong>App Store</strong></span>
            </a>
            <small class="app-download-note">iPad·iPhone용 Matths 앱 · App Store에서 설치</small>
          </div>
          <div class="app-device-gallery" aria-label="Matths 실제 iPad와 iPhone 앱 화면">
            <figure class="real-device real-device-ipad">
              <figcaption><span>iPad</span><strong>오늘의 학습과 Arena를 한 화면에</strong></figcaption>
              <div class="real-device-frame">
                <img class="theme-device-shot theme-device-shot-light" src="/images/home-devices/matths-ipad-light.jpg" alt="Matths iPad 앱 라이트 모드 대시보드" width="2732" height="1961" loading="lazy" decoding="async" fetchpriority="low" />
                <img class="theme-device-shot theme-device-shot-dark" src="/images/home-devices/matths-ipad-dark.jpg" alt="Matths iPad 앱 다크 모드 대시보드" width="2732" height="1965" loading="lazy" decoding="async" fetchpriority="low" />
              </div>
            </figure>
            <figure class="real-device real-device-iphone">
              <figcaption><span>iPhone</span><strong>이동 중에도 이어지는 커리큘럼</strong></figcaption>
              <div class="real-device-frame">
                <img class="theme-device-shot theme-device-shot-light" src="/images/home-devices/matths-iphone-light.jpg" alt="Matths iPhone 앱 라이트 모드 커리큘럼" width="1206" height="2369" loading="lazy" decoding="async" fetchpriority="low" />
                <img class="theme-device-shot theme-device-shot-dark" src="/images/home-devices/matths-iphone-dark.jpg" alt="Matths iPhone 앱 다크 모드 커리큘럼" width="1206" height="2369" loading="lazy" decoding="async" fetchpriority="low" />
              </div>
            </figure>
          </div>
        </div>
      </section>

      <section class="closing-cta" aria-labelledby="closing-cta-title">
        <div class="container closing-cta-inner">
          <div>
            <p>이해한 만큼, 실력이 됩니다.</p>
            <h2 id="closing-cta-title">당신의 수학이 달라질 순간입니다.</h2>
          </div>
          <div>
            <a class="button button-primary button-large c-button c-button--primary" href="<%= learningHref %>"><%= rolePrimaryLabel %> <span aria-hidden="true">→</span></a>
            <a href="<%= appStoreHref %>" target="_blank" rel="noopener noreferrer">모바일 앱 다운로드</a>
          </div>
        </div>
      </section>
    </main>

  <%- include("partials/business-footer") %>
  </body>
</html>

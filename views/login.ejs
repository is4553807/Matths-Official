<%
  const formError =
    typeof error !== "undefined" ? error : null;
  const formSuccess =
    typeof success !== "undefined" ? success : null;
  const protectedPageNotice =
    typeof loginNotice !== "undefined" ? loginNotice : null;
  const selectedAccountType =
    ["student", "academy", "parent", "admin"].includes(
      typeof accountType === "string" ? accountType : ""
    )
      ? accountType
      : "student";
  const accountCopy = {
    student: {
      label: "학생",
      eyebrow: "STUDENT LOGIN",
      title: "학생 학습을 이어가세요.",
      description: "오늘의 학습, 오답 기록과 학원 과제를 확인합니다.",
      action: "/student/login",
      register: "/student/register",
    },
    academy: {
      label: "학원",
      eyebrow: "ACADEMY LOGIN",
      title: "학원 운영 화면으로 들어가세요.",
      description: "반, 출결, 과제와 학생 학습 현황을 관리합니다.",
      action: "/academy/login",
      register: "/academy/register",
    },
    parent: {
      label: "학부모",
      eyebrow: "PARENT LOGIN",
      title: "자녀의 학습 현황을 확인하세요.",
      description: "자녀별 학습 현황, 알림과 결제 내역을 확인합니다.",
      action: "/parent/login",
      register: "/parent/register",
    },
    admin: {
      label: "운영자",
      eyebrow: "ADMIN LOGIN",
      title: "Matths 운영센터 로그인",
      description: "승인된 운영자 계정만 접근할 수 있습니다.",
      action: "/admin/login",
      register: "",
    },
  }[selectedAccountType];
  const loginNext =
    typeof next === "string" && next.startsWith("/") && !next.startsWith("//")
      ? next
      : "";

  const input =
    typeof oldInput !== "undefined" && oldInput
      ? oldInput
      : { email: "" };
  const socialProviders =
    typeof socialAuthProviders !== "undefined" && Array.isArray(socialAuthProviders)
      ? socialAuthProviders
      : [];
%>

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Matths <%= accountCopy.label %> 계정으로 로그인하세요."
    />

    <title><%= accountCopy.label %> 로그인 | Matths</title>

    <link
      rel="stylesheet"
      href="/css/auth.css"
    />

    <script
      src="/js/auth.js"
      defer
    ></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/matths-theme.css" />
    <link rel="stylesheet" href="/css/contrast.css" />
  </head>

  <body>
    <a
      class="skip-link"
      href="#auth-form"
    >
      로그인 폼으로 이동
    </a>

    <header class="auth-header">
      <%- include("partials/matths-brand", {
        href: "/",
        ariaLabel: "Matths 메인 페이지",
        className: "auth-brand",
      }) %>

      <nav aria-label="인증 페이지 메뉴">
        <span><%= accountCopy.label %> 계정이 없나요?</span>
        <% if (accountCopy.register) { %><a href="<%= accountCopy.register %>">회원가입</a><% } %>
      </nav>
    </header>

    <main class="auth-layout">
      <section
        class="auth-visual"
        aria-labelledby="visual-title"
      >
        <div class="visual-copy">
          <p><%= accountCopy.eyebrow %></p>

          <h1 id="visual-title">
            역할에 맞는 공간에서<br />
            <strong>필요한 화면만</strong><br />
            안전하게 이용하세요.
          </h1>

          <span>
            학생·학원·학부모 계정은 서로 다른 데이터와
            접근 권한으로 분리되어 있습니다.
          </span>
        </div>

        <div class="visual-points">
          <span>
            <b>학생</b>
            학습·오답·과제
          </span>

          <span>
            <b>학원</b>
            반·출결·과제 관리
          </span>

          <span>
            <b>학부모</b>
            자녀 현황·알림·결제
          </span>
        </div>
      </section>

      <section
        class="auth-panel"
        id="auth-form"
        aria-labelledby="login-title"
      >
        <div class="auth-panel-inner">
          <div class="auth-heading">
            <p><%= accountCopy.eyebrow %></p>
            <h2 id="login-title"><%= accountCopy.title %></h2>

            <span>
              <%= accountCopy.description %>
            </span>
          </div>

          <% if (selectedAccountType !== "admin") { %>
            <nav class="account-type-switcher" aria-label="계정 유형 선택">
              <a href="/student/login" class="<%= selectedAccountType === 'student' ? 'is-active' : '' %>" <% if (selectedAccountType === "student") { %>aria-current="page"<% } %>>학생</a>
              <a href="/academy/login" class="<%= selectedAccountType === 'academy' ? 'is-active' : '' %>" <% if (selectedAccountType === "academy") { %>aria-current="page"<% } %>>학원</a>
              <a href="/parent/login" class="<%= selectedAccountType === 'parent' ? 'is-active' : '' %>" <% if (selectedAccountType === "parent") { %>aria-current="page"<% } %>>학부모</a>
            </nav>
          <% } %>

          <% if (protectedPageNotice) { %>
            <div class="form-alert form-alert-login" role="status">
              <span aria-hidden="true">→</span>
              <p><%= protectedPageNotice %></p>
            </div>
          <% } %>

          <% if (formError) { %>
            <div
              class="form-alert"
              role="alert"
            >
              <span aria-hidden="true">!</span>
              <p><%= formError %></p>
            </div>
          <% } %>

          <% if (formSuccess) { %>
            <div
              class="form-alert form-alert-success"
              role="status"
            >
              <span aria-hidden="true">✓</span>
              <p><%= formSuccess %></p>
            </div>
          <% } %>

          <form
            class="auth-form"
            action="<%= accountCopy.action %>"
            method="POST"
          >
            <% if (loginNext) { %><input type="hidden" name="next" value="<%= loginNext %>" /><% } %>
            <div class="form-field">
              <label for="email">이메일</label>

              <input
                id="email"
                name="email"
                type="email"
                value="<%= input.email || '' %>"
                placeholder="가입한 이메일을 입력하세요"
                autocomplete="email"
                inputmode="email"
                autocapitalize="none"
                spellcheck="false"
                required
              />
            </div>

            <div class="form-field">
              <div class="field-label-row">
                <label for="password">
                  비밀번호
                </label>

                <% if (["student", "admin"].includes(selectedAccountType)) { %><a href="/forgot-password">비밀번호를 잊었나요?</a><% } %>
              </div>

              <div class="password-field">
                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="비밀번호를 입력하세요"
                  autocomplete="current-password"
                  minlength="8"
                  required
                />

                <button
                  type="button"
                  data-password-toggle="password"
                  aria-label="비밀번호 표시"
                  aria-pressed="false"
                >
                  보기
                </button>
              </div>
            </div>
            <button
              class="submit-button"
              type="submit"
            >
              로그인
              <span aria-hidden="true">→</span>
            </button>
          </form>

          <% if (selectedAccountType !== "admin") { %><%- include("partials/social-auth-buttons", {
            accountType: selectedAccountType, socialAuthProviders: socialProviders,
            next: loginNext, inviteToken: "", registrationFlow: "",
          }) %><% } %>

          <div class="auth-switch">
            <% if (accountCopy.register) { %>
              <span><%= accountCopy.label %> 계정이 처음인가요?</span>
              <a href="<%= accountCopy.register %>">회원가입</a>
            <% } else { %>
              <span>운영자 계정 발급이 필요한가요?</span>
              <a href="/contact">문의하기</a>
            <% } %>
          </div>

          <p class="auth-notice">
            로그인하면 <a href="/terms">이용약관</a>과 <a href="/privacy">개인정보처리방침</a>에
            동의한 것으로 간주됩니다.
          </p>
        </div>
      </section>
    </main>
  <%- include("partials/business-footer") %>
  </body>
</html>

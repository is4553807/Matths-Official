<%
  const formError =
    typeof error !== "undefined" ? error : null;
  const formSuccess =
    typeof success !== "undefined" ? success : null;
  const protectedPageNotice =
    typeof loginNotice !== "undefined" ? loginNotice : null;

  const input =
    typeof oldInput !== "undefined" && oldInput
      ? oldInput
      : { email: "" };
  const socialProviders =
    typeof socialAuthProviders !== "undefined" && Array.isArray(socialAuthProviders)
      ? socialAuthProviders
      : [];
  const socialProviderConfigured = (key) =>
    socialProviders.find((provider) => provider.key === key)?.configured === true;
%>

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Matths에 로그인하고 학습을 이어서 시작하세요."
    />

    <title>로그인 | Matths</title>

    <link
      rel="stylesheet"
      href="/css/auth.css"
    />

    <script
      src="/js/auth.js"
      defer
    ></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/matths-theme.css" />
    <link rel="stylesheet" href="/css/contrast.css" />
  </head>

  <body>
    <a
      class="skip-link"
      href="#auth-form"
    >
      로그인 폼으로 이동
    </a>

    <header class="auth-header">
      <%- include("partials/matths-brand", {
        href: "/",
        ariaLabel: "Matths 메인 페이지",
        className: "auth-brand",
      }) %>

      <nav aria-label="인증 페이지 메뉴">
        <span>아직 계정이 없나요?</span>
        <a href="/register">회원가입</a>
      </nav>
    </header>

    <main class="auth-layout">
      <section
        class="auth-visual"
        aria-labelledby="visual-title"
      >
        <div class="visual-copy">
          <p>WELCOME BACK</p>

          <h1 id="visual-title">
            외운 공식 말고,<br />
            <strong>이해한 장면</strong>부터<br />
            이어서 시작하세요.
          </h1>

          <span>
            지난 학습 위치와 오답 기록을 불러와
            필요한 개념부터 다시 보여드립니다.
          </span>
        </div>

        <div class="visual-points">
          <span>
            <b>01</b>
            마지막 학습부터 이어서
          </span>

          <span>
            <b>02</b>
            오답은 막힌 Step부터
          </span>

          <span>
            <b>03</b>
            내 진도를 한눈에
          </span>
        </div>
      </section>

      <section
        class="auth-panel"
        id="auth-form"
        aria-labelledby="login-title"
      >
        <div class="auth-panel-inner">
          <div class="auth-heading">
            <p>LOGIN</p>
            <h2 id="login-title">다시 만나 반갑습니다.</h2>

            <span>
              로그인하고 오늘의 학습을 이어가세요.
            </span>
          </div>

          <% if (protectedPageNotice) { %>
            <div class="form-alert form-alert-login" role="status">
              <span aria-hidden="true">→</span>
              <p><%= protectedPageNotice %></p>
            </div>
          <% } %>

          <% if (formError) { %>
            <div
              class="form-alert"
              role="alert"
            >
              <span aria-hidden="true">!</span>
              <p><%= formError %></p>
            </div>
          <% } %>

          <% if (formSuccess) { %>
            <div
              class="form-alert form-alert-success"
              role="status"
            >
              <span aria-hidden="true">✓</span>
              <p><%= formSuccess %></p>
            </div>
          <% } %>

          <form
            class="auth-form"
            action="/login"
            method="POST"
          >
            <div class="form-field">
              <label for="email">이메일</label>

              <input
                id="email"
                name="email"
                type="email"
                value="<%= input.email || '' %>"
                placeholder="가입 이메일"
                autocomplete="username"
                required
              />
            </div>

            <div class="form-field">
              <div class="field-label-row">
                <label for="password">
                  비밀번호
                </label>

                <a href="/forgot-password">
                  비밀번호를 잊었나요?
                </a>
              </div>

              <div class="password-field">
                <input
                  id="password"
                  name="password"
                  type="password"
                  placeholder="비밀번호를 입력하세요"
                  autocomplete="current-password"
                  minlength="8"
                  required
                />

                <button
                  type="button"
                  data-password-toggle="password"
                  aria-label="비밀번호 표시"
                  aria-pressed="false"
                >
                  보기
                </button>
              </div>
            </div>
            <button
              class="submit-button"
              type="submit"
            >
              로그인
              <span aria-hidden="true">→</span>
            </button>
          </form>

          <div class="social-auth" aria-label="소셜 로그인">
            <div class="social-auth-divider"><span>또는</span></div>
            <div class="social-auth-buttons">
              <a
                class="social-auth-button is-google<%= socialProviderConfigured('google') ? '' : ' is-disabled' %>"
                href="<%= socialProviderConfigured('google') ? '/auth/google' : '#' %>"
                aria-disabled="<%= socialProviderConfigured('google') ? 'false' : 'true' %>"
              >
                <img
                  class="social-auth-google-mark"
                  src="/images/google-g-logo.svg"
                  alt=""
                  width="20"
                  height="20"
                  aria-hidden="true"
                />
                Google로 계속하기
              </a>
              <a
                class="social-auth-button is-kakao<%= socialProviderConfigured('kakao') ? '' : ' is-disabled' %>"
                href="<%= socialProviderConfigured('kakao') ? '/auth/kakao' : '#' %>"
                aria-disabled="<%= socialProviderConfigured('kakao') ? 'false' : 'true' %>"
              >
                <img
                  class="social-auth-kakao-mark"
                  src="/images/kakao-login-mark.svg"
                  alt=""
                  width="20"
                  height="20"
                  aria-hidden="true"
                />
                카카오로 계속하기
              </a>
            </div>
            <% if (socialProviders.some((provider) => !provider.configured)) { %>
              <small class="social-auth-guide">운영 키가 설정되지 않은 로그인 방식은 아직 사용할 수 없습니다.</small>
            <% } %>
          </div>

          <div class="auth-switch">
            <span>Matths가 처음인가요?</span>
            <a href="/register">
              무료로 시작하기
            </a>
          </div>

          <p class="auth-notice">
            로그인하면 <a href="/terms">이용약관</a>과 <a href="/privacy">개인정보처리방침</a>에
            동의한 것으로 간주됩니다.
          </p>
        </div>
      </section>
    </main>
  <%- include("partials/business-footer") %>
  </body>
</html>

<%
  const learner = user;
  const data = dashboardData;

  const displayName = String(learner.name || "학생");
  const greetingName = String(learner.realName || learner.name || "학생");
  const notifications = Array.isArray(data.notifications) ? data.notifications : [];
  const hasUrgentNotification = Boolean(data.hasUrgentNotification);
  const activeDashboardNotices = Array.isArray(data.activeDashboardNotices) ? data.activeDashboardNotices : [];
  const activityDays = Array.isArray(data.weeklyActivity?.days) ? data.weeklyActivity.days : [];
  const weeklyStudyMinutes = Number(data.stats?.weeklyStudyMinutes) || 0;
  const todayStudyMinutes = Number(data.stats?.todayStudyMinutes) || 0;
  const activeStudyDays = Number(data.stats?.activeStudyDays) || 0;
  const averageStudyMinutes = Number(data.stats?.averageStudyMinutes) || 0;
  const weeklySolvedProblems = Number(data.stats?.weeklySolvedProblems) || 0;
  const weeklyCorrectRate = Number(data.stats?.correctRate) || 0;
  const activePlan = data.activePlan || { code: "FREE", name: "기본학습 패키지" };
  const accessRenewalNotice = data.accessRenewalNotice || null;
  const currentKoreanYear = new Intl.DateTimeFormat("en-US", {
    timeZone: "Asia/Seoul",
    year: "numeric",
  }).format(new Date());

  const formatStudyTime = (minutes) => {
    const safeMinutes = Math.max(0, Math.round(Number(minutes) || 0));
    const hours = Math.floor(safeMinutes / 60);
    const remainingMinutes = safeMinutes % 60;

    if (!hours) return `${remainingMinutes}분`;
    if (!remainingMinutes) return `${hours}시간`;
    return `${hours}시간 ${remainingMinutes}분`;
  };

  const gradeLabel = learner.schoolGrade === 10
    ? "고등학교 1학년"
    : learner.schoolGrade === 11
      ? "고등학교 2학년"
      : learner.schoolGrade === 12
        ? "고등학교 3학년"
        : learner.schoolGrade === 13
          ? "N수생"
          : learner.schoolGrade === 14
            ? "대학생"
            : learner.schoolGrade === 15
              ? "직장인"
              : "학년 미설정";

  const chartMaximum = Math.max(1, Number(data.weeklyActivity?.maxMinutes) || 0);
  const planExpiryLabel = activePlan.expiresAt
    ? new Intl.DateTimeFormat("ko-KR", {
        timeZone: "Asia/Seoul",
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(new Date(activePlan.expiresAt))
    : "기간 제한 없음";
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="이번 주 학습 기록을 한눈에 확인하는 Matths 대시보드입니다."
    />
    <meta name="theme-color" content="#f5f7fc" />
    <title>학습 홈 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <script src="/js/main.js" defer></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body class="dashboard-home">
    <a class="skip-link" href="#dashboard-main">본문으로 바로가기</a>

    <% if (accessRenewalNotice) { %>
      <dialog
        class="access-renewal-dialog"
        id="access-renewal-dialog"
        data-access-renewal-dialog
        <%= accessRenewalNotice.graceDeadline ? `data-grace-deadline="${new Date(accessRenewalNotice.graceDeadline).toISOString()}"` : "" %>
      >
        <div class="access-renewal-dialog__glow" aria-hidden="true"></div>
        <form method="dialog" class="access-renewal-dialog__body">
          <p><%= accessRenewalNotice.kind === "MAIN_DEMOTION" ? "RANKED 이용 종료" : "학습권 이용 종료" %></p>
          <h2>정기권 학습 가능 일수를 모두 사용했습니다.</h2>
          <% if (accessRenewalNotice.kind === "MAIN_DEMOTION") { %>
            <span>Ranked 이용이 종료되어 Unranked로 전환됐습니다. 다시 이용하려면 29일 학습권 패키지를 구매해 주세요.</span>
            <dl class="access-renewal-preview">
              <div><dt>72시간 내 재구매 예상 위치</dt><dd><strong><%= accessRenewalNotice.referenceTier %></strong> · <%= accessRenewalNotice.referenceGp %> GP<% if (accessRenewalNotice.referenceOverallPosition) { %> · 전체 <%= accessRenewalNotice.referenceOverallPosition %>위<% } %></dd></div>
              <div><dt>72시간 종료까지</dt><dd data-renewal-countdown><%= accessRenewalNotice.withinGrace ? "계산 중" : "종료됨" %></dd></div>
              <div><dt>기한 후 랭크 복귀전 최고 위치</dt><dd><strong><%= accessRenewalNotice.lateTier %></strong> · <%= accessRenewalNotice.lateGp %> GP</dd></div>
            </dl>
            <small>72시간은 무료 이용 기간이 아닙니다. 기한이 지나면 결제 후 랭크 복귀전을 완료해야 합니다.</small>
          <% } else { %>
            <span>GOAT Arena와 Matths 주간 공식 모의고사 이용이 중단됐습니다. 새 학습권 패키지의 가격과 이용 범위를 확인해 주세요.</span>
          <% } %>
          <div class="access-renewal-dialog__actions">
            <a href="/pricing">학습권 패키지 확인</a>
            <button type="submit">대시보드 먼저 보기</button>
          </div>
        </form>
      </dialog>
    <% } %>

    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

      <aside class="sidebar" id="dashboard-sidebar" aria-label="학습 메뉴">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Matths 학습 홈">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span>Matths</span>
          </a>

          <button class="sidebar-close" id="sidebar-close" type="button" aria-label="메뉴 닫기">
            ×
          </button>
        </div>

        <%- include("partials/dashboard-navigation", {
          activePage: "main",
        }) %>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-profile">
          <a
            class="profile-avatar"
            href="/profile"
            aria-label="<%= displayName %>님의 프로필 설정으로 이동"
            title="프로필 설정"
          ><%= displayName.slice(0, 1) %></a>

          <div class="profile-copy">
            <strong><%= displayName %>님</strong>
            <small><%= gradeLabel %></small>
          </div>

          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃" title="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main class="dashboard-main" id="dashboard-main">
        <header class="topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>

            <div>
              <p id="today-label">오늘의 학습</p>
              <h1><%= greetingName %>님, 반갑습니다.</h1>
            </div>
          </div>

          <div class="topbar-actions">
            <div class="streak-pill" title="연속 학습일">
              <span aria-hidden="true">●</span>
              <strong><%= learner.currentStreak %>일 연속</strong>
            </div>

            <div class="notification-wrap">
              <button
                class="notification-button <%= hasUrgentNotification ? 'urgent shake' : '' %>"
                id="notification-button"
                type="button"
                aria-label="알림 <%= notifications.length %>개 보기"
                aria-expanded="false"
                aria-controls="notification-panel"
              >
                <span aria-hidden="true">♢</span>
                <% if (notifications.length > 0) { %>
                  <i><%= notifications.length %></i>
                <% } %>
              </button>

              <div class="notification-panel" id="notification-panel" hidden>
                <div class="notification-panel-title">
                  <strong><a href="/notifications">알림 우편함</a></strong>
                  <button id="notification-close" type="button" aria-label="알림 닫기">×</button>
                </div>

                <% if (notifications.length) { %>
                  <% notifications.forEach((notification) => { %>
                    <a class="<%= notification.urgent ? 'urgent' : '' %>" href="<%= notification.href %>">
                      <b><%= notification.title %></b>
                      <small><%= notification.description %></small>
                    </a>
                  <% }) %>
                <% } else { %>
                  <p class="panel-empty">새로운 알림이 없습니다.</p>
                <% } %>
                <a class="notification-inbox-cta" href="/notifications">
                  알림 우편함 전체 보기
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </header>

        <% if (activeDashboardNotices.length) { %>
          <section class="dashboard-announcements" aria-label="운영 공지">
            <% activeDashboardNotices.forEach((notice) => { %>
              <article class="<%= notice.kind === 'integrity' ? 'integrity' : '' %>" data-dashboard-notice="<%= notice.id %>">
                <span aria-hidden="true">!</span>
                <a href="<%= notice.href %>">
                  <strong><%= notice.title %></strong>
                  <p><%= notice.content %></p>
                </a>
                <button
                  type="button"
                  data-dismiss-dashboard-notice="<%= notice.dismissUrl %>"
                  aria-label="<%= notice.title %> 알림 닫기"
                  title="대시보드에서 닫기"
                >×</button>
              </article>
            <% }) %>
          </section>
        <% } %>

        <% if (data.coach?.message) { %>
          <section
            class="dashboard-coach-card"
            data-mode="<%= data.coach.mode %>"
            aria-label="오늘의 Matths 코치 메시지"
          >
            <span class="dashboard-coach-avatar" aria-hidden="true">M</span>
            <div>
              <p>TODAY COACH · <%= data.coach.label %></p>
              <strong><%= data.coach.message %></strong>
              <small>학습 상황에 맞춰 정답·오답·미응답 피드백이 달라집니다.</small>
            </div>
            <a href="/profile#coach-mode-settings">말투 설정 <span aria-hidden="true">→</span></a>
          </section>
        <% } %>

        <section class="usage-plan-section" aria-labelledby="usage-plan-title">
          <article class="usage-plan-card usage-plan-card--<%= String(activePlan.code || 'FREE').toLowerCase() %>">
            <div class="usage-plan-copy">
              <p>이용 플랜</p>
              <h2 id="usage-plan-title"><%= activePlan.name %></h2>
              <span><%= activePlan.statusLabel %><% if (activePlan.division) { %> · <%= activePlan.division %><% } %></span>
            </div>
            <dl class="usage-plan-metrics">
              <div>
                <dt>남은 학습일수</dt>
                <% if (activePlan.unlimited) { %>
                  <dd><strong>무제한</strong><small>만료 없음</small></dd>
                <% } else { %>
                  <dd><strong><%= Number(activePlan.remainingLearningDays) || 0 %></strong><small>일</small></dd>
                <% } %>
              </div>
              <% if (activePlan.code === "LEARNING_PACKAGE" && Number(activePlan.reservedLearningDays || 0) + Number(activePlan.lockedLearningDays || 0) > 0) { %>
                <div>
                  <dt>지금 사용 가능</dt>
                  <dd><strong><%= Number(activePlan.availableLearningDays) || 0 %></strong><small>일</small></dd>
                  <p>예약 <%= Number(activePlan.reservedLearningDays) || 0 %>일 · 경기 예치 <%= Number(activePlan.lockedLearningDays) || 0 %>일</p>
                </div>
              <% } %>
              <div>
                <dt>이용 기간</dt>
                <dd class="usage-plan-date"><%= planExpiryLabel %></dd>
              </div>
            </dl>
            <a href="/pricing"><%= activePlan.code === "FREE" ? "플랜 비교하기" : "이용 범위 확인" %><span aria-hidden="true">→</span></a>
          </article>
        </section>

        <section
          class="learning-record-section"
          id="learning-record"
          aria-labelledby="learning-record-title"
        >
          <article class="activity-card">
            <div class="card-heading">
              <div>
                <p>WEEKLY ACTIVITY</p>
                <h2 id="learning-record-title">이번 주 학습 기록</h2>
              </div>

              <span class="chart-legend"><b></b> 학습 시간</span>
            </div>

            <dl class="learning-kpi-grid" aria-label="최근 7일 학습 통계">
              <div>
                <dt>최근 7일 학습</dt>
                <dd>
                  <strong><%= formatStudyTime(weeklyStudyMinutes) %></strong>
                  <small><%= data.stats?.weeklyStudyDetail || "비교 기록 없음" %></small>
                </dd>
              </div>
              <div>
                <dt>오늘 학습</dt>
                <dd>
                  <strong><%= formatStudyTime(todayStudyMinutes) %></strong>
                  <small>한국 시간 기준</small>
                </dd>
              </div>
              <div>
                <dt>학습한 날</dt>
                <dd>
                  <strong><%= activeStudyDays %><span>일</span></strong>
                  <small>최근 7일 중</small>
                </dd>
              </div>
              <div>
                <dt>학습일 평균</dt>
                <dd>
                  <strong><%= formatStudyTime(averageStudyMinutes) %></strong>
                  <small>학습한 날 기준</small>
                </dd>
              </div>
              <div>
                <dt>최근 7일 풀이</dt>
                <dd>
                  <strong><%= weeklySolvedProblems %><span>문제</span></strong>
                  <small>개념·복습·평가 포함</small>
                </dd>
              </div>
              <div>
                <dt>최근 7일 정답률</dt>
                <dd>
                  <strong><%= weeklyCorrectRate %><span>%</span></strong>
                  <small><%= data.stats?.correctRateDetail || "비교 기록 없음" %></small>
                </dd>
              </div>
            </dl>

            <% if (activityDays.length) { %>
              <div class="weekly-chart" aria-label="요일별 학습 시간">
                <% activityDays.forEach((day) => {
                  const rawHeight = Math.round((Number(day.minutes) || 0) / chartMaximum * 100);
                  const barHeight = day.minutes > 0 ? Math.max(7, rawHeight) : 0;
                %>
                  <div class="chart-day <%= day.isToday ? 'today' : '' %>">
                    <div class="bar-track">
                      <i
                        style="--height:<%= barHeight %>%"
                        aria-label="<%= day.label %> <%= day.minutes %>분"
                      >
                        <span><%= day.minutes %>분</span>
                      </i>
                    </div>
                    <small><%= day.label %></small>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="section-empty chart-empty">
                <strong>아직 학습 기록이 없습니다.</strong>
                <p>개념을 학습하면 요일별 학습 시간이 표시됩니다.</p>
              </div>
            <% } %>
          </article>
        </section>

        <footer class="dashboard-footer">
          <span>© <%= currentKoreanYear %> Matths</span>
          <p>설명은 친절하게. 학습은 단계적으로.</p>
          <div>
            <a href="/terms">이용약관</a>
            <a href="/privacy">개인정보처리방침</a>
            <%- include("partials/social-footer-links") %>
          </div>
        </footer>

        <p class="sr-only" id="dashboard-status" role="status" aria-live="polite"></p>
      </main>
    </div>
  </body>
</html>

<%
  const learner = user;
  const data = learningData;
  const displayName = String(learner.name || "학생");
  const totalUnits = data.courses.reduce(
    (sum, course) => sum + (course.developmentLocked ? 0 : course.units.length),
    0
  );
  const gradeLabel = learner.schoolGrade === 10
    ? "고등학교 1학년"
    : learner.schoolGrade === 11
      ? "고등학교 2학년"
      : learner.schoolGrade === 12
        ? "고등학교 3학년"
        : learner.schoolGrade === 13
          ? "N수생"
          : "학년 미설정";
  const featuredCourse = data.courses
    .filter((course) => !course.developmentLocked)
    .sort(
    (left, right) =>
      Number(right.progress || 0) -
        Number(left.progress || 0) ||
      Number(Boolean(right.hasActivity)) -
        Number(Boolean(left.hasActivity))
  )[0] || null;
  const featuredConcepts =
    featuredCourse?.units.flatMap(
      (unit) => unit.concepts
    ) || [];
  const featuredContinue =
    featuredConcepts.find(
      (concept) =>
        concept.progress > 0 &&
        concept.progress < 100
    ) ||
    featuredConcepts.find(
      (concept) =>
        concept.progress < 100
    ) ||
    featuredConcepts[0];
  const featuredHref =
    featuredContinue?.href ||
    data.continueHref;
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="공통수학 전체 단원과 개념별 학습 진도를 확인하고 이어서 학습합니다."
    />
    <meta name="theme-color" content="#f5f7fc" />
    <title>내 학습 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/my-learning.css" />
    <script>
      window.MathJax = {
        tex: {
          inlineMath: [["\\(", "\\)"]],
          displayMath: [["\\[", "\\]"]],
          processEscapes: true,
        },
        options: {
          enableSpeech: false,
          enableBraille: false,
          enableExplorer: false,
        },
      };
    </script>
    <script
      src="/vendor/mathjax/tex-svg.js"
      defer
    ></script>
    <script src="/js/math-renderer.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="/js/my-learning.js" defer></script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="stylesheet" href="/css/brand.css" />
  </head>
  <body>
    <a class="skip-link" href="#my-learning-main">본문으로 바로가기</a>

    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

      <aside class="sidebar" id="dashboard-sidebar" aria-label="학습 메뉴">
        <div class="sidebar-top">
          <%- include("partials/matths-brand", { href: "/", ariaLabel: "Matths 학습 홈", className: "brand", tone: "light" }) %>
          <button class="sidebar-close" id="sidebar-close" type="button" aria-label="메뉴 닫기">×</button>
        </div>

        <%- include("partials/dashboard-navigation", {
          activePage: "my-learning",
        }) %>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile" aria-label="<%= displayName %>님의 프로필 설정으로 이동" title="프로필 설정"><%= displayName.slice(0, 1) %></a>
          <div class="profile-copy">
            <strong><%= displayName %>님</strong>
            <small><%= gradeLabel %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃" title="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main class="dashboard-main my-learning-main" id="my-learning-main">
        <header class="topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>내 학습 진도</p>
              <h1>어디까지 이해했는지 확인하세요.</h1>
            </div>
          </div>
          <a class="back-dashboard learning-home-button" href="/main">학습 홈으로 <span aria-hidden="true">→</span></a>
        </header>

        <section class="learning-summary">
          <div class="summary-copy">
            <p>MY LEARNING</p>
            <h2>
              <span class="learning-math-content"><%= featuredCourse?.officialTitle || "학습 과목" %></span>
              진도
            </h2>
            <span>체크한 학습 항목은 단원과 과목 진도에 바로 반영됩니다.</span>
            <a href="<%= featuredHref %>">이어서 학습하기 <b aria-hidden="true">→</b></a>
          </div>

          <div
            class="overall-ring"
            style="--overall:<%= Number(featuredCourse?.progress || 0) * 3.6 %>deg"
            role="progressbar"
            aria-label="<%= featuredCourse?.officialTitle || '과목' %> 학습 진도"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="<%= Number(featuredCourse?.progress || 0) %>"
          >
            <div>
              <strong><%= Number(featuredCourse?.progress || 0) %>%</strong>
              <small>과목 완성도</small>
            </div>
          </div>

          <div class="summary-numbers">
            <div><strong><%= data.completedConcepts %></strong><span>완료 개념</span></div>
            <div><strong><%= data.totalConcepts - data.completedConcepts %></strong><span>남은 개념</span></div>
            <div><strong><%= totalUnits %></strong><span>전체 대단원</span></div>
          </div>
        </section>

        <% if (data.courses.length) { %>
          <section class="course-progress-section" aria-labelledby="course-progress-title">
            <div class="learning-section-head">
              <div>
                <p>COURSE PROGRESS</p>
                <h2 id="course-progress-title">과목별 학습 진도</h2>
              </div>
            </div>

            <div class="course-switcher" role="tablist" aria-label="과목 선택">
              <% data.courses.forEach((course, index) => { %>
                <button
                  id="course-tab-<%= course.id %>"
                  class="course-tab <%= course.developmentLocked ? 'is-development-locked' : '' %> <%= course.id === featuredCourse?.id ? 'active' : '' %>"
                  type="button"
                  role="tab"
                  <%= course.developmentLocked ? "disabled aria-disabled=true" : `data-course=${course.id}` %>
                  aria-selected="<%= course.id === featuredCourse?.id %>"
                  <%= course.developmentLocked ? "" : `aria-controls=panel-${course.id}` %>
                  tabindex="<%= course.id === featuredCourse?.id ? 0 : -1 %>"
                >
                  <span class="learning-math-content"><%= course.officialTitle %></span>
                  <% if (course.developmentLocked) { %>
                    <b class="course-lock-label"><i aria-hidden="true">🔒</i> 준비 중</b>
                  <% } else { %>
                    <b><%= course.progress %>%</b>
                  <% } %>
                </button>
              <% }) %>
            </div>

            <div class="course-panels">
              <% data.courses.forEach((course, courseIndex) => { %>
                <% if (!course.developmentLocked) { %>
                <section
                  class="course-panel <%= course.id === featuredCourse?.id ? 'active' : '' %>"
                  id="panel-<%= course.id %>"
                  data-course-panel="<%= course.id %>"
                  role="tabpanel"
                  aria-labelledby="course-tab-<%= course.id %>"
                >
                  <header class="course-overview">
                    <div>
                      <span><%= String(courseIndex + 1).padStart(2, "0") %></span>
                      <div>
                        <small>COMMON MATHEMATICS · 기본 순서 <%= course.defaultSemester %></small>
                        <h3 class="learning-math-content"><%= course.officialTitle %></h3>
                      </div>
                    </div>

                    <div class="course-total">
                      <p><strong><%= course.completedConcepts %></strong> / <%= course.totalConcepts %>개념 완료</p>
                      <div><i style="--progress:<%= course.progress %>%"></i></div>
                      <b><%= course.progress %>%</b>
                    </div>
                  </header>

                  <% if (course.assessmentRequired) { %>
                    <div class="assessment-gate-banner">
                      <div>
                        <span>COURSE FINAL REQUIRED</span>
                        <strong>
                          개념 학습은 끝났습니다. 과목 종합평가에서 80점 이상을 받으면 최종 완료됩니다.
                        </strong>
                      </div>
                      <a href="/assessments">종합평가 확인 →</a>
                    </div>
                  <% } else if (course.assessmentPassed) { %>
                    <div class="assessment-gate-banner passed">
                      <div>
                        <span>COURSE COMPLETE</span>
                        <strong>과목 종합평가까지 통과했습니다.</strong>
                      </div>
                      <a href="/assessments">평가 기록 보기 →</a>
                    </div>
                  <% } %>

                  <div class="progress-unit-list">
                    <% course.units.forEach((unit, unitIndex) => { %>
                      <details class="progress-unit" data-unit-id="<%= unit.id %>" <%= unitIndex === 0 ? "open" : "" %>>
                        <summary>
                          <span class="unit-number"><%= String(unit.order).padStart(2, "0") %></span>
                          <div class="unit-title">
                            <strong class="learning-math-content"><%= unit.title %></strong>
                            <small><%= unit.completedConcepts %> / <%= unit.concepts.length %>개념 완료</small>
                          </div>
                          <div class="unit-bar">
                            <i><b style="--progress:<%= unit.progress %>%"></b></i>
                            <strong><%= unit.progress %>%</strong>
                          </div>
                          <span class="unit-toggle"><i><%= unitIndex === 0 ? "소단원 닫기" : "소단원 보기" %></i><b aria-hidden="true">+</b></span>
                        </summary>

                        <div class="unit-progress-body">
                          <div class="unit-action">
                            <p><strong class="learning-math-content"><%= unit.title %></strong>에서 배우는 개념을 순서대로 확인하세요.</p>
                            <a href="<%= unit.assessmentRequired ? '/assessments' : unit.firstConceptHref %>">
                              <%= unit.assessmentRequired ? "기말평가 보기" : "단원 학습하기" %>
                              <span aria-hidden="true">→</span>
                            </a>
                          </div>

                          <% if (unit.assessmentRequired) { %>
                            <p class="unit-assessment-notice">
                              개념은 모두 완료했지만 대단원 기말평가를 통과하기 전이라 진도는 95%로 유지됩니다.
                            </p>
                          <% } else if (unit.assessmentPassed) { %>
                            <p class="unit-assessment-notice passed">
                              기말평가 80점 기준을 통과해 대단원이 최종 완료되었습니다.
                            </p>
                          <% } %>

                          <div class="concept-progress-list">
                            <% unit.concepts.forEach((concept, conceptIndex) => {
                              const statusText = concept.progress >= 100
                                ? "완료"
                                : concept.progress > 0
                                  ? "학습 중"
                                  : "시작 전";
                            %>
                              <a class="concept-progress-row <%= concept.status %>" href="<%= concept.href %>">
                                <span class="concept-state" aria-hidden="true"><%= concept.progress >= 100 ? "✓" : String(conceptIndex + 1).padStart(2, "0") %></span>
                                <div class="concept-info">
                                  <strong class="learning-math-content"><%= concept.title %></strong>
                                  <small><%= concept.standardCode %> · <%= concept.completedTopics %>/<%= concept.topics.length %> 주제 완료</small>
                                </div>
                                <div class="concept-bar">
                                  <i><b style="--progress:<%= concept.progress %>%"></b></i>
                                  <span><%= concept.progress %>%</span>
                                </div>
                                <em><%= statusText %></em>
                                <b class="row-arrow" aria-hidden="true">→</b>
                              </a>
                            <% }) %>
                          </div>
                        </div>
                      </details>
                    <% }) %>
                  </div>
                </section>
                <% } %>
              <% }) %>
            </div>
          </section>
        <% } else { %>
          <section class="learning-empty">
            <span aria-hidden="true">▦</span>
            <h2>학습 기록을 불러오지 못했습니다.</h2>
            <p>잠시 후 다시 시도해 주세요. 문제가 계속되면 문의하기로 알려주세요.</p>
          </section>
        <% } %>

      </main>
    </div>
  <%- include("partials/business-footer") %>
  </body>
</html>

<%
  const formatWon = (value) => `${new Intl.NumberFormat("ko-KR").format(Number(value) || 0)}원`;
  const formatDate = (value) => value
    ? new Intl.DateTimeFormat("ko-KR", {
        timeZone: "Asia/Seoul",
        dateStyle: "medium",
        timeStyle: "short",
      }).format(new Date(value))
    : "-";
  const statusLabels = {
    AWAITING_PG: "결제 대기",
    AWAITING_DEPOSIT: "입금 대기",
    PAID: "결제 완료",
    CANCELLED: "결제 취소",
    EXPIRED: "주문 만료",
    REFUND_REQUESTED: "환불 접수",
    REFUND_CALCULATED: "환불액 산정 완료",
    PARTIALLY_REFUNDED: "부분 환불",
    REFUNDED: "환불 완료",
  };
  const refundStatusLabels = {
    REQUESTED: "접수",
    CALCULATED: "산정 완료",
    COMPLETED: "환불 완료",
    REJECTED: "반려",
  };
%>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>결제·환불 관리 | Matths 학부모</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="stylesheet" href="/css/brand.css" />
  <link rel="stylesheet" href="/css/parent.css" />
</head>
<body class="parent-page">
  <%- include('partials/parent-navigation', { activeParentPage: 'payments' }) %>
  <main class="parent-main">
    <header class="parent-page-heading">
      <p>결제·환불 관리</p>
      <h1><%= child.realName || child.name %> 학생의<br />결제 기록을 확인하세요.</h1>
      <span>이 학부모 계정에서 결제한 주문만 표시합니다. 영수증 확인과 환불 신청 상태를 한곳에서 관리할 수 있습니다.</span>
    </header>

    <% if (feedback) { %><div class="parent-form-message is-success" role="status"><%= feedback %></div><% } %>
    <% if (error) { %><div class="parent-form-message is-error" role="alert"><%= error %></div><% } %>

    <section class="parent-payment-summary" aria-label="결제 요약">
      <article><small>전체 주문</small><strong><%= paymentData.summary.orderCount %><em>건</em></strong></article>
      <article><small>승인 결제</small><strong><%= paymentData.summary.paidCount %><em>건</em></strong></article>
      <article><small>누적 승인금액</small><strong><%= formatWon(paymentData.summary.paidAmount) %></strong></article>
      <article><small>환불 완료금액</small><strong><%= formatWon(paymentData.summary.refundedAmount) %></strong></article>
    </section>

    <section class="parent-payment-list" aria-label="결제 내역">
      <% if (!paymentData.orders.length) { %>
        <div class="parent-payment-empty">
          <strong>아직 이 학부모 계정으로 결제한 내역이 없습니다.</strong>
          <p>선택한 자녀의 이용권을 구매하면 주문과 영수증이 여기에 표시됩니다.</p>
          <a href="/parent/pricing">패키지 확인하기</a>
        </div>
      <% } %>

      <% paymentData.orders.forEach((order) => { %>
        <article class="parent-payment-card">
          <header>
            <div>
              <span class="parent-payment-status status-<%= order.status.toLowerCase() %>"><%= statusLabels[order.status] || order.status %></span>
              <% if (order.providerMode === "TEST") { %><span class="parent-payment-test">TEST</span><% } %>
              <h2><%= order.productName %></h2>
              <p>주문 <%= order.orderId %></p>
            </div>
            <div class="parent-payment-price"><strong><%= formatWon(order.amount) %></strong><small><%= formatDate(order.approvedAt || order.createdAt) %></small></div>
          </header>

          <dl>
            <div><dt>결제수단</dt><dd><%= order.paymentMethod || (order.status === "PAID" ? "확인 중" : "-") %></dd></div>
            <div><dt>승인 상태</dt><dd><%= statusLabels[order.status] || order.status %></dd></div>
            <div><dt>환불 가능 잔액</dt><dd><%= order.payment ? formatWon(order.remainingAmount) : "-" %></dd></div>
          </dl>

          <div class="parent-payment-actions">
            <% if (order.receiptUrl) { %>
              <a href="<%= order.receiptUrl %>" target="_blank" rel="noopener noreferrer">영수증 보기</a>
            <% } else { %>
              <span>승인 완료 후 영수증이 제공됩니다.</span>
            <% } %>
          </div>

          <% if (order.refund) { %>
            <section class="parent-refund-status">
              <div><small>최근 환불 신청</small><strong><%= refundStatusLabels[order.refund.status] || order.refund.status %></strong></div>
              <p>신청 <%= formatDate(order.refund.requestedAt) %> · 처리기한 <%= formatDate(order.refund.processingDeadlineAt) %></p>
              <% if (order.refund.status === "CALCULATED") { %><p>산정 환불액 <strong><%= formatWon(order.refund.calculation?.calculatedAmount) %></strong></p><% } %>
              <% if (order.refund.status === "COMPLETED") { %><p>완료 환불액 <strong><%= formatWon(order.refund.decision?.approvedAmount) %></strong></p><% } %>
            </section>
          <% } %>

          <% if (order.isRefundable) { %>
            <details class="parent-refund-request">
              <summary>이 결제 환불 신청하기</summary>
              <form action="/parent/payments/<%= order.paymentId %>/refund" method="post">
                <label>
                  <span>환불 사유</span>
                  <select name="reasonType" required>
                    <option value="SIMPLE_CHANGE">단순 변심</option>
                    <option value="NOT_AS_DESCRIBED">상품 설명과 다름</option>
                    <option value="SERVICE_FAILURE">서비스 이용 문제</option>
                    <option value="OTHER">기타</option>
                  </select>
                </label>
                <label>
                  <span>상세 사유</span>
                  <textarea name="reasonDetail" minlength="10" maxlength="5000" rows="4" required placeholder="환불을 요청하는 이유를 10자 이상 작성해주세요."></textarea>
                </label>
                <p>환불 기준에 따라 운영자가 금액을 산정하며, 접수일로부터 3영업일 이내 처리를 원칙으로 합니다.</p>
                <button type="submit">환불 신청 접수</button>
              </form>
            </details>
          <% } %>
        </article>
      <% }) %>
    </section>
  </main>
</body>
</html>

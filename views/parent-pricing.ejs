<!doctype html>
<html lang="ko">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>패키지 구매 | Matths 학부모</title><link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" /><link rel="stylesheet" href="/css/brand.css" /><link rel="stylesheet" href="/css/parent.css" /></head>
  <body class="parent-page">
    <%- include('partials/parent-navigation', { activeParentPage: 'pricing' }) %>
    <main class="parent-main" id="parent-main">
      <header class="parent-page-heading"><p>패키지 구매하기</p><h1><%= child.realName || child.name %> 학생에게 필요한<br />이용권을 확인해 주세요.</h1><span>표시 금액과 이용 기간을 한눈에 비교할 수 있습니다.</span></header>
      <section class="parent-product-grid">
        <% products.forEach((product) => { const access = productAccess?.[product.code] || { purchaseAllowed: true }; %><article>
          <small><%= product.periodLabel %> 이용</small><h2><%= product.name %></h2><p><%= product.description %></p><strong><%= new Intl.NumberFormat('ko-KR').format(product.amount) %><em>원</em></strong>
          <section class="pricing-refund-summary"><b>환불 기준</b><p><%= product.refundPolicy.fullRefund %></p><p><%= product.refundPolicy.partialRefund %></p><code><%= product.refundPolicy.formula %></code></section>
          <% if (!access.purchaseAllowed) { %>
            <p class="parent-product-status"><%= access.active ? "현재 이용 중인 상품입니다." : "정리할 기존 학습권이 있습니다." %></p>
            <a href="<%= access.active ? '/parent' : '/parent/payments' %>"><%= product.code === 'MOCK_EXAM_ONLY' ? '자녀 모의고사 현황 보기' : '자녀 학습 현황 보기' %></a>
          <% } else if (checkoutEnabled) { %><a href="/parent/checkout/<%= product.code %>">결제하기</a><% } else { %><p class="parent-pg-note">온라인 결제 준비 중</p><% } %>
        </article><% }) %>
      </section>
      <% if (!checkoutEnabled) { %><p class="parent-pg-note">온라인 결제가 열리면 이 화면에서 결제할 수 있습니다.</p><% } %>
    </main>
  <%- include("partials/business-footer") %>
  </body>
</html>

<%
  const publicArenaContract =
    typeof contract !== "undefined" && contract
      ? contract
      : null;
%>
<% if (publicArenaContract) { %>
  <ul class="arena-contract" aria-label="GOAT Arena 핵심 규칙">
    <li data-arena-contract="ranked">
      <b>Ranked</b>
      <strong>학습일수를 예치하고 경기합니다.</strong>
      <span>패배하면 예치한 학습일수가 상대에게 이전될 수 있습니다.</span>
    </li>
    <li data-arena-contract="unranked">
      <b>Unranked</b>
      <strong><%= publicArenaContract.learningCycleDays %>일 이용 주기의 조건을 채우면 페이백을 신청합니다.</strong>
      <span>공격 출석 <%= publicArenaContract.minimumAttackParticipationDays %>일·페이백 점수·공정성 조건에 따라 결제액의 최대 <%= publicArenaContract.maximumPaybackRatePercent %>%를 지급받습니다.</span>
    </li>
  </ul>
<% } %>

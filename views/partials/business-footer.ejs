<% const footerPublicOrigin =
    typeof serviceUrls !== "undefined" && serviceUrls?.public
      ? String(serviceUrls.public).replace(/\/$/, "")
      : "";
  const footerPublicPath = (path) => `${footerPublicOrigin}${path}`;
%>
<footer class="business-site-footer">
  <div class="business-site-footer__inner">
    <div class="business-site-footer__top">
      <%- include("matths-brand", {
        href: "/",
        ariaLabel: "Matths 메인",
        className: "business-site-footer__brand",
        tone: "light",
      }) %>
      <nav class="business-site-footer__links" aria-label="하단 정책 및 고객지원">
        <a href="<%= footerPublicPath('/intro') %>">서비스 소개</a>
        <a href="<%= footerPublicPath('/curriculum') %>">교육과정</a>
        <a href="<%= footerPublicPath('/faq') %>">자주 묻는 질문</a>
        <a href="<%= footerPublicPath('/terms') %>">이용약관</a>
        <a href="<%= footerPublicPath('/privacy') %>">개인정보처리방침</a>
        <button type="button" class="business-site-footer__cookie-button" data-cookie-settings-open>쿠키 설정</button>
        <a href="<%= footerPublicPath('/contact') %>">문의하기</a>
      </nav>
    </div>

    <%- include("business-footer-details", { detailsClass: "business-site-footer__details" }) %>

    <div class="business-site-footer__bottom">
      <span>© <%= new Date().getFullYear() %> Matths. All rights reserved.</span>
      <%- include("social-footer-links") %>
    </div>
  </div>
</footer>

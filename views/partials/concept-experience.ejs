    </button>

    <button type="button" data-jump-to="concept-motion">
      <b>02</b>
      <span>모션그래픽</span>
    </button>

    <button type="button" data-jump-to="concept-playground">
      <b>03</b>
      <span>수학 놀이터</span>
    </button>

    <button type="button" data-jump-to="concept-practice">
      <b>04</b>
      <span>문제풀이</span>
    </button>
  </nav>

  <section
    class="experience-section explanation-section"
    id="concept-explanation"
  >
    <div class="experience-heading">
      <div>
        <p>STEP 01 · CONCEPT</p>
        <h3>먼저 개념을 이해합니다.</h3>
      </div>
      <span><%= isCommonMathExperience ? "핵심 기준부터 차례대로 정리합니다." : "공식보다 움직임을 먼저 봅니다." %></span>
    </div>

    <div class="concept-intro-card">
      <span aria-hidden="true"><%= experienceProfile.symbol %></span>

      <div>
        <p><%= lesson.summary %></p>
        <strong><%= lesson.keyTakeaway %></strong>
      </div>
    </div>

    <div class="concept-step-grid <%= isCommonMathExperience ? 'common-math-step-grid' : '' %>">
      <%
        const displayedConceptSteps = isCommonMathExperience
          ? [0, 2, 4].map((startIndex, groupIndex) => ({
              order: groupIndex + 1,
              title: ["기준 세우기", "원리 적용하기", "비교하고 검산하기"][groupIndex],
              description: (lesson.steps || [])
                .slice(startIndex, startIndex + 2)
                .map((step) => step.description)
                .filter(Boolean)
                .join(" "),
            }))
          : lesson.steps;
        displayedConceptSteps.forEach((step) => {
      %>
        <article>
          <span><%= isCommonMathExperience ? "PHASE" : "STEP" %> <%= String(step.order).padStart(2, "0") %></span>
          <h4><%= step.title %></h4>
          <p><%= step.description %></p>
        </article>
      <% }) %>
    </div>
  </section>

  <section
    class="experience-section motion-section"
    id="concept-motion"
  >
    <div class="experience-heading">
      <div>
        <p>STEP 02 · MOTION GRAPHIC</p>
        <h3><%= experienceProfile.motionTitle %></h3>
      </div>
      <span><%= experienceProfile.motionNote %></span>
    </div>

    <div class="motion-player">
      <div
        class="motion-stage <%= isCommonMathExperience ? 'common-math-motion-stage' : algebraGraphProfile || isProbabilityExperience || isAdvancedCalculusExperience ? 'algebra-motion-stage' : '' %>"
      >
        <% if (isCommonMathExperience) { %>
          <div class="common-math-motion-board" aria-label="<%= concept.title %>의 세 단계 학습 흐름">
            <div class="common-math-motion-formula">
              <span>핵심 관계</span>
              <strong><%= lesson.dashboardPreview?.formula || concept.title %></strong>
            </div>
            <div class="common-math-motion-flow">
              <% (lesson.dashboardPreview?.blocks || []).forEach((block, index) => { %>
                <article>
                  <b><%= String(index + 1).padStart(2, "0") %></b>
                  <strong><%= block.label %></strong>
                  <p><%= commonMathMotionDescriptions[index] || lesson.keyTakeaway %></p>
                </article>
                <% if (index < 2) { %><span aria-hidden="true">→</span><% } %>
              <% }) %>
            </div>
          </div>
        <% } else if (isAdvancedCalculusExperience) { %>
          <svg
            id="calculus-motion-visual"
            class="algebra-graph-svg calculus-motion-visual"
            viewBox="0 0 760 400"
            role="img"
            aria-label="<%= concept.title %>의 핵심 원리를 단계적으로 보여주는 시각화"
          ></svg>
        <% } else if (isProbabilityExperience) { %>
          <svg
            id="probability-motion-visual"
            class="algebra-graph-svg probability-motion-visual"
            viewBox="0 0 760 400"
            role="img"
            aria-label="<%= concept.title %>의 핵심 원리를 단계적으로 보여주는 시각화"
          ></svg>
        <% } else if (algebraGraphProfile) { %>
          <svg
            id="algebra-motion-graph"
            class="algebra-graph-svg algebra-motion-graph"
            viewBox="0 0 760 400"
            role="img"
            aria-label="<%= concept.title %>의 핵심 관계를 단계적으로 보여주는 그래프"
          ></svg>
        <% } else if (lesson.motion?.assetUrl) { %>
          <video
            id="concept-motion-video"
            controls
            playsinline
            preload="metadata"
            <% if (lesson.motion.posterUrl) { %>
              poster="<%= lesson.motion.posterUrl %>"
            <% } %>
          >
            <source
              src="<%= lesson.motion.assetUrl %>"
              type="video/mp4"
            />
          </video>
        <% } else { %>
          <canvas
            id="limit-opening-canvas"
            aria-label="<%= concept.title %> 개념 모션그래픽"
          ></canvas>

          <div
            class="motion-final-formula"
            id="motion-final-formula"
            aria-hidden="true"
          >
            <%= experienceProfile.motionFormula %>
          </div>
        <% } %>
      </div>

      <div class="motion-caption">
        <div>
          <small>NOW PLAYING</small>
          <strong id="motion-caption-text">
            <%= experienceProfile.initialCaption %>
          </strong>
        </div>

        <% if (isCommonMathExperience) { %>
          <span class="common-math-motion-caption">정의에서 검산까지 한 흐름으로 정리했습니다.</span>
        <% } else if (isAdvancedCalculusExperience) { %>
          <button id="replay-calculus-motion" type="button">
            처음부터 다시 보기
          </button>
        <% } else if (isProbabilityExperience) { %>
          <button id="replay-probability-motion" type="button">
            처음부터 다시 보기
          </button>
        <% } else if (algebraGraphProfile) { %>
          <button id="replay-algebra-motion" type="button">
            처음부터 다시 보기
          </button>
        <% } else if (!lesson.motion?.assetUrl) { %>
          <button id="replay-motion" type="button">
            처음부터 다시 보기
          </button>
        <% } %>
      </div>
    </div>
  </section>

  <section
    class="experience-section playground-section <%= isProbabilityExperience || isAdvancedCalculusExperience ? 'probability-playground-section' : '' %>"
    id="concept-playground"
  >
    <div class="experience-heading">
      <div>
        <p>STEP 03 · PLAYGROUND</p>
        <h3><%= experienceProfile.playgroundTitle %></h3>
      </div>
      <span><%= experienceProfile.playgroundNote %></span>
    </div>

    <% if (lesson.playgroundKey === "limit-intuition") { %>
    <div class="limit-lab">
      <aside class="lab-controls">
        <div>
          <p>그래프 상황</p>

          <div class="mode-buttons">
            <button
              type="button"
              class="active"
              data-limit-mode="hole"
            >
              구멍이 있는 함수
            </button>

            <button type="button" data-limit-mode="jump">
              좌우가 다른 함수
            </button>

            <button type="button" data-limit-mode="infinity">
              무한대로 가는 함수
            </button>
          </div>
        </div>

        <label>
          <span>
            접근하는 위치 a
            <output id="limit-a-output">1</output>
          </span>
          <input
            id="limit-a"
            type="range"
            min="-2"
            max="2"
            step="1"
            value="1"
          />
        </label>

        <label>
          <span>
            a에 가까워지는 정도
            <output id="limit-distance-output">0.20</output>
          </span>
          <input
            id="limit-distance"
            type="range"
            min="0"
            max="100"
            step="1"
            value="40"
          />
        </label>

        <label id="point-value-control">
          <span>
            실제 함수값 f(a)
            <output id="point-value-output">-2</output>
          </span>
          <input
            id="point-value"
            type="range"
            min="-4"
            max="4"
            step="1"
            value="-2"
          />
        </label>

        <button id="play-limit-approach" type="button">
          양쪽에서 접근시키기
        </button>

        <div class="lab-tip">
          <b>관찰 포인트</b>
          <p>
            f(a)를 바꿔도 주변의 함수값이 향하는 극한값은
            바뀌지 않는지 확인해 보세요.
          </p>
        </div>
      </aside>

      <div class="lab-visual">
        <div class="lab-formula">
          <span>현재 함수</span>
          <strong id="limit-formula"></strong>
        </div>

        <div class="limit-graph-wrap">
          <svg
            id="limit-graph"
            viewBox="0 0 720 430"
            role="img"
            aria-label="함수의 극한을 확인하는 좌표평면. 마우스 휠로 확대하거나 축소할 수 있습니다."
          ></svg>
          <span
            class="graph-zoom-status"
            aria-hidden="true"
          >
            휠 줌
            <output id="limit-zoom-output">100%</output>
          </span>
        </div>

        <div class="limit-readout">
          <div>
            <span>왼쪽 함수값</span>
            <strong id="left-limit-value">-</strong>
          </div>

          <div>
            <span>오른쪽 함수값</span>
            <strong id="right-limit-value">-</strong>
          </div>

          <div class="limit-verdict">
            <span>관찰 결과</span>
            <strong id="limit-verdict">-</strong>
          </div>
        </div>
      </div>
    </div>
    <% } else { %>
      <%- include(
        "concept-secondary-playground",
        {
          playgroundKey: lesson.playgroundKey,
          concept,
          lesson,
          algebraGraphProfile,
          isAdvancedCalculusExperience,
          calculusPlaygroundProfile,
          isProbabilityExperience,
          probabilityVisualKey:
            probabilityVisualKey,
          probabilityPlaygroundProfile
        }
      ) %>
    <% } %>
  </section>

  <section
    class="experience-section practice-section"
    id="concept-practice"
  >
    <div class="experience-heading">
      <div>
        <p>
          <%= reviewMode
            ? "STEP 04 · REVIEW RETRY"
            : "STEP 04 · PRACTICE"
          %>
        </p>
        <h3>
          <%= reviewMode
            ? "틀렸던 유형을 다시 풀어봅니다."
            : "서로 다른 유형으로 이해를 확인합니다."
          %>
        </h3>
      </div>
      <span>
        <%= reviewMode
          ? "한 문제를 정확히 맞히면 오답 복습이 완료됩니다."
          : "같은 유형을 반복해서 맞혀도 한 개로 계산합니다."
        %>
      </span>
    </div>

    <div class="practice-layout">
      <div class="practice-card">
        <div class="problem-meta">
          <span id="problem-type-label">문제를 준비하고 있습니다.</span>
          <b id="problem-number"></b>
        </div>

        <h4 id="problem-prompt" class="problem-prompt">
          잠시만 기다려주세요.
        </h4>

        <form id="problem-answer-form">
          <div id="problem-answer-area"></div>

          <button
            class="submit-answer"
            id="submit-answer"
            type="submit"
          >
            정답 확인
          </button>
        </form>

        <div
          class="problem-feedback"
          id="problem-feedback"
          aria-live="polite"
          hidden
        >
          <figure
            class="problem-coach-character"
            data-problem-coach-character
            hidden
            aria-hidden="true"
          >
            <img
              data-problem-coach-character-image
              src="/images/coach-characters/mild-goat-1.webp"
              alt=""
              draggable="false"
            />
          </figure>
          <div
            class="problem-feedback-copy"
            data-problem-feedback-copy
          ></div>
        </div>

        <button
          class="next-problem"
          id="next-problem"
          type="button"
          hidden
        >
          <%= reviewMode
            ? "같은 유형 다시 풀기 →"
            : "다음 유형 풀기 →"
          %>
        </button>

        <a
          class="review-return"
          id="review-return"
          href="/wrong-notes?status=completed"
          <%= reviewMode?.completed ? "" : "hidden" %>
        >
          오답노트로 돌아가기 →
        </a>
      </div>

      <aside class="mastery-card">
        <p>개념 학습 현황</p>
        <h4>완료 조건</h4>

        <strong>
          서로 다른 유형
          <em id="correct-type-count">
            <%= correctTypeIds.length %>
          </em>
          / <%= requiredTypes %>
        </strong>

        <div
          class="mastery-dots"
          id="mastery-dots"
          aria-label="유형별 정답 진행도"
        >
          <% for (let index = 0; index < requiredTypes; index += 1) { %>
            <i class="<%= index < correctTypeIds.length ? 'done' : '' %>">
              <%= index < correctTypeIds.length ? "✓" : index + 1 %>
            </i>
          <% } %>
        </div>

        <label
          class="concept-complete-toggle <%= gateUnlocked ? 'unlocked' : 'locked' %>"
          id="concept-complete-label"
        >
          <input
            id="concept-complete-checkbox"
            type="checkbox"
            <%= gateUnlocked ? "" : "disabled" %>
            <%= gate.userCompleted ? "checked" : "" %>
          />

          <span aria-hidden="true"></span>

          <div>
            <strong>이 개념 학습 완료</strong>
            <small id="completion-message">
              <%= gateUnlocked
                ? "완료 표시를 선택하거나 취소할 수 있습니다."
                : `${requiredTypes - correctTypeIds.length}개의 새로운 유형을 더 맞혀야 합니다.`
              %>
            </small>
          </div>
        </label>

        <p class="mastery-notice">
          문제를 풀어 잠금을 해제한 기록은 체크를 취소해도
          사라지지 않습니다.
        </p>
      </aside>
    </div>
  </section>
</div>

<script
  id="concept-experience-config"
  type="application/json"
><%- clientConfig %></script>

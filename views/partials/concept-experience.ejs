    "algebra-01-05": "\\(\\log N\\)",
    "algebra-01-06": "\\(a^x\\)",
    "algebra-01-07": "\\(y=a^x\\)",
    "algebra-01-08": "\\(a^x=b\\)",
    "algebra-02-01": "\\(\\theta\\)",
    "algebra-02-02": "\\(\\sin x\\)",
    "algebra-02-03": "\\(a^2\\)",
    "algebra-03-01": "\\(a_n\\)",
    "algebra-03-02": "\\(a_n\\)",
    "algebra-03-03": "\\(a_1r^{n-1}\\)",

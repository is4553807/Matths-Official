    motionStageLabels:
      lesson.clientMotionStageLabels ||
      (lesson.steps || []).map(
        (step) => step.title
      ),
    requiredDistinctTypes: requiredTypes,
    initialMastery: {
      correctTypeIds,
      unlocked: gateUnlocked,
      userCompleted: Boolean(gate.userCompleted),
    },
    review: reviewMode
      ? {
          attemptId: reviewMode.attemptId,
          typeId: reviewMode.typeId,
          status: reviewMode.status,
          completed: Boolean(reviewMode.completed),

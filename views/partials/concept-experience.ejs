%>

<div class="concept-experience">
  <% if (reviewMode) { %>
    <section
      class="review-mode-banner <%= reviewMode.completed ? 'completed' : '' %>"
      id="review-mode-banner"
      aria-labelledby="review-mode-title"
    >
      <span class="review-mode-icon" aria-hidden="true">
        <%= reviewMode.completed ? "✓" : "↻" %>
      </span>

      <div>
        <p>WRONG NOTE REVIEW</p>
        <strong id="review-mode-title">
          <%= reviewMode.completed
            ? "이미 복습을 완료한 오답입니다."
            : "이 오답의 복습을 시작합니다."
          %>
        </strong>
        <small id="review-mode-message">
          <%= reviewMode.completed
            ? "원한다면 같은 유형을 다시 풀어볼 수 있습니다."
            : "시각 풀이를 확인하고 같은 유형 1문제를 맞히면 자동으로 복습 완료됩니다."
          %>
        </small>
      </div>

      <button
        type="button"
        data-jump-to="concept-practice"
      >
        <%= reviewMode.completed
          ? "다시 풀어보기"
          : "재도전 문제로 이동"
        %>
      </button>
    </section>
  <% } %>


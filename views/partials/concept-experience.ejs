  const algebraGraphProfile =
    algebraGraphProfiles[concept.id] || null;

  const experienceProfile = isAlgebraExperience
    ? {
        symbol:
          algebraSymbols[concept.id] ||
          "\\(x\\)",
        motionTitle:
          algebraGraphProfile?.explanationTitle ||
          `${concept.title}의 핵심 관계가 완성되는 장면을 봅니다.`,
        motionNote:
          algebraGraphProfile?.explanationNote ||
          "정의, 성질, 계산이 연결되는 순서를 확인합니다.",
        motionFormula:
          lesson.dashboardPreview?.formula ||
          concept.title,
        initialCaption:
          lesson.steps?.[0]?.description ||
          "핵심 정의를 먼저 확인합니다.",
        playgroundTitle:
          algebraGraphProfile?.playgroundTitle ||
          `${concept.title}: 값을 바꾸며 확인합니다.`,
        playgroundNote:
          algebraGraphProfile?.playgroundNote ||
          "값을 조절하고 계산 단계를 한 장씩 확인해보세요.",
      }
    : experienceProfiles[lesson.playgroundKey] ||
      experienceProfiles["limit-intuition"];

  const clientConfig = JSON.stringify({
    courseId: course.id,
    unitId: unit.id,
    conceptId: concept.id,
    playgroundKey: lesson.playgroundKey,
    conceptTitle: concept.title,
    algebraGraphKey:
      algebraGraphProfile?.key || null,
    motionCaptions:
      lesson.clientMotionCaptions ||
      (lesson.steps || []).map(
        (step) => step.description

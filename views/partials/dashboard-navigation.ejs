<%
  const dashboardAssetVersion = encodeURIComponent(
    typeof assetVersion === "string" && assetVersion
      ? assetVersion
      : "dev"
  );
  const currentDashboardPage =
    typeof activePage === "string"
      ? activePage
      : "";
  const navigationData =
    typeof data !== "undefined" && data
      ? data
      : {};
  const navigationStats =
    navigationData.stats || {};
  const wrongNoteStats =
    typeof stats !== "undefined" && stats
      ? stats
      : {};
  const completedConceptCount =
    Number(navigationData.completedConcepts);
  const pendingReviewCount =
    Number(
      wrongNoteStats.due ??
        navigationStats.pendingReviewCount
    );
  const dashboardNavIcon = (name) => {
    const paths = {
      home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5 10.5V20h5v-6h4v6h5v-9.5"/>',
      book: '<path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v18H7.5A3.5 3.5 0 0 0 4 23.5Z"/><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v18h3.5a3.5 3.5 0 0 1 3.5 3.5Z"/>',
      school: '<path d="M3 21h18"/><path d="M5 21V9l7-4 7 4v12"/><path d="M9 21v-5h6v5"/><path d="M8 11h.01M12 11h.01M16 11h.01"/>',
      graduation: '<path d="m2 10 10-5 10 5-10 5Z"/><path d="M6 12.5V17c3.5 2.5 8.5 2.5 12 0v-4.5"/><path d="M22 10v6"/>',
      timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 1.5M9 2h6"/>',
      clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M8.5 13l2 2 5-5"/>',
      notebook: '<path d="M6 3h12a2 2 0 0 1 2 2v16H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M8 3v18M12 8h5M12 12h3M16.5 17.5l3-3"/>',
      swords: '<path d="m14.5 5.5 4-4 1 3 3 1-4 4M13 7l4 4"/><path d="m9.5 5.5-4-4-1 3-3 1 4 4M11 7l-7 7 3 3 7-7M15 14l2 2-3 3-2-2"/>',
      store: '<path d="M4 10v11h16V10"/><path d="M3 10h18l-2-6H5Z"/><path d="M8 14h8v7"/>',
      message: '<path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/><path d="M12 7v8M8 11h8"/>',
      shield: '<path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z"/><path d="M12 8v8M8 12h8"/>',
    };
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name] || paths.home}</svg>`;
  };
  const dashboardNavigationItems = [
    {
      id: "main",
      href: "/main",
      icon: dashboardNavIcon("home"),
      label: "학습 홈",
    },
    {
      id: "my-learning",
      href: "/my-learning",
      icon: dashboardNavIcon("book"),
      label: "내 학습",
      badge:
        Number.isFinite(completedConceptCount)
          ? completedConceptCount
          : null,
    },
    {
      id: "curriculum",
      href: "/log-curriculum",
      icon: dashboardNavIcon("graduation"),
      label: "교육과정",
    },
    {
      id: "quick-practice",
      href: "/quick-practice",
      icon: dashboardNavIcon("timer"),
      label: "40초 눈풀이",
    },
    {
      id: "assessments",
      href: "/assessments",
      icon: dashboardNavIcon("clipboard"),
      label: "평가 센터",
    },
    {
      id: "wrong-notes",
      href: "/wrong-notes",
      icon: dashboardNavIcon("notebook"),
      label: "오답 노트",
      badge:
        Number.isFinite(pendingReviewCount) &&
        pendingReviewCount > 0
          ? pendingReviewCount
          : null,
    },
    {
      id: "war-of-masters",
      href: "/war-of-masters",
      icon: dashboardNavIcon("swords"),
      label: "GOAT Arena",
    },
    {
      id: "store",
      href: "/store",
      icon: dashboardNavIcon("store"),
      label: "고2·고3 수험관",
    },
    {
      id: "coach-suggestions",
      href: "/coach-suggestions",
      icon: dashboardNavIcon("message"),
      label: "문구 제안소",
    },
  ];
  const navigationUser =
    typeof user !== "undefined"
      ? user
      : null;
  const showAcademyNavigation =
    typeof academyMembershipAvailable !== "undefined"
      ? academyMembershipAvailable === true
      : navigationUser?.hasAcademyMembership === true;

  if (
    navigationUser?.role === "admin"
  ) {
    dashboardNavigationItems.push({
      id: "admin",
      href: "/admin",
      icon: dashboardNavIcon("shield"),
      label: "관리자",
    });
  }

  if (showAcademyNavigation) {
    dashboardNavigationItems.splice(2, 0, {
      id: "my-academy",
      href: "/my-academy",
      icon: dashboardNavIcon("school"),
      label: "학원",
    });
  }
%>
<link rel="stylesheet" href="/css/matths-theme.css?v=<%= dashboardAssetVersion %>" />
<link rel="stylesheet" href="/css/contrast.css?v=<%= dashboardAssetVersion %>" />

<nav class="side-nav" aria-label="대시보드 메뉴" data-tutorial-target="dashboard-navigation">
  <p>LEARNING</p>
  <% dashboardNavigationItems.forEach((item) => { %>
    <% const isActive = item.id === currentDashboardPage; %>
    <a
      class="<%= isActive ? 'active' : '' %>"
      href="<%= item.href %>"
      aria-label="<%= item.label %>"
      title="<%= item.label %>"
      data-tutorial-nav="<%= item.id %>"
      <%- isActive ? 'aria-current="page"' : "" %>
    >
      <span class="nav-icon" aria-hidden="true"><%- item.icon %></span>
      <span><%= item.label %></span>
      <% if (item.badge !== null && item.badge !== undefined) { %>
        <b
          <%- item.id === "my-learning"
            ? 'id="completed-concept-badge"'
            : "" %>
        ><%= item.badge %></b>
      <% } %>
    </a>
  <% }) %>
</nav>
<script src="/js/navigation-performance.js?v=<%= dashboardAssetVersion %>" defer></script>
<script src="/js/session-usage.js?v=<%= dashboardAssetVersion %>" defer></script>

<%
  const dashboardAssetVersion = encodeURIComponent(
    typeof assetVersion === "string" && assetVersion
      ? assetVersion
      : "dev"
  );
  const currentDashboardPage =
    typeof activePage === "string"
      ? activePage
      : "";
  const navigationData =
    typeof data !== "undefined" && data
      ? data
      : {};
  const navigationStats =
    navigationData.stats || {};
  const wrongNoteStats =
    typeof stats !== "undefined" && stats
      ? stats
      : {};
  const completedConceptCount =
    Number(navigationData.completedConcepts);
  const pendingReviewCount =
    Number(
      wrongNoteStats.due ??
        navigationStats.pendingReviewCount
    );
  const dashboardNavIcon = (name) => {
    const paths = {
      home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
      book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
      school: '<path d="M14 22v-4a2 2 0 1 0-4 0v4"/><path d="m18 10 3.447 1.724a1 1 0 0 1 .553.894V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7.382a1 1 0 0 1 .553-.894L6 10"/><path d="M18 5v17"/><path d="m4 6 7.106-3.553a2 2 0 0 1 1.788 0L20 6"/><path d="M6 5v17"/><circle cx="12" cy="9" r="2"/>',
      graduation: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
      timer: '<line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/>',
      clipboard: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
      notebook: '<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"/><path d="M2 6h4"/><path d="M2 10h4"/><path d="M2 14h4"/><path d="M2 18h4"/><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/>',
      swords: '<polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" x2="19" y1="19" y2="13"/><line x1="16" x2="20" y1="16" y2="20"/><line x1="19" x2="21" y1="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" x2="9" y1="14" y2="18"/><line x1="7" x2="4" y1="17" y2="20"/><line x1="3" x2="5" y1="19" y2="21"/>',
      store: '<path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"/>',
      message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M12 7v6"/><path d="M9 10h6"/>',
      shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
    };
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name] || paths.home}</svg>`;
  };
  const dashboardNavigationItems = [
    {
      id: "main",
      href: "/main",
      icon: dashboardNavIcon("home"),
      label: "학습 홈",
    },
    {
      id: "my-learning",
      href: "/my-learning",
      icon: dashboardNavIcon("book"),
      label: "내 학습",
      badge:
        Number.isFinite(completedConceptCount) &&
        completedConceptCount > 0
          ? completedConceptCount
          : null,
    },
    {
      id: "curriculum",
      href: "/log-curriculum",
      icon: dashboardNavIcon("graduation"),
      label: "교육과정",
    },
    {
      id: "quick-practice",
      href: "/quick-practice",
      icon: dashboardNavIcon("timer"),
      label: "40초 눈풀이",
    },
    {
      id: "assessments",
      href: "/assessments",
      icon: dashboardNavIcon("clipboard"),
      label: "평가 센터",
    },
    {
      id: "wrong-notes",
      href: "/wrong-notes",
      icon: dashboardNavIcon("notebook"),
      label: "오답 노트",
      badge:
        Number.isFinite(pendingReviewCount) &&
        pendingReviewCount > 0
          ? pendingReviewCount
          : null,
    },
    {
      id: "war-of-masters",
      href: "/war-of-masters",
      icon: dashboardNavIcon("swords"),
      label: "GOAT Arena",
    },
    {
      id: "store",
      href: "/store",
      icon: dashboardNavIcon("store"),
      label: "고2·고3 수험관",
    },
    {
      id: "coach-suggestions",
      href: "/coach-suggestions",
      icon: dashboardNavIcon("message"),
      label: "문구 제안소",
    },
  ];
  const navigationUser =
    typeof user !== "undefined"
      ? user
      : null;
  const showAcademyNavigation =
    typeof academyMembershipAvailable !== "undefined"
      ? academyMembershipAvailable === true
      : navigationUser?.hasAcademyMembership === true;

  if (
    navigationUser?.role === "admin"
  ) {
    dashboardNavigationItems.push({
      id: "admin",
      href: "/admin",
      icon: dashboardNavIcon("shield"),
      label: "관리자",
    });
  }

  if (showAcademyNavigation) {
    dashboardNavigationItems.splice(2, 0, {
      id: "my-academy",
      href: "/my-academy",
      icon: dashboardNavIcon("school"),
      label: "학원",
    });
  }
%>
<nav class="side-nav" aria-label="대시보드 메뉴" data-tutorial-target="dashboard-navigation">
  <p>LEARNING</p>
  <% dashboardNavigationItems.forEach((item) => { %>
    <% const isActive = item.id === currentDashboardPage; %>
    <a
      class="<%= isActive ? 'active' : '' %>"
      href="<%= item.href %>"
      aria-label="<%= item.label %>"
      title="<%= item.label %>"
      data-tutorial-nav="<%= item.id %>"
      <%- isActive ? 'aria-current="page"' : "" %>
    >
      <span class="nav-icon" aria-hidden="true"><%- item.icon %></span>
      <span><%= item.label %></span>
      <% if (item.badge !== null && item.badge !== undefined) { %>
        <b
          <%- item.id === "my-learning"
            ? 'id="completed-concept-badge"'
            : "" %>
        ><%= item.badge %></b>
      <% } %>
    </a>
  <% }) %>
</nav>
<script src="/js/navigation-performance.js?v=<%= dashboardAssetVersion %>" defer></script>
<script src="/js/session-usage.js?v=<%= dashboardAssetVersion %>" defer></script>

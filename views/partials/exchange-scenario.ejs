<% const futures = kind === "futures"; %>
<section class="panel scenario-panel" id="exchange-scenario" data-scenario-chart="<%= kind %>"
  data-scenario-state="<%= JSON.stringify(scenario) %>" aria-labelledby="scenario-heading" <%= scenario ? "" : "hidden" %>>
  <header class="panel-heading">
    <h2 id="scenario-heading"><%= futures ? "시뮬레이션 선물 체결" : "시뮬레이션 MPI" %></h2>
    <span class="scenario-tag">자동화 시나리오</span>
  </header>
  <p class="scenario-note"><%= futures
    ? "자동화 계정 간 모의 체결입니다. 실제 주문장, 거래량, TP 잔액과 별도로 표시합니다."
    : "가상 모의고사 성적으로 계산한 지수입니다. 공식 MPI와 만기 정산은 실제 유효 응시 성적을 사용합니다." %></p>
  <dl class="scenario-metrics">
    <div><dt><%= futures ? "최근 모의 체결가" : "시뮬레이션 MPI" %></dt><dd data-scenario-value>—</dd></div>
    <div><dt><%= futures ? "모의 거래량" : "가상 응시 인원" %></dt><dd data-scenario-count>—</dd></div>
    <div><dt><%= futures ? "최근 모의 체결 · KST" : "최근 가상 응시 · KST" %></dt><dd data-scenario-at>—</dd></div>
  </dl>
  <%- include("exchange-chart-controls", { intervals, activeInterval: "1h" }) %>
  <output class="candle-summary" data-candle-summary aria-label="시뮬레이션 캔들 요약"></output>
  <div class="chart-area">
    <canvas role="img" aria-label="<%= futures ? "시뮬레이션 선물 체결 캔들" : "시뮬레이션 MPI 캔들" %>"></canvas>
    <div class="chart-empty" data-scenario-empty <%= scenario?.candles.length ? "hidden" : "" %>>
      <strong><%= futures ? "첫 모의 체결을 기다리는 중" : "첫 가상 응시를 기다리는 중" %></strong>
    </div>
  </div>
  <% if (futures) { %><ol class="scenario-trades" data-scenario-trades aria-label="최근 모의 체결" hidden></ol><% } %>
</section>

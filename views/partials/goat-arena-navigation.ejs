<%
  const arenaAssetVersion = encodeURIComponent(
    typeof assetVersion === "string" && assetVersion
      ? assetVersion
      : "dev"
  );
  const arenaNotificationState =
    typeof arenaNotifications !== "undefined"
      ? arenaNotifications
      : null;
  const arenaNavigationItems = [
    {
      key: "home",
      label: "홈",
      ariaLabel: "GOAT Arena 홈",
      href: "/goat-arena",
    },
    {
      key: "sub",
      label: "일반전",
      ariaLabel: "GOAT Arena 일반전",
      href: "/goat-arena/sub",
      alertCount: arenaNotificationState?.actionByDivision?.SUB || arenaNotificationState?.defenseByDivision?.SUB || 0,
    },
    {
      key: "main",
      label: "경쟁전",
      ariaLabel: "GOAT Arena 경쟁전",
      href: "/goat-arena/main",
      alertCount: arenaNotificationState?.actionByDivision?.MAIN || arenaNotificationState?.defenseByDivision?.MAIN || 0,
    },
    {
      key: "friends",
      label: "친구",
      ariaLabel: "GOAT Arena 친구와 친선전",
      href: "/goat-arena/friends",
    },
    {
      key: "rules",
      label: "경기 규정",
      ariaLabel: "GOAT Arena 경기 규정",
      href: "/goat-arena/rules",
    },
  ];
%>
<header class="arena-hud">
  <%- include("matths-brand", {
    href: "/goat-arena",
    ariaLabel: "GOAT Arena 홈",
    className: "arena-brand",
    suffix: "GOAT ARENA",
    tone: "light",
    compact: true,
  }) %>

  <nav
    class="arena-main-navigation"
    aria-label="GOAT Arena 메뉴"
    data-arena-tutorial-target="navigation"
  >
    <% arenaNavigationItems.forEach((item) => { %>
      <a
        class="<%= activeArenaPage === item.key ? 'active' : '' %>"
        href="<%= item.href %>"
        aria-label="<%= item.ariaLabel %>"
        data-arena-tutorial-nav="<%= item.key %>"
        <%= activeArenaPage === item.key ? 'aria-current="page"' : '' %>
      ><%= item.label %><% if (item.alertCount) { %><span class="arena-nav-alert-dot" aria-label="확인할 경기 <%= item.alertCount %>개"></span><% } %></a>
    <% }) %>
  </nav>

  <div class="arena-account">
    <a
      class="arena-dashboard-link"
      href="/main"
    >Matths 대시보드</a>
    <div class="arena-mailbox <%= activeArenaPage === 'mailbox' ? 'active' : '' %>" data-arena-mailbox>
      <button
        class="arena-mailbox-button"
        type="button"
        aria-label="GOAT Arena 우편함<%= arenaNotificationState?.unreadCount ? `, 읽지 않은 알림 ${arenaNotificationState.unreadCount}개` : '' %>"
        aria-expanded="false"
        data-arena-mailbox-toggle
      >
        <span aria-hidden="true">✉</span>
        <% if (arenaNotificationState?.unreadCount) { %><b><%= arenaNotificationState.unreadCount > 99 ? "99+" : arenaNotificationState.unreadCount %></b><% } %>
      </button>
      <section class="arena-mailbox-panel" aria-label="최근 알림" hidden data-arena-mailbox-panel>
        <header><strong>우편함</strong><a href="/goat-arena/mailbox">전체 보기</a></header>
        <% if (!arenaNotificationState?.notifications?.length) { %>
          <p>도착한 알림이 없습니다.</p>
        <% } %>
        <% arenaNotificationState?.notifications?.forEach((notification) => { %>
          <a class="arena-mailbox-item <%= notification.unread ? 'is-unread' : '' %> <%= notification.tone ? `is-${notification.tone}` : '' %>" href="<%= notification.href %>">
            <strong><%= notification.title %></strong>
            <span><%= notification.message %></span>
          </a>
        <% }) %>
      </section>
    </div>
    <a
      class="arena-player <%= activeArenaPage === 'profile' ? 'active' : '' %>"
      href="/goat-arena/profile"
      data-arena-tutorial-nav="profile"
      aria-label="<%= arenaUser.nickname %>님의 GOAT Arena 프로필, 활동 레벨 <%= arenaUser.activityLevel?.level || 1 %>"
      <%= activeArenaPage === "profile" ? 'aria-current="page"' : '' %>
    >
      <span class="arena-avatar-unit arena-avatar-unit--nav" aria-hidden="true">
        <span class="arena-avatar-frame">
          <img src="<%= arenaUser.avatar?.imageSrc || '/images/arena-avatars/nova-goat.svg' %>" alt="" />
        </span>
        <span class="arena-level-plate">
          <small>LV</small>
          <b><%= String(arenaUser.activityLevel?.level || 1).padStart(2, "0") %></b>
        </span>
      </span>
      <strong>
        <%= arenaUser.nickname %>
      </strong>
    </a>
  </div>
</header>
<%- include("arena-tutorial") %>
<script src="/js/navigation-performance.js?v=<%= arenaAssetVersion %>" defer></script>
<script src="/js/session-usage.js?v=<%= arenaAssetVersion %>" defer></script>
<script src="/js/goat-arena-navigation.js?v=<%= arenaAssetVersion %>" defer></script>
<script src="/js/arena-tutorial.js?v=<%= arenaAssetVersion %>" defer></script>

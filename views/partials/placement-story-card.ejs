<%
  const storyTierAssets = {
    "브론즈": "bronze",
    "실버": "silver",
    "골드": "gold",
    "플래티넘": "platinum",
    "에메랄드": "emerald",
    "다이아몬드": "diamond",
    "마스터": "master",
    "그랜드마스터": "grandmaster",
    "챌린저": "challenger",
  };
  const storyTier = String(placementResult.initialTier || "배치 완료");
  const storyTopPercent =
    placementResult.estimatedTopPercent !== null &&
    placementResult.estimatedTopPercent !== undefined
      ? Number(placementResult.estimatedTopPercent)
      : placementResult.percentile !== null &&
          placementResult.percentile !== undefined
        ? Math.max(
            0,
            Math.round(
              (100 - Number(placementResult.percentile)) * 10
            ) / 10
          )
        : null;
  const storyEstimatedRankPopulation = Number(
    placementResult.estimatedRankPopulation || 10000
  );
  const storyEstimatedRank = Number(
    placementResult.estimatedRank ||
      Math.max(
        1,
        Math.ceil(
          (Number(storyTopPercent || 0) / 100) *
            storyEstimatedRankPopulation
        )
      )
  );
  const storyCohortSize = Number(placementResult.cohortSize || 0);
  const storyCohortRank = Number(placementResult.cohortRank || 0);
  const storyActualRankMinimumCohortSize = Number(
    placementResult.actualRankMinimumCohortSize || 100
  );
  const placementStoryConfig = {
    nickname: String(learner.name || "Matths Learner").slice(0, 30),
    tier: storyTier,
    tierAsset: storyTierAssets[storyTier] || "bronze",
    correctCount: Number(placementTotalCorrect || 0),
    totalCount: 30,
    topPercent: storyTopPercent,
    estimatedRankPopulation: storyEstimatedRankPopulation,
    estimatedRank: storyEstimatedRank,
    cohortSize: storyCohortSize,
    cohortRank: storyCohortRank,
    actualRankPublished:
      storyCohortSize >= storyActualRankMinimumCohortSize &&
      storyCohortRank > 0,
    positionBasis: String(placementResult.positionBasis || ""),
    estimatedTopPercentMin: placementResult.estimatedTopPercentMin,
    estimatedTopPercentMax: placementResult.estimatedTopPercentMax,
  };
%>
<section class="placement-story-section" aria-labelledby="placement-story-title">
  <div class="placement-story-preview">
    <canvas
      id="placement-story-canvas"
      width="1080"
      height="1920"
      role="img"
      aria-label="<%= placementStoryConfig.nickname %>님의 <%= placementStoryConfig.tier %> 배치 결과 인스타그램 스토리 카드"
    ></canvas>
  </div>
  <div class="placement-story-copy">
    <p>INSTAGRAM STORY · 9:16</p>
    <h2 id="placement-story-title">내 첫 티어를<br />스토리로 공유하세요.</h2>
    <span>공개 닉네임, 최초 티어, 정답 수와 10,000명 기준 예상 순위를 담은 1080 × 1920 PNG를 기기에서 바로 만듭니다.</span>
    <button type="button" id="placement-story-download" disabled>
      스토리 이미지 다운로드
      <span aria-hidden="true">↓</span>
    </button>
    <small id="placement-story-status" role="status" aria-live="polite">스토리 카드를 준비하고 있습니다.</small>
  </div>
</section>
<script id="placement-story-config" type="application/json"><%- JSON.stringify(placementStoryConfig).replace(/</g, "\\u003c") %></script>

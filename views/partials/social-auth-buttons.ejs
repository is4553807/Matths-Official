<%
  const providers = Array.isArray(socialAuthProviders) ? socialAuthProviders : [];
  const type = typeof accountType === "string" ? accountType : "student";
  const socialInvite = typeof inviteToken === "string" ? inviteToken : "";
  const socialFlow = typeof registrationFlow === "string" ? registrationFlow : "";
  const socialNext = typeof next === "string" ? next : "";
  const enabled = key => { const p = providers.find(p => p.key === key); return key === "apple" ? p?.webConfigured === true : p?.configured === true; };
  const authHref = key => {
    if (!enabled(key)) return "#";
    const params = new URLSearchParams();
    if (type !== "student") params.set("accountType", type);
    if (socialInvite) params.set("invite", socialInvite);
    if (socialFlow === "staff") params.set("path", "staff");
    if (socialNext) params.set("next", socialNext);
    return `/auth/${key}${params.size ? "?" + params : ""}`;
  };
%>
<div class="social-auth" aria-label="소셜 로그인">
  <div class="social-auth-divider"><span>또는</span></div>
  <div class="social-auth-buttons">
    <% if (type !== "admin") { %><a class="social-auth-button is-apple<%= enabled('apple') ? '' : ' is-disabled' %>" data-social-provider="apple" href="<%= authHref('apple') %>" aria-disabled="<%= !enabled('apple') %>" tabindex="<%= enabled('apple') ? 0 : -1 %>"><svg class="social-auth-apple-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.79 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.1l.01-.01zM12.03 7.25C11.88 5.02 13.69 3.18 15.77 3c.29 2.58-2.34 4.5-3.74 4.25z" /></svg>Apple로 계속하기</a><% } %>
    <% [['google', 'Google', '/images/google-g-logo.svg'], ['kakao', '카카오', '/images/kakao-login-mark.svg']].forEach(([key, label, icon]) => { %><a class="social-auth-button is-<%= key %><%= enabled(key) ? '' : ' is-disabled' %>" data-social-provider="<%= key %>" href="<%= authHref(key) %>" aria-disabled="<%= !enabled(key) %>" tabindex="<%= enabled(key) ? 0 : -1 %>"><img class="social-auth-<%= key %>-mark" src="<%= icon %>" alt="" width="20" height="20" aria-hidden="true" /><%= label %>로 계속하기</a><% }) %>
  </div>
  <% if (providers.some(p => p.key === 'apple' ? type !== 'admin' && !p.webConfigured : !p.configured)) { %><small class="social-auth-guide">운영 키가 설정되지 않은 로그인 방식은 아직 사용할 수 없습니다.</small><% } %>
</div>

<%
  const currentStep =
    typeof step !== "undefined" ? step : "request";
  const formError =
    typeof error !== "undefined" ? error : null;
  const emailValue =
    typeof email !== "undefined" ? email : "";
  const developmentCode =
    typeof previewCode !== "undefined" ? previewCode : null;
  const stepCopy = {
    request: {
      kicker: "비밀번호 찾기",
      title: "이메일을 확인할게요.",
      description: "가입한 이메일로 6자리 인증코드를 보내드립니다.",
    },
    verify: {
      kicker: "이메일 인증",
      title: "인증코드를 입력하세요.",
      description: "인증코드는 발송 후 10분 동안 유효합니다.",
    },
    reset: {
      kicker: "새 비밀번호",
      title: "비밀번호를 다시 설정하세요.",
      description: "영문과 숫자를 포함해 8자 이상 입력해주세요.",
    },
  }[currentStep];
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="이메일 인증코드로 Matths 비밀번호를 재설정합니다." />
    <title>비밀번호 재설정 | Matths</title>
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/matths-theme.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/auth.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#auth-form">비밀번호 재설정 폼으로 이동</a>
    <header class="auth-header">
      <a class="auth-brand" href="/" aria-label="Matths 메인 페이지">
        <span class="brand-mark" aria-hidden="true">M</span>
        <strong>Matths</strong>
      </a>
      <nav aria-label="인증 페이지 메뉴">
        <span>비밀번호가 기억났나요?</span>
        <a href="/login">로그인</a>
      </nav>
    </header>

    <main class="auth-layout reset-layout">
      <section class="auth-visual" aria-labelledby="visual-title">
        <div class="visual-copy">
          <p>SECURE RESET</p>
          <h1 id="visual-title">
            인증코드는 짧게,<br />
            새 비밀번호는<br />
            <strong>오래 안전하게.</strong>
          </h1>
          <span>인증코드는 암호화된 형태로 저장되며 10분 뒤 자동으로 만료됩니다.</span>
        </div>
        <div class="reset-steps" aria-label="재설정 순서">
          <span class="<%= currentStep === "request" ? "active" : "" %>"><b>01</b> 이메일 확인</span>
          <span class="<%= currentStep === "verify" ? "active" : "" %>"><b>02</b> 코드 인증</span>
          <span class="<%= currentStep === "reset" ? "active" : "" %>"><b>03</b> 비밀번호 변경</span>
        </div>
      </section>

      <section class="auth-panel" id="auth-form" aria-labelledby="reset-title">
        <div class="auth-panel-inner">
          <div class="auth-heading">
            <p><%= stepCopy.kicker %></p>
            <h2 id="reset-title"><%= stepCopy.title %></h2>
            <span><%= stepCopy.description %></span>
          </div>

          <% if (formError) { %>
            <div class="form-alert" role="alert">
              <span aria-hidden="true">!</span>
              <p><%= formError %></p>
            </div>
          <% } %>

          <% if (developmentCode) { %>
            <div class="form-alert form-alert-preview" role="status">
              <span aria-hidden="true">⌘</span>
              <p>로컬 개발용 인증코드: <strong><%= developmentCode %></strong><br />운영 환경에서는 이메일로만 발송됩니다.</p>
            </div>
          <% } %>

          <% if (currentStep === "request") { %>
            <form class="auth-form" action="/forgot-password" method="POST">
              <div class="form-field">
                <label for="email">가입 이메일</label>
                <input id="email" name="email" type="email" value="<%= emailValue %>" autocomplete="email" placeholder="student@example.com" required />
              </div>
              <button class="submit-button" type="submit">인증코드 받기 <span aria-hidden="true">→</span></button>
            </form>
          <% } %>

          <% if (currentStep === "verify") { %>
            <form class="auth-form" action="/forgot-password/verify" method="POST">
              <input type="hidden" name="email" value="<%= emailValue %>" />
              <div class="form-field">
                <label for="reset-email">인증 이메일</label>
                <input id="reset-email" type="email" value="<%= emailValue %>" disabled />
              </div>
              <div class="form-field">
                <label for="code">6자리 인증코드</label>
                <input class="verification-code" id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="000000" required />
              </div>
              <button class="submit-button" type="submit">코드 확인 <span aria-hidden="true">→</span></button>
            </form>
            <form class="reset-resend" action="/forgot-password" method="POST">
              <input type="hidden" name="email" value="<%= emailValue %>" />
              <button type="submit">인증코드 다시 받기</button>
            </form>
          <% } %>

          <% if (currentStep === "reset") { %>
            <form class="auth-form" action="/forgot-password/reset" method="POST">
              <div class="form-field">
                <label for="password">새 비밀번호</label>
                <div class="password-field">
                  <input id="password" name="password" type="password" minlength="8" autocomplete="new-password" placeholder="영문과 숫자를 포함한 8자 이상" required />
                  <button type="button" data-password-toggle="password" aria-label="비밀번호 표시" aria-pressed="false">보기</button>
                </div>
              </div>
              <div class="form-field">
                <label for="passwordConfirm">새 비밀번호 확인</label>
                <div class="password-field">
                  <input id="passwordConfirm" name="passwordConfirm" type="password" minlength="8" autocomplete="new-password" placeholder="새 비밀번호를 다시 입력하세요" required />
                  <button type="button" data-password-toggle="passwordConfirm" aria-label="비밀번호 확인 표시" aria-pressed="false">보기</button>
                </div>
              </div>
              <button class="submit-button" type="submit">비밀번호 변경 <span aria-hidden="true">→</span></button>
            </form>
          <% } %>

          <div class="auth-switch">
            <a href="/login">← 로그인으로 돌아가기</a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<%
  const parentAccount = accountType === "parent";
  const selectedAccountType = parentAccount ? "parent" : "academy";
  const invitation = typeof registrationInvite !== "undefined" ? registrationInvite : null;
  const input = { ...(oldInput || {}) };
  const verifiedSocial = typeof socialRegistration !== "undefined" ? socialRegistration : null;
  if (verifiedSocial) { input.email = verifiedSocial.email; if (!input.displayName) input.displayName = verifiedSocial.displayName; }
  const flow = parentAccount ? "parent" : invitation || input.registrationFlow === "staff" ? "staff" : "new";
  const action = typeof registrationAction !== "undefined" && registrationAction ? registrationAction : parentAccount ? "/parent/register" : "/academy/register";
  const config = selectedAccountType === "parent"
    ? {
        label: "학부모",
        eyebrow: "PARENT ACCOUNT",
        title: "자녀의 학습을 함께 확인하세요.",
        description: "학부모 계정을 먼저 만들고, 자녀의 초대로 안전하게 연결하세요.",
        action: "/parent/register",
        login: "/parent/login",
      }
    : {
        label: "학원",
        eyebrow: "ACADEMY ACCOUNT",
        title: "학원 운영을 시작하세요.",
        description: "새 학원을 등록하거나, 원장에게 받은 교사 초대로 합류하세요.",
        action: "/academy/register",
        login: "/academy/login",
      };
  const expiryLabel = invitation ? new Intl.DateTimeFormat("ko-KR", { timeZone: "Asia/Seoul", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(invitation.expiresAt)) : "";
  if (invitation) config.login += "?next=" + encodeURIComponent(parentAccount ? "/parent/invite/" + invitation.token : "/academy/staff-invite/" + invitation.token);
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Matths <%= config.label %> 전용 회원가입" />
    <meta name="referrer" content="no-referrer" />
    <title><%= config.label %> 회원가입 | Matths</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="stylesheet" href="/css/matths-theme.css" />
    <link rel="stylesheet" href="/css/portal-register.css" />
    <script src="/js/portal-register.js" defer></script>
    <script src="/js/auth.js" defer></script>
  </head>
  <body class="portal-registration-page">
    <a class="skip-link" href="#portal-register-form">회원가입 폼으로 이동</a>
    <header class="auth-header">
      <%- include("partials/matths-brand", {
        href: "/",
        ariaLabel: "Matths 메인 페이지",
        className: "auth-brand",
      }) %>
      <nav aria-label="회원가입 페이지 메뉴">
        <span>이미 <%= config.label %> 계정이 있나요?</span>
        <a href="<%= config.login %>">로그인</a>
      </nav>
    </header>

    <main class="auth-layout">
      <section class="auth-visual" aria-labelledby="portal-visual-title">
        <div class="visual-copy">
          <p><%= config.eyebrow %></p>
          <h1 id="portal-visual-title">
            <% if (parentAccount) { %>자녀의 노력에,<br /><strong>든든한 동행을.</strong><% } else { %>학원 운영의 시작,<br /><strong>확인된 권한으로.</strong><% } %>
          </h1>
          <span><%= parentAccount ? "간단하게 가입하고, 자녀가 공유한 학습 현황과 결제 내역을 학부모 전용 화면에서 확인하세요." : "기관 정보와 담당자 권한을 확인한 뒤, 반·출결·과제를 한곳에서 관리하세요." %></span>
        </div>
        <div class="visual-points">
          <% if (parentAccount) { %><span><b>01</b>간단한 독립 가입</span><span><b>02</b>자녀 초대로 안전한 연결</span><span><b>03</b>학부모 전용 대시보드</span><% } else { %><span><b>01</b>기관 등록과 운영 권한 확인</span><span><b>02</b>초대받은 교사의 참여 신청</span><span><b>03</b>승인 후 운영 시작</span><% } %>
        </div>
      </section>

      <section class="auth-panel" id="portal-register-form" aria-labelledby="portal-register-title">
        <div class="auth-panel-inner" data-portal-registration data-account-type="<%= selectedAccountType %>" data-invitation-locked="<%= Boolean(invitation) %>">
          <div class="auth-heading">
            <p><%= config.eyebrow %></p>
            <h2 id="portal-register-title" data-flow-title><%= !parentAccount && flow === 'staff' ? '초대받은 학원에 합류하세요.' : config.title %></h2>
            <span><%= config.description %></span>
          </div>

          <nav class="account-type-switcher" aria-label="계정 유형 선택">
            <a href="/student/register">학생</a>
            <a href="/academy/register" class="<%= selectedAccountType === 'academy' ? 'is-active' : '' %>" <% if (selectedAccountType === "academy") { %>aria-current="page"<% } %>>학원</a>
            <a href="/parent/register" class="<%= selectedAccountType === 'parent' ? 'is-active' : '' %>" <% if (selectedAccountType === "parent") { %>aria-current="page"<% } %>>학부모</a>
          </nav>

          <% if (!parentAccount) { %><nav class="portal-paths" aria-label="학원 가입 경로"><a href="/academy/register" data-registration-path="new" class="<%= flow === 'new' ? 'is-selected' : '' %>"><strong>새 학원 등록</strong><span>원장·대표 담당자</span></a><a href="/academy/register?path=staff" data-registration-path="staff" class="<%= flow === 'staff' ? 'is-selected' : '' %>"><strong>초대받은 교사</strong><span>기존 학원에 합류</span></a></nav><% } %>
          <ol class="portal-progress" aria-label="가입 단계" data-registration-progress hidden></ol>
          <% if (error) { %><div class="form-alert" role="alert"><span aria-hidden="true">!</span><p><%= error %></p></div><% } %>
          <% if (verifiedSocial) { %><p class="portal-note"><%= verifiedSocial.providerLabel %> 인증 완료 · 아래 가입 정보와 동의를 확인해 주세요.</p><% } else { %><%- include("partials/social-auth-buttons", { accountType: selectedAccountType, socialAuthProviders: typeof socialAuthProviders !== "undefined" ? socialAuthProviders : [], inviteToken: invitation?.token || "", registrationFlow: flow, next: "" }) %><% } %>
          <p class="portal-step-status" data-step-status role="status" aria-live="polite" hidden></p>
          <form class="auth-form" method="post" action="<%= action %>" data-register-form data-portal-form>
            <input type="hidden" name="registrationFlow" value="<%= flow %>" />
            <input type="hidden" name="inviteToken" value="<%= invitation ? invitation.token : input.inviteToken || '' %>" data-invite-token />
            <fieldset class="portal-stage" data-registration-stage="account">
              <legend tabindex="-1"><%= parentAccount ? '학부모 계정 만들기' : '담당자 계정' %></legend>
              <div class="form-field"><label for="displayName"><%= parentAccount ? '학부모 이름' : '담당자 이름' %></label><input id="displayName" name="displayName" value="<%= input.displayName || '' %>" minlength="2" maxlength="<%= parentAccount ? 30 : 40 %>" autocomplete="name" placeholder="실명" required /></div>
              <div class="form-field"><label for="email">로그인 이메일</label><input id="email" name="email" type="email" value="<%= verifiedSocial ? verifiedSocial.email : invitation ? invitation.email : input.email || '' %>" maxlength="254" autocomplete="email" inputmode="email" autocapitalize="none" <%= invitation || verifiedSocial ? 'readonly' : '' %> required /><small class="field-guide"><%= verifiedSocial ? '소셜 계정에서 인증한 이메일입니다.' : invitation ? '초대받은 이메일로 고정됩니다.' : parentAccount ? '자녀가 초대를 보낼 이메일과 같은 주소를 사용하세요.' : '신청·승인 안내를 받을 이메일입니다.' %></small></div>
              <% if (!verifiedSocial) { %><div class="form-field"><label for="password">비밀번호</label><div class="password-field"><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required /><button type="button" data-password-toggle="password" aria-label="비밀번호 표시" aria-pressed="false">보기</button></div><small class="field-guide">영문과 숫자를 포함해 8자 이상 입력해 주세요.</small></div>
              <div class="form-field"><label for="passwordConfirm">비밀번호 확인</label><div class="password-field"><input id="passwordConfirm" name="passwordConfirm" type="password" minlength="8" autocomplete="new-password" required /><button type="button" data-password-toggle="passwordConfirm" aria-label="비밀번호 확인 표시" aria-pressed="false">보기</button></div><small class="field-guide" id="password-match"></small></div><% } %>
              <% if (parentAccount) { %><label class="check-field terms-field"><input type="checkbox" name="termsAccepted" value="1" <%= input.termsAccepted ? 'checked' : '' %> required /><span aria-hidden="true"></span><em>[필수] <a href="/terms" target="_blank" rel="noopener">이용약관</a>과 <a href="/privacy" target="_blank" rel="noopener">개인정보처리방침</a>에 동의합니다.</em></label><% } %>
            </fieldset>
            <% if (!parentAccount) { %>
              <fieldset class="portal-stage" data-registration-stage="institution" <%= flow === 'staff' ? 'hidden disabled' : '' %>>
                <legend tabindex="-1">학원 기본 정보</legend>
                <div class="form-field"><label for="academyName">학원 이름</label><input id="academyName" name="academyName" value="<%= input.academyName || '' %>" minlength="2" maxlength="80" autocomplete="organization" placeholder="학원 공식 명칭" required /></div>
                <div class="form-field"><label for="branchName">지점 이름 <small>선택</small></label><input id="branchName" name="branchName" value="<%= input.branchName || '' %>" maxlength="80" placeholder="본점·분원명" /></div>
                <div class="form-field"><label for="address">학원 주소</label><input id="address" name="address" value="<%= input.address || '' %>" minlength="5" maxlength="200" autocomplete="street-address" placeholder="지역 및 상세 주소" required /></div>
                <div class="form-field"><label for="contactPhone">학원 연락처</label><input id="contactPhone" name="contactPhone" type="tel" value="<%= input.contactPhone || '' %>" minlength="7" maxlength="30" autocomplete="tel" placeholder="운영 안내를 받을 연락처" required /></div>
                <p class="portal-note">기관 정보·담당자 권한·계약 상태는 신청 후 운영자가 확인합니다. 추가 확인 자료가 필요하면 별도로 안내드립니다.</p>
              </fieldset>
              <fieldset class="portal-stage" data-registration-stage="staff" <%= flow === 'new' ? 'hidden disabled' : '' %>>
                <legend tabindex="-1">학원 초대 확인</legend>
                <p class="portal-note">원장이 발급한 교사 전용 초대 링크로 참여합니다. 학생용 초대 링크로는 교사 권한을 받을 수 없습니다.</p>
                <% if (!invitation) { %><div class="form-field"><label for="inviteLink">교사 초대 링크</label><div class="portal-invite-input"><input id="inviteLink" name="inviteLink" value="<%= input.inviteToken || '' %>" placeholder="원장에게 받은 링크를 붙여넣으세요" data-invite-link /><button type="button" class="portal-secondary" data-invite-lookup>초대 확인</button></div></div><% } %>
                <%- include("partials/portal-registration-invite", { invitation, parentAccount, expiryLabel }) %>
                <p class="field-guide">초대에 지정된 학원으로만 신청됩니다. 가입 후 원장 승인 전까지 학생 정보·출결·과제에 접근할 수 없습니다.</p>
              </fieldset>
              <fieldset class="portal-stage" data-registration-stage="review">
                <legend tabindex="-1">확인하고 신청하기</legend>
                <dl class="portal-review" data-registration-review hidden></dl>
                <p class="portal-note" data-new-only <%= flow === 'staff' ? 'hidden' : '' %>>계정 생성 → 기관·권한 검토와 계약 확인 → 운영 시작<br />승인 대기 중에는 신청 상태만 확인할 수 있습니다.</p>
                <p class="portal-note" data-staff-only <%= flow === 'new' ? 'hidden' : '' %>>교사 초대 확인 → 참여 신청 → 원장 승인<br />학원 정보를 다시 등록하거나 원장 권한을 임의로 선택하지 않습니다.</p>
                <label class="check-field terms-field"><input type="checkbox" name="termsAccepted" value="1" <%= input.termsAccepted ? 'checked' : '' %> required /><span aria-hidden="true"></span><em>[필수] <a href="/terms" target="_blank" rel="noopener">이용약관</a>과 <a href="/privacy" target="_blank" rel="noopener">개인정보처리방침</a>에 동의합니다.</em></label>
                <label class="check-field terms-field" data-new-only <%= flow === 'staff' ? 'hidden' : '' %>><input type="checkbox" name="authorityConfirmed" value="1" <%= input.authorityConfirmed ? 'checked' : '' %> <%= flow === 'staff' ? 'disabled' : 'required' %> /><span aria-hidden="true"></span><em>[필수] 학원 운영 권한이 있는 담당자임을 확인합니다.</em></label>
              </fieldset>
            <% } else { %>
              <fieldset class="portal-stage" data-registration-stage="child">
                <legend tabindex="-1">자녀 계정 연결 <small>초대가 없으면 나중에</small></legend>
                <p class="portal-note">자녀가 학부모 이메일로 보낸 초대를 확인하고 연결합니다. 자녀 이름이나 이메일을 검색해 임의로 연결할 수 없습니다.</p>
                <% if (!invitation) { %><div class="form-field"><label for="inviteLink">자녀 초대 링크 <small>선택</small></label><div class="portal-invite-input"><input id="inviteLink" name="inviteLink" value="<%= input.inviteToken || '' %>" placeholder="자녀에게 받은 링크를 붙여넣으세요" data-invite-link /><button type="button" class="portal-secondary" data-invite-lookup>초대 확인</button></div></div><% } %>
                <%- include("partials/portal-registration-invite", { invitation, parentAccount, expiryLabel }) %>
                <div class="portal-child-consent" data-child-consent>
                  <div class="form-field"><label for="relationship">자녀와의 관계</label><select id="relationship" name="relationship" <%= invitation ? 'required' : '' %>><option value="">선택해 주세요</option><% [['FATHER', '부'], ['MOTHER', '모'], ['GUARDIAN', '기타 보호자']].forEach(([value, label]) => { %><option value="<%= value %>" <%= input.relationship === value ? 'selected' : '' %>><%= label %></option><% }) %></select></div>
                  <label class="check-field terms-field"><input type="checkbox" name="linkConsent" value="1" <%= input.linkConsent ? 'checked' : '' %> <%= invitation ? 'required' : '' %> /><span aria-hidden="true"></span><em>초대에 표시된 자녀와 공유 범위(학습 현황·결제 내역)를 확인하고 연결에 동의합니다.</em></label>
                </div>
                <p class="field-guide">연결 후에도 학부모 전용 화면만 이용합니다. 학생 계정으로 로그인하거나 학생 대시보드에 접근할 수 없습니다.</p>
              </fieldset>
            <% } %>
            <div class="portal-actions"><button type="button" class="portal-secondary" data-registration-back hidden>이전</button><button type="button" class="portal-primary" data-registration-next hidden>다음 →</button><button class="submit-button" type="submit" data-registration-submit><%= parentAccount ? invitation ? '가입하고 자녀 연결하기' : '학부모 계정 만들기' : '학원 계정 신청' %><span aria-hidden="true">→</span></button></div>
            <% if (parentAccount && !invitation) { %><button type="button" class="portal-later" data-connect-later hidden>초대가 없어요 · 나중에 연결하기</button><noscript><p class="field-guide">초대가 없으면 자녀 연결 항목을 비워두고 가입하세요. 나중에 이메일 초대로 연결할 수 있습니다.</p></noscript><% } %>
          </form>

          <div class="auth-switch"><span>이미 계정이 있나요?</span><a href="<%= config.login %>"><%= config.label %> 로그인</a></div>
        </div>
      </section>
    </main>
    <%- include("partials/business-footer") %>
  </body>
</html>

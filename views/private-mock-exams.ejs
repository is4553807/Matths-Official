<%
  const gradeLabel = {
    10: "고등학교 1학년",
    11: "고등학교 2학년",
    12: "고등학교 3학년",
    13: "N수생",
  }[Number(user.schoolGrade)] || "학년 미설정";
  const formatRelease = (value) =>
    new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      month: "long",
      day: "numeric",
      weekday: "long",
      hour: "numeric",
      minute: "2-digit",
    }).format(new Date(value));
  const currentRatingRules = [
    "응시한 회차의 유효한 결과는 응시자 본인의 내부 실력 지표에만 반영됩니다.",
    "공개 경쟁전 점수는 바뀌지 않으며, 응시하지 않은 사용자에게도 불이익이 없습니다.",
    "토요일 12시 마감 후 전체 응시자의 성적을 집계해 반영합니다.",
  ];
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Matths 주간 공식 모의고사와 응시자 본인의 내부 실력 지표 반영 안내" />
    <title>Matths 주간 공식 모의고사 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/private-mock-exams.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/main.js" defer></script>
    <script src="/js/private-mock-exams.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#private-mock-main">본문으로 바로가기</a>
    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>
      <%- include("partials/dashboard-sidebar", {
  activePage: "weekly-mock",
  profileName: String(user.name || "학생"),
  profileSubtitle: gradeLabel,
  navigationUser: user,
}) %>

      <main class="dashboard-main private-mock-main" id="private-mock-main">
        <header class="topbar">
          <div class="topbar-left">
            <button class="sidebar-open" id="sidebar-open" type="button" aria-label="학습 메뉴 열기" aria-controls="dashboard-sidebar" aria-expanded="false">
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>일요일 15시 공개 · 토요일 12시 마감 · 한국시간</p>
              <h1>Matths 주간 공식 모의고사</h1>
            </div>
          </div>
          <a class="learning-home-button" href="/main">학습 홈으로 <span aria-hidden="true">→</span></a>
        </header>

        <% if (!examData.eligibility.allowed) { %>
          <section class="private-mock-eligibility-card">
            <p>응시 조건</p>
            <h2><%= examData.eligibility.title %></h2>
            <span><%= examData.eligibility.message %></span>
            <a href="<%= examData.eligibility.ctaHref %>"><%= examData.eligibility.ctaLabel %> <b aria-hidden="true">→</b></a>
          </section>
        <% } else { %>
        <section
          class="private-mock-hero"
          data-server-now="<%= examData.serverNow %>"
          data-release-at="<%= examData.nextReleaseAt %>"
          data-close-at="<%= examData.currentExam?.closeAt ? new Date(examData.currentExam.closeAt).toISOString() : "" %>"
        >
          <div>
            <p>Matths 주간 모의고사</p>
            <h2>일요일에 열고,<br />한 주 동안 도전하세요.</h2>
            <span>한국시간 기준 일요일 15시부터 토요일 12시까지 원하는 때 시작할 수 있습니다. 시작부터 최대 100분 동안 응시하며, 토요일 12시에는 남은 시간과 관계없이 종료됩니다.</span>
          </div>
          <div class="private-mock-countdown">
            <small data-mock-countdown-label>공개까지</small>
            <strong data-mock-countdown>계산 중</strong>
            <span><%= formatRelease(examData.nextReleaseAt) %></span>
          </div>
        </section>

        <div class="private-mock-grid">
          <section class="private-mock-card current">
            <header>
              <div><p>이번 주</p><h2>이번 주 모의고사</h2></div>
              <span><%= examData.durationMinutes %>분</span>
            </header>
            <% if (examData.currentExam) { %>
              <h3><%= examData.currentExam.title %></h3>
              <p class="private-mock-current-meta"><%= examData.currentExam.isTest ? "CUSTOM · 운영 확인용" : "주간 모의고사" %> · <%= examData.currentExam.questionCount %>문항 · 최대 <%= examData.durationMinutes %>분<br /><%= formatRelease(examData.currentExam.releaseAt) %> 공개 ~ <%= formatRelease(examData.currentExam.closeAt) %> 마감</p>
              <% if (examData.currentExam.isTest) { %>
                <p class="private-mock-test-notice">CUSTOM 회차의 점수는 내부 실력 지표·공지·자동 아카이브에 반영되지 않습니다.</p>
              <% } %>
              <% if (examData.currentExam.attemptStatus === "expired") { %>
                <span class="private-mock-start-link disabled" aria-disabled="true">응시 시간 종료</span>
              <% } else if (!examData.currentExam.canEnterRoom) { %>
                <span
                  class="private-mock-start-link disabled"
                  aria-disabled="true"
                  data-private-mock-room-link
                  data-room-href="<%= examData.currentExam.href %>"
                  data-lobby-opens-at="<%= examData.currentExam.lobbyOpensAt %>"
                >시험장 입장 대기</span>
              <% } else { %>
                <a class="private-mock-start-link" href="<%= examData.currentExam.href %>" data-private-mock-room-link data-submitted="<%= examData.currentExam.attemptStatus === "submitted" ? "1" : "0" %>">
                  <%= examData.currentExam.attemptStatus === "submitted"
                    ? "제출 결과 보기"
                    : examData.currentExam.attemptStatus === "in_progress"
                      ? `이어서 응시 (${examData.currentExam.answeredCount}문항 작성)`
                      : examData.currentExam.canStart
                        ? "시험 시작"
                        : "시험장 입장" %>
                  <span aria-hidden="true">→</span>
                </a>
              <% } %>
            <% } else { %>
              <div class="private-mock-empty">
                <span aria-hidden="true">◇</span>
                <h3>현재 응시 가능한 시험이 없습니다.</h3>
                <p>등록된 회차가 공개되면 이 카드에서 응시할 수 있습니다.</p>
              </div>
            <% } %>
            <% if (examData.selection && examData.selection.canChoose) { %>
              <form
                class="private-mock-selection-form compact"
                data-private-mock-selection
                data-week-key="<%= examData.selection.weekKey %>"
              >
                <h3>이번 주 내부 실력 지표 반영 성적 선택</h3>
                <div class="private-mock-selection-options">
                  <% examData.selection.attempts.forEach((attempt) => { %>
                    <label>
                      <input
                        type="radio"
                        name="representativeAttempt"
                        value="<%= attempt.id %>"
                        <%= examData.selection.selectedAttemptId === attempt.id ? "checked" : "" %>
                      />
                      <strong><%= attempt.attemptNumber %>회차 기록</strong>
                      <span>평가 지표 <%= attempt.standardizedPerformance %></span>
                    </label>
                  <% }) %>
                </div>
                <div class="private-mock-selection-actions">
                  <button type="submit">선택 저장</button>
                  <button type="button" class="secondary" data-private-mock-defer>마감 전까지 선택 미루기</button>
                </div>
                <small data-private-mock-selection-status aria-live="polite"></small>
              </form>
            <% } else if (examData.selection && examData.selection.locked) { %>
              <div class="private-mock-selection-guide">
                <strong>대표 성적 선택이 확정되었습니다.</strong>
                <span>
                  <%= examData.selection.selectionReason === "only-submission"
                    ? "응시한 시험이 하나여서 해당 성적을 자동 반영했습니다."
                    : examData.selection.selectionReason === "highest-standardized"
                      ? "선택하지 않아 최고 표준화 성적을 자동 반영했습니다."
                      : "직접 선택한 시험 성적을 반영했습니다." %>
                </span>
              </div>
            <% } %>
          </section>

          <section class="private-mock-card rules">
            <header>
              <div><p>내부 실력 지표</p><h2>주간 성적 반영 기준</h2></div>
            </header>
            <ol>
              <% currentRatingRules.forEach((rule, index) => { %>
                <li><span><%= String(index + 1).padStart(2, "0") %></span><p><%= rule %></p></li>
              <% }) %>
            </ol>
          </section>
        </div>

        <% } %>
      </main>
    </div>
  <%- include("partials/business-footer") %>
  </body>
</html>

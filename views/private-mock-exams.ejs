<%
  const gradeLabel = {
    10: "고등학교 1학년",
    11: "고등학교 2학년",
    12: "고등학교 3학년",
    13: "N수생",
  }[Number(user.schoolGrade)] || "학년 미설정";
  const formatRelease = (value) =>
    new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      month: "long",
      day: "numeric",
      weekday: "long",
      hour: "numeric",
      minute: "2-digit",
    }).format(new Date(value));
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="매주 일요일 3회 공개되는 Matths 주간 공식 모의고사와 최종 종합 랭킹" />
    <title>Matths 주간 공식 모의고사 | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/private-mock-exams.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <script src="/js/main.js" defer></script>
    <script src="/js/private-mock-exams.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#private-mock-main">본문으로 바로가기</a>
    <div class="dashboard-shell">
      <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>
      <aside class="sidebar" id="dashboard-sidebar" aria-label="학습 메뉴">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Matths 메인">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span>Matths</span>
          </a>
          <button class="sidebar-close" id="sidebar-close" type="button" aria-label="메뉴 닫기">×</button>
        </div>
        <%- include("partials/dashboard-navigation", {
          activePage: "war-of-masters",
        }) %>
        <div class="sidebar-spacer"></div>
        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile"><%= String(user.name || "M").slice(0, 1) %></a>
          <div class="profile-copy">
            <strong><%= user.name %>님</strong>
            <small><%= gradeLabel %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main class="dashboard-main private-mock-main" id="private-mock-main">
        <header class="topbar">
          <div class="topbar-left">
            <button class="sidebar-open" id="sidebar-open" type="button" aria-label="학습 메뉴 열기" aria-controls="dashboard-sidebar" aria-expanded="false">
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>매주 일요일 3회 제공</p>
              <h1>Matths 주간 공식 모의고사</h1>
            </div>
          </div>
          <a class="learning-home-button" href="/main">학습 홈으로 <span aria-hidden="true">→</span></a>
        </header>

        <% if (!examData.eligibility.allowed) { %>
          <section class="private-mock-eligibility-card">
            <p>응시 조건</p>
            <h2><%= examData.eligibility.title %></h2>
            <span><%= examData.eligibility.message %></span>
            <a href="<%= examData.eligibility.ctaHref %>"><%= examData.eligibility.ctaLabel %> <b aria-hidden="true">→</b></a>
          </section>
        <% } else { %>
        <section
          class="private-mock-hero"
          data-server-now="<%= examData.serverNow %>"
          data-release-at="<%= examData.nextReleaseAt %>"
        >
          <div>
            <p>Matths 매주 일요일</p>
            <h2>한 번의 실수 대신,<br />세 번의 도전으로 증명하세요.</h2>
            <span>가장 먼저 응시할 수 있는 시험 하나만 안내합니다. 공개 10분 전부터 시험장에 입장하고, 시작 시각에 문제지를 열 수 있습니다.</span>
          </div>
          <div class="private-mock-countdown">
            <small>가장 가까운 시험</small>
            <strong data-mock-countdown>계산 중</strong>
            <span><%= formatRelease(examData.nextReleaseAt) %></span>
          </div>
        </section>

        <div class="private-mock-grid">
          <section class="private-mock-card current">
            <header>
              <div><p>이번 주</p><h2>이번 주 모의고사</h2></div>
              <span><%= examData.durationMinutes %>분</span>
            </header>
            <% if (examData.currentExam) { %>
              <h3><%= examData.currentExam.title %></h3>
              <p class="private-mock-current-meta"><%= examData.currentExam.isTest ? "TEST · OMR 확인용" : `${examData.currentExam.formCode}형` %> · <%= examData.currentExam.questionCount %>문항 · <%= examData.durationMinutes %>분 · <%= formatRelease(examData.currentExam.releaseAt) %> 시작</p>
              <% if (examData.currentExam.isTest) { %>
                <p class="private-mock-test-notice">이 회차의 점수는 주간 GP·랭킹·공지·자동 아카이브에 반영되지 않습니다.</p>
              <% } %>
              <% if (examData.currentExam.attemptStatus === "expired") { %>
                <span class="private-mock-start-link disabled" aria-disabled="true">응시 시간 종료</span>
              <% } else if (!examData.currentExam.canEnterRoom) { %>
                <span
                  class="private-mock-start-link disabled"
                  aria-disabled="true"
                  data-private-mock-room-link
                  data-room-href="<%= examData.currentExam.href %>"
                  data-lobby-opens-at="<%= examData.currentExam.lobbyOpensAt %>"
                >시험장 입장 대기</span>
              <% } else { %>
                <a class="private-mock-start-link" href="<%= examData.currentExam.href %>" data-private-mock-room-link>
                  <%= examData.currentExam.attemptStatus === "submitted"
                    ? "제출 결과 보기"
                    : examData.currentExam.attemptStatus === "in_progress"
                      ? `이어서 응시 (${examData.currentExam.answeredCount}문항 작성)`
                      : examData.currentExam.canStart
                        ? "시험 시작"
                        : "시험장 입장" %>
                  <span aria-hidden="true">→</span>
                </a>
              <% } %>
            <% } else { %>
              <div class="private-mock-empty">
                <span aria-hidden="true">◇</span>
                <h3>현재 응시 가능한 시험이 없습니다.</h3>
                <p>등록된 회차가 공개되면 이 카드에서 응시할 수 있습니다.</p>
              </div>
            <% } %>
            <% if (examData.selection && examData.selection.canChoose) { %>
              <form
                class="private-mock-selection-form compact"
                data-private-mock-selection
                data-week-key="<%= examData.selection.weekKey %>"
              >
                <h3>최종 종합 랭킹 대표 성적 선택</h3>
                <div class="private-mock-selection-options">
                  <% examData.selection.attempts.forEach((attempt) => { %>
                    <label>
                      <input
                        type="radio"
                        name="representativeAttempt"
                        value="<%= attempt.id %>"
                        <%= examData.selection.selectedAttemptId === attempt.id ? "checked" : "" %>
                      />
                      <strong><%= attempt.formCode %>형</strong>
                      <span>표준화 <%= attempt.standardizedPerformance %></span>
                    </label>
                  <% }) %>
                </div>
                <div class="private-mock-selection-actions">
                  <button type="submit">선택 저장</button>
                  <button type="button" class="secondary" data-private-mock-defer>3회차 후 선택</button>
                </div>
                <small data-private-mock-selection-status aria-live="polite"></small>
              </form>
            <% } else if (examData.selection && examData.selection.locked) { %>
              <div class="private-mock-selection-guide">
                <strong>대표 성적 선택이 확정되었습니다.</strong>
                <span>
                  <%= examData.selection.selectionReason === "only-submission"
                    ? "응시한 시험이 하나여서 해당 성적을 자동 반영했습니다."
                    : examData.selection.selectionReason === "highest-standardized"
                      ? "선택하지 않아 최고 표준화 성적을 자동 반영했습니다."
                      : "직접 선택한 시험 성적을 반영했습니다." %>
                </span>
              </div>
            <% } %>
          </section>

          <section class="private-mock-card rules">
            <header>
              <div><p>랭킹 반영 기준</p><h2>최종 종합 랭킹 기준</h2></div>
            </header>
            <ol>
              <% examData.rankingRules.forEach((rule, index) => { %>
                <li><span><%= String(index + 1).padStart(2, "0") %></span><p><%= rule %></p></li>
              <% }) %>
            </ol>
          </section>
        </div>

        <section class="private-mock-card weekly-ranking">
          <header>
            <div>
              <p>최종 종합 랭킹</p>
              <h2><%= examData.rankingTitle %></h2>
            </div>
            <span><%= examData.rankingFinalized ? "최종 종합 랭킹 확정" : examData.rankingPending ? "최종 종합 랭킹 집계 중" : "최종 종합 랭킹 공개 대기" %> · 대표 표준화 성적</span>
          </header>
          <% if (examData.rankingSummary) { %>
            <dl class="private-mock-ranking-summary">
              <div><dt>응시 인원</dt><dd><%= examData.rankingSummary.participantCount %>명</dd></div>
              <div><dt>대표 성적 평균</dt><dd><%= examData.rankingSummary.averageScore %></dd></div>
            </dl>
          <% } %>
          <% if (!examData.weeklyRanking.length) { %>
            <div class="private-mock-empty compact">
              <span aria-hidden="true">♜</span>
              <% if (examData.rankingPending) { %>
                <h3>평균과 성적 데이터를 분석하고 있습니다.</h3>
                <p><%= formatRelease(examData.rankingPending.publishesAt) %>에 이번 주 랭킹이 공개됩니다.</p>
              <% } else { %>
                <h3>아직 공개된 최종 종합 랭킹이 없습니다.</h3>
                <p>시험 종료 후 집계가 끝나면 최종 종합 랭킹이 표시됩니다.</p>
              <% } %>
            </div>
          <% } else { %>
            <ol class="private-mock-ranking-list">
              <% examData.weeklyRanking.forEach((entry, index) => { %>
                <li>
                  <strong><%= entry.rank || index + 1 %></strong>
                  <span><%= entry.displayName %></span>
                  <b><%= entry.standardizedPerformance %></b>
                  <small><%= entry.attemptCount %>회 응시 · <%= entry.elapsedLabel %></small>
                </li>
              <% }) %>
            </ol>
          <% } %>
        </section>
        <% } %>
      </main>
    </div>
  </body>
</html>

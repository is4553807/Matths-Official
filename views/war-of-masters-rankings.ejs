<%
  const gradeLabel = {
    10: "고1",
    11: "고2",
    12: "고3",
    13: "N수생",
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Matths Sub Division·Main Division과 티어 내 순위"
    />
    <title>Sub Division·Main Division 랭킹 | War of GOAT | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/war-of-masters.css" />
    <link rel="stylesheet" href="/css/tier-rankings.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <script src="/js/main.js" defer></script>
    <script src="/js/tier-rankings.js" defer></script>
  </head>
  <body class="masters-page rankings-page">
    <a class="skip-link" href="#rankings-main">본문으로 바로가기</a>

    <div class="dashboard-shell">
      <div
        class="sidebar-overlay"
        id="sidebar-overlay"
        hidden
      ></div>
      <aside
        class="sidebar"
        id="dashboard-sidebar"
        aria-label="학습 메뉴"
      >
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Matths 메인">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span>Matths</span>
          </a>
          <button
            class="sidebar-close"
            id="sidebar-close"
            type="button"
            aria-label="메뉴 닫기"
          >×</button>
        </div>
        <%- include("partials/dashboard-navigation", {
          activePage: "war-of-masters",
        }) %>
        <div class="sidebar-spacer"></div>
        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile">
            <%= String(user.name || "M").slice(0, 1) %>
          </a>
          <div class="profile-copy">
            <strong><%= user.name %>님</strong>
            <small><%= gradeLabel[Number(user.schoolGrade)] || "학년 미설정" %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main class="dashboard-main rankings-main" id="rankings-main">
        <header class="topbar masters-topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>War of GOAT</p>
              <h1>Sub Division·Main Division 랭킹</h1>
            </div>
          </div>
          <div class="masters-topbar-actions">
            <a
              class="back-dashboard secondary learning-home-button"
              href="/main"
            >Matths 대시보드</a>
            <a class="back-dashboard" href="/war-of-masters">
              War of GOAT
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </header>

        <section class="matths-ranking-intro">
          <div>
            <p>티어 랭킹</p>
            <h2>같은 티어 안에서<br />내 위치를 확인하세요.</h2>
          </div>
          <p>
            화면의 랭킹 숫자는 전체 사용자를 한 줄로 세운 순위가 아닙니다.
            Sub와 Main을 나누고, 각 티어 안에서 몇 위인지 표시합니다.
            내 티어는 전체 목록을 스크롤할 수 있고 다른 티어는 상위 20명만 볼 수 있습니다.
          </p>
        </section>

        <%- include("partials/tier-ranking-pools", {
          ranking,
          user,
          rankingTheme: "ranking-theme-matths",
        }) %>
      </main>
    </div>
  </body>
</html>

<%
  const gradeLabel = {
    10: "고1",
    11: "고2",
    12: "고3",
    13: "N수생",
  };
%>
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Matths 최종 종합 랭킹과 고등학교·N수생 랭킹"
    />
    <title>최종 종합 랭킹 | War of GOAT | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/war-of-masters.css" />
    <link rel="stylesheet" href="/css/tier-rankings.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <script src="/js/main.js" defer></script>
    <script src="/js/tier-rankings.js" defer></script>
  </head>
  <body class="masters-page rankings-page">
    <a class="skip-link" href="#rankings-main">본문으로 바로가기</a>

    <div class="dashboard-shell">
      <div
        class="sidebar-overlay"
        id="sidebar-overlay"
        hidden
      ></div>
      <aside
        class="sidebar"
        id="dashboard-sidebar"
        aria-label="학습 메뉴"
      >
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Matths 메인">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span>Matths</span>
          </a>
          <button
            class="sidebar-close"
            id="sidebar-close"
            type="button"
            aria-label="메뉴 닫기"
          >×</button>
        </div>
        <%- include("partials/dashboard-navigation", {
          activePage: "war-of-masters",
        }) %>
        <div class="sidebar-spacer"></div>
        <div class="sidebar-profile">
          <a class="profile-avatar" href="/profile">
            <%= String(user.name || "M").slice(0, 1) %>
          </a>
          <div class="profile-copy">
            <strong><%= user.name %>님</strong>
            <small><%= gradeLabel[Number(user.schoolGrade)] || "학년 미설정" %></small>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" aria-label="로그아웃">↗</button>
          </form>
        </div>
      </aside>

      <main class="dashboard-main rankings-main" id="rankings-main">
        <header class="topbar masters-topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>War of GOAT</p>
              <h1>최종 종합 랭킹</h1>
            </div>
          </div>
          <div class="masters-topbar-actions">
            <a
              class="back-dashboard secondary learning-home-button"
              href="/main"
            >Matths 대시보드</a>
            <a class="back-dashboard" href="/war-of-masters">
              War of GOAT
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </header>

        <section class="matths-ranking-intro">
          <div>
            <p>MATTHS RANKING</p>
            <h2>개인과 학교의<br />현재 위치를 확인하세요.</h2>
          </div>
          <p>
            최종 종합 랭킹은 활성 이용자의 최종 종합 점수로 정렬합니다.
            고등학교별 랭킹은 재학생들의 최종 종합 랭킹 순위 평균이 낮은 학교부터 표시하며,
            N수생은 학교 집계에서 제외하고 별도 N수생 랭킹에서 확인합니다.
          </p>
        </section>

        <section class="matths-final-ranking-hub" data-final-ranking-tabs>
          <div class="ranking-pool-tabs" role="tablist" aria-label="Matths 랭킹 선택">
            <button type="button" role="tab" aria-selected="true" data-final-ranking-tab="overall">최종 종합 랭킹</button>
            <button type="button" role="tab" aria-selected="false" data-final-ranking-tab="school"><%= Number(user.schoolGrade) === 13 ? "N수생 랭킹" : "고등학교별 랭킹" %></button>
          </div>

          <section data-final-ranking-panel="overall">
            <% if (ranking.currentFinal) { %>
              <article class="tier-my-ranking">
                <div><small>나의 최종 종합 랭킹</small><h2><%= ranking.currentFinal.displayName %></h2><p><%= ranking.currentFinal.schoolName || "N수생" %> · <%= ranking.currentFinal.division %> Division</p></div>
                <dl><div><dt>현재 순위</dt><dd><%= ranking.currentFinal.finalRank %><small>위</small></dd></div><div><dt>최종 종합 점수</dt><dd><%= ranking.currentFinal.finalRating %></dd></div></dl>
              </article>
            <% } %>
            <div class="matths-ranking-table-scroll">
              <div class="tier-ranking-table">
                <div class="tier-ranking-row tier-ranking-head"><span>순위</span><span>Division</span><span>이름</span><span>학교</span><span>최종 종합 점수</span></div>
                <% ranking.finalOverall.slice(0, 100).forEach((entry) => { %>
                  <div class="tier-ranking-row <%= entry.userId === String(user._id) ? 'is-me' : '' %>"><b><%= entry.finalRank %></b><span><%= entry.division %> Division</span><strong><%= entry.displayName %></strong><span><%= entry.schoolName || "N수생" %></span><em><%= entry.finalRating %></em></div>
                <% }) %>
              </div>
            </div>
          </section>

          <section data-final-ranking-panel="school" hidden>
            <% if (Number(user.schoolGrade) === 13) { %>
              <div class="matths-ranking-table-scroll"><div class="tier-ranking-table">
                <div class="tier-ranking-row tier-ranking-head"><span>순위</span><span>Division</span><span>이름</span><span>구분</span><span>최종 종합 순위</span></div>
                <% ranking.retakerRankings.forEach((entry) => { %><div class="tier-ranking-row <%= entry.userId === String(user._id) ? 'is-me' : '' %>"><b><%= entry.retakerRank %></b><span><%= entry.division %> Division</span><strong><%= entry.displayName %></strong><span>N수생</span><em><%= entry.finalRank %>위</em></div><% }) %>
              </div></div>
            <% } else { %>
              <div class="school-final-ranking-list">
                <% ranking.schoolRankings.forEach((school) => { %>
                  <details class="school-final-ranking-card">
                    <summary><b><%= school.rank %>위</b><div><strong><%= school.name %></strong><small><%= school.region %> · 재학생 <%= school.participantCount %>명</small></div><em>평균 <%= school.averageFinalRank %>위</em></summary>
                    <div class="school-student-ranking-list">
                      <% school.students.forEach((student, index) => { %><p><b><%= index + 1 %></b><strong><%= student.displayName %></strong><span>최종 종합 <%= student.finalRank %>위</span></p><% }) %>
                    </div>
                  </details>
                <% }) %>
              </div>
            <% } %>
          </section>
        </section>
        <script>
          (() => {
            const root = document.querySelector("[data-final-ranking-tabs]");
            root?.querySelectorAll("[data-final-ranking-tab]").forEach((button) => button.addEventListener("click", () => {
              root.querySelectorAll("[data-final-ranking-tab]").forEach((item) => item.setAttribute("aria-selected", String(item === button)));
              root.querySelectorAll("[data-final-ranking-panel]").forEach((panel) => panel.hidden = panel.dataset.finalRankingPanel !== button.dataset.finalRankingTab);
            }));
          })();
        </script>
      </main>
    </div>
  </body>
</html>

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Matths GOAT Arena 경쟁전 랭킹"
    />
    <meta name="theme-color" content="#0c1125" />
    <title>GOAT Arena | Matths</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/war-of-masters.css" />
    <link rel="stylesheet" href="/css/onboarding-tutorial.css" />
    <link rel="stylesheet" href="/css/brand.css" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32.png"
    />
    <script src="/js/main.js" defer></script>
    <script src="/js/war-of-masters.js" defer></script>
    <script src="/js/onboarding-tutorial.js" defer></script>
  </head>
  <body class="masters-page">
    <a class="skip-link" href="#masters-main">본문으로 바로가기</a>

    <div class="dashboard-shell">
      <div
        class="sidebar-overlay"
        id="sidebar-overlay"
        hidden
      ></div>

      <%- include("partials/dashboard-sidebar", {
  activePage: "war-of-masters",
  profileName: String(arenaUser.nickname || "학생"),
  profileSubtitle: String(arenaUser.gradeLabel || "GOAT Arena"),
  navigationUser: typeof user !== "undefined" ? user : null,
}) %>

      <main class="dashboard-main masters-main" id="masters-main">
        <header class="topbar masters-topbar">
          <div class="topbar-left">
            <button
              class="sidebar-open"
              id="sidebar-open"
              type="button"
              aria-label="학습 메뉴 열기"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
            >
              <span></span><span></span><span></span>
            </button>
            <div>
              <p>Matths 랭킹 Arena</p>
              <h1>GOAT Arena</h1>
            </div>
          </div>
          <a class="back-dashboard learning-home-button" href="/main">
            학습 홈으로 <span aria-hidden="true">→</span>
          </a>
        </header>

        <section class="masters-actions" aria-label="GOAT Arena 메뉴">
          <article class="masters-action-card goat-arena-action-card" data-tutorial-target="arena-match">
            <div>
              <p>일반전 · 경쟁전 · 친선전</p>
              <h2>GOAT Arena</h2>
              <small>
                비슷한 실력의 유저와 대결하거나 친구·단체와 같은 문제를 풀고 결과를 비교하세요.
              </small>
            </div>
            <a class="goat-arena-entry" href="/goat-arena">
              <span class="goat-arena-entry-copy">
                <strong>GOAT Arena 입장</strong>
                <small>Arena 입장</small>
              </span>
              <span class="goat-arena-entry-mark" aria-hidden="true">
                <i></i>
                <b>→</b>
              </span>
            </a>
          </article>

          <article class="masters-action-card placement-action-card" data-tutorial-target="arena-placement">
            <div>
              <span aria-hidden="true">01</span>
              <p>배치고사</p>
              <h2>배치고사</h2>
              <small>
                <%= placement.requiresPaidAccess && !paidPackageAccess.active
                  ? "배치과정 응시 조건을 확인해 주세요."
                  : placement.status === "submitted"
                  ? `${placement.result.initialTier} 배치 완료`
                  : placement.status === "verification-required"
                    ? "제출 결과 확인 중"
                  : placement.status === "in-progress"
                    ? `${placement.answeredCount}개 답안 저장됨`
                    : placement.status === "not-started" && placement.freeInitialAttempt
                      ? "유효한 일반전 3경기 후 시작 · 1~5회 배치"
                      : "경쟁전 초기 점수와 티어 결정" %>
              </small>
            </div>
            <% if (placement.requiresPaidAccess && !paidPackageAccess.active) { %>
              <button type="button" class="private-mock-disabled-action" disabled aria-disabled="true">배치고사 잠김 <span aria-hidden="true">×</span></button>
            <% } else if (placement.status === "submitted") { %>
              <a href="<%= placement.ctaHref %>">배치 결과·스토리 카드 보기 <span aria-hidden="true">→</span></a>
            <% } else if (placement.status === "attempt-used") { %>
              <button type="button" class="private-mock-disabled-action placement-complete-action" disabled aria-disabled="true">배치고사 응시 종료 <span aria-hidden="true">×</span></button>
            <% } else if (placement.status === "not-started") { %>
              <button type="button" data-placement-open>
                <%= placement.ctaLabel %>
                <span aria-hidden="true">→</span>
              </button>
            <% } else { %>
              <a href="<%= placement.ctaHref %>">
                <%= placement.ctaLabel %>
                <span aria-hidden="true">→</span>
              </a>
            <% } %>
          </article>

          <article class="masters-action-card private-mock-action-card" data-tutorial-target="arena-official-mock">
            <div>
              <span aria-hidden="true">02</span>
              <p>매주 일요일 3회 제공</p>
              <h2>Matths 주간 공식 모의고사</h2>
              <small>
                <%= privateMockEligibility.allowed
                  ? "응시 성적은 내부 실력 지표에만 반영 · 경쟁전 점수 미반영 · 미응시 불이익 없음"
                  : "운영 일정과 응시 가능 여부를 확인해 주세요." %>
              </small>
            </div>
            <% if (["payment-required", "access-expired", "placement-required", "verification-required", "ranking-pending"].includes(privateMockEligibility.status)) { %>
              <button
                type="button"
                class="private-mock-disabled-action"
                disabled
                aria-disabled="true"
              >
                주간 공식 모의고사 응시 조건 확인
                <span aria-hidden="true">×</span>
              </button>
            <% } else { %>
              <a href="<%= privateMockEligibility.ctaHref %>">
                <%= privateMockEligibility.ctaLabel %>
                <span aria-hidden="true">→</span>
              </a>
            <% } %>
          </article>

          <article class="masters-action-card ranking-action-card" data-tutorial-target="arena-ranking">
            <div>
              <span aria-hidden="true">03</span>
              <p>랭킹</p>
              <h2>랭킹 보기</h2>
              <small>경쟁전 전체 랭킹과 고등학교·N수생 랭킹</small>
            </div>
            <a href="/war-of-masters/rankings">
              랭킹 페이지 열기
              <span aria-hidden="true">→</span>
            </a>
          </article>

          <article class="masters-action-card identity-action-card" data-tutorial-target="arena-identity">
            <div>
              <span aria-hidden="true">04</span>
              <p>프로필</p>
              <h2>닉네임 관리</h2>
              <small>모든 공개 랭킹과 GOAT Arena에는 닉네임만 표시됩니다.</small>
            </div>
            <a href="/profile#nickname-settings">
              닉네임 확인하기
              <span aria-hidden="true">→</span>
            </a>
          </article>

          <article class="masters-action-card objection-action-card" data-tutorial-target="arena-objection">
            <div>
              <span aria-hidden="true">05</span>
              <p>문제 검토</p>
              <h2>문제 이의신청</h2>
              <small>공개된 Matths 주간 공식 모의고사 문항이나 정답이 잘못되었다고 판단되면 근거와 함께 알려주세요.</small>
            </div>
            <a href="/war-of-masters/objections/new">
              이의신청 작성
              <span aria-hidden="true">→</span>
            </a>
          </article>
        </section>

        <p
          class="sr-only"
          id="dashboard-status"
          role="status"
          aria-live="polite"
        ></p>
      </main>
    </div>

    <dialog
      class="placement-start-dialog"
      id="placement-start-dialog"
      aria-labelledby="placement-dialog-title"
    >
      <form method="dialog" class="placement-dialog-card">
        <button
          class="placement-dialog-close"
          type="submit"
          value="cancel"
          aria-label="닫기"
        >×</button>
        <p>배치고사</p>
        <h2 id="placement-dialog-title">경쟁전 배치과정을 시작합니다.</h2>
        <ul>
          <% if (placement.freeInitialAttempt) { %>
            <li>유효한 일반전 3경기를 완료한 회원은 배치과정을 시작할 수 있습니다.</li>
          <% } %>
          <li>배치는 1회에서 최대 5회까지 진행할 수 있습니다.</li>
          <li>서버 오류로 완료하지 못한 응시는 시도 횟수에서 제외됩니다.</li>
          <li>직접 응시를 중단한 경우에는 사용한 시도가 자동으로 복구되지 않습니다.</li>
          <li>유효한 결과로 초기 경쟁전 점수와 티어를 결정합니다.</li>
        </ul>
        <div>
          <button type="submit" value="cancel">취소</button>
          <button type="button" data-placement-confirm>
            확인하고 바로 시작
          </button>
        </div>
      </form>
      <form
        id="placement-start-form"
        action="/war-of-masters/placement/start"
        method="post"
        hidden
      ></form>
    </dialog>
  <%- include("partials/onboarding-tutorial", { page: "war-of-masters" }) %>
  <%- include("partials/business-footer") %>
  </body>
</html>
